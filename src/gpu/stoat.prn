  169                                   ; *******************************************************************
  170                                   ; texter
  171                                   ;
  172                                   ; Jaguar texter. Input IN_BUF=address of textstring, +4=address of font structure, +8/+12=dropshadow vector X/Y
  173                                   ; +16/+20=XY scale, +24/+28=XY shear, +32=text origin
  174                                   ;*
  175                                   ;* REX: Robotron explosion generator. Takes an image from the source screen and expands it in X and Y, then
  176                                   ;*  uses a1_n to draw the resultant matrix of single pixels.
  177                                   ;*
  178                                   ;*  Provide: dest screen in gpu_screen, in_buf: 0=source image address
  179                                   ;*  4=source image start pixel address, 8=x and y size of source, 12=X scale (16:16), 16=Y scale (16:16), 20=X shear (16:16), 24=Y shear,
  180                                   ;*  28=Mode (0=Top edge, 1=Centered), 32=Dest X and Y
  181                                   ;*
  182                                   ;*****
  183                                   ; *******************************************************************
  184                                   texter:
  185           =0000000D                       blit     REGEQU r13
  186           =0000000E                       a1_n     REGEQU r14
  187           =0000000F                       a2_n     REGEQU r15
  188                                       
  189           =00000002                       _bass    REGEQU r2         ; Source base address
  190           =00000003                       spixel   REGEQU r3         ; Source pixel start
  191           =00000004                       ssize    REGEQU r4         ; Source rectangle size
  192           =00000005                       scalex   REGEQU r5
  193           =00000006                       scaley   REGEQU r6         ; Scaling X and Y
  194           =00000007                       shearx   REGEQU r7
  195           =00000008                       sheary   REGEQU r8         ; Shearing X and Y
  196           =00000009                       mode     REGEQU r9         ; Centering mode
  197                                       
  198           =0000000A                       xinc     REGEQU r10
  199           =0000000B                       yinc     REGEQU r11
  200           =0000000C                       xstep    REGEQU r12
  201           =00000010                       ystep    REGEQU r16
  202           =00000011                       _xstart  REGEQU r17
  203           =00000012                       ystart   REGEQU r18
  204           =00000013                       himask   REGEQU r19
  205           =00000014                       lomask   REGEQU r20
  206           =00000015                       dstxy    REGEQU r21
  207           =00000016                       axshear  REGEQU r22
  208           =00000017                       ayshear  REGEQU r23
  209                                       
  210           =00000018                       xx       REGEQU r24
  211           =00000019                       yy       REGEQU r25
  212           =0000001A                       x_add    REGEQU r26
  213           =0000001D                       textptr  REGEQU r29
  214           =0000001E                       fontbase REGEQU r30
  215                                       
  216           =00000002                       dropx    REGEQU r2
  217           =00000003                       dropy    REGEQU r3
  218                                       
