   85                                   ; *******************************************************************
   86                                   ; sdiv
   87                                   ; *******************************************************************
   88                                           MACRO sdiv                 ; Divide, keeping sign of that which is divided, uses r27
   89                                 .         move \2,r31
   90                                 .         abs \2
   91                                 .         div \1,\2
   92                                 .         btst #31,r31               ; Get sign bit of original thang
   93                                 .         jr z,\~sdtt
   94                                 .         nop
   95                                 .         neg \2
   96                                 .       \~sdtt:
   97                                 .         ENDM
   98                                       
   99                                   ; *******************************************************************
  100                                   ; waitblit
  101                                   ; *******************************************************************
  102                                           MACRO waitblit             ; Wait for the Blitter to stop
  103                                 .       \~waitt:
  104                                 .         load (blit),r31
  105                                 .         btst #0,r31
  106                                 .         jr z,\~waitt
  107                                 .         nop
  108                                 .         ENDM


                                        src/gpu/stoat.gas    Page 18      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


