  145                                   ; fjsr
  146                                   ; *******************************************************************
  147                                           MACRO fjsr                 ; Fast single-level JSR
  148                                 .         move PC,r30
  149                                 .         jump (\1)
  150                                 .         addq #6,r30                ; Determine Return Address
  151                                 .         ENDM
  152                                       
  153                                           MACRO frts
  154                                 .         jump (r30)
  155                                 .         nop
  156                                 .         ENDM
  157                                       
  158                                           MACRO gjsr                 ; Fast single-level JSR
  159                                 .         move PC,r31
  160                                 .         jump (\1)
  161                                 .         addq #6,r31                ; Determine Return Address
  162                                 .         ENDM
  163                                       
  164                                           MACRO grts


