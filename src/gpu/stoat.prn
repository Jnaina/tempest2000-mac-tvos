   74           =00000000                       _base EQU 0
   75           =00000001                       _flags EQU 1
   76           =00000002                       _clip EQU 2
   77           =00000002                       _mask EQU 2
   78           =00000003                       _pixel EQU 3
   79           =00000004                       _step EQU 4
