  110                                   ; *******************************************************************
  111                                   ; fmult
  112                                   ; *******************************************************************
  113                                           MACRO fmult                ; multiply 2 thangs, uses r2-r4, returns in first reg.
  114                                 .         moveta \2,r0               ; (preserves second Thang)
  115                                 .         moveq #0,r27
  116                                 .         move r27,r28
  117                                 .         abs \1
  118                                 .         addc r28,r27
  119                                 .         abs \2
  120                                 .         addc r28,r27
  121                                 .         move \2,r28
  122                                 .         mult \1,r28
  123                                 .         move \1,r29
  124                                 .         shrq #16,r28
  125                                 .         shrq #16,r29
  126                                 .         mult \2,r29
  127                                 .         shrq #16,\2
  128                                 .         add r29,r28
  129                                 .         move \2,r29
  130                                 .         mult \1,r29
  131                                 .         shrq #16,\1
  132                                 .         add r29,r28
  133                                 .         mult \2,\1
  134                                 .         shlq #16,\1
  135                                 .         add r28,\1
  136                                 .         btst #0,r27
  137                                 .         jr z,\~fmptt
  138                                 .         movefa r0,\2
  139                                 .         neg \1
  140                                 .       \~fmptt:
  141                                 .         ENDM
  142                                       
  143                                       
