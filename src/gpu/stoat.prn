  122           =00018000               O_2GAP          EQU     (3<<15)
  123           =00020000               O_3GAP          EQU     (4<<15)
  124           =00028000               O_4GAP          EQU     (5<<15)
  125           =00030000               O_5GAP          EQU     (6<<15)
  126           =00038000               O_6GAP          EQU     (7<<15)
  127                                   
  128           =00000000               O_BREQ          EQU     (0<<14) ; CC field of BRANCH objects
  129           =00004000               O_BRGT          EQU     (1<<14)
  130           =00008000               O_BRLT          EQU     (2<<14)
  131           =0000C000               O_BROP          EQU     (3<<14)
  132           =00010000               O_BRHALF        EQU     (4<<14)
