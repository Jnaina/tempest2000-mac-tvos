  931                                   ;*
  932                                   ;* SCARPER: SCale And Rotate an image with PERspective into the destination rectangle
  933                                   ;*
  934                                   ;* INPUTS: set up source_ and dest_flags as usual; gpu_screen set to the destination screen;
  935                                   ;*
  936                                   ;* IN_BUF:  0()=Source screen
  937                                   ;*          4()=Dest x width, in pixels
  938                                   ;*         8()=Dest y height, in pixels
  939                                   ;*        12()=X scale factor, as an 8:8 frac
  940                                   ;*        16()=Y scale factor, as an 8:8 frac (faster than multiplying a 16:16)
  941                                   ;*        20()=Angle of rotation, in brads
  942                                   ;*        24()=Centre of rotation X, 16:16, on source image
  943                                   ;*        28()=Centre of rotation Y, 16:16, on source image
  944                                   ;*        32()=Height of VP above surface, 16:16
  945                                   ;*        36()=Destination offset, Y:X
  946                                   ;*


