  651                                   ;* scar
  652                                   ;
  653                                   ;* SCAR: SCale And Rotate an image into the destination rectangle
  654                                   ;*
  655                                   ;* INPUTS: set up source_ and dest_flags as usual; gpu_screen set to the destination screen;
  656                                   ;*
  657                                   ;* IN_BUF:  0()=Source screen
  658                                   ;*          4()=Dest x width, in pixels
  659                                   ;*          8()=Dest y width, in pixels
  660                                   ;*         12()=X scale factor, as an 8:8 frac
  661                                   ;*         16()=Y scale factor, as an 8:8 frac (faster than multiplying a 16:16)
  662                                   ;*         20()=Angle of rotation, in brads
  663                                   ;*         24()=Centre of rotation X, 16:16, on source image
  664                                   ;*         28()=Centre of rotation Y, 16:16, on source image
  665                                   ;*         32()=Destination offset, Y:X
  666                                   ;*         36()=Delta intensity
  667                                   ;*
  668                                   ; *******************************************************************
  669                                   scar:
  670                                       
  671           =00000001                       d_width   REGEQU r1        ; Destination width
  672           =00000002                       d_height  REGEQU r2
  673           =00000003                       x1_n      REGEQU r3
  674           =00000004                       y1_n      REGEQU r4
  675           =00000005                       x2_n      REGEQU r5
  676           =00000006                       y2_n      REGEQU r6        ; Useful co-ordinate registers
  677                                       
