 1165                                   ; *******************************************************************
 1166                                   ;*
 1167                                   ; voxel
 1168                                   ;
 1169                                   ;* VOXEL: Based on the VoxelSpace technique used in Comanche Maximum Overkill
 1170                                   ;*
 1171                                   ;* INPUTS: set up dest_flags as usual; gpu_screen set to the destination screen;
 1172                                   ;*
 1173                                   ;* IN_BUF:  0()=Source screen
 1174                                   ;*          4()=Dest x width, in voxels (4-pixel width units)
 1175                                   ;*         8()=Dest y (# of rows of voxels front to back)
 1176                                   ;*        12()=X scale factor, as an 8:8 frac (for stepping over source image)
 1177                                   ;*        16()=Y scale factor, as an 8:8 frac
 1178                                   ;*        20()=Angle of rotation, in brads
 1179                                   ;*        24()=Centre of rotation X, 16:16, on source image
 1180                                   ;*        28()=Centre of rotation Y, 16:16, on source image
 1181                                   ;*        32()=base height for voxel generation, 16:16
 1182                                   ;*        36()=Multiplier for elevating voxels above the base, 16:16
 1183                                   ;*        40()=Address of Prev Line table
 1184                                   ; *******************************************************************
 1185                                       
 1186                                   voxel:
 1187                                   ;       d_width REGEQU r1               ;Destination width
 1188                                   ;       d_height REGEQU r2
 1189                                   ;       x1_n    REGEQU r3
 1190                                   ;       y1_n    REGEQU r4
 1191                                   ;       x2_n    REGEQU r5
 1192                                   ;       y2_n    REGEQU r6               ;Useful co-ordinate registers
 1193                                       
