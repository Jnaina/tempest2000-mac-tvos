  679           =00000008                       grad_frac REGEQU r8
  680           =00000009                       lo_mask   REGEQU r9
  681           =0000000A                       hi_mask   REGEQU r10
  682           =00000012                       _byte     REGEQU r18
  683           =00000013                       _sinebase REGEQU r19
