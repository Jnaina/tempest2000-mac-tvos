   81                                   ; *******************************************************************
   82                                   ; fmult
   83                                   ; *******************************************************************
   84                                           MACRO fmult                ; multiply 2 thangs, uses r2-r4, returns in first reg.
   85                                 .         moveta \2,r0               ; (preserves second Thang)
   86                                 .         moveq #0,r27
   87                                 .         move r27,r28
   88                                 .         abs \1
   89                                 .         addc r28,r27
   90                                 .         abs \2
   91                                 .         addc r28,r27
   92                                 .         move \2,r28
   93                                 .         mult \1,r28
   94                                 .         move \1,r29
   95                                 .         shrq #16,r28
   96                                 .         shrq #16,r29
   97                                 .         mult \2,r29
   98                                 .         shrq #16,\2
   99                                 .         add r29,r28
  100                                 .         move \2,r29
  101                                 .         mult \1,r29
  102                                 .         shrq #16,\1
  103                                 .         add r29,r28
  104                                 .         mult \2,\1
  105                                 .         shlq #16,\1
  106                                 .         add r28,\1
  107                                 .         btst #0,r27
  108                                 .         jr z,\~fmptt


                                        src/gpu/antelope.gas Page 18      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  109                                 .         movefa r0,\2
  110                                 .         neg \1
  111                                 . \~fmptt:
  112                                 .         ENDM
  113                                       
  114                                   ; *******************************************************************
  115                                   ; sdiv
  116                                   ; *******************************************************************
  117                                           MACRO sdiv                 ; Divide, keeping sign of that which is divided, uses r27
  118                                 .         move \2,r27
  119                                 .         abs \2
  120                                 .         div \1,\2
  121                                 .         btst #31,r27               ; Get sign bit of original thang
  122                                 .         jr z,\~sdtt
  123                                 .         nop
  124                                 .         neg \2
  125                                 . \~sdtt:
  126                                 .         ENDM
  127                                       
  128                                   ; *******************************************************************
  129                                   ; Execution of the module starts here.
  130                                   ;
  131                                   ; Detect the GPU mode selected by the caller and use that to determine
  132                                   ; which routine (shader) to run.
  133                                   ; Mode 0 = mandel
  134                                   ; Mode 1 = ripplewarp
  135                                   ; Mode 2 = scar
  136                                   ; Mode 3 = scarper (Unused.)
  137                                   ; Mode 4 = voxel (Unused.)
  138                                   ; Mode 5 = sinethang
  139                                   ; Mode 6 = rwarp (Unused.)
  140                                   ; *******************************************************************
  141  00000000  98003FFC00F0                   movei #gpu_mode,r0         ; Get mode
  142  00000006  A401                           load (r0),r1
  143  00000008  9802xxxxxxxx                   movei #mandel,r2
  144  0000000E  9803xxxxxxxx                   movei #ripplewarp,r3       ; choices
  145  00000014  9804xxxxxxxx                   movei #scar,r4
  146  0000001A  9805xxxxxxxx                   movei #scarper,r5
  147  00000020  9806xxxxxxxx                   movei #voxel,r6
  148  00000026  9807xxxxxxxx                   movei #v_rwarp,r7
  149  0000002C  7C01                           cmpq #0,r1                 ; Mode 0 select?
  150  0000002E  D042                           jump eq,(r2)               ; Go to mandel
  151  00000030  E400                           nop
  152  00000032  7C21                           cmpq #1,r1                 ; Mode 1 selected?
  153  00000034  D062                           jump eq,(r3)               ; Go to ripplewarp
  154  00000036  E400                           nop
  155  00000038  7C41                           cmpq #2,r1                 ; Mode 2 selected?
  156  0000003A  D082                           jump eq,(r4)               ; Go to scar.
  157  0000003C  E400                           nop
  158  0000003E  7C61                           cmpq #3,r1                 ; Mode 3 selected?
  159  00000040  D0A2                           jump eq,(r5)               ; Go to scarper
  160  00000042  E400                           nop
  161  00000044  7C81                           cmpq #4,r1                 ; Mode 4 selected?
  162  00000046  D0C2                           jump eq,(r6)               ; Go to voxel
  163  00000048  E400                           nop
  164  0000004A  7CC1                           cmpq #6,r1                 ; Mode 6 selected?


                                        src/gpu/antelope.gas Page 19      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  165  0000004C  D0E2                           jump eq,(r7)               ; Go to rwarp
  166  0000004E  E400                           nop
  167                                       
  168  00000050  9803xxxxxxxx                   movei #sinethang,r3        ; Mode 5 selected.
  169  00000056  D060                           jump (r3)                  ; Go to sinethang.
  170  00000058  E400                           nop
  171                                       
  172                                   ; *******************************************************************
  173                                   ; mandel
  174                                   ;
  175                                   ; LEONARD'S MANDY:  Very simple fixed point Mandy generator, using Leonard's inner loop.
  176                                   ;
  177                                   ; Input: gpu_screen points to start of dest screen.
  178                                   ;
  179                                   ;        in_buf has, in order: cx,cy,ix,iy,xstep,ystep.
  180                                   ;
  181                                   ; draw the Mandelbrot set
  182                                   ;
  183                                   ; *******************************************************************
  184                                   mandel:
  185                                       
  186           =00000001                       xi              REGEQU          r1   ; Reg equates for Leonard's old Mandy routine
  187           =00000002                       yi              REGEQU          r2
  188           =00000003                       cx              REGEQU          r3
  189           =00000004                       cy              REGEQU          r4
  190           =00000005                       sx              REGEQU          r5
  191           =00000006                       sy              REGEQU          r6
  192           =00000007                       temp            REGEQU          r7
  193           =00000008                       count           REGEQU          r8
  194           =00000009                       maxcnt          REGEQU          r9
  195           =0000000A                       four            REGEQU          r10
  196           =0000000B                       inloop          REGEQU          r11
  197           =0000000D                       inbuf           REGEQU          r13
  198                                       
  199           =0000000E                       dest            REGEQU  r14   ; New stuff - destination screen base...
  200           =0000000F                       px              REGEQU  r15   ; pixel X counter
  201           =00000010                       py              REGEQU  r16   ; puxel Y counter
  202           =00000011                       xinc            REGEQU  r17   ; x-increment
  203           =00000012                       yinc            REGEQU  r18   ; y-increment
  204           =00000013                       xloop           REGEQU r19
  205           =00000014                       yloop           REGEQU r20   ; loop jump back points
  206                                       
  207                                       
  208                                       
  209  0000005A  980A80000000                   movei   #(4<<13),four
  210  00000060  980900FE0000                   movei   #254,maxcnt
  211  00000066  980D3F6000F0                   movei   #in_buf,inbuf
  212  0000006C  A5A3                           load    (inbuf),cx         ; get initial x/y
  213  0000006E  088D                           addq    #4,inbuf
  214  00000070  A5A4                           load    (inbuf),cy
  215  00000072  088D                           addq    #4,inbuf
  216  00000074  A5A1                           load    (inbuf),xi         ; get x and y initial offset (zero for m-set)
  217  00000076  088D                           addq    #4,inbuf
  218  00000078  A5A2                           load    (inbuf),yi
  219  0000007A  088D                           addq    #4,inbuf
  220  0000007C  A5B1                           load    (inbuf),xinc


                                        src/gpu/antelope.gas Page 20      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  221  0000007E  088D                           addq    #4,inbuf
  222  00000080  A5B2                           load    (inbuf),yinc       ; get x/y step
  223  00000082  088D                           addq    #4,inbuf
  224  00000084  98003FF800F0                   movei #gpu_screen,r0
  225  0000008A  A40E                           load (r0),dest             ; where the graphics shall go
  226  0000008C  9021                           moveta xi,xi
  227  0000008E  9042                           moveta yi,yi               ; save initial values of these
  228  00000090  9813xxxxxxxx                   movei #x_loop,xloop        ; load various constants
  229  00000096  9814xxxxxxxx                   movei #y_loop,yloop
  230  0000009C  980Bxxxxxxxx                   movei   #loop,inloop       ; this is Leonard's Mandy inner loop
  231  000000A2  980F01800000                   movei #width,px
  232  000000A8  981001180000                   movei #height,py
  233  000000AE  91EF                           moveta px,px               ; px needs to be reset at each line-start
  234  000000B0  9063                           moveta cx,cx               ; and so does cx
  235                                       
  236  000000B2  9463                   y_loop: movefa cx,cx
  237  000000B4  95EF                           movefa px,px               ; restore Thangs
  238  000000B6  2D08                   x_loop: xor     count,count        ; count zero
  239  000000B8  9421                           movefa xi,xi
  240  000000BA  9442                           movefa yi,yi               ; restor initial stuff
  241                                       
  242  000000BC  8827                   loop:   move    xi,temp
  243  000000BE  4447                           imult   yi,temp            ; temp=xi*yi
  244  000000C0  4421                           imult   xi,xi              ; xi=xi*xi
  245  000000C2  4442                           imult   yi,yi              ; yi=yi*yi
  246  000000C4  6DA1                           sharq   #13,xi             ; normalize all mult results
  247  000000C6  6DA7                           sharq   #13,temp
  248  000000C8  6DA2                           sharq   #13,yi
  249  000000CA  00E7                           add     temp,temp          ; temp=temp+temp
  250  000000CC  8846                           move    yi,sy              ; sy=yi*yi
  251  000000CE  0087                           add     cy,temp            ; temp=temp+temp+cy
  252  000000D0  8825                           move    xi,sx              ; sx=xi*xi
  253  000000D2  88E2                           move    temp,yi            ; yi=temp+temp+cy
  254  000000D4  10C1                           sub     sy,xi              ; xi=sx-sy
