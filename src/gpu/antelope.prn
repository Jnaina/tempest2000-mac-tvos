  344                                   ;*****
  345                                   ;*
  346                                   ;* StretchLine:  Stretch a line of the source bitmap and copy to the ENTIRE destination scanline.
  347                                   ;*
  348                                   ;* Input: r1 = Source start pixel  (source1)  16:16
  349                                   ;*       r2 = Source end pixel    (source2)  16:16
  350                                   ;*       r3 = Dest scan line.     (dest1)
  351                                   ;*       r4 = Dest scan width.    (dest2)
  352                                   ;*       r5 = Blitter command word.    (cmd)
  353                                   ;*       r6 = Source scanline (source3)
  354                                   ;*
  355                                   ;*       TEMP2 is used to hold the Count register address.
  356                                   ;*       Expects Blitter base stuff set outside of loop.
  357                                   ;*       Expects Blitter base registers to contain their addresses
  358                                   ;*
  359                                   ;*
  360                                   ;*****
  361                                       
  362  0000010C  1022                   stretchline: sub source1,source2   ; get width of source to stretch
  363  0000010E  5482                           div dest2,source2          ; divide by the dest width to yield
  364                                                                   ;the blitter source step
  365  00000110  6203                           shlq #16,dest1
  366                                       
  367  00000112  6207                           shlq #16,source3           ; Y pixel addresses to hi words
  368  00000114  6601                           shrq #16,source1           ; source X pixel back to integer
  369                                       
                                                waitblit                   ; Ensure blitter is stopped
                                      @ M0waitt:
       00000116  A5A0                 @         load (blit),r0
       00000118  3400                 @         btst #0,r0
       0000011A  D7A2                 @         jr z,M0waitt
  370  0000011C  E400                 @         nop
  371  0000011E  2827                           or source1,source3         ; source3 has combined source pixel address
  372  00000120  C863                           store dest1,(a2_n+_pixel)   ; set dest pixel address
  373  00000122  C467                           store source3,(a1_n+_pixel)   ; source start
  374  00000124  2D6B                           xor temp1,temp1            ; generate zero
  375  00000126  C4EB                           store temp1,(a1_n+_inc)    ; zero integer source step
  376  00000128  C4CB                           store temp1,(a1_n+_fpixel)   ; fractional pixel pos'n to 0
  377                                       
  378  0000012A  C502                           store source2,(a1_n+_finc)   ; result of initial divide
  379                                       
  380  0000012C  8880                           move dest2,r0              ; get dest width to loop counter
  381  0000012E  3A00                           bset #16,r0                ; make y count=1
  382  00000130  BD80                           store r0,(temp2)           ; set the count to dest width
  383  00000132  BDA6                           store cmd,(blit)           ; do the blit


                                        src/gpu/antelope.gas Page 23      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


                                                frts                       ; return to caller.
       00000134  D3C0                 @         jump (freturn)
  384  00000136  E400                 @         nop
