  386                                   ;*****
  387                                   ;*
  388                                   ;* V_StretchLine:  Stretch a column of the source bitmap and copy to the ENTIRE destination column.
  389                                   ;*
  390                                   ;* Input: r1 = Source start pixel  (source1)  16:16
  391                                   ;*       r2 = Source end pixel    (source2)  16:16
  392                                   ;*       r3 = Dest X column       (dest1)
  393                                   ;*       r4 = Dest scan height.   (dest2)
  394                                   ;*       r5 = Blitter command word.    (cmd)
  395                                   ;*       r6 = Source column (source3)
  396                                   ;*
  397                                   ;*       TEMP2 is used to hold the Count register address.
  398                                   ;*       Expects Blitter base stuff set outside of loop.
  399                                   ;*       Expects Blitter base registers to contain their addresses
  400                                   ;*
  401                                   ;*
  402                                   ;*****
  403                                       
  404                                   v_stretchline: 
  405  00000138  1022                           sub source1,source2        ; get height of source to stretch
  406  0000013A  5482                           div dest2,source2          ; divide by the dest height to yield
  407                                                                      ; the blitter source vertical step
  408  0000013C  98000000FFFF                   movei #$ffff0000,r0        ; mask
  409  00000142  2401                           and r0,source1             ; source Y in top 16 bits
  410                                       
                                                waitblit                   ; Ensure blitter is stopped
                                      @ M2waitt:
       00000144  A5A0                 @         load (blit),r0
       00000146  3400                 @         btst #0,r0
       00000148  D7A2                 @         jr z,M2waitt
  411  0000014A  E400                 @         nop
  412  0000014C  2827                           or source1,source3         ; source3 has combined source pixel address
  413  0000014E  C863                           store dest1,(a2_n+_pixel)  ; set dest pixel address (DEST1,0)
  414                                       
  415  00000150  C467                           store source3,(a1_n+_pixel); source start
  416  00000152  2D6B                           xor temp1,temp1            ; generate zero
  417  00000154  C4EB                           store temp1,(a1_n+_inc)    ; zero integer source step
  418  00000156  C4CB                           store temp1,(a1_n+_fpixel) ; fractional pixel pos'n to 0
  419                                       
  420  00000158  6202                           shlq #16,source2           ; divide result to top 16-bits
  421                                       
  422  0000015A  C502                           store source2,(a1_n+_finc) ; result of initial divide
  423                                                                      ; is the fractional y-step
  424  0000015C  8880                           move dest2,r0              ; get dest height to loop counter
  425  0000015E  3A00                           bset #16,r0                ; make outer loop count=1
  426  00000160  BD80                           store r0,(temp2)           ; set the count
  427  00000162  BDA6                           store cmd,(blit)           ; do the blit
                                                frts
       00000164  D3C0                 @         jump (freturn)
  428  00000166  E400                 @         nop
