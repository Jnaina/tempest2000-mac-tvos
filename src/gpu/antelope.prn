 1571                                   ;* SINETHANG:  This just generates a smoothly varying source image Thang, mainly for use with Voxel.
 1572                                   ;*
 1573                                   ;* Input: set the dest screen in GPU_SCREEN, in_buf=sine X step, +4=sine Y step
 1574                                   ;*                                                 +8=x phase, +12=y phase
 1575                                   ;*
 1576                                   ; *******************************************************************
 1577                                   sinethang:
 1578                                   ;       _sinebase       REGEQU r19
 1579                                   ;       _byte           REGEQU r18
 1580           =00000001                       sbase           REGEQU r1
 1581           =00000002                       xstep           REGEQU r2   ; 16:16 frac
 1582           =00000003                       ystep           REGEQU r3   ; 16:16 frac
 1583           =00000004                       xcount          REGEQU r4
 1584           =00000005                       ycount          REGEQU r5
 1585           =00000006                       xlooop          REGEQU r6
 1586           =00000007                       ylooop          REGEQU r7
 1587           =00000008                       xphase          REGEQU r8
 1588           =00000009                       yphase          REGEQU r9
 1589           =0000000A                       zero            REGEQU r10
 1590           =0000000B                       nlix            REGEQU r11
 1591           =0000000C                       nliy            REGEQU r12
 1592                                       
 1593  00000DBE  98003FF800F0                   movei #gpu_screen,r0
 1594  00000DC4  A401                           load (r0),sbase            ; set screen base
 1595  00000DC6  98003F6000F0                   movei #in_buf,r0
 1596  00000DCC  A402                           load (r0),xstep
 1597  00000DCE  0880                           addq #4,r0
 1598  00000DD0  A403                           load (r0),ystep
 1599  00000DD2  0880                           addq #4,r0
 1600  00000DD4  A408                           load (r0),xphase
 1601  00000DD6  0880                           addq #4,r0
 1602  00000DD8  A409                           load (r0),yphase           ; get initial status
 1603  00000DDA  0880                           addq #4,r0
 1604  00000DDC  A40B                           load (r0),nlix
 1605  00000DDE  0880                           addq #4,r0
 1606  00000DE0  A40C                           load (r0),nliy
 1607                                       
 1608  00000DE2  981300000003                   movei #p_sines,_sinebase
 1609  00000DE8  981200FF0000                   movei #$ff,_byte
 1610  00000DEE  9806xxxxxxxx                   movei #x_looop,xlooop
 1611  00000DF4  9807xxxxxxxx                   movei #y_looop,ylooop
 1612  00000DFA  2D4A                           xor zero,zero              ; initialise them Constant thangs
 1613                                       
 1614  00000DFC  9108                           moveta xphase,xphase       ; To restart each'n'every line
 1615  00000DFE  9042                           moveta xstep,xstep
 1616  00000E00  980500F00000                   movei #240,ycount          ; Do me 240 times..


                                        src/gpu/antelope.gas Page 57      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 1617  00000E06  980401800000           y_looop: movei #384,xcount
 1618  00000E0C  9508                           movefa xphase,xphase       ; Set line start value
 1619  00000E0E  9442                           movefa xstep,xstep
 1620  00000E10  8914                   x_looop: move xphase,r20           ; Copy for mungeing
 1621  00000E12  8935                           move yphase,r21            ; Might as well interleave Y shit, too
 1622  00000E14  6614                           shrq #16,r20               ; To int
 1623  00000E16  6615                           shrq #16,r21               ; To int
 1624  00000E18  2654                           and _byte,r20              ; To index
 1625  00000E1A  2655                           and _byte,r21              ; To index
 1626  00000E1C  0274                           add _sinebase,r20          ; Points to sine
 1627  00000E1E  0275                           add _sinebase,r21          ; Points to sine
 1628  00000E20  9E96                           loadb (r20),r22
 1629  00000E22  9EB7                           loadb (r21),r23            ; Get the sines
 1630  00000E24  42D7                           mult r22,r23               ; Multiply the little buggers
 1631  00000E26  6D17                           sharq #8,r23               ; Normalise it
 1632  00000E28  2657                           and _byte,r23              ; That's it - that's the colour value, that is
 1633  00000E2A  B437                           storeb r23,(sbase)         ; Put it on the Screen
 1634  00000E2C  0048                           add xstep,xphase           ; Do the Phase
 1635  00000E2E  0162                           add nlix,xstep
 1636  00000E30  1824                           subq #1,xcount
 1637  00000E32  D0C1                           jump ne,(xlooop)           ; Loop
 1638  00000E34  0821                           addq #1,sbase              ; Update the screen address Thang
 1639  00000E36  0183                           add nliy,ystep
 1640  00000E38  1825                           subq #1,ycount
 1641  00000E3A  D0E1                           jump ne,(ylooop)
 1642  00000E3C  0069                           add ystep,yphase           ; shift the y Phase
 1643  00000E3E  980030FC00F0                   movei #StopGPU,r0
 1644  00000E44  D000                           jump (r0)
 1645  00000E46  E400                           nop                        ; stop
