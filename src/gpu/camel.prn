  283                                   ; *******************************************************************
  284                                   ; pretty_poly
  285                                   ;
  286                                   ; This is passed a raw polygon data structure in the in_buf. See for
  287                                   ; example ppyr, which draws the pyramid in head-to-head mode used to
  288                                   ; record player hits..
  289                                   ;*****
  290                                   ;*
  291                                   ;* PRETTY_POLY: Gouraud-shaded poly renderer. Only for triangular pollies.
  292                                   ;*              This version does NOT use the Blitter; it interpolates colours as well as intensities.
  293                                   ;*
  294                                   ;* INPUTS: in_buf       +0 = Pointer to start of poly data structure in main RAM
  295                                   ;*
  296                                   ;* Poly data structure: <x1_n.w><y1_n.w><i1_n.w><col1.w><x2_n.w><y2_n.w><i2_n.w><col2.w><x3_n.w><y3_n.w><i3_n.w><col3.w>
  297                                   ;*
  298                                   ;*****
  299                                   ; *******************************************************************
  300                                   pretty_poly:
  301           =00000017                       c1              REGEQU r23
  302           =00000018                       c2              REGEQU r24
  303           =00000019                       c3              REGEQU r25
  304                                       
  305           =00000005                       sum5            REGEQU r5
