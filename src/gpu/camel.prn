  148                                   ; *******************************************************************
  149                                           MACRO bank0
  150                                 .         movei #G_FLAGS,r0
  151                                 .         load (r0),r1
  152                                 .         bclr #14,r1
  153                                 .         store r1,(r0)              ; Switch to Register Bank #0
  154                                 .         nop
  155                                 .         nop
  156                                 .         nop
  157                                 .         nop
  158                                 .         nop
  159                                 . \~bnk0tt:       movei #G_FLAGS,r0
  160                                 .         load (r0),r1
  161                                 .         btst #14,r1
  162                                 .         jr nz,\~bnk0tt
  163                                 .         nop
  164                                 .         ENDM


