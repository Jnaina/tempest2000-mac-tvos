  663                                   ; *******************************************************************
  664                                   ; crex
  665                                   ; A centred version of 'rex' below - does some set up and falls through
  666                                   ; to execute 'rex'.
  667                                   ;*****
  668                                   ;*
  669                                   ;* REX: Robotron explosion generator. Takes an image from the source screen and expands it in X and Y, then
  670                                   ;*      uses a1_n to draw the resultant matrix of single pixels.
  671                                   ;*
  672                                   ;*      Provide: dest screen in gpu_screen, in_buf: 0=source image address
  673                                   ;*      4=source image start pixel address, 8=x and y size of source, 12=X scale (16:16), 16=Y scale (16:16), 20=X shear (16:16), 24=Y shear,
  674                                   ;*      28=Mode (0=Top edge, 1=Centered), 32=Dest X and Y
  675                                   ;*
  676                                   ;*****
  677                                   ; *******************************************************************
  678                                   crex:
  679           =0000000F                       a2_n            REGEQU r15
  680           =00000002                       _bass           REGEQU r2   ; Source base address
  681           =00000003                       spixel          REGEQU r3   ; Source pixel start
  682           =00000004                       ssize           REGEQU r4   ; Source rectangle size
  683           =00000005                       scalex          REGEQU r5
  684           =00000006                       scaley          REGEQU r6   ; Scaling X and Y
  685           =00000007                       shearx          REGEQU r7
  686           =00000008                       sheary          REGEQU r8   ; Shearing X and Y
  687           =00000009                       mode            REGEQU r9   ; Centering mode
  688                                       
  689           =0000000A                       xinc            REGEQU r10
  690           =0000000B                       yinc            REGEQU r11
  691           =0000000C                       xstep           REGEQU r12
  692           =00000010                       ystep           REGEQU r16
  693           =00000011                       _xstart         REGEQU r17
  694           =00000012                       ystart          REGEQU r18
  695           =00000013                       himask          REGEQU r19
  696           =00000014                       lomask          REGEQU r20
  697           =00000015                       dstx            REGEQU r21
  698           =00000016                       axshear         REGEQU r22
  699           =00000017                       ayshear         REGEQU r23
  700                                       
  701           =00000018                       xx              REGEQU r24
  702           =00000019                       yy              REGEQU r25
  703           =0000001A                       dsty            REGEQU r26
  704           =00000001                       dstz            REGEQU r1
  705                                       
