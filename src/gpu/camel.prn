  310           =00000001               SRCEN           EQU     $00000001       ; d00:     source data read (inner loop)
  311           =00000002               SRCENZ          EQU     $00000002       ; d01:     source Z read (inner loop)
  312           =00000004               SRCENX          EQU     $00000004       ; d02:     source data read (realign)
  313           =00000008               DSTEN           EQU     $00000008       ; d03:     dest data read (inner loop)
  314           =00000010               DSTENZ          EQU     $00000010       ; d04:     dest Z read (inner loop)
  315           =00000020               DSTWRZ          EQU     $00000020       ; d05:     dest Z write (inner loop)
  316           =00000040               CLIP_A1         EQU     $00000040       ; d06:     A1 clipping enable
  317           =00000100               UPDA1F          EQU     $00000100       ; d08:     A1 update step fraction
  318           =00000200               UPDA1           EQU     $00000200       ; d09:     A1 update step
  319           =00000400               UPDA2           EQU     $00000400       ; d10:     A2 update step
  320           =00000800               DSTA2           EQU     $00000800       ; d11:     reverse usage of A1 and A2
  321           =00001000               GOURD           EQU     $00001000       ; d12:     enable Gouraud shading
  322           =00002000               ZBUFF           EQU     $00002000       ; d13:     polygon Z data updates
  323           =00004000               TOPBEN          EQU     $00004000       ; d14:     intensity carry into byte
  324           =00008000               TOPNEN          EQU     $00008000       ; d15:     intensity carry into nibble
  325           =00010000               PATDSEL         EQU     $00010000       ; d16:     Select pattern data
  326           =00020000               ADDDSEL         EQU     $00020000       ; d17:     diagnostic
  327                                                                           ; d18-d20: Z comparator inhibit
  328           =00040000               ZMODELT         EQU     $00040000       ;            source < destination
  329           =00080000               ZMODEEQ         EQU     $00080000       ;            source = destination
  330           =00100000               ZMODEGT         EQU     $00100000       ;            source > destination
  331                                                                           ; d21-d24: Logic function control
  332           =00200000               LFU_NAN         EQU     $00200000       ;            !source & !destination
  333           =00400000               LFU_NA          EQU     $00400000       ;            !source &  destination
  334           =00800000               LFU_AN          EQU     $00800000       ;             source & !destination


                                        jaguar.inc           Page 8       5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  335           =01000000               LFU_A           EQU     $01000000       ;             source &  destination
  336                                   
  337           =02000000               CMPDST          EQU     $02000000       ; d25:     pixel compare pattern & dest
  338           =04000000               BCOMPEN         EQU     $04000000       ; d26:     bit compare write inhibit
  339           =08000000               DCOMPEN         EQU     $08000000       ; d27:     data compare write inhibit
  340           =10000000               BKGWREN         EQU     $10000000       ; d28:     data write back
  341           =20000000               BUSHI           EQU     $20000000       ; d29      blitter priority
  342           =40000000               SRCSHADE        EQU     $40000000       ; d30:     shade src data w/IINC value
  343                                   
  344                                   ;;;
  345                                   ;;; The following are ALL 16 possible logical operations of the LFUs
  346                                   ;;;
  347                                   
  348           =00000000               LFU_ZERO        EQU     $00000000       ; All Zeros
  349           =00200000               LFU_NSAND       EQU     $00200000       ; NOT Source AND NOT Destination
  350           =00400000               LFU_NSAD        EQU     $00400000       ; NOT Source AND Destination
  351           =00600000               LFU_NOTS        EQU     $00600000       ; NOT Source
  352           =00800000               LFU_SAND        EQU     $00800000       ; Source AND NOT Destination
  353           =00A00000               LFU_NOTD        EQU     $00A00000       ; NOT Destination
  354           =00C00000               LFU_SXORD       EQU     $00C00000       ; Source XOR Destination
  355           =00E00000               LFU_NSORND      EQU     $00E00000       ; NOT Source OR NOT Destination
  356           =01000000               LFU_SAD         EQU     $01000000       ; Source AND Destination
  357           =01200000               LFU_N_SXORD     EQU     $01200000       ; NOT (Source XOR Destination)
  358           =01400000               LFU_D           EQU     $01400000       ; Destination
  359           =01600000               LFU_NSORD       EQU     $01600000       ; NOT Source OR Destination
  360           =01800000               LFU_S           EQU     $01800000       ; Source
  361           =01A00000               LFU_SORND       EQU     $01A00000       ; Source OR NOT Destination
  362           =01C00000               LFU_SORD        EQU     $01C00000       ; Source OR Destination
  363           =01E00000               LFU_ONE         EQU     $01E00000       ; All Ones
  364                                   
  365                                   ; These are some common combinations with less boolean names
  366                                   
  367           =01800000               LFU_REPLACE     EQU     $01800000       ; Source REPLACEs destination
  368           =00C00000               LFU_XOR         EQU     $00C00000       ; Source XOR with destination
  369           =00000000               LFU_CLEAR       EQU     $00000000       ; CLEAR destination
  370                                   
  371                                   ;;;
  372                                   ;;; BLITTER Flags (A1 or A2) register equates
  373                                   ;;;
  374                                   
  375                                   ; Pitch d00-d01:
  376                                   ;       distance between pixel phrases
  377           =00000000               PITCH1          EQU     $00000000       ; 0 phrase gap
  378           =00000001               PITCH2          EQU     $00000001       ; 1 phrase gap
  379           =00000002               PITCH4          EQU     $00000002       ; 3 phrase gap
  380           =00000003               PITCH3          EQU     $00000003       ; 2 phrase gap
  381                                   
  382                                   ; Pixel d03-d05
  383                                   ;       bit depth (2^n)
  384           =00000000               PIXEL1          EQU     $00000000       ; n = 0
  385           =00000008               PIXEL2          EQU     $00000008       ; n = 1
  386           =00000010               PIXEL4          EQU     $00000010       ; n = 2
  387           =00000018               PIXEL8          EQU     $00000018       ; n = 3
  388           =00000020               PIXEL16         EQU     $00000020       ; n = 4
  389           =00000028               PIXEL32         EQU     $00000028       ; n = 5
  390                                   


                                        jaguar.inc           Page 9       5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  391                                   ; Z offset d06-d08
  392                                   ;       offset from phrase of pixel data from its corresponding
  393                                   ;       Z data phrases
  394           =00000000               ZOFFS0          EQU     $00000000       ; offset = 0    UNUSED
  395           =00000040               ZOFFS1          EQU     $00000040       ; offset = 1
  396           =00000080               ZOFFS2          EQU     $00000080       ; offset = 2
  397           =000000C0               ZOFFS3          EQU     $000000C0       ; offset = 3
  398           =00000100               ZOFFS4          EQU     $00000100       ; offset = 4
  399           =00000140               ZOFFS5          EQU     $00000140       ; offset = 5
  400           =00000180               ZOFFS6          EQU     $00000180       ; offset = 6
  401           =000001C0               ZOFFS7          EQU     $000001C0       ; offset = 7    UNUSED
  402                                   
