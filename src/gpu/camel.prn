  665                                   ;;;
  666                                   
  667           =00F1D000               ROM_TABLE       EQU     BASE + $1D000   ; Base of tables
  668                                   
  669           =00F1D000               ROM_TRI         EQU     BASE + $1D000   ; A triangle wave
  670           =00F1D200               ROM_SINE        EQU     BASE + $1D200   ; Full amplitude SINE


                                        jaguar.inc           Page 14      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  671           =00F1D400               ROM_AMSINE      EQU     BASE + $1D400   ; Linear (?) ramp SINE
  672           =00F1D600               ROM_12W         EQU     BASE + $1D600   ; SINE(X)+SINE(2*X) : (was ROM_SINE12W)
  673           =00F1D800               ROM_CHIRP16     EQU     BASE + $1D800   ; SHORT SWEEP
  674           =00F1DA00               ROM_NTRI        EQU     BASE + $1DA00   ; Triangle w/NOISE
  675           =00F1DC00               ROM_DELTA       EQU     BASE + $1DC00   ; Positive spike
  676           =00F1DE00               ROM_NOISE       EQU     BASE + $1DE00   ; Guess
