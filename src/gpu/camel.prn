   89                                   ; *******************************************************************
   90                                   ; sdiv
   91                                   ; *******************************************************************
   92                                           MACRO sdiv                 ; Divide, keeping sign of that which is divided, uses r27
   93                                 .         move \2,r31
   94                                 .         abs \2
   95                                 .         div \1,\2
   96                                 .         btst #31,r31               ; Get sign bit of original thang
   97                                 .         jr z,\~sdtt
   98                                 .         nop
   99                                 .         neg \2
  100                                 . \~sdtt:
  101                                 .         ENDM
  102                                       
  103                                   ; *******************************************************************
  104                                   ; waitblit
  105                                   ; *******************************************************************
  106                                           MACRO waitblit             ; Wait for the Blitter to stop
  107                                 . \~waitt:        load (blit),r31
  108                                 .         btst #0,r31


                                        src/gpu/camel.gas    Page 18      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  109                                 .         jr z,\~waitt
  110                                 .         nop
  111                                 .         ENDM
  112                                       
  113                                   ; *******************************************************************
  114                                   ; fmult
  115                                   ; *******************************************************************
  116                                           MACRO fmult                ; multiply 2 thangs, uses r2-r4, returns in first reg.
  117                                 .         moveta \2,r31              ; (preserves second Thang)
  118                                 .         moveq #0,r27
  119                                 .         move r27,r28
  120                                 .         abs \1
  121                                 .         addc r28,r27
  122                                 .         abs \2
  123                                 .         addc r28,r27
  124                                 .         move \2,r28
  125                                 .         mult \1,r28
  126                                 .         move \1,r29
  127                                 .         shrq #16,r28
  128                                 .         shrq #16,r29
  129                                 .         mult \2,r29
  130                                 .         shrq #16,\2
  131                                 .         add r29,r28
  132                                 .         move \2,r29
  133                                 .         mult \1,r29
  134                                 .         shrq #16,\1
  135                                 .         add r29,r28
  136                                 .         mult \2,\1
  137                                 .         shlq #16,\1
  138                                 .         add r28,\1
  139                                 .         btst #0,r27
  140                                 .         jr z,\~fmptt
  141                                 .         movefa r31,\2
  142                                 .         neg \1
  143                                 . \~fmptt:
  144                                 .         ENDM
