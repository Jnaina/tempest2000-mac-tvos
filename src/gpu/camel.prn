  186                                       
  187                                   ; *******************************************************************
  188                                   ; Execution of the module starts here.
  189                                   ;
  190                                   ; Detect the GPU mode selected by the caller and use that to determine
  191                                   ; which routine (shader) to run.
  192                                   ; Mode 1 = poly
  193                                   ; Mode 2 = pretty_poly
  194                                   ; Mode 3 = crex
  195                                   ; Mode 4 = rex
  196                                   ; Mode 5 = polyo2d (Not used).
  197                                   ; *******************************************************************
  198  00000000  98003FFC00F0                   movei #gpu_mode,r0
  199  00000006  A401                           load (r0),r1               ; get gpu #
  200  00000008  9802xxxxxxxx                   movei #poly,r2
  201  0000000E  9803xxxxxxxx                   movei #pretty_poly,r3
  202  00000014  9804xxxxxxxx                   movei #crex,r4
  203  0000001A  9805xxxxxxxx                   movei #rex,r5
  204  00000020  9806xxxxxxxx                   movei #polyo2d+2,r6
  205  00000026  7C21                           cmpq #1,r1                 ; Mode 1 selected?
  206  00000028  D042                           jump eq,(r2)               ; Jump to poly
  207  0000002A  E400                           nop
  208  0000002C  7C41                           cmpq #2,r1                 ; Mode 2 selected?
  209  0000002E  D062                           jump eq,(r3)               ; Jumpt to pretty_poly
  210  00000030  E400                           nop
  211  00000032  7C61                           cmpq #3,r1                 ; Mode 3 selected?
  212  00000034  D082                           jump eq,(r4)               ; Jump to crex
  213  00000036  E400                           nop
  214  00000038  7C81                           cmpq #4,r1                 ; Mode 4 selected?
  215  0000003A  D0A2                           jump eq,(r5)               ; Jump to rex.
  216  0000003C  E400                           nop
  217  0000003E  7CA1                           cmpq #5,r1                 ; Mode 5 selected?
  218  00000040  D0C2                           jump eq,(r6)               ; Jump to polyo2d
  219  00000042  E400                           nop
  220                                       


                                        src/gpu/camel.gas    Page 20      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  221                                   ; *******************************************************************
  222                                   ; poly
  223                                   ;
  224                                   ;*****
  225                                   ;*
  226                                   ;* POLY: Gouraud-shaded poly renderer. Only for triangular pollies.
  227                                   ;*
  228                                   ;* INPUTS: in_buf       +0 = Pointer to start of poly data structure in main RAM
  229                                   ;*
  230                                   ;* Poly data structure: <x1_n.w><y1_n.w><i1_n.w><x2_n.w><y2_n.w><i2_n.w><x3_n.w><y3_n.w><i3_n.w>
  231                                   ;*
  232                                   ;*****
  233                                   ; *******************************************************************
  234                                   poly:
  235                                       
  236           =00000003                       x1_n            REGEQU r3
  237           =00000004                       y1_n            REGEQU r4
  238           =00000005                       x2_n            REGEQU r5
  239           =00000006                       y2_n            REGEQU r6
  240           =00000007                       x3_n            REGEQU r7
  241           =00000008                       y3_n            REGEQU r8
  242           =00000009                       i1_n            REGEQU r9
  243           =0000000A                       i2_n            REGEQU r10
  244           =0000000B                       i3_n            REGEQU r11
  245           =0000000C                       xinc1           REGEQU r12
  246           =0000000F                       iinc1           REGEQU r15
  247           =00000010                       xinc2           REGEQU r16
  248           =00000011                       iinc2           REGEQU r17
  249           =00000012                       count1          REGEQU r18
  250           =00000013                       count2          REGEQU r19
  251           =00000014                       loop1           REGEQU r20
  252           =00000015                       loop2           REGEQU r21
  253           =00000016                       count3          REGEQU r22
  254           =00000017                       sum1            REGEQU r23
  255           =00000018                       sum2            REGEQU r24
  256           =00000019                       sum3            REGEQU r25
  257           =0000001A                       sum4            REGEQU r26
  258                                       
  259           =0000001B                       xstart          REGEQU r27
  260           =0000001C                       istart          REGEQU r28
  261           =0000001D                       xsize           REGEQU r29
  262           =0000001E                       isize           REGEQU r30
  263           =00000002                       cmd             REGEQU r2
  264                                       
  265                                       
  266           =0000000D                       blit            REGEQU r13
  267           =0000000E                       a1_n            REGEQU r14
  268                                       
  269                                           MACRO swap
  270                                 .         move \1,r31
  271                                 .         move \2,\1
  272                                 .         move r31,\2
  273                                 .         ENDM
