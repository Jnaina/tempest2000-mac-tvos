  652           =00000001               FIRE_X          EQU     1
  653                                   
  654           =00F00000               ANY_JOY         EQU     $00F00000       ; AND joyedge with this...
  655                                                                           ; joypad was pressed if result is not 0
  656           =32002200               ANY_FIRE        EQU     $32002200       ; AND joyedge with this...
  657                                                                           ; A,B C, Option or Pause was pressed
