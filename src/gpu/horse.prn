  218                                   ; *******************************************************************
  219                                   ; Detect the GPU mode selected by the caller and use that to determine
  220                                   ; which routine (shader) to run.


                                        src/gpu/horse.gas    Page 20      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  221                                   ; Mode 0 = polyo2d
  222                                   ; Mode 1 = pring2
  223                                   ; Mode 2 = psphere
  224                                   ; *******************************************************************
  225  0000000E  98003FFC00F0                   movei #gpu_mode,r0
  226  00000014  9801xxxxxxxx                   movei #pring2,r1
  227  0000001A  9802xxxxxxxx                   movei #psphere,r2
  228  00000020  A41F                           load (r0),r31
  229  00000022  7C3F                           cmpq #1,r31                ; Mode 1 selected?
  230  00000024  D022                           jump eq,(r1)               ; Jump to pring2.
  231  00000026  E400                           nop
  232  00000028  7C5F                           cmpq #2,r31                ; Mode 2 selected?
  233  0000002A  D042                           jump eq,(r2)               ; Jump to psphere.
  234  0000002C  E400                           nop
  235                                           ; Mode 1 selected. Fall through to polyo2d.
  236                                       
  237                                   ; *******************************************************************
  238                                   ; polyo2d
  239                                   ;*
  240                                   ;* POLYO2D:  Draw 2D object made of polygons, positioned in Tempest 3D space (extended version with clipping)
  241                                   ;*
  242                                   ;* Inputs: IN_BUF+0=Pointer to poly object data structure
  243                                   ;*         +4=X +8=Y +12=Z, Tempest world co-ordinates
  244                                   ;*         +16=X centre; +20=Y centre, as 16:16 fractions; +24=XY Rotation Angle
  245                                   ;*
  246                                   ; Used by drawsolidxy, one of the main solid polygon drawing routines.
  247                                   ; *******************************************************************
  248                                   polyo2d:
  249           =00000003                       x1_n            REGEQU r3
  250           =00000004                       y1_n            REGEQU r4
  251           =00000005                       x2_n            REGEQU r5
  252           =00000006                       y2_n            REGEQU r6
  253           =00000007                       x3_n            REGEQU r7
  254           =00000008                       y3_n            REGEQU r8
  255           =00000009                       i1_n            REGEQU r9
  256           =0000000A                       i2_n            REGEQU r10
  257           =0000000B                       i3_n            REGEQU r11
  258           =0000000C                       xinc1           REGEQU r12
  259           =0000000F                       iinc1           REGEQU r15
  260           =00000010                       xinc2           REGEQU r16
  261           =00000011                       iinc2           REGEQU r17
  262           =00000012                       count1          REGEQU r18
  263           =00000013                       count2          REGEQU r19
  264           =00000014                       loop1           REGEQU r20
  265           =00000015                       loop2           REGEQU r21
  266           =00000016                       count3          REGEQU r22
  267           =00000017                       sum1            REGEQU r23
  268           =00000018                       sum2            REGEQU r24
  269           =00000019                       sum3            REGEQU r25
  270           =0000001A                       sum4            REGEQU r26
  271                                       
  272           =0000001B                       xstart          REGEQU r27
  273           =0000001C                       istart          REGEQU r28
  274           =0000001D                       xsize           REGEQU r29
  275           =0000001E                       isize           REGEQU r30
  276           =00000002                       cmd             REGEQU r2


