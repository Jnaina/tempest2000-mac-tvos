  117                                   ; *******************************************************************
  118                                   ; waitblit
  119                                   ; *******************************************************************
  120                                           MACRO waitblit             ; Wait for the Blitter to stop
  121                                 . \~waitt:load (blit),r31
  122                                 .         btst #0,r31
  123                                 .         jr z,\~waitt
  124                                 .         nop
  125                                 .         ENDM
