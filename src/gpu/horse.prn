  719                                   
  720           =00000040               D_CPULAT        EQU     $00000040       ; Interrupt Latches
  721           =00000080               D_I2SLAT        EQU     $00000080
  722           =00000100               D_TIM1LAT       EQU     $00000100
  723           =00000200               D_TIM2LAT       EQU     $00000200
  724           =00000400               D_EXT1LAT       EQU     $00000400
  725           =00010000               D_EXT2LAT       EQU     $00010000
