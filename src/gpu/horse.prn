  681                                   
  682           =00F1A100               D_FLAGS         EQU     BASE + $1A100   ; DSP Flags
  683           =00F1A104               D_MTXC          EQU     BASE + $1A104   ; DSP Matrix Control
  684           =00F1A108               D_MTXA          EQU     BASE + $1A108   ; DSP Matrix Address
  685           =00F1A10C               D_END           EQU     BASE + $1A10C   ; DSP Data Organization
  686           =00F1A110               D_PC            EQU     BASE + $1A110   ; DSP Program Counter
  687           =00F1A114               D_CTRL          EQU     BASE + $1A114   ; DSP Operation Control/Status
  688           =00F1A118               D_MOD          EQU     BASE + $1A118   ; DSP Modulo Instruction Mask
  689           =00F1A11C               D_REMAIN        EQU     BASE + $1A11C   ; DSP Division Remainder
  690           =00F1A11C               D_DIVCTRL       EQU     BASE + $1A11C   ; DSP Divider control
