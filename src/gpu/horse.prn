  649           =00000002               SHIFT_R         EQU     2
  650           =00000011               FIRE_Z          EQU     17
  651           =00000005               FIRE_Y          EQU     5
  652           =00000001               FIRE_X          EQU     1
  653                                   
  654           =00F00000               ANY_JOY         EQU     $00F00000       ; AND joyedge with this...
  655                                                                           ; joypad was pressed if result is not 0
  656           =32002200               ANY_FIRE        EQU     $32002200       ; AND joyedge with this...
  657                                                                           ; A,B C, Option or Pause was pressed
  658                                                                           ; if result is not 0
  659           =000F00FF               ANY_KEY         EQU     $000F00FF       ; AND joyedge with this... 123456789*0#
  660                                                                           ; was pressed if result is not 0
  661                                   
  662                                   ;;;
  663                                   ;;;     ROM Tables built into Jerry - 128 samples each
  664                                   ;;;     16 bit samples sign extended to 32
  665                                   ;;;
  666                                   
  667           =00F1D000               ROM_TABLE       EQU     BASE + $1D000   ; Base of tables
  668                                   
  669           =00F1D000               ROM_TRI         EQU     BASE + $1D000   ; A triangle wave
  670           =00F1D200               ROM_SINE        EQU     BASE + $1D200   ; Full amplitude SINE
  671           =00F1D400               ROM_AMSINE      EQU     BASE + $1D400   ; Linear (?) ramp SINE
  672           =00F1D600               ROM_12W         EQU     BASE + $1D600   ; SINE(X)+SINE(2*X) : (was ROM_SINE12W)
  673           =00F1D800               ROM_CHIRP16     EQU     BASE + $1D800   ; SHORT SWEEP
  674           =00F1DA00               ROM_NTRI        EQU     BASE + $1DA00   ; Triangle w/NOISE
  675           =00F1DC00               ROM_DELTA       EQU     BASE + $1DC00   ; Positive spike
  676           =00F1DE00               ROM_NOISE       EQU     BASE + $1DE00   ; Guess


