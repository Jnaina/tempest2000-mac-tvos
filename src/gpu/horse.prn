  983                                   ; *******************************************************************
  984                                   ; pring2
  985                                   ;
  986                                   ; Pixel Ring for explosions; small pixels. Enter with:
  987                                   ; in_buf=# pixels this ring
  988                                   ; +4=X centre
  989                                   ; +8=Y centre
  990                                   ; +12=Z centre          ;all 16:16 frax
  991                                   ; +16=Raw colour        ;0-255
  992                                   ; +20=Radius as 16:16 frac
  993                                   ;
  994                                   ; Use for all the power-up and power-up explosions.
  995                                   ; *******************************************************************
  996                                   pring2:
  997           =00000015                       dstx            REGEQU r21
  998           =0000001A                       dsty            REGEQU r26
  999           =00000001                       dstz            REGEQU r1
 1000           =0000000A                       dstc            REGEQU r10
 1001           =0000000B                       lwid            REGEQU r11
 1002           =0000000C                       scrbase         REGEQU r12
 1003           =0000000D                       l_2             REGEQU r13
 1004           =0000000E                       x_max           REGEQU r14
 1005           =0000000F                       y_max           REGEQU r15


                                        src/gpu/horse.gas    Page 43      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 1006           =00000010                       radius          REGEQU r16
 1007           =00000011                       sinbass         REGEQU r17
 1008           =00000012                       loop_ptr        REGEQU r18
 1009           =00000013                       phase           REGEQU r19
 1010           =00000014                       forty           REGEQU r20
 1011           =00000016                       bytemask        REGEQU r22
 1012           =00000017                       eighty          REGEQU r23
 1013           =00000018                       xcentr          REGEQU r24
 1014           =00000019                       ycentr          REGEQU r25
