  519                                   
  520           =00F10000               JPIT1           EQU     BASE + $10000   ; Timer 1 Pre-Scaler
  521           =00F10002               JPIT2           EQU     BASE + $10002   ; Timer 1 Divider
  522           =00F10004               JPIT3           EQU     BASE + $10004   ; Timer 2 Pre-Scaler
  523           =00F10006               JPIT4           EQU     BASE + $10006   ; Timer 2 Divider
