  639           =00000005               KEY_8           EQU     5
  640           =00000006               KEY_5           EQU     6
  641           =00000007               KEY_2           EQU     7
  642                                   
  643           =00000000               KEY_HASH        EQU     0
  644           =00000001               KEY_9           EQU     1
  645           =00000002               KEY_6           EQU     2
  646           =00000003               KEY_3           EQU     3
  647                                   
