   88                                   ; *******************************************************************
   89                                   ; sdiv
   90                                   ; *******************************************************************
   91                                           MACRO sdiv                 ; Divide, keeping sign of that which is divided, uses r27
   92                                 .         move \2,r31
   93                                 .         abs \2
   94                                 .         div \1,\2
   95                                 .         btst #31,r31               ; Get sign bit of original thang
   96                                 .         jr z,\~sdtt
   97                                 .         nop
   98                                 .         neg \2
   99                                 . \~sdtt:
  100                                 .         ENDM
  101                                       
  102                                   ; *******************************************************************
  103                                   ; sdiv0
  104                                   ; *******************************************************************
  105                                           MACRO sdiv0                ; Divide, keeping sign of that which is divided, uses r2-r3
  106                                 .         move \2,r0
  107                                 .         abs \2
  108                                 .         div \1,\2


                                        src/gpu/horse.gas    Page 18      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  109                                 .         btst #31,r0                ; Get sign bit of original thang
  110                                 .         jr z,\~sd0tt
  111                                 .         nop
  112                                 .         neg \2
  113                                 . \~sd0tt:
  114                                 .         ENDM
