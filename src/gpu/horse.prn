  127                                   ; *******************************************************************
  128                                   ; fmult
  129                                   ; *******************************************************************
  130                                           MACRO fmult                ; multiply 2 thangs, uses r2-r4, returns in first reg.
  131                                 .         moveta \2,r31              ; (preserves second Thang)
  132                                 .         moveq #0,r27
  133                                 .         move r27,r28
  134                                 .         abs \1
  135                                 .         addc r28,r27
  136                                 .         abs \2
  137                                 .         addc r28,r27
  138                                 .         move \2,r28
  139                                 .         mult \1,r28
  140                                 .         move \1,r29
  141                                 .         shrq #16,r28
  142                                 .         shrq #16,r29
  143                                 .         mult \2,r29
  144                                 .         shrq #16,\2
  145                                 .         add r29,r28
  146                                 .         move \2,r29
  147                                 .         mult \1,r29
  148                                 .         shrq #16,\1
  149                                 .         add r29,r28
  150                                 .         mult \2,\1
  151                                 .         shlq #16,\1
  152                                 .         add r28,\1
  153                                 .         btst #0,r27
  154                                 .         jr z,\~fmptt
  155                                 .         movefa r31,\2
  156                                 .         neg \1
  157                                 . \~fmptt:
  158                                 .         ENDM
