  253                                   ; *******************************************************************
  254                                   ; Execution of the module starts here.
  255                                   ;
  256                                   ; Detect the GPU mode selected by the caller and use that to determine
  257                                   ; which routine (shader) to run.
  258                                   ; Mode 1 = poly
  259                                   ; Mode 2 = pretty_poly
  260                                   ; Mode 3 = tile16
  261                                   ; Mode 4 = rex
  262                                   ; Mode 5 = snglpix
  263                                   ; Mode 6 = pring
  264                                   ; Mode 7 = pring2
  265                                   ; *******************************************************************
  266  0000000E  98003FFC00F0                   movei #gpu_mode,r0
  267  00000014  A401                           load (r0),r1               ; get gpu #
  268  00000016  9802xxxxxxxx                   movei #poly,r2
  269  0000001C  9803xxxxxxxx                   movei #pretty_poly,r3
  270  00000022  9804xxxxxxxx                   movei #tile16,r4
  271  00000028  9805xxxxxxxx                   movei #rex,r5
  272  0000002E  9806xxxxxxxx                   movei #pring,r6
  273  00000034  9807xxxxxxxx                   movei #pring2,r7
  274  0000003A  7C21                           cmpq #1,r1                 ; Mode 1 selected?
  275  0000003C  D042                           jump eq,(r2)               ; Go to poly
  276  0000003E  E400                           nop


                                        src/gpu/xcamel.gas   Page 21      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  277  00000040  7C41                           cmpq #2,r1                 ; Mode 2 selected?
  278  00000042  D062                           jump eq,(r3)               ; Go to pretty_poly
  279  00000044  E400                           nop
  280  00000046  7C61                           cmpq #3,r1                 ; Mode 3 selected?
  281  00000048  D082                           jump eq,(r4)               ; Got to tile16
  282  0000004A  E400                           nop
  283  0000004C  7C81                           cmpq #4,r1                 ; Mode 4 selected?
  284  0000004E  D0A2                           jump eq,(r5)               ; Go to rex
  285  00000050  E400                           nop
  286  00000052  7CC1                           cmpq #6,r1                 ; Mode 6 selected?
  287  00000054  D0C2                           jump eq,(r6)               ; Go to pring
  288  00000056  E400                           nop
  289  00000058  7CE1                           cmpq #7,r1                 ; Mode 7 selected?
  290  0000005A  D0E2                           jump eq,(r7)               ; Go to pring2.
  291  0000005C  E400                           nop
