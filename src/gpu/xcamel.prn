   94                                   ; *******************************************************************
   95                                   ; sdiv
   96                                   ; *******************************************************************
   97                                           MACRO sdiv                 ; Divide, keeping sign of that which is divided, uses r27
   98                                 .         move \2,r31
   99                                 .         abs \2
  100                                 .         div \1,\2
  101                                 .         btst #31,r31               ; Get sign bit of original thang
  102                                 .         jr z,\~sdtt
  103                                 .         nop
  104                                 .         neg \2
  105                                 . \~sdtt:
  106                                 .         ENDM
  107                                   ; *******************************************************************
  108                                   ; waitblit


                                        src/gpu/xcamel.gas   Page 18      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  109                                   ; *******************************************************************
  110                                           MACRO waitblit             ; Wait for the Blitter to stop
  111                                 . \~waitt:        load (blit),r31
  112                                 .         btst #0,r31
  113                                 .         jr z,\~waitt
  114                                 .         nop
  115                                 .         ENDM
  116                                       
  117                                   ; *******************************************************************
  118                                   ; fmult
  119                                   ; *******************************************************************
  120                                           MACRO fmult                ; multiply 2 thangs, uses r2-r4, returns in first reg.
  121                                 .         moveta \2,r0               ; (preserves second Thang)
  122                                 .         moveq #0,r27
  123                                 .         move r27,r28
  124                                 .         abs \1
  125                                 .         addc r28,r27
  126                                 .         abs \2
  127                                 .         addc r28,r27
  128                                 .         move \2,r28
  129                                 .         mult \1,r28
  130                                 .         move \1,r29
  131                                 .         shrq #16,r28
  132                                 .         shrq #16,r29
  133                                 .         mult \2,r29
  134                                 .         shrq #16,\2
  135                                 .         add r29,r28
  136                                 .         move \2,r29
  137                                 .         mult \1,r29
  138                                 .         shrq #16,\1
  139                                 .         add r29,r28
  140                                 .         mult \2,\1
  141                                 .         shlq #16,\1
  142                                 .         add r28,\1
  143                                 .         btst #0,r27
  144                                 .         jr z,\~fmptt
  145                                 .         movefa r0,\2
  146                                 .         neg \1
  147                                 . \~fmptt:
  148                                 .         ENDM
