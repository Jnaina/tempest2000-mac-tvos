  191                                   ; pix2x2
  192                                   ; *******************************************************************
  193                                           MACRO pix2x2
  194                                 .         movei #\~fxfxtt,r0
  195                                 .         cmpq #0,dstx
  196                                 .         jump mi,(r0)
  197                                 .         nop
  198                                 .         cmpq #0,dsty
  199                                 .         jump mi,(r0)
  200                                 .         nop
  201                                 .         cmp x_max,dstx
  202                                 .         jump pl,(r0)
  203                                 .         nop
  204                                 .         cmp y_max,dsty
  205                                 .         jump pl,(r0)
  206                                 .         nop
  207                                 .         shlq #1,dstx               ; x times 2 to point at words...
  208                                 .         mult lwid,dsty             ; Y*linewidth
  209                                 .         add dsty,dstx
  210                                 .         add scrbase,dstx           ; r6 now points to actual screen location
  211                                 .         storew dstc,(dstx)         ; store that pixel
  212                                 .         addq #2,dstx
  213                                 .         storew dstc,(dstx)
  214                                 .         add l_2,dstx
  215                                 .         storew dstc,(dstx)
  216                                 .         addq #2,dstx
  217                                 .         storew dstc,(dstx)
  218                                 . \~fxfxtt: nop
  219                                 .         ENDM
