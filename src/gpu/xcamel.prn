  685                                   ;*****
  686                                   ;*
  687                                   ;* PRETTY_POLY: Gouraud-shaded poly renderer. Only for triangular pollies.
  688                                   ;*              This version does NOT use the Blitter; it interpolates colours as well as intensities.
  689                                   ;*
  690                                   ;* INPUTS: in_buf       +0 = Pointer to start of poly data structure in main RAM
  691                                   ;*
  692                                   ;* Poly data structure: <x1_n.w><y1_n.w><i1_n.w><col1.w><x2_n.w><y2_n.w><i2_n.w><col2.w><x3_n.w><y3_n.w><i3_n.w><col3.w>
  693                                   ;*
  694                                   ;*****
  695                                   ; *******************************************************************
  696                                   pretty_poly:
  697                                       
  698           =00000017                       c1              REGEQU r23
  699           =00000018                       c2              REGEQU r24
  700           =00000019                       c3              REGEQU r25
  701                                       
  702           =00000005                       sum5            REGEQU r5
  703           =00000006                       sum6            REGEQU r6
  704           =00000007                       sum7            REGEQU r7
  705           =00000008                       sum8            REGEQU r8
  706           =00000002                       cinc1           REGEQU r2
