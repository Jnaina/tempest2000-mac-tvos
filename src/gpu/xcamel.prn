  163                                   
  164           =00000008               GENLOCK         EQU     $0008           ; Not Supported in Jaguar Console
  165           =00000010               INCEN           EQU     $0010           ; Enable encrustation
  166           =00000020               BINC            EQU     $0020           ; Select local border color
  167           =00000040               CSYNC           EQU     $0040           ; Enable composite sync
  168           =00000080               BGEN            EQU     $0080           ; Clear line buffer to BG
  169           =00000100               VARMOD          EQU     $0100           ; Enable variable-color resolution mode
