  525           =00F10020               J_INT          EQU     BASE + $10020   ; Jerry Interrupt control (to TOM)
  526                                   
  527           =00F14000               JOYSTICK       EQU     BASE + $14000   ; Joystick register and mute
  528           =00F14000               JOYOUT         EQU     BASE + $14000   ; Joystick register and mute
  529           =00F14000               JOYIN          EQU     BASE + $14000   ; Joystick register and mute
  530           =00F14002               JOYBUTS         EQU     BASE + $14002   ; Joystick register
