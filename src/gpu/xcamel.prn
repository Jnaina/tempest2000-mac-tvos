  297                                   ; *******************************************************************
  298                                   ;*
  299                                   ;* POLY: Gouraud-shaded poly renderer. Only for triangular pollies.
  300                                   ;*
  301                                   ;* INPUTS: in_buf       +0 = Pointer to start of poly data structure in main RAM
  302                                   ;*
  303                                   ;* Poly data structure: <x1_n.w><y1_n.w><i1_n.w><x2_n.w><y2_n.w><i2_n.w><x3_n.w><y3_n.w><i3_n.w>
  304                                   ;*
  305                                   ;*****
  306                                   ; *******************************************************************
  307                                   poly:
  308           =00000003                       x1_n            REGEQU r3
  309           =00000004                       y1_n            REGEQU r4
  310           =00000005                       x2_n            REGEQU r5
  311           =00000006                       y2_n            REGEQU r6
  312           =00000007                       x3_n            REGEQU r7
  313           =00000008                       y3_n            REGEQU r8
  314           =00000009                       i1_n            REGEQU r9
  315           =0000000A                       i2_n            REGEQU r10
  316           =0000000B                       i3_n            REGEQU r11
  317           =0000000C                       xinc1           REGEQU r12
  318           =0000000F                       iinc1           REGEQU r15
  319           =00000010                       xinc2           REGEQU r16
  320           =00000011                       iinc2           REGEQU r17
  321           =00000012                       count1          REGEQU r18
  322           =00000013                       count2          REGEQU r19
  323           =00000014                       loop1           REGEQU r20
  324           =00000015                       loop2           REGEQU r21
  325           =00000016                       count3          REGEQU r22
  326           =00000017                       sum1            REGEQU r23
  327           =00000018                       sum2            REGEQU r24
  328           =00000019                       sum3            REGEQU r25
  329           =0000001A                       sum4            REGEQU r26
  330                                       
  331           =0000001B                       xstart          REGEQU r27
  332           =0000001C                       istart          REGEQU r28


