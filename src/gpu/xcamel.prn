  153                                           MACRO bank0
  154                                 .         movei #G_FLAGS,r0
  155                                 .         load (r0),r1
  156                                 .         bclr #14,r1
  157                                 .         store r1,(r0)              ; Switch to Register Bank #0
  158                                 .         nop
  159                                 .         nop
  160                                 .         nop
  161                                 .         nop
  162                                 .         nop
  163                                 . \~bnk0tt:       movei #G_FLAGS,r0
  164                                 .         load (r0),r1


                                        src/gpu/xcamel.gas   Page 19      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  165                                 .         btst #14,r1
  166                                 .         jr nz,\~bnk0tt
  167                                 .         nop
  168                                 .         ENDM
