 1118                                   ; *******************************************************************
 1119                                   ; rex
 1120                                   ;*
 1121                                   ;* REX: Robotron explosion generator. Takes an image from the source screen and expands it in X and Y, then
 1122                                   ;*      uses a1_n to draw the resultant matrix of single pixels.
 1123                                   ;*
 1124                                   ;*      Provide: dest screen in gpu_screen, in_buf: 0=source image address
 1125                                   ;*      4=source image start pixel address, 8=x and y size of source, 12=X scale (16:16), 16=Y scale (16:16), 20=X shear (16:16), 24=Y shear,
 1126                                   ;*      28=Mode (0=Top edge, 1=Centered), 32=Dest X and Y
 1127                                   ;*
 1128                                   ;*****
 1129                                   ; *******************************************************************
 1130                                   rex:
 1131                                       
 1132           =00000002                       _bass           REGEQU r2   ; Source base address
