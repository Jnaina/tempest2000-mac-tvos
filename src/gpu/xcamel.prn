 1134           =00000004                       ssize           REGEQU r4   ; Source rectangle size
 1135           =00000005                       scalex          REGEQU r5
 1136           =00000006                       scaley          REGEQU r6   ; Scaling X and Y
 1137           =00000007                       shearx          REGEQU r7
 1138           =00000008                       sheary          REGEQU r8   ; Shearing X and Y
 1139           =00000009                       mode            REGEQU r9   ; Centering mode
 1140                                       
 1141           =0000000A                       xinc            REGEQU r10
 1142           =0000000B                       yinc            REGEQU r11
 1143           =0000000C                       xstep           REGEQU r12
 1144           =00000010                       ystep           REGEQU r16
 1145           =00000011                       _xstart         REGEQU r17
 1146           =00000012                       ystart          REGEQU r18
 1147           =00000013                       himask          REGEQU r19
 1148           =00000014                       lomask          REGEQU r20
