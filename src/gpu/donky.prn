  137                                   ;      VIDEO INITIALIZATION CONSTANTS
  138                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  139                                   
  140           =00000581               NTSC_WIDTH      EQU     1409            ; Width of screen in pixel clocks
  141           =00000337               NTSC_HMID       EQU     823             ; Middle of screen in pixel clocks
  142           =000000F1               NTSC_HEIGHT     EQU     241             ; Height of screen in scanlines
  143           =0000010A               NTSC_VMID       EQU     266             ; Middle of screen in halflines
  144                                   
  145           =00000565               PAL_WIDTH       EQU     1381            ; Same as above for PAL...
  146           =0000034B               PAL_HMID        EQU     843
  147           =0000011F               PAL_HEIGHT      EQU     287
  148           =00000142               PAL_VMID        EQU     322
  149                                   
  150                                   ;;; The following mask will extract the PAL/NTSC flag bit from the
  151                                   ;;; CONFIG register. NTSC = Bit Set, PAL = Bit Clear
  152                                   
  153           =00000010               VIDTYPE         EQU     $10
  154                                   
  155                                   ;;; The following are Video Mode register flags
  156                                   
  157           =00000001               VIDEN           EQU     $0001           ; Enable video-time base generator
  158                                   
  159           =00000000               CRY16           EQU     $0000           ; Enable 16-bit CRY mode
  160           =00000002               RGB24           EQU     $0002           ; Enable 24-bit RGB mode
  161           =00000004               DIRECT16        EQU     $0004           ; Enable 16-bit DIRECT mode
  162           =00000006               RGB16           EQU     $0006           ; Enable 16-bit RGB mode
  163                                   
  164           =00000008               GENLOCK         EQU     $0008           ; Not Supported in Jaguar Console
  165           =00000010               INCEN           EQU     $0010           ; Enable encrustation
  166           =00000020               BINC            EQU     $0020           ; Select local border color
  167           =00000040               CSYNC           EQU     $0040           ; Enable composite sync
  168           =00000080               BGEN            EQU     $0080           ; Clear line buffer to BG


                                        jaguar.inc           Page 5       5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  169           =00000100               VARMOD          EQU     $0100           ; Enable variable-color resolution mode
  170                                   
  171           =00000000               PWIDTH1         EQU     $0000           ; Select pixels 1 clock wide
  172           =00000200               PWIDTH2         EQU     $0200           ; Select pixels 2 clocks wide
  173           =00000400               PWIDTH3         EQU     $0400           ; Select pixels 3 clocks wide
  174           =00000600               PWIDTH4         EQU     $0600           ; Select pixels 4 clocks wide
  175           =00000800               PWIDTH5         EQU     $0800           ; Select pixels 5 clocks wide
