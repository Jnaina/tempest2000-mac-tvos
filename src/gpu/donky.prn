  263                                   ; *******************************************************************
  264                                   ; Detect the GPU mode selected by the caller.
  265                                   ; Mode 0 = web3d
  266                                   ; Mode 1 = starplane
  267                                   ; *******************************************************************
  268  00000000  98003FFC00F0                   movei #gpu_mode,r0
  269  00000006  A401                           load (r0),r1
  270  00000008  9802xxxxxxxx                   movei #starplane,r2
  271  0000000E  7C21                           cmpq #1,r1 ; Mode 1 selected?
  272  00000010  D042                           jump eq,(r2) ; Go to starplane
  273  00000012  E400                           nop
  274                                           ; Mode 0 selected: web3d.
  275                                   
  276                                   ; *******************************************************************


                                        src/gpu/donky.gas    Page 21      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  277                                   ; web3d
  278                                   ;*
  279                                   ;* WEB3D:  Draw 3D Web made of polygons, positioned in Tempest 3D space
  280                                   ;*
  281                                   ;* Inputs: IN_BUF+0=Pointer to standard Web data structure
  282                                   ;*         +4=X +8=Y +12=Z, Tempest world co-ordinates
  283                                   ;*         +16=X centre; +20=Y centre, as 16:16 fractions; +24=XY Rotation Angle
  284                                   ;*
  285                                   ; *******************************************************************
                                                bank0
       00000014  9800210000F0         @         movei #G_FLAGS,r0
       0000001A  A41F                 @         load (r0),r31
       0000001C  3DDF                 @         bclr #14,r31
       0000001E  BC1F                 @         store r31,(r0)                  
       00000020  E400                 @         nop
       00000022  E400                 @         nop
       00000024  E400                 @         nop
       00000026  E400                 @         nop
       00000028  E400                 @         nop
       0000002A  9800210000F0         @ M0bnk0tt:       movei #G_FLAGS,r0
       00000030  A41F                 @         load (r0),r31
       00000032  35DF                 @         btst #14,r31
