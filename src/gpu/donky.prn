  115           =00002000               O_DEPTH4        EQU     (2<<12)
  116           =00003000               O_DEPTH8        EQU     (3<<12)
  117           =00004000               O_DEPTH16       EQU     (4<<12)
  118           =00005000               O_DEPTH32       EQU     (5<<12)
