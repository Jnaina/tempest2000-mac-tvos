 1073                                   ; starplane
 1074                                   ;
 1075                                   ; draw a single plane of random field; inputs Nstars,Col,Xdisp,Ydisp,Rseed
 1076                                   ; *******************************************************************
 1077                                   starplane:
 1078                                   
 1079           =00000004                       nstars          REGEQU r4
 1080           =00000005                       starcol         REGEQU r5
