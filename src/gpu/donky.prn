   59           =00F00000               BASE            EQU     $F00000 ; TOM Internal Register Base
   60                                   
   61                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   62                                   ;       TOM REGISTERS
   63                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   64                                   
   65           =00F00004               HC              EQU     BASE + 4        ; Horizontal Count
   66           =00F00006               VC              EQU     BASE + 6        ; Vertical Count
   67           =00F00008               LPH             EQU     BASE + 8        ; Horizontal Lightpen
   68           =00F0000A               LPV             EQU     BASE + $0A      ; Vertical Lightpen
   69           =00F00010               OB0             EQU     BASE + $10      ; Current Object Phrase
   70           =00F00012               OB1             EQU     BASE + $12
   71           =00F00014               OB2             EQU     BASE + $14
   72           =00F00016               OB3             EQU     BASE + $16
   73           =00F00020               OLP             EQU     BASE + $20      ; Object List Pointer
   74           =00F00026               OBF             EQU     BASE + $26      ; Object Processor Flag
   75           =00F00028               VMODE           EQU     BASE + $28      ; Video Mode
   76           =00F0002A               BORD1           EQU     BASE + $2A      ; Border Color (Red & Green)
   77           =00F0002C               BORD2           EQU     BASE + $2C      ; Border Color (Blue)
   78           =00F00038               HDB1            EQU     BASE + $38      ; Horizontal Display Begin One
   79           =00F0003A               HDB2            EQU     BASE + $3A      ; Horizontal Display Begin Two
   80           =00F0003C               HDE             EQU     BASE + $3C      ; Horizontal Display End
   81           =00F00044               VS              EQU     BASE + $44      ; Vertical Sync
   82           =00F00046               VDB             EQU     BASE + $46      ; Vertical Display Begin
   83           =00F00048               VDE             EQU     BASE + $48      ; Vertical Display End
   84           =00F0004E               VI              EQU     BASE + $4E      ; Vertical Interrupt
   85           =00F00050               PIT0            EQU     BASE + $50      ; Programmable Interrupt Timer (Lo)
   86           =00F00052               PIT1            EQU     BASE + $52      ; Programmable Interrupt Timer (Hi)
   87           =00F00058               BG              EQU     BASE + $58      ; Background Color
   88                                   
   89           =00F000E0               INT1            EQU     BASE + $E0      ; CPU Interrupt Control Register
   90           =00F000E2               INT2            EQU     BASE + $E2      ; CPU Interrupt Resume Register
   91                                   
   92           =00F00400               CLUT            EQU     BASE + $400     ; Color Lookup Table
   93                                   
   94           =00F00800               LBUFA           EQU     BASE + $800     ; Line Buffer A
   95           =00F01000               LBUFB           EQU     BASE + $1000    ; Line Buffer B
   96           =00F01800               LBUFC           EQU     BASE + $1800    ; Line Buffer Current
