  181                                 .         ENDM
  182                                   
  183                                   ; *******************************************************************
  184                                   ; swap
  185                                   ; *******************************************************************
  186                                           MACRO swap
  187                                 .         move \1,r31
  188                                 .         move \2,\1
  189                                 .         move r31,\2
  190                                 .         ENDM
  191                                   
