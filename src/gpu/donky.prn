  519                                   
  520           =00F10000               JPIT1           EQU     BASE + $10000   ; Timer 1 Pre-Scaler
  521           =00F10002               JPIT2           EQU     BASE + $10002   ; Timer 1 Divider
  522           =00F10004               JPIT3           EQU     BASE + $10004   ; Timer 2 Pre-Scaler
  523           =00F10006               JPIT4           EQU     BASE + $10006   ; Timer 2 Divider
  524                                   
  525           =00F10020               J_INT          EQU     BASE + $10020   ; Jerry Interrupt control (to TOM)
  526                                   
  527           =00F14000               JOYSTICK       EQU     BASE + $14000   ; Joystick register and mute
  528           =00F14000               JOYOUT         EQU     BASE + $14000   ; Joystick register and mute
  529           =00F14000               JOYIN          EQU     BASE + $14000   ; Joystick register and mute
  530           =00F14002               JOYBUTS         EQU     BASE + $14002   ; Joystick register
  531           =00F14002               CONFIG          EQU     BASE + $14002   ; Also has NTSC/PAL
  532                                   
  533           =00F1A118               MOD_MASK        EQU     BASE + $1A118   ; Mask for ADDQ(SUBQ)MOD
  534                                   
  535           =00F1A150               SCLK            EQU     BASE + $1A150   ; SSI Clock Frequency
  536           =00F1A154               SMODE           EQU     BASE + $1A154   ; SSI Control
  537                                   
  538           =00F1A148               L_I2S           EQU     BASE + $1A148   ; I2S Serial Interface
  539           =00F1A14C               R_I2S           EQU     BASE + $1A14C   ; I2S Serial Interface
  540           =00F1A148               LTXD            EQU     BASE + $1A148   ; Synonyms
  541           =00F1A14C               RTXD            EQU     BASE + $1A14C
  542           =00F1A148               LRXD            EQU     BASE + $1A148   ; Synonyms
  543           =00F1A14C               RRXD            EQU     BASE + $1A14C
  544                                   
  545           =00F1A148               R_DAC           EQU     BASE + $1A148   ; Swapped on Purpose!
  546           =00F1A14C               L_DAC           EQU     BASE + $1A14C
  547                                   
  548           =00F10034               ASICLK          EQU     BASE + $10034   ; Asynchronous Clock Register
  549           =00F10032               ASICTRL         EQU     BASE + $10032   ; Asynchronous Control Register
  550           =00F10032               ASISTAT         EQU     BASE + $10032   ; Asynchronous Status Register
