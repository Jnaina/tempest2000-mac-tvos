   87                                   ; *******************************************************************
   88                                   ; sdiv
   89                                   ; *******************************************************************
   90                                           MACRO sdiv      ;Divide, keeping sign of that which is divided, uses r27
   91                                 .         move \2,r31
   92                                 .         abs \2
   93                                 .         div \1,\2
   94                                 .         btst #31,r31    ;Get sign bit of original thang
   95                                 .         jr z,\~sdtt
   96                                 .         nop
   97                                 .         neg \2
   98                                 . \~sdtt: 
   99                                 .         ENDM
  100                                   ; *******************************************************************
  101                                   ; waitblit
  102                                   ; *******************************************************************
  103                                           MACRO waitblit  ; Wait for the Blitter to stop
  104                                 . \~waitt:        load (blit),r31
  105                                 .         btst #0,r31
  106                                 .         jr z,\~waitt
  107                                 .         nop
  108                                 .         ENDM


                                        src/gpu/donky.gas    Page 18      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  109                                   
  110                                   ; *******************************************************************
  111                                   ; fmult
  112                                   ; *******************************************************************
  113                                           MACRO fmult     ;multiply 2 thangs, uses r2-r4, returns in first reg.
  114                                 .         moveta \2,r31   ;(preserves second Thang)
  115                                 .         moveq #0,r27
  116                                 .         move r27,r28
  117                                 .         abs \1
  118                                 .         addc r28,r27
  119                                 .         abs \2
  120                                 .         addc r28,r27
  121                                 .         move \2,r28
  122                                 .         mult \1,r28
  123                                 .         move \1,r29
  124                                 .         shrq #16,r28
  125                                 .         shrq #16,r29
  126                                 .         mult \2,r29
  127                                 .         shrq #16,\2
  128                                 .         add r29,r28
  129                                 .         move \2,r29
  130                                 .         mult \1,r29
  131                                 .         shrq #16,\1
  132                                 .         add r29,r28
  133                                 .         mult \2,\1
  134                                 .         shlq #16,\1
  135                                 .         add r28,\1
  136                                 .         btst #0,r27
  137                                 .         jr z,\~fmptt
  138                                 .         movefa r31,\2
  139                                 .         neg \1
  140                                 . \~fmptt:
  141                                 .         ENDM
  142                                   
  143                                   ; *******************************************************************
  144                                   ; bank0
  145                                   ; *******************************************************************
  146                                           MACRO bank0
  147                                 .         movei #G_FLAGS,r0
  148                                 .         load (r0),r31
  149                                 .         bclr #14,r31
  150                                 .         store r31,(r0)                  ;Switch to Register Bank #0
  151                                 .         nop
  152                                 .         nop
  153                                 .         nop
  154                                 .         nop
  155                                 .         nop
  156                                 . \~bnk0tt:       movei #G_FLAGS,r0
  157                                 .         load (r0),r31
  158                                 .         btst #14,r31
  159                                 .         jr nz,\~bnk0tt
  160                                 .         nop
  161                                 .         ENDM
  162                                   
