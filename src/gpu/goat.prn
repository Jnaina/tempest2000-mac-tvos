  140           =00000581               NTSC_WIDTH      EQU     1409            ; Width of screen in pixel clocks
  141           =00000337               NTSC_HMID       EQU     823             ; Middle of screen in pixel clocks
  142           =000000F1               NTSC_HEIGHT     EQU     241             ; Height of screen in scanlines
  143           =0000010A               NTSC_VMID       EQU     266             ; Middle of screen in halflines
