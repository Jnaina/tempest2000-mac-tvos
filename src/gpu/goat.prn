  116                                   ; *******************************************************************
  117                                   ; fmult
  118                                   ; *******************************************************************
  119                                           MACRO fmult                ; multiply 2 thangs, uses r2-r4, returns in first reg.
  120                                 .         moveq #0,r2
  121                                 .         move r2,r3
  122                                 .         abs \1
  123                                 .         addc r3,r2
  124                                 .         abs \2
  125                                 .         addc r3,r2
  126                                 .         move \2,r3
  127                                 .         mult \1,r3
  128                                 .         move \1,r4
  129                                 .         shrq #16,r3
  130                                 .         shrq #16,r4
  131                                 .         mult \2,r4
  132                                 .         shrq #16,\2
  133                                 .         add r4,r3
  134                                 .         move \2,r4
  135                                 .         mult \1,r4
  136                                 .         shrq #16,\1
  137                                 .         add r4,r3
  138                                 .         mult \2,\1
  139                                 .         shlq #16,\1
  140                                 .         add r3,\1
  141                                 .         btst #0,r2
  142                                 .         jr z,\~fmptt
  143                                 .         nop
  144                                 .         neg \1
  145                                 . \~fmptt:
  146                                 .         ENDM
  147                                       
  148                                   ; *******************************************************************
  149                                   ; sdiv
  150                                   ; *******************************************************************
  151                                           MACRO sdiv                 ; Divide, keeping sign of that which is divided, uses r2-r3
  152                                 .         move \2,r2
  153                                 .         abs \2
  154                                 .         div \1,\2
  155                                 .         btst #31,r2                ; Get sign bit of original thang
  156                                 .         jr z,\~sdtt
  157                                 .         nop
  158                                 .         neg \2
  159                                 . \~sdtt:
  160                                 .         ENDM
  161                                       
  162                                   ; *******************************************************************
  163                                   ; fjsr
  164                                   ; *******************************************************************


                                        src/gpu/goat.gas     Page 19      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  165                                           MACRO fjsr                 ; Fast single-level JSR
  166                                 .         move PC,r30
  167                                 .         jump (\1)
  168                                 .         addq #6,r30                ; Determine Return Address
  169                                 .         ENDM
  170                                       
  171                                   ; *******************************************************************
  172                                   ; frts
  173                                   ; *******************************************************************
  174                                           MACRO frts
  175                                 .         jump (r30)
  176                                 .         nop
  177                                 .         ENDM
  178                                       
  179                                   ; *******************************************************************
  180                                   ; gjsr
  181                                   ; *******************************************************************
  182                                           MACRO gjsr                 ; Fast single-level JSR
  183                                 .         move PC,r31
  184                                 .         jump (\1)
  185                                 .         addq #6,r31                ; Determine Return Address
  186                                 .         ENDM
  187                                       
  188                                   ; *******************************************************************
  189                                   ; grts
  190                                   ; *******************************************************************
  191                                           MACRO grts
  192                                 .         jump (r31)
  193                                 .         nop
  194                                 .         ENDM
