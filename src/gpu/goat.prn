  616                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  617                                   
  618                                   ; Bits when LONGword is formatted as below (from JOYTEST\JT_LOOP.S).
  619                                   ;
  620                                   ; Format: xxApxxBx RLDU147* xxCxxxox 2580369#
  621                                   
  622           =00000014               JOY_UP          EQU     20              ;joypad
  623           =00000015               JOY_DOWN        EQU     21
  624           =00000016               JOY_LEFT        EQU     22
  625           =00000017               JOY_RIGHT       EQU     23
  626                                   
  627           =0000001D               FIRE_A          EQU     29              ;fire buttons
  628           =00000019               FIRE_B          EQU     25
  629           =0000000D               FIRE_C          EQU     13
  630           =00000009               OPTION          EQU     9
  631           =0000001C               PAUSE           EQU     28
