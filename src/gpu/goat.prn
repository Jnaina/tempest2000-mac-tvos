  197                                   ; Execution of the module starts here.
  198                                   ; *******************************************************************
  199                                           ; Set up our GPU flags.
  200  00000000  981B3F0000F0                   movei #(GPU_RAM+$f00),r27   ; To use as a stack pointer
  201  00000006  9814223800F0                   movei #BLIT_CMD,cmd        ; Init register stuff
  202  0000000C  9816220C00F0                   movei #BLIT_A1PIXEL,A1PIXEL
  203  00000012  9815223C00F0                   movei #BLIT_COUNT,count
  204  00000018  981A00000003                   movei #p_sines,sinebase
  205                                       
  206  0000001E  980044200003                   movei #(PITCH1|PIXEL16|WIDTH384|XADDINC),r0   ; usual blittr settings
  207  00000024  9801220400F0                   movei #BLIT_A1FLAGS,r1
  208  0000002A  BC20                           store r0,(r1)
  209  0000002C  98013FF800F0                   movei #gpu_screen,r1
  210  00000032  A420                           load (r1),r0               ; Dest screen passed from foreground
  211  00000034  9801220000F0                   movei #BLIT_A1BASE,r1
  212  0000003A  BC20                           store r0,(r1)
  213                                       
  214                                   ; *******************************************************************
  215                                   ; Detect the GPU mode selected by the caller and use that to determine
  216                                   ; which routine (shader) to run.
  217                                   ; Mode 0 = undraw (Not Used)
  218                                   ; Mode 2 = vect3d
  219                                   ; Mode 3 = starfield1 (Not used)
  220                                   ; Mode 4 = view_otm


                                        src/gpu/goat.gas     Page 20      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  221                                   ; *******************************************************************
  222  0000003C  98003FFC00F0                   movei #gpu_mode,r0
  223  00000042  A401                           load (r0),r1               ; get GPU mode that was set
  224  00000044  9800xxxxxxxx                   movei #undraw,r0
  225  0000004A  7C01                           cmpq #0,r1
  226  0000004C  D002                           jump eq,(r0)               ; Undraw lines
  227  0000004E  E400                           nop
  228  00000050  9800xxxxxxxx                   movei #starfield1,r0
  229  00000056  7C61                           cmpq #3,r1
  230  00000058  D002                           jump eq,(r0)               ; go draw a starfield
  231  0000005A  E400                           nop
  232  0000005C  9800xxxxxxxx                   movei #view_otm,r0
  233  00000062  7C81                           cmpq #4,r1
  234  00000064  D002                           jump eq,(r0)               ; go prepare the viewer OTM
  235  00000066  E400                           nop
  236  00000068  9800xxxxxxxx                   movei #vect3d,r0
  237  0000006E  D000                           jump (r0)
  238  00000070  E400                           nop                        ; go draw 3d vectors
  239                                       
  240                                       
  241                                   ; *******************************************************************
  242                                   ; view_otm
  243                                   ;
  244                                   ; prepare the viewer's transformation matrix
  245                                   ; *******************************************************************
  246                                   view_otm:
  247                                       
  248  00000072  981C3F0000F0                   movei #vpang,r28           ; address of angle x-y in list   ---- getting sines and coses for this object
  249  00000078  980100FF0000                   movei #$ff,r1
  250  0000007E  980200800000                   movei #$80,r2              ; used in getting sine
  251  00000084  A780                           load (r28),r0              ; get angle
  252  00000086  089C                           addq #4,r28
  253  00000088  8803                           move r0,r3                 ; save for getting cos
  254  0000008A  2420                           and r1,r0                  ; limit 0-255
  255  0000008C  0340                           add sinebase,r0            ; point into sine table
  256  0000008E  9C08                           loadb (r0),r8              ; get sine x
  257  00000090  1048                           sub r2,r8                  ; make signed
  258  00000092  980000400000                   movei #$40,r0              ; get angle
  259  00000098  0060                           add r3,r0                  ; add $40
  260  0000009A  2420                           and r1,r0                  ; limit 0-255
  261  0000009C  0340                           add sinebase,r0
  262  0000009E  9C10                           loadb (r0),r16             ; get cos x
