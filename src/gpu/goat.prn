  553                                   ;================================================================
  554                                   ; UART Definitions (new in this file as of 24-Apr-95)
  555                                   ;================================================================


                                        jaguar.inc           Page 12      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  556                                   
  557                                   ; UART control register Masks
  558                                   ; All unused bits in the control register need to be written as zeros !
  559                                   ; With exception of U_CLRERR these are valid for read in ASISTAT, too
  560                                   
  561           =00000001               U_MODD          equ     (1<<0)  ; selects odd parity
  562           =00000002               U_MPAREN        equ     (1<<1)  ; enable parity
  563           =00000004               U_MTXOPOL       equ     (1<<2)  ; transmit output polarity (if set: active low)
  564           =00000008               U_MRXIPOL       equ     (1<<3)  ; receive input polarity (if set: invert input)
  565           =00000010               U_MTINTEN       equ     (1<<4)  ; enable transmitter interrupts
  566           =00000020               U_MRINTEN       equ     (1<<5)  ; enable reciever interrupts
  567           =00000040               U_MCLRERR       equ     (1<<6)  ; clear error (only use if U_SERIN is 
  568                                                                   ; inactive otherwise the UART locks up.
  569                                                                   ; By default input is active low. This
  570                                                                   ; depends on U_MRXIPOL) 
  571           =00004000               U_MTXBRK        equ     (1<<14) ; transmit break
  572                                   
  573                                   ; UART control register (ONLY) bit numbers
  574           =00000006               U_CLRERR        equ     6
  575                                   
  576                                   ; UART control AND status register (SHARED) bit numbers 
  577                                   
  578           =00000000               U_ODD           equ     0       ; selects odd parity
  579           =00000001               U_PAREN         equ     1       ; enable parity
  580           =00000002               U_TXOPOL        equ     2       ; transmit output polarity (if set: active low)
  581           =00000003               U_RXIPOL        equ     3       ; receive input polarity (if set: invert input)
  582           =00000004               U_TINTEN        equ     4       ; enable transmitter interrupts
  583           =00000005               U_RINTEN        equ     5       ; enable reciever interrupts
  584           =0000000E               U_TXBRK         equ     14      ; transmit break
  585                                   
  586                                   ; UART status register (ONLY) bit numbers
  587                                   
  588           =0000000F               U_ERR           equ     15      ; error condition exists
  589           =0000000D               U_SERIN         equ     13      ; state of UART1 Pin (serial input data)
  590           =0000000B               U_OE            equ     11      ; overrun error
  591           =0000000A               U_FE            equ     10      ; frame error
  592           =00000009               U_PE            equ     9       ; parity error
  593           =00000008               U_TBE           equ     8       ; transitter buffer empty
  594           =00000007               U_RBF           equ     7       ; receiver buffer full
  595                                   
  596                                   ;;;
  597                                   ;;; Jerry Interrupt Control Flags
  598                                   ;;;
  599                                   
  600           =00000001               J_EXTENA        EQU     $0001           ; Enable external interrupts
  601           =00000002               J_DSPENA        EQU     $0002           ; Enable DSP interrupts
  602           =00000004               J_TIM1ENA       EQU     $0004           ; Enable Timer 1 interrupts
  603           =00000008               J_TIM2ENA       EQU     $0008           ; Enable Timer 2 interrupts
  604           =00000010               J_ASYNENA       EQU     $0010           ; Enable Asyncronous Serial interrupts
  605           =00000020               J_SYNENA        EQU     $0020           ; Enable Syncronous Serial interrupts
  606                                   
  607           =00000100               J_EXTCLR        EQU     $0100           ; Clear pending external interrupts
  608           =00000200               J_DSPCLR        EQU     $0200           ; Clear pending DSP interrupts
  609           =00000400               J_TIM1CLR       EQU     $0400           ; Clear pending Timer 1 interrupts
  610           =00000800               J_TIM2CLR       EQU     $0800           ; Clear pending Timer 2 interrupts
  611           =00001000               J_ASYNCLR       EQU     $1000           ; Clear pending Asynch. Serial interrupts


                                        jaguar.inc           Page 13      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  612           =00002000               J_SYNCLR        EQU     $2000           ; Clear pending Synch. Serial interrupts
