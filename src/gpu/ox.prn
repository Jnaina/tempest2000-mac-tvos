  215                                       
  216                                   ; *******************************************************************
  217                                   ; Execution of the module starts here.
  218                                   ;
  219                                   ; Detect the GPU mode selected by the caller.
  220                                   ; Mode 0 = fline


                                        src/gpu/ox.gas       Page 20      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  221                                   ; Mode 1 = mode7
  222                                   ; Mode 2 = starseg
  223                                   ; Mode 3 = voo
  224                                   ; Mode 4 = pshere - draws a sphere.
  225                                       
  226                                   ; *******************************************************************
  227  00000000  98003FFC00F0                   movei #gpu_mode,r0         ; Get the mode selected by caller.
  228  00000006  A401                           load (r0),r1               ; Store it in r1.
  229  00000008  9802xxxxxxxx                   movei #mode7,r2
  230  0000000E  7C21                           cmpq #1,r1                 ; Mode 1 selected?
  231  00000010  D042                           jump eq,(r2)               ; If so, jump to mode7.
  232  00000012  E400                           nop
  233  00000014  9802xxxxxxxx                   movei #starseg,r2
  234  0000001A  7C41                           cmpq #2,r1                 ; Mode 2 selected?
  235  0000001C  D042                           jump eq,(r2)               ; If so, jump to starseg.
  236  0000001E  E400                           nop
  237  00000020  9802xxxxxxxx                   movei #voo,r2
  238  00000026  7C61                           cmpq #3,r1                 ; Mode 3 selected?
  239  00000028  D042                           jump eq,(r2)               ; If so, jump to voo.
  240  0000002A  E400                           nop
  241  0000002C  9802xxxxxxxx                   movei #psphere,r2
  242  00000032  7C81                           cmpq #4,r1                 ; Mode 4 selected?
  243  00000034  D042                           jump eq,(r2)               ; If so, jump to pshere.
  244  00000036  E400                           nop
  245                                           ; Mode 0 selected, fall through to fline.
  246                                       
  247                                   ; *******************************************************************
  248                                   ; fline
  249                                   ; Draw a 3D line with points on the line _offset by a function (ie line+noise=lightning)
  250                                   ; Used for drawing lines in quite a few places, usually where we're drawing solid polygons
  251                                   ; too, e.g. draw_adroid.
  252                                   ; *******************************************************************
  253                                   fline:
  254           =00000000                       pointer REGEQU r0
  255           =0000000F                       x1_n    REGEQU r15
  256           =00000010                       y1_n    REGEQU r16
  257           =00000011                       z1      REGEQU r17
  258           =00000012                       x2_n    REGEQU r18
  259           =00000013                       y2_n    REGEQU r19
  260           =00000014                       z2      REGEQU r20
  261           =00000015                       col     REGEQU r21
  262           =00000016                       segs    REGEQU r22
  263           =00000017                       xmax    REGEQU r23
  264           =00000018                       ymax    REGEQU r24
  265           =0000000A                       xto     REGEQU r10
  266           =0000000B                       yto     REGEQU r11
  267           =0000000C                       zto     REGEQU r12
  268           =00000019                       rseed   REGEQU r25         ; SEED and MASK for shift/mask RNG
  269           =0000001A                       rmask   REGEQU r26
  270           =0000001F                       x0_n    REGEQU r31
  271           =0000000D                       y0_n    REGEQU r13
  272           =0000000E                       intens_0 REGEQU r14
  273           =00000009                       intens_1 REGEQU r9
  274           =00000008                       imax    REGEQU r8
  275           =00000007                       zmax    REGEQU r7
  276                                       


                                        src/gpu/ox.gas       Page 21      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  277           =00000006                       L_COUNT REGEQU r6
  278           =0000000F                       L_PIX   REGEQU r15
  279           =00000010                       L_INCF  REGEQU r16
  280           =00000011                       L_INC   REGEQU r17
  281           =00000005                       cmd     REGEQU r5
  282                                       
