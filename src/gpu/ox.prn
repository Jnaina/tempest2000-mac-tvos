  190                                   ; *******************************************************************
  191                                   ; rannum
  192                                   ; *******************************************************************
  193                                           MACRO rannum
  194                                 .         btst #0,rseed              ; check bottom bit
  195                                 .         jr nz,\~donett             ; one, go discard btm bit and do mask
  196                                 .         nop
  197                                 .         shrq #1,rseed              ; discard 0-bit
  198                                 .         jr \~xrndtt
  199                                 .         nop
  200                                 . \~donett:       shrq #1,rseed
  201                                 .         xor rmask,rseed
  202                                 . \~xrndtt:       nop
  203                                 .         ENDM
  204                                       
  205                                   ; *******************************************************************
  206                                   ; waitblit
  207                                   ; *******************************************************************
  208                                           MACRO waitblit             ; Wait for the Blitter to stop
  209                                 . \~waitt:        load (blit),r28
  210                                 .         btst #0,r28
  211                                 .         jr z,\~waitt
  212                                 .         nop
  213                                 .         ENDM
