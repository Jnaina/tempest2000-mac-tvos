   97                                   ; *******************************************************************
   98                                   ; fmult
   99                                   ; *******************************************************************
  100                                           MACRO fmult                ; multiply 2 thangs, uses r2-r4, returns in first reg.
  101                                 .         moveta \2,r0               ; (preserves second Thang)
  102                                 .         moveq #0,r27
  103                                 .         move r27,r28
  104                                 .         abs \1
  105                                 .         addc r28,r27
  106                                 .         abs \2
  107                                 .         addc r28,r27
  108                                 .         move \2,r28


                                        src/gpu/ox.gas       Page 18      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  109                                 .         mult \1,r28
  110                                 .         move \1,r29
  111                                 .         shrq #16,r28
  112                                 .         shrq #16,r29
  113                                 .         mult \2,r29
  114                                 .         shrq #16,\2
  115                                 .         add r29,r28
  116                                 .         move \2,r29
  117                                 .         mult \1,r29
  118                                 .         shrq #16,\1
  119                                 .         add r29,r28
  120                                 .         mult \2,\1
  121                                 .         shlq #16,\1
  122                                 .         add r28,\1
  123                                 .         btst #0,r27
  124                                 .         jr z,\~fmptt
  125                                 .         movefa r0,\2
  126                                 .         neg \1
  127                                 . \~fmptt:
  128                                 .         ENDM
  129                                       
  130                                       
  131                                   ; *******************************************************************
  132                                   ; sdiv
  133                                   ; *******************************************************************
  134                                           MACRO sdiv                 ; Divide, keeping sign of that which is divided, uses r2-r3
  135                                 .         move \2,r27
  136                                 .         abs \2
  137                                 .         div \1,\2
  138                                 .         btst #31,r27               ; Get sign bit of original thang
  139                                 .         jr z,\~sdtt
  140                                 .         nop
  141                                 .         neg \2
  142                                 . \~sdtt:
  143                                 .         ENDM
  144                                       
  145                                   ; *******************************************************************
  146                                   ; sdiv0
  147                                   ; *******************************************************************
  148                                           MACRO sdiv0                ; Divide, keeping sign of that which is divided, uses r2-r3
  149                                 .         move \2,r0
  150                                 .         abs \2
  151                                 .         div \1,\2
  152                                 .         btst #31,r0                ; Get sign bit of original thang
  153                                 .         jr z,\~sd0tt
  154                                 .         nop
  155                                 .         neg \2
  156                                 . \~sd0tt:
  157                                 .         ENDM
  158                                       
