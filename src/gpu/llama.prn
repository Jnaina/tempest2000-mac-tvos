  759                                   
  760           =00000001               RISCGO          EQU     $00000001       ; Start GPU or DSP
  761           =00000002               CPUINT          EQU     $00000002       ; Allow the GPU/DSP to interrupt CPU
  762           =00000004               FORCEINT0       EQU     $00000004       ; Cause an INT 0 on GPU or DSP
  763           =00000008               SINGLE_STEP     EQU     $00000008       ; Enter SINGLE_STEP mode
  764           =00000010               SINGLE_GO       EQU     $00000010       ; Execute one instruction
  765                                   
