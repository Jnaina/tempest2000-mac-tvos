  163                                           MACRO gjsr                 ; Fast single-level JSR
  164                                 .         move PC,r31


                                        src/gpu/llama.gas    Page 19      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  165                                 .         jump (\1)
  166                                 .         addq #6,r31                ; Determine Return Address
