  488                                   ; A2 Mask Enable Bit
  489           =00008000               BLITMASK        EQU     $00008000
  490                                   
  491                                   ; X add control d16-d17
  492                                   ;       controls the update of the X pointer on each pass
  493                                   ;       round the inner loop
  494           =00000000               XADDPHR         EQU     $00000000       ; 00 - add phrase width and truncate
  495           =00010000               XADDPIX         EQU     $00010000       ; 01 - add pixel size (add 1)
  496           =00020000               XADD0           EQU     $00020000       ; 10 - add zero
  497           =00030000               XADDINC         EQU     $00030000       ; 11 - add the increment
  498                                   
  499                                   ; Y add control d18
  500                                   ;       controls the update of the Y pointer within the inner loop.
  501                                   ;       it is overridden by the X add control if they are in add increment
  502           =00000000               YADD0           EQU     $00000000       ; 00 - add zero
  503           =00040000               YADD1           EQU     $00040000       ; 01 - add 1
  504                                   
  505                                   ; X sign d19
  506                                   ;       add or subtract pixel size if X add control = 01 (XADDPIX)
  507           =00000000               XSIGNADD        EQU     $00000000       ; 0 - add pixel size
  508           =00080000               XSIGNSUB        EQU     $00080000       ; 1 - subtract pixel size
  509                                   
  510                                   ; Y sign d20


                                        jaguar.inc           Page 11      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  511                                   ;       add or subtract pixel size if Y add control = 01 (YADD1)
  512           =00000000               YSIGNADD        EQU     $00000000       ; 0 - add 1
  513           =00100000               YSIGNSUB        EQU     $00100000       ; 1 - sub 1
