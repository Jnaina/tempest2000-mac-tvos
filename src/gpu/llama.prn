  814                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  815                                   ;;; Atari claimed the below registers should never be messed with and
  816                                   ;;; eventually removed them from later copies of jaguar.inc. However, there
  817                                   ;;; are corner cases in which messing with them is necessary (E.g., fixing up
  818                                   ;;; MEMCON1 to access the Jaguar CD's memory-mapped registers while booting
  819                                   ;;; from a Skunkboard, programming custom high-resolution video modes, etc.),
  820                                   ;;; so I've restored them. In general though, the point stands: Don't use
  821                                   ;;; these if you don't know what you're doing.
  822                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  823                                   
  824           =00F00000               MEMCON1         EQU     BASE + 0        ; Memory Configuration Register One
  825           =00F00002               MEMCON2         EQU     BASE + 2        ; Memory Configuration Register Two
  826           =00F00020               OLPLO           EQU     BASE + $20
  827           =00F00022               OLPHI           EQU     BASE + $22
  828           =00F00024               ODP             EQU     BASE + $24      ; Object Data Pointer
  829           =00F0002E               HP              EQU     BASE + $2e      ; Horizontal Period
  830           =00F00030               HBB             EQU     BASE + $30      ; Horizontal Blanking Begin
  831           =00F00032               HBE             EQU     BASE + $32      ; Horizontal Blanking End
  832           =00F00034               HS              EQU     BASE + $34      ; Horizontal Sync
  833           =00F00036               HVS             EQU     BASE + $36      ; Horizontal Vertical Sync
  834           =00F0003E               VP              EQU     BASE + $3e      ; Vertical Period
  835           =00F00040               VBB             EQU     BASE + $40      ; Vertical Blanking Begin
  836           =00F00042               VBE             EQU     BASE + $42      ; Vertical Blanking End
  837           =00F0004A               VEB             EQU     BASE + $4a      ; Vertical EQUalization Begin
  838           =00F0004C               VEE             EQU     BASE + $4c      ; Vertical EQUalization End
  839           =00F00054               HEQ             EQU     BASE + $54      ; Horizontal EQUalization End
  840           =00F00056               TEST1           EQU     BASE + $56      ; Undocumented Register - DO NOT USE
  841                                   
