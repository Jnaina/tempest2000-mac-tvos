  696                                   ;;; JERRY Flag Register Equates
  697                                   ;;;
  698                                   
  699           =00000010               D_CPUENA        EQU     $00000010       ; CPU Interrupt Enable Bit
  700           =00000020               D_I2SENA        EQU     $00000020       ; I2S Interrupt Enable Bit
  701           =00000040               D_TIM1ENA       EQU     $00000040       ; Timer 1 Interrupt Enable Bit
  702           =00000080               D_TIM2ENA       EQU     $00000080       ; Timer 2 Interrupt Enable Bit
  703           =00000100               D_EXT0ENA       EQU     $00000100       ; External Interrupt 0 Enable Bit
  704           =00010000               D_EXT1ENA       EQU     $00010000       ; External Interrupt 1 Enable Bit
  705                                   
  706           =00000200               D_CPUCLR        EQU     $00000200       ; CPU Interrupt Clear Bit
  707           =00000400               D_I2SCLR        EQU     $00000400       ; I2S Interrupt Clear Bit
  708           =00000800               D_TIM1CLR       EQU     $00000800       ; Timer 1 Interrupt Clear Bit
  709           =00001000               D_TIM2CLR       EQU     $00001000       ; Timer 2 Interrupt Clear Bit
  710           =00002000               D_EXT0CLR       EQU     $00002000       ; External Interrupt 0 Clear Bit
  711           =00020000               D_EXT1CLR       EQU     $00020000       ; External Interrupt 1 Clear Bit
  712                                   
  713                                   ;;;
  714                                   ;;; JERRY Control/Status Register
  715                                   ;;;
  716                                   
  717           =00000001               DSPGO           EQU     $00000001       ; Start DSP
  718           =00000004               DSPINT0         EQU     $00000004       ; Generate a DSP Interrupt 0
  719                                   
  720           =00000040               D_CPULAT        EQU     $00000040       ; Interrupt Latches
  721           =00000080               D_I2SLAT        EQU     $00000080
  722           =00000100               D_TIM1LAT       EQU     $00000100
  723           =00000200               D_TIM2LAT       EQU     $00000200
  724           =00000400               D_EXT1LAT       EQU     $00000400
  725           =00010000               D_EXT2LAT       EQU     $00010000
  726                                   
