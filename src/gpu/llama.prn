   25                                   ;      GENERIC DEFINES
   26                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   27                                   
   28           =00000000               DRAM            EQU     $000000 ; First system RAM location
   29           =00004000               USERRAM         EQU     $004000 ; Beginning of non-reserved RAM
   30           =00200000               ENDRAM          EQU     $200000 ; End of DRAM
   31           =001FFFFC               INITSTACK       EQU     ENDRAM-4        ; Good place to initialize stack
   32                                   
   33                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   34                                   ;      CPU REGISTERS
   35                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   36                                   
   37           =00000100               LEVEL0          EQU     $100            ; 68000 Level 0 Autovector Interrupt
   38           =00000100               USER0           EQU     $100            ; Pseudonym for LEVEL0
   39                                   
   40                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   41                                   ; Masks for INT1 CPU Interrupt Control Register
   42                                   
   43           =00000001               C_VIDENA        EQU     $0001           ; Enable Video time-base interrupts
   44           =00000002               C_GPUENA        EQU     $0002           ; Enable GPU register-write interrupt
   45           =00000004               C_OPENA         EQU     $0004           ; Enable OP stop-object interrupt
   46           =00000008               C_PITENA        EQU     $0008           ; Enable PIT interrupt
   47           =00000010               C_JERENA        EQU     $0010           ; Enable Jerry interrupt
   48                                   
   49           =00000100               C_VIDCLR        EQU     $0100           ; Clear pending video interrupts
   50           =00000200               C_GPUCLR        EQU     $0200           ; Clear pending GPU interrupts
   51           =00000400               C_OPCLR         EQU     $0400           ; Clear pending OP interrupts
   52           =00000800               C_PITCLR        EQU     $0800           ; Clear pending PIT interrupts
   53           =00001000               C_JERCLR        EQU     $1000           ; Clear pending Jerry interrupts
   54                                   
