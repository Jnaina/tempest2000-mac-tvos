   97                                   ; *******************************************************************
   98                                   ; fmult
   99                                   ; *******************************************************************
  100                                           MACRO fmult                ; multiply 2 thangs, uses r2-r4, returns in first reg.
  101                                 .         moveq #0,r2
  102                                 .         move r2,r3
  103                                 .         abs \1
  104                                 .         addc r3,r2
  105                                 .         abs \2
  106                                 .         addc r3,r2
  107                                 .         move \2,r3
  108                                 .         mult \1,r3


                                        src/gpu/llama.gas    Page 18      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  109                                 .         move \1,r4
  110                                 .         shrq #16,r3
  111                                 .         shrq #16,r4
  112                                 .         mult \2,r4
  113                                 .         shrq #16,\2
  114                                 .         add r4,r3
  115                                 .         move \2,r4
  116                                 .         mult \1,r4
  117                                 .         shrq #16,\1
  118                                 .         add r4,r3
  119                                 .         mult \2,\1
  120                                 .         shlq #16,\1
  121                                 .         add r3,\1
  122                                 .         btst #0,r2
  123                                 .         jr z,\~fmptt
  124                                 .         nop
  125                                 .         neg \1
  126                                 . \~fmptt:
  127                                 .         ENDM
  128                                       
  129                                   ; *******************************************************************
  130                                   ; sdiv
  131                                   ; *******************************************************************
  132                                           MACRO sdiv                 ; Divide, keeping sign of that which is divided, uses r2-r3
  133                                 .         move \2,r2
  134                                 .         abs \2
  135                                 .         div \1,\2
  136                                 .         btst #31,r2                ; Get sign bit of original thang
  137                                 .         jr z,\~sdtt
  138                                 .         nop
  139                                 .         neg \2
  140                                 . \~sdtt:
  141                                 .         ENDM
  142                                       
  143                                   ; *******************************************************************
  144                                   ; fjsr
  145                                   ; *******************************************************************
  146                                           MACRO fjsr                 ; Fast single-level JSR
  147                                 .         move PC,r30
  148                                 .         jump (\1)
  149                                 .         addq #6,r30                ; Determine Return Address
  150                                 .         ENDM
  151                                       
  152                                   ; *******************************************************************
  153                                   ; frts
  154                                   ; *******************************************************************
  155                                           MACRO frts
  156                                 .         jump (r30)
  157                                 .         nop
  158                                 .         ENDM
  159                                       
  160                                   ; *******************************************************************
