  824                                   ; *******************************************************************
  825                                   ; starfield1
  826                                   ;
  827                                   ; display straightforward 3d starfield, wraps Z-plane automatically
  828                                   ;
  829                                   ; IN_BUF = PS undraw buffer
  830                                   ; +4 = VP_X
  831                                   ; +8 = VP_Y
  832                                   ; +12 = VP_Z all as 16:16
  833                                   ; +16 = Address of a starfield data structure
  834                                   ;
  835                                   ; Used to draw nearly all starfields in the game. Can you think of a
  836                                   ; screen that doesn't have a starfield in it?
  837                                   ; *******************************************************************
  838                                   starfield1:
  839  0000058E  981C3F6000F0                   movei #in_buf,r28
