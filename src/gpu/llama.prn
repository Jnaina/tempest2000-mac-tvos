  846  000005A0  089C                           addq #4,r28
  847  000005A2  A799                           load (r28),r25             ; r25 points to start of star data structure in 68K RAM (or ROM...)
  848  000005A4  089C                           addq #4,r28
  849  000005A6  A780                           load (r28),r0              ; this is the warp counter
  850  000005A8  089C                           addq #4,r28
  851  000005AA  A781                           load (r28),r1              ; and this is the warp separation
  852                                       
  853  000005AC  A73A                           load (r25),r26             ; r26 has the total number of stars.
  854  000005AE  0899                           addq #4,r25                ; r25 now points to the first star.
  855                                       
  856  000005B0  981C3FF800F0                   movei #gpu_screen,r28
  857  000005B6  A798                           load (r28),r24             ; r24 points to the base of screen RAM.
  858  000005B8  981201800000                   movei #width,r18
  859  000005BE  981300F00000                   movei #height,r19          ; Keep these in register for fast pixel address generation and clipping.
  860                                       
