  191                                   ; *******************************************************************
  192                                   ; Detect the GPU mode selected by the caller and use that to determine
  193                                   ; which routine (shader) to run.
  194                                   ; Mode 0 = starfield1
  195                                   ; Mode 2 = undraw
  196                                   ; Mode 3 = vect3d
  197                                   ; *******************************************************************
  198  0000003C  98003FFC00F0                   movei #gpu_mode,r0
  199  00000042  A401                           load (r0),r1               ; get GPU mode that was set
  200  00000044  9800xxxxxxxx                   movei #undraw,r0
  201  0000004A  7C01                           cmpq #0,r1
  202  0000004C  D002                           jump eq,(r0)               ; Undraw lines
  203  0000004E  E400                           nop
  204  00000050  9800xxxxxxxx                   movei #starfield1,r0
  205  00000056  7C61                           cmpq #3,r1
  206  00000058  D002                           jump eq,(r0)               ; go draw a starfield
  207  0000005A  E400                           nop
  208  0000005C  9800xxxxxxxx                   movei #vect3d,r0
  209  00000062  D000                           jump (r0)
  210  00000064  E400                           nop                        ; go draw 3d vectors
  211                                       
