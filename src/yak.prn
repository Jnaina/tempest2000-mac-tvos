15785                                   ; *******************************************************************
15786                                   ; make_vo2d
15787                                   ; make a 2d vector object at a0, using the vertex list at (a1)
15788                                   ;
15789                                   ; d0.l=x scale, d1.l=y scale, d2.l=x centre, d3.l=y centre, d4=angle
15790                                   ; *******************************************************************
15791                                   make_vo2d:
15792                                       
15793  0000C76E  2448                           move.l a0,a2
15794  0000C770  20C0                           move.l d0,(a0)+            ; Add X scale to our object.
15795  0000C772  20C1                           move.l d1,(a0)+            ; Add Y scale to our object.
15796  0000C774  41E80008                       lea 8(a0),a0               ; skip extent values
15797  0000C778  20C2                           move.l d2,(a0)+            ; Add X centre to our object.
15798  0000C77A  20C3                           move.l d3,(a0)+            ; Add Y centre to our object.
15799  0000C77C  3084                           move d4,(a0)               ; Add angle to our object.
15800  0000C77E  4245                           clr d5
15801  0000C780  4246                           clr d6                     ; use to do extent
15802                                       
15803  0000C782  41EA0020                       lea 32(a2),a0              ; start of vector info
15804  0000C786  1019                   gv:     move.b (a1)+,d0
15805  0000C788  6B00xxxx                       bmi gv_end
15806  0000C78C  1219                           move.b (a1)+,d1
15807  0000C78E  BA40                           cmp d0,d5                  ; check and set extent if necessary
15808  0000C790  6C00xxxx                       bge gv1
15809  0000C794  3A00                           move d0,d5
15810  0000C796  BC41                   gv1:    cmp d1,d6
15811  0000C798  6C00xxxx                       bge gv2
15812  0000C79C  3C01                           move d1,d6
15813  0000C79E  1419                   gv2:    move.b (a1)+,d2            ; get 1 vertex
15814  0000C7A0  C0BC000000FF                   and.l #$ff,d0              ; co-ordinates are 0-255
15815  0000C7A6  C2BC000000FF                   and.l #$ff,d1              ; Keep it between 0 and 255
15816  0000C7AC  4840                           swap d0                    ; Swap position of the first 2 bytes with last 2 bytes.
15817  0000C7AE  4841                           swap d1                    ; Swap position of the first 2 bytes with last 2 bytes.
15818  0000C7B0  20C0                           move.l d0,(a0)+            ; already in right order for reasding as 16:16
15819  0000C7B2  20C1                           move.l d1,(a0)+            ; Add it to our GPU RAM input buffer.


                                        src/yak.s            Page 299     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


15820  0000C7B4  4882                           ext d2
15821  0000C7B6  48C2                           ext.l d2
15822  0000C7B8  20C2                           move.l d2,(a0)+            ; vertexinfo
15823  0000C7BA  60CA                           bra gv
15824                                       
