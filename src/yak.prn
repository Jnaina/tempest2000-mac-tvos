 2584                                   ; *******************************************************************
 2585                                   ; draw_sfuseball
 2586                                   ; A member of the solids list.
 2587                                   ; A member of the 'shapes' list
 2588                                   ; Called during the draw_objects sequence as a member of the solids list.
 2589                                   ; *******************************************************************
 2590                                   draw_sfuseball:
 2591  000018EA  3F39xxxxxxxx                   move ranptr,-(a7)          ; Stash some values in the stack so we can restore them later.
 2592  000018F0  3E39xxxxxxxx                   move frames,d7             ; Store frames in d7.
 2593  000018F6  E44F                           lsr #2,d7                  ; Divide by 4.
 2594  000018F8  33C7xxxxxxxx                   move d7,ranptr             ; Store in ranptr.
 2595                                       
 2596  000018FE  4DF9xxxxxxxx                   lea fbcols,a6              ; Point a6 at our list of fuseball colors.
 2597  00001904  3E3C0004                       move #4,d7                 ; We'll loop 4 times in fleg.
 2598  00001908  2F00                   fleg:   move.l d0,-(a7)            ; Stash some values in the stack so we can restore them later.
 2599  0000190A  43F9xxxxxxxx                   lea fbpiece1,a1            ; Point a1 at the polygon data structure for 1st leg of fuseball.
 2600  00001910  4EB9xxxxxxxx                   jsr rannum                 ; Put a random number between 0 and d1 in d0.
 2601  00001916  08000000                       btst #0,d0                 ; Is it zero?
 2602  0000191A  6600xxxx                       bne dsfb1                  ; If so, skip next line.
 2603  0000191E  43F9xxxxxxxx                   lea fbpiece2,a1            ; If no, point a1 at the 2nd leg polygon data structure instead.
 2604  00001924  201F                   dsfb1:  move.l (a7)+,d0            ; Restore stashed values from the stack.
 2605  00001926  1C367000                       move.b 0(a6,d7.w),d6       ; Use our loop counter to pick a color from fbcols.
 2606  0000192A  13460005                       move.b d6,5(a1)            ; Update the color in the polygon data structure.
 2607  0000192E  13460015                       move.b d6,21(a1)           ; Update the color in the polygon data structure.
 2608  00001932  48E7C000                       movem.l d0-d1,-(A7)        ; Stash some values in the stack so we can restore them later.
 2609  00001936  4EB9xxxxxxxx                   jsr drawsolidxy            ; Draw the fuseball as a solid polygon.
 2610  0000193C  4EB9xxxxxxxx                   jsr gpuwait                ; Wait for the GPU to finish.
 2611  00001942  4CDF0003                       movem.l (a7)+,d0-d1        ; Restore stashed values from the stack.
 2612  00001946  D03C0033                       add.b #$33,d0              ; Add $33 to our random number.
 2613  0000194A  51CFFFBC                       dbra d7,fleg               ; Loop until zero!
 2614                                       
 2615  0000194E  33DFxxxxxxxx                   move (a7)+,ranptr          ; Restore stashed values from the stack.
 2616  00001954  4E75                           rts
 2617                                       
