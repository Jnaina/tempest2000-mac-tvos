 2551                                   upulsa:
 2552  00001898  3C39xxxxxxxx                   move pucnt,d6              ; Put our pulsecount in d6.
 2553  0000189E  41F9xxxxxxxx                   lea spulsars,a0            ; Point a0 at spulsars.
 2554  000018A4  CC7C000F                       and #$0f,d6                ; Keep the pulse count between 0 and 15.
 2555  000018A8  E54E                           lsl #2,d6                  ; Multiply it by 4.
 2556  000018AA  22706000                       move.l 0(a0,d6.w),a1       ; Draw selected pulsar polygon in a1 as a solid polygon.
