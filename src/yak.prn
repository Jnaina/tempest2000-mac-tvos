 2650                                   ; *******************************************************************
 2651                                   ; s_sattest
 2652                                   ; Draw coloured legs of the fuseball
 2653                                   ; A member of the 'shapes' list
 2654                                   ; *******************************************************************
 2655                                   s_sattest:
 2656  000019BA  4DF9xxxxxxxx                   lea fbcols,a6              ; Point a6 at fbcols.
 2657  000019C0  3E3C000F                       move #15,d7                ; We'll iterate the ssat loop 15 times.
 2658  000019C4  3C39xxxxxxxx                   move frames,d6             ; Store frames in d6.
 2659  000019CA  E246                           asr #1,d6                  ; Divide by 2.
 2660  000019CC  CC7C00FF                       and #$ff,d6                ; Keep d6 between 0 and 255.
 2661  000019D0  3F07                   ssat:   move d7,-(a7)              ; Stash some values in the stack so we can restore them later.
