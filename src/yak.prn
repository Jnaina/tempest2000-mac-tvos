 1332  0000088E  C07C00FF                       and #$ff,d0                ; Keep it between 0 and 255
 1333  00000892  10300000                       move.b 0(a0,d0.w),d0       ; Use frames as index to pick a value from sine table.
 1334  00000896  4880                           ext d0                     ; Make it long
 1335  00000898  E340                           asl #1,d0                  ; Multiply it by 2.
