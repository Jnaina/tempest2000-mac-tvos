 9810  00007EF0  2879xxxxxxxx                   move.l _claw,a4
 9811  00007EF6  286C0038                       move.l 56(a4),a4           ; p2's Claw
 9812  00007EFA  286C0038                       move.l 56(a4),a4           ; p1's Shield
 9813  00007EFE  302E0010                       move 16(a6),d0
 9814  00007F02  B06C0010                       cmp 16(a4),d0
 9815  00007F06  6600xxxx                       bne np1sh                  ; same lane chec
 9816  00007F0A  302E000C                       move 12(a6),d0             ; this bull's Z
 9817  00007F0E  B06C000C                       cmp 12(a4),d0              ; check against the Shield
