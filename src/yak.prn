15232                                   ; *******************************************************************
15233                                   ; Initialize the Object List. We make it 12 items long. The main object
15234                                   ; is the first one, which is a full screen of pixel data generated by the
15235                                   ; GPU.
15236                                   ;
15237                                   ; Data structure of items in 'beasties':
15238                                   ; 0-3      X
15239                                   ; 4-7      Y
15240                                   ; 12-13    Object Mode
15241                                   ; 14-15    Object Type
15242                                   ; 16-18    Pointer to screen data.
15243                                   ; 20-22    Index to post-creation routine in 'postfixups'.
15244                                   ; *******************************************************************
15245                                   InitBeasties:
15246  0000C2A8  41F9xxxxxxxx                   lea beasties,a0            ; Point a0 at the first entry in beasties.
15247  0000C2AE  3E3C000C                       move #12,d7                ; Move 12 to d7.
15248  0000C2B2  33C7xxxxxxxx                   move d7,nbeasties          ; There will be 12 entries in beasties.
15249  0000C2B8  317CFFFF000C           ibeasts: move #-1,12(a0)           ; Initialize the mode of the entry to 'inactive'
15250  0000C2BE  41E80040                       lea 64(a0),a0              ; Each entry is 64 bytes long.
15251  0000C2C2  51CFFFF4                       dbra d7,ibeasts            ; Go to the next entry.
15252  0000C2C6  4E75                           rts
15253                                       
15254                                   ; *******************************************************************
15255                                   ; RunBeasties
15256                                   ; Create the Object List (aka Display List). This is used by the
15257                                   ; Jaguar's Object Processor to write pixel data to the screen. It has
15258                                   ; a fixed length of 12 objects in the list (fixed by InitBeasties above).
15259                                   ; The main object is the first one (see ObTypes), which is a full screen


                                        src/yak.s            Page 289     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


15260                                   ; of pixel data populated by the GPU.
15261                                   ;
15262                                   ; Data structure of items in 'beasties':
15263                                   ; 0-3      X
15264                                   ; 4-7      Y
15265                                   ; 12-13    Object Mode
15266                                   ; 14-15    Object Type
15267                                   ; 16-18    Pointer to screen data.
15268                                   ; 20-22    Index to post-creation routine in 'postfixups'.
15269                                   ; *******************************************************************
15270                                   RunBeasties:
15271  0000C2C8  2079xxxxxxxx                   move.l blist,a0            ; We will build our Object List in blist, so point a0 at it.
15272  0000C2CE  2879xxxxxxxx                   move.l dlist,a4            ; THis goes unused.
15273  0000C2D4  4A79xxxxxxxx                   tst warp_flash
15274  0000C2DA  6600xxxx                       bne StopList
15275                                       
15276  0000C2DE  45F9xxxxxxxx                   lea beasties,a2            ; Point a2 at beasties.
15277  0000C2E4  3E39xxxxxxxx                   move nbeasties,d7          ; We're going to loop in RBeasts 12 times.
15278  0000C2EA  3F07                   RBeasts:move d7,-(a7)              ; Stash the loop counter in the stack so we can restore it later.
15279  0000C2EC  302A000C                       move 12(a2),d0             ; get mode
15280  0000C2F0  6B00xxxx                       bmi nxbeast                ; If object not in use, skip to next one.
15281  0000C2F4  47F9xxxxxxxx                   lea ModeVex,a3             ; Point a3 at ModeVex
15282  0000C2FA  E540                           asl #2,d0                  ; Multiply d0 (mode) it by 4.
15283  0000C2FC  26730000                       move.l 0(a3,d0.w),a3       ; Use it as an index into ModeVex to get the mode routine
15284  0000C300  4E93                           jsr (a3)                   ; Call the selecte routine, action for that Mode.
15285                                       
15286                                           ; Pull out the X and Y info from the current entry in beasties.
15287  0000C302  3012                           move (a2),d0               ; Put X position in d0.
15288  0000C304  C07C0FFF                       and #$fff,d0               ; limit to 12-bit
15289  0000C308  322A0004                       move 4(a2),d1              ; Put Y position in d1
15290  0000C30C  08810000                       bclr #0,d1                 ; Clear the lower byte?
15291                                       
15292                                           ; This section appears unnecessary.
15293  0000C310  3C2A0008                       move 8(a2),d6
15294  0000C314  362A000A                       move 10(a2),d3
15295  0000C318  E14B                           lsl #8,d3
15296  0000C31A  8646                           or d6,d3
15297  0000C31C  4843                           swap d3                    ; Swap position of the first 2 bytes with last 2 bytes.
15298                                       
15299                                           ; Pull out the rest of the data from the current entry in beasties and use it to
15300                                           ; make an Object List object for display.
15301  0000C31E  3E2A000E                       move 14(a2),d7             ; Put the object type in d7.
15302  0000C322  47F9xxxxxxxx                   lea ObTypes,a3             ; Point a3 at the ObTypes list.
15303  0000C328  E747                           asl #3,d7                  ; Multiply d7 (object type) by 8.
15304  0000C32A  36337000                       move 0(a3,d7.w),d3         ; Get the width from the ObTypes entry in phrases
15305  0000C32E  38337002                       move 2(a3,d7.w),d4         ; Get the vertical height from ObTypes entry
15306  0000C332  3A337004                       move 4(a3,d7.w),d5         ; Get the depth from ObTypes entry
15307  0000C336  34337006                       move 6(a3,d7.w),d2         ; Get the CLUT offset from the ObTypes entry.
15308  0000C33A  226A0010                       move.l 16(a2),a1           ; Put the object's screen data pointer in a1.
15309  0000C33E  6100xxxx                       bsr MakeUnScaledObject     ; Use it all to make an Object List object.
15310  0000C342  302A0014                       move 20(a2),d0             ; Put the index into postfixups in d0.
15311  0000C346  6B00xxxx                       bmi nxbeast                ; If we don't have an index, move to the next entry.
15312  0000C34A  47F9xxxxxxxx                   lea postfixups,a3          ; Point a3 at postfixups.
15313  0000C350  E540                           asl #2,d0                  ; Multiply our index by 4.
15314  0000C352  26730000                       move.l 0(a3,d0.w),a3       ; Use it as an index into postfixups.
15315  0000C356  4E93                           jsr (a3)                   ; Run the selected routine in postfixups.


                                        src/yak.s            Page 290     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


15316  0000C358  3E1F                   nxbeast:move (a7)+,d7              ; Restore the loop counter from the stack.
15317  0000C35A  45EA0040                       lea 64(a2),a2              ; Move a2 to point to the next entry in beasties.
15318  0000C35E  51CFFF8A                       dbra d7,RBeasts            ; Loop until we've done all 12 'beasties'.
15319                                       
15320  0000C362  6000xxxx                       bra StopList               ; put a stopobject on the end
15321                                       
15322                                   postfixups:
15323  0000C366  xxxxxxxxxxxxxxxx               dc.l make_rmw,make_trans
15324                                       
15325                                   ; *******************************************************************
15326                                   ; make_rmw
15327                                   ; set RMW on the sprite just defined
15328                                   ; *******************************************************************
15329                                   make_rmw:
15330  0000C36E  47E8FFE0                       lea -32(a0),a3             ; point to start of object
15331  0000C372  08EB0006000A                   bset.b #6,10(a3)           ; set the RMW flag
15332  0000C378  4E75                           rts
15333                                       
15334                                   ; *******************************************************************
15335                                   ; make_trans
15336                                   ; make this sprite transparent
15337                                   ; *******************************************************************
