 6332  00005022  223C00730086                   move.l #$730086,d1         ; srce size for yak head.
 6333  00005028  4A79xxxxxxxx                   tst joby                   ; Should we display the 'joby' graphic instead?
 6334  0000502E  6600xxxx                       bne notjob                 ; If not, go to 'notjob'.
 6335  00005032  45F900898000                   lea pic5,a2                ; Select the sprite map with the Joby graphic (beasty7.cry).
 6336  00005038  203C005B00D2                   move.l #$5b00d2,d0         ; Start address for the joby graphic.
 6337  0000503E  223C006B006C                   move.l #$6b006c,d1         ; Length of data to extract.
 6338  00005044  0C790001xxxxxxxx       notjob: cmp #1,joby                ; Should we display the 'Atari' graphic?
 6339  0000504C  6600xxxx                       bne notatari               ; If not 1, then don't.
