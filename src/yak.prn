 9796  00007EBC  33FC0013xxxxxxxx               move #$13,sfx              ; Select 'Pulsar Pulse' sound effect.
 9797  00007EC4  33FC0003xxxxxxxx               move #3,sfx_pri            ; Set the sound's priority compared to others.
 9798  00007ECC  4EB9xxxxxxxx                   jsr fox                    ; Play selected sound effect.
 9799  00007ED2  609C                           bra moomoomoo
 9800                                   np2sh:
 9801  00007ED4  0C6E00BF000C                   cmp #webz+81,12(a6)        ; Set top of the web as Z position in activobject entry.
 9802  00007EDA  6B00xxxx                       bmi rrts                   ; If not, return now.
 9803                                   kllit:
 9804  00007EDE  226E0018                       move.l 24(a6),a1
 9805  00007EE2  4291                           clr.l (a1)
 9806  00007EE4  3D7C00030032                   move #3,50(a6)             ; Mark it for deletion.
 9807  00007EEA  4E75                           rts
 9808                                   upweb:
