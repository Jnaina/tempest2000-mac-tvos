 9647                                   ; *******************************************************************
 9648                                   ; make_webs
 9649                                   ; Take the data structures that define our webs in web1, web2 etc. and
 9650                                   ; turn them into web 'objects' that we store in 'webs'.
 9651                                   ; *******************************************************************
 9652                                   make_webs:
 9653  00007CAC  4DF9xxxxxxxx                   lea raw_webs,a6            ; Point a6 at our list of web data structures, e.g. web1, web2 etc.
 9654  00007CB2  4BF9xxxxxxxx                   lea webs,a5                ; Point a5 at webs, which we will use to store the constructed webs.
 9655                                   mk_webs:
 9656  00007CB8  48E70106                       movem.l a5-a6/d7,-(a7)     ; Stash some values in the stack so we can restore them later.
 9657  00007CBC  2256                           move.l (a6),a1             ; Point a1 at current entry in 'raw_webs'.
 9658  00007CBE  247C00000028                   move.l #40,a2
 9659  00007CC4  7001                           move.l #1,d0               ; RMODE. 0=only XY rotate
 9660  00007CC6  7201                           move.l #1,d1
 9661  00007CC8  7401                           move.l #1,d2
 9662  00007CCA  7808                           move.l #8,d4
 9663  00007CCC  4286                           clr.l d6
 9664  00007CCE  4247                           clr d7
 9665  00007CD0  4BED0020                       lea 32(a5),a5
 9666  00007CD4  6100xxxx                       bsr extrude
 9667  00007CD8  4CDF6080                       movem.l (a7)+,a5-a6/d7     ; Restore stashed values from the stack.
 9668  00007CDC  4DEE0004                       lea 4(a6),a6
 9669  00007CE0  2A88                           move.l a0,(a5)             ; Put address of the constructed vectors at the start of the web object.
 9670  00007CE2  2B79xxxxxxxx0004               move.l web_otab,4(a5)
 9671  00007CEA  2B79xxxxxxxx0008               move.l web_ptab,8(a5)
 9672  00007CF2  3B79xxxxxxxx000C               move web_max,12(a5)        ; Store the number of lanes int he web.
 9673  00007CFA  2B79xxxxxxxx000E               move.l web_firstseg,14(a5)


                                        src/yak.s            Page 189     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 9674  00007D02  3B79xxxxxxxx0012               move web_x,18(a5)
 9675  00007D0A  3B79xxxxxxxx0014               move web_z,20(a5)
 9676  00007D12  3B79xxxxxxxx0016               move connect,22(a5)
 9677  00007D1A  4BED0080                       lea 128(a5),a5             ; Advance pointer to the next slot for the next web.
 9678  00007D1E  2E16                           move.l (a6),d7
 9679  00007D20  6696                           bne mk_webs                ; Keep going until we reached the end of raw_webs.
 9680  00007D22  4E75                           rts
