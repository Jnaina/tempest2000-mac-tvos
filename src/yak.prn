 5291                                   ; *******************************************************************
 5292                                   ; ffade ; Do a meltovision transition.
 5293                                   ; A demo_routine
 5294                                   ; Used to implement the meltovision rotate and fade effect for the
 5295                                   ; entire screen.
 5296                                   ; *******************************************************************
 5297                                   ffade:
 5298                                           ; The net result of the dance here is that we pass a pongz value of 0xFF (-1)
 5299                                           ; for the first 7 frames, and then 0x00 for all frames after that. Since
 5300                                           ; pongz is the angle (in brads) to rotate, this results in rotating the image
 5301                                           ; for the first few frames and then leaving it without a rotation after that. 
 5302  00004052  06790001xxxxxxxx               add #1,pongy
 5303  0000405A  3039xxxxxxxx                   move pongy,d0
 5304  00004060  C07C0003                       and #$03,d0       ; First 7 frames are rotated 1 degree to right.
 5305  00004064  6600xxxx                       bne failfade               ; Do a meltovision transition.
 5306  00004068  4A39xxxxxxxx                   tst.b pongz+1 ; If pongz+1 is zero, don't alter it.
 5307  0000406E  6700xxxx                       beq failfade               ; Do a meltovision transition.
 5308  00004072  6B00xxxx                       bmi ffinc
 5309  00004076  04390002xxxxxxxx               sub.b #2,pongz+1
 5310                                   ffinc:


                                        src/yak.s            Page 111     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 5311  0000407E  06390001xxxxxxxx               add.b #1,pongz+1
 5312                                   failfade:
