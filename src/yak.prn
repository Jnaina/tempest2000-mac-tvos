23884                                   ; *******************************************************************
23885                                   ; These are the data structures for the solid polygon objects such
23886                                   ; as the flipper, fusetank, claws etc.
23887                                   ; They are used by the drawsolidxy routine and the polyo2d gpu routine
23888                                   ; in horse.gas to draw solid polygonal objects on the screen.
23889                                   ; *******************************************************************
23890                                   .include "obj2d.s"
