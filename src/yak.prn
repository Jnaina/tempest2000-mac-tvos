 9187                                   ; *******************************************************************
 9188                                   ; rundroid
 9189                                   ; Called during the run_objects sequence as a member of the run_vex list.
 9190                                   ; *******************************************************************
 9191                                   rundroid:
 9192  00007714  4279xxxxxxxx                   clr whichclaw
 9193                                           ; Universal stuff
 9194  0000771A  066E0001001C                   add #1,28(a6)              ; Increment pitch.
 9195  00007720  066E0002001E                   add #2,30(a6)              ; Increment roll.
 9196  00007726  066E00030020                   add #3,32(a6)              ; Increment yaw.
 9197  0000772C  3D79xxxxxxxx0028               move flashcol,40(a6)       ; Update the color.
 9198                                       
 9199                                           ; Should we expire the droid?
 9200  00007734  0C790002xxxxxxxx               cmp #2,entities            ; did we start with 2 entities (driod is permanent)?
 9201  0000773C  6700xxxx                       beq always_2
 9202  00007740  0C79FFFExxxxxxxx               cmp #-2,wave_tim
 9203  00007748  6600xxxx                       bne always_2
 9204  0000774C  3D7C00010032                   move #1,50(a6)             ; FG Unlink Please
 9205  00007752  4E75                           rts
 9206                                       
 9207                                           ; See if we can fire a bullet from the droid.
 9208                                   always_2:
 9209  00007754  04390001xxxxxxxx               sub.b #1,droidel           ; Droid's firing rate
 9210  0000775C  6A00xxxx                       bpl nodfire
 9211  00007760  13F9xxxxxxxxxxxxxxxx           move.b droidel+1,droidel
 9212  0000776A  4A79xxxxxxxx                   tst locked                 ; Are we in the middle of deleting an object from activeobjects?
 9213  00007770  6600xxxx                       bne nodfire                ; If so, don't fire a bullet from the droid.
 9214  00007774  4A79xxxxxxxx                   tst shots+2
 9215  0000777A  6B00xxxx                       bmi nodfire                ; If so, don't fire a bullet from the droid.
 9216  0000777E  0C6E00010022                   cmp #1,34(a6)
 9217  00007784  6600xxxx                       bne nodfire                ; If so, don't fire a bullet from the droid.
 9218                                       
 9219                                           ; We can fire a bullet from the droid.
 9220  00007788  04790001xxxxxxxx               sub #1,shots+2
 9221  00007790  224E                           move.l a6,a1
 9222  00007792  3E3C0080                       move #$80,d7               ; marker for bullets to distinguish pl. 1 and pl 2 shots
 9223  00007796  2A39xxxxxxxx                   move.l _chevre,d5          ; Set address of the vector object to draw: _chevre.
 9224  0000779C  6100xxxx                       bsr frab0                  ; frab0 is fire w. arbitrary graphic
 9225                                       


                                        src/yak.s            Page 181     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 9226                                           ;  Is the droid moving already?
 9227  000077A0  4A6E002C               nodfire:tst 44(a6)
 9228  000077A4  6600xxxx                       bne movedroid              ; mode non0 means droid is moving.
 9229                                       
 9230                                           ; Initiate movement of the droid.
 9231  000077A8  3039xxxxxxxx                   move droid_data,d0         ; this is the closest enemy to the top of the Web
 9232  000077AE  6100xxxx                       bsr lor                    ; ask Left or Right to get there
 9233  000077B2  6600xxxx                       bne droidright             ; init droid motion to the right.
 9234  000077B6  6000xxxx                       bra droidleft              ; init droid motion to the left.
 9235                                       
