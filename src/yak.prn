 1090                                   ; *******************************************************************
 1091                                   ; dloop
 1092                                   ; Topmost game control loop.
 1093                                   ; The routine 'it', aliased as '_demo' below,
 1094                                   ; will do the game setup and invoke 'mainloop'.
 1095                                   ; We come back here whenever we lose a life or complete the game.
 1096                                   ; When the game finishes we'll go back to the top of rreset.
 1097                                   ; *******************************************************************
 1098                                   dloop:
 1099                                           ; Camera viewpoint as 16:16 fracs
 1100  00000450  42B9xxxxxxxx                   clr.l vp_x                 ; Clear x viewpoint
 1101  00000456  42B9xxxxxxxx                   clr.l vp_y                 ; Clear y viewpoint
 1102  0000045C  42B9xxxxxxxx                   clr.l vp_z                 ; Clear z viewpoint
 1103                                   ego:
 1104  00000462  2079xxxxxxxx                   move.l _demo,a0            ; Stash 'it' routine in a0.
 1105  00000468  33FC0001xxxxxxxx               move #1,pauen              ; Enable Pause.
 1106  00000470  4279xxxxxxxx                   clr finished               ; Reset the 'finished' signal.
 1107                                       
 1108  00000476  4E90                           jsr (a0)                   ; Run the 'it' routine which will invoke the 'mainloop'.
 1109                                       
 1110  00000478  4279xxxxxxxx                   clr _pauen                 ; Disable pause.
 1111  0000047E  4A79xxxxxxxx                   tst gb                     ; Have we finished the game and earned beastly mode?
 1112  00000484  6600xxxx                       bne dobeastly              ; If so, set up beastly mode and start a new game.
 1113  00000488  4A79xxxxxxxx                   tst auto                   ; Are we in demo mode?
 1114  0000048E  6600xxxx                       bne zreset                 ; If so, fade and return to title screen.
 1115  00000492  4A79xxxxxxxx                   tst z                      ; Has the player done a hard reset?
 1116  00000498  6600xxxx                       bne zreset                 ; If so, fade and return to title screen.


                                        src/yak.s            Page 36      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 1117  0000049C  4A79xxxxxxxx                   tst h2h                    ; Are we in head-to-head mode?
 1118  000004A2  6600xxxx                       bne h2hover                ; If so, do the head-to-head game over sequence.
 1119  000004A6  4A79xxxxxxxx                   tst finished               ; Is the game finished?
