11882                                   run_spike:
11883  000098CA  302E000C                       move 12(a6),d0
11884  000098CE  3F00                           move d0,-(a7)              ; save our z pos
11885  000098D0  906E0024                       sub 36(a6),d0
11886  000098D4  3D40000C                       move d0,12(a6)             ; Set Z position in activobject entry. Our 'position' is the height of our Spike
11887                                       
11888  000098D8  4A6E0014                       tst 20(a6)
11889  000098DC  6700xxxx                       beq nospf
