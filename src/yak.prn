16228                                           ; in 'run_vex' for each object.
16229  0000CCB2  BDFCFFFFFFFF           r_obj:  cmpa.l #-1,a6              ; Have we reached the end of the activeobjects lit?
16230  0000CCB8  6700xxxx                       beq r_end                  ; If so, clean up and exit.
16231  0000CCBC  4A6E0032                       tst 50(a6)                 ; Is the object marked for deletion?
16232  0000CCC0  6B00xxxx                       bmi r_end1                 ; If so, exit and clean up. >>>>> KLUDGE to prevent a garbled list being traversed
16233                                       
16234  0000CCC4  41F90000CB72                   lea run_vex,a0             ; Store run_vex in a0
16235  0000CCCA  302E0022                       move 34(a6),d0             ; Do we have a draw routine or are we collapsed to a pixel?
