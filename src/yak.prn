10955                                   ; Make an enemy of type FLIPPER


                                        src/yak.s            Page 212     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


10956                                   ; *******************************************************************
10957                                   make_flipper:
10958                                       
10959  00008D9E  4A79xxxxxxxx                   tst t2k                    ; Are we playing Tempest 2000?
10960  00008DA4  6700xxxx                       beq maflip
10961                                       
10962  00008DA8  6100xxxx                       bsr rannum                 ; Put a random number between 0 and d1 in d0.
10963  00008DAC  B079xxxxxxxx                   cmp sflip_prob3,d0
10964  00008DB2  6BCA                           bmi make_sflip2
10965                                       
10966                                   maflip:
10967  00008DB4  4A79xxxxxxxx                   tst afree                  ; Are there any free slots for a new activeobject?
10968  00008DBA  6B00xxxx                       bmi rrts                   ; If not, return now.
10969  00008DBE  04790001xxxxxxxx               sub #1,afree               ; Reserve the slot in activeobjects we're going to us.
10970  00008DC6  2079xxxxxxxx                   move.l freeobjects,a0      ; Point a0 at the address to use for our new activeobject.
10971  00008DCC  2039xxxxxxxx                   move.l _flipper,d0         ; Set address of the vector object to draw: _flipper.
10972  00008DD2  4A79xxxxxxxx                   tst blanka                 ; Are we drawing solids or vectors?
10973  00008DD8  6700xxxx                       beq nsf                    ; If vectors we've alread selecetd _flipper, so skip to nsf.
10974  00008DDC  70FF                           move.l #-1,d0              ; We're drawing solids, so set index to 'cdraw_sflipper' instead.
10975                                       
10976  00008DDE  2080                   nsf:    move.l d0,(a0)             ; Set the draw routine we selected above, i.e. solid or vector.
10977  00008DE0  317C00BE000C                   move #webz+80,12(a0)       ; Store the top of the web's Z position as the zlipper's Z position.
10978  00008DE6  4268000E                       clr 14(a0)
10979  00008DEA  3239xxxxxxxx                   move web_max,d1            ; Get number of lanes in web and put it in d1.
10980  00008DF0  6100xxxx                       bsr rand                   ; Put a random number between 0 and d1 in d0.
10981                                       
10982  00008DF4  31400010                       move d0,16(a0)             ; initial webpos of this flipper
10983  00008DF8  42A8001E                       clr.l 30(a0)               ; clear Y and Z rotate
10984  00008DFC  317C00030022                   move #3,34(a0)             ; Draw routine in draw_vex is 'draw_vxc'.
10985  00008E02  42A80024                       clr.l 36(a0)               ; x centre to default
10986  00008E06  3179xxxxxxxx0028               move flipcol,40(a0)        ; Flippers are RED
10987  00008E0E  3179xxxxxxxx001A               move flip_pause,26(a0)     ; Set the delay between flips
10988  00008E16  317C0001002A                   move #1,42(a0)             ; Fine rez
10989  00008E1C  317C00020036                   move #2,54(a0)             ; Object Update routine is 'run_flipper'.
10990  00008E22  317C00000018                   move #0,24(a0)             ; Flipper mode 0 (Ride up rail)
10991  00008E28  4268002C                       clr 44(a0)                 ; Optional behaviour on rail, default mode is 'stdrail'.
10992  00008E2C  317C00010034                   move #1,52(a0)             ; IS vulnerable to the Superzapper
10993  00008E32  2C48                           move.l a0,a6               ; Move our newly created object into the activeobjects list.
10994  00008E34  6100xxxx                       bsr toweb                  ; Attach the flipper to the web
