15662  0000C608  23C700F0223C                   move.l d7,B_COUNT
15663  0000C60E  3E04                           move d4,d7                 ; get colour
15664  0000C610  4847                           swap d7                    ; Swap position of the first 2 bytes with last 2 bytes.
