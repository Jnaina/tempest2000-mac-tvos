 1633  00000D58  4840                           swap d0                    ; Swap position of the first 2 bytes with last 2 bytes.
 1634  00000D5A  4841                           swap d1                    ; Swap position of the first 2 bytes with last 2 bytes.
 1635  00000D5C  3A3C0008                       move #8,d5                 ; Set the index to ObTypes to 8: 48-pixel high bit of cry screen.
 1636  00000D60  363C0024                       move #$24,d3               ; Set the width?
 1637  00000D64  383C0024                       move #$24,d4               ; Set the height?
 1638  00000D68  4EB9xxxxxxxx                   jsr makeit_trans           ; Make a transparent object entry in beasties.
 1639                                       
