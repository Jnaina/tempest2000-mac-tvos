17611  0000DF3E  2468003C                       move.l 60(a0),a2
17612  0000DF42  06790001xxxxxxxx               add #1,ofree               ; Make one less slot available on the freeobjects list.
17613  0000DF4A  47F9xxxxxxxx                   lea freeobjects,a3         ; Point a3 at freeobjects.
17614  0000DF50  49F9xxxxxxxx                   lea activeobjects,a4       ; Point a4 at activeobjects.
17615  0000DF56  6000FEC4                       bra MoveLink
