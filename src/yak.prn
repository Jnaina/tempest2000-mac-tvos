16120  0000CAA2  5343                           subq #1,d3                 ; Subtract 1
16121  0000CAA4  E94B                           lsl #4,d3                  ; Multiply it by 32.
16122  0000CAA6  43F900005494                   lea sphertypes,a1          ; Point a1 at sphertypes
16123  0000CAAC  43F13000                       lea 0(a1,d3.w),a1          ; Use fw_sphere as in index into sphertypes to populate..
16124  0000CAB0  21590018                       move.l (a1)+,24(a0)        ; rings/sphere to GPU input buffer.
16125  0000CAB4  2159001C                       move.l (a1)+,28(a0)        ; pixels/ring to GPU input buffer.
16126  0000CAB8  21590020                       move.l (a1)+,32(a0)        ; pixel spacing to GPU input buffer.
16127  0000CABC  21590024                       move.l (a1)+,36(a0)        ; twist per ring to GPU input buffer.
16128  0000CAC0  322E0028                       move 40(a6),d1             ; Put the color in d1.
16129  0000CAC4  C2BC000000FF                   and.l #$ff,d1              ; Keep it between 0 and 255
16130  0000CACA  21410028                       move.l d1,40(a0)           ; Put the colour in GPU input buffer.
16131  0000CACE  4480                           neg.l d0                   ; Negate the rad value
16132  0000CAD0  D0BC000000FF                   add.l #$ff,d0              ; Add ff, which decreases it by 1.
16133  0000CAD6  2140002C                       move.l d0,44(a0)           ; Update it as our new step count.
16134  0000CADA  23FC0000000400F03FFC           move.l #4,gpu_mode         ; Op 4 is 'psphere' in ox.gas.
16135  0000CAE4  41F9xxxxxxxx                   lea bovine,a0              ; Load the GPU module in ox.gas.
16136  0000CAEA  4EB9xxxxxxxx                   jsr gpurun                 ; do clear screen
16137  0000CAF0  4EF9xxxxxxxx                   jmp gpuwait                ; Wait for the GPU to finish.
