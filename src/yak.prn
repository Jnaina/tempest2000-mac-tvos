 3470                                   ; *******************************************************************
 3471                                   selse:
 3472  0000258C  33FC0001xxxxxxxx               move #1,players            ; Set as a 1 player game.
 3473  00002594  33FC001Cxxxxxxxx               move #$1c,bulland          ; Standard number of bullet slots.
 3474  0000259C  33FC0007xxxxxxxx               move #7,bullmax            ; 8 bullets max.
 3475  000025A4  33FC0001xxxxxxxx               move #1,entities           ; 1 entity: a claw.
 3476  000025AC  0C790002xxxxxxxx               cmp #2,selected            ; Is Tempest 2000 selected?
 3477  000025B4  6700xxxx                       beq npling                 ; If so, jump to npling and skip 2 player setup.
 3478  000025B8  4A79xxxxxxxx                   tst selected               ; Is Classic Tempest selected?
 3479  000025BE  6700xxxx                       beq opling                 ; If so, no Droidy or 2pl in trad Tempest so nothing further required.
 3480                                       
 3481                                           ; Tempest Plus has been selected. Player can now choose the type of game for Tempest Plus.
 3482                                           ; Display 'Select Options for this Game': 1 Player, AI Droid, 2 Player Team.
 3483  000025C2  3F39xxxxxxxx                   move selected,-(a7)        ; Stash selection in the stack so we can restore it later.
 3484  000025C8  4279xxxxxxxx                   clr selected               ; Set  1 Player as default.
 3485  000025CE  33FC0002xxxxxxxx               move #2,selectable         ; Three options are available.
 3486  000025D6  23FCxxxxxxxxxxxxxxxx           move.l #option7,the_option   ; Enable 'Select Options for this Game'
 3487  000025E0  6100xxxx                       bsr do_choose              ; Display it and get a selection.
 3488                                       
 3489                                           ; Process the player's selection for the type of Tempest Plus game.
 3490  000025E4  3039xxxxxxxx                   move selected,d0           ; Store the selection in d0.
 3491  000025EA  6700xxxx                       beq stdstrt                ; 1 Player was selected, go start it up.
 3492  000025EE  B07C0002                       cmp #2,d0                  ; If not, was two player mode selected?
 3493  000025F2  6700xxxx                       beq set22                  ; If so, set up two players in set22.
 3494                                       
 3495                                           ; Otherwise, it's a 1 player game with a Droid..
 3496  000025F6  33FC0001xxxxxxxx               move #1,players            ; 1 Player
 3497  000025FE  33FC003Cxxxxxxxx               move #$3c,bulland          ; Increased number of bullet slots for test droid mode
 3498  00002606  33FC000Fxxxxxxxx               move #15,bullmax           ; 16 bullets max
 3499  0000260E  33FC0002xxxxxxxx               move #2,entities           ; 2 entities: claw and droid.
 3500  00002616  6000xxxx                       bra stdstrt                ; Skip to rest of set up.
 3501                                       
 3502                                           ; Player has selected 2 player: set up two player game.
 3503  0000261A  33FC0002xxxxxxxx       set22:  move #2,players            ; start 2-player simul mode
 3504  00002622  33FC0002xxxxxxxx               move #2,entities           ; 2 entities: claw and claw.
 3505  0000262A  33FC003Cxxxxxxxx               move #$3c,bulland          ; Increased number of bullet slots for 2 players.
 3506  00002632  33FC000Fxxxxxxxx               move #15,bullmax           ; 16 bullets max.
 3507  0000263A  4279xxxxxxxx                   clr dying
 3508                                       
 3509  00002640  33DFxxxxxxxx           stdstrt:move (a7)+,selected        ; Restore the game selection value from the stack.
 3510  00002646  6000xxxx                       bra opling                 ; Skip all the other set up.
 3511                                       
