 9291                                   ; *******************************************************************
 9292                                   ; lor
 9293                                   ; left or right
 9294                                   ; enter with d0=web column # of target. For any web, returns d1=0 for go left, 1 for go right, based on a6 object's position.
 9295                                   ; *******************************************************************
 9296                                   lor:
 9297                                       
 9298  0000782A  322E0010                       move 16(a6),d1             ; Flipper current pos
 9299  0000782E  B240                           cmp d0,d1
 9300  00007830  6600xxxx                       bne nntrv
 9301  00007834  4A79xxxxxxxx                   tst auto                   ; Are we in demo mode?
 9302  0000783A  6700xxxx                       beq nntrv
 9303  0000783E  323CFFFF                       move #-1,d1
 9304  00007842  4E75                           rts
 9305                                   nntrv:
