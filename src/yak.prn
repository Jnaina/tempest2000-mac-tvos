13062  0000A738  4245                           clr d5                     ; midpoint to 16:16
13063  0000A73A  2D440004                       move.l d4,4(a6)            ; Set X position in activeobject entry.
13064  0000A73E  2D450008                       move.l d5,8(a6)            ; Set Y position in activeobject entry.
13065  0000A742  3C2E0010                       move 16(a6),d6
13066  0000A746  E34E                           lsl #1,d6                  ; Multiply it by 2.
13067  0000A748  2279xxxxxxxx                   move.l web_otab,a1         ; Put the web orientation table in a1.
13068  0000A74E  3D716000001C                   move 0(a1,d6.w),28(a6)     ; Use d6 to get the right orientation value from the web orientation table.
13069  0000A754  4E75                           rts
