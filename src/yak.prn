 9313  00007858  3439xxxxxxxx                   move web_max,d2            ; Get number of lanes in web and put it in d2.
 9314  0000785E  E242                           asr #1,d2                  ; half distance around web
 9315  00007860  9240                           sub d0,d1
 9316  00007862  6E00xxxx                       bgt _lll
 9317  00007866  6F00xxxx                       ble _rrr
 9318                                   ;  bra zz
 9319                                   _lll:
 9320  0000786A  9242                           sub d2,d1
 9321  0000786C  6D00xxxx                       blt lor0
 9322  00007870  6000xxxx                       bra lor1
 9323                                   _rrr:
 9324  00007874  4441                           neg d1
 9325  00007876  9242                           sub d2,d1
 9326  00007878  6D00xxxx                       blt lor1
 9327                                       
 9328                                       
 9329                                   lor0:
 9330  0000787C  4241                           clr d1
 9331  0000787E  4E75                           rts
 9332                                   lor1:
