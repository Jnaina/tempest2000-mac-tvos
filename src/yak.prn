 1675                                   ; draw_oo
 1676                                   ; Used during the level selection loop as the 'mainloop_routine'.


                                        src/yak.s            Page 46      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 1677                                   ; *******************************************************************
 1678                                   draw_oo:
 1679  00000E26  6100xxxx                       bsr draw_o
 1680  00000E2A  08390002xxxxxxxx               btst.b #2,sysflags         ; Is Beastly Mode enabled?
 1681  00000E32  6700xxxx                       beq rrrts
 1682  00000E36  4A79xxxxxxxx                   tst h2h                    ; Are we playing a head-to-head game?
 1683  00000E3C  6600xxxx                       bne rrrts
 1684  00000E40  41F9xxxxxxxx                   lea bstymsg,a0             ; "PRESS option FOR BEASTLY MODE!"
 1685  00000E46  43F9xxxxxxxx                   lea cfont,a1               ; Load the small regular font to a1.
 1686  00000E4C  303C00B4                       move #180,d0               ; Set Y position of text.
 1687  00000E50  4A79xxxxxxxx                   tst pal
 1688  00000E56  6700xxxx                       beq gnopal2
 1689  00000E5A  D079xxxxxxxx                   add palfix2,d0             ; Adjust for PAL screens if required.
 1690  00000E60  4EF9xxxxxxxx           gnopal2:jmp centext                ; Display horizontally centred text.
 1691                                           ; Returns
 1692                                       
 1693                                   ; *******************************************************************
 1694                                   ; draw_o
 1695                                   ; The bespoke object drawing routine for the level selection screen.
 1696                                   ; draw_objects does most of the work but there is other stuff like
 1697                                   ; updating the bonus points for the selectedlevel that this takes care
 1698                                   ; of.
 1699                                   ; *******************************************************************
 1700  00000E66  0C790001xxxxxxxx       draw_o: cmp #1,webcol              ; Is the web the default colour?
 1701  00000E6E  6600xxxx                       bne do_2                   ; If yes, skip.
 1702  00000E72  06790001xxxxxxxx               add #1,wpt                 ; 
 1703  00000E7A  02790007xxxxxxxx               and #7,wpt
 1704  00000E82  6600xxxx                       bne do_1
 1705  00000E86  6100xxxx                       bsr swebpsych              ; Make the web psychedelic.
 1706  00000E8A  6000xxxx                       bra do_2
 1707                                   do_1:
 1708                                   do_2:
 1709  00000E8E  4EB9xxxxxxxx                   jsr draw_objects           ; Do all the object drawing.
 1710  00000E94  4AB9xxxxxxxx                   tst.l csmsg                ; Do we have any bonus points to show?
 1711  00000E9A  6700xxxx                       beq rrrts                  ; If no bonus points to show, return now.
 1712                                       
 1713                                           ; Clear a spot for us to display the bonuspoints.
 1714  00000E9E  23FC0005000000F03FF8           move.l #screen3,gpu_screen
 1715  00000EA8  303C0000                       move #0,d0                 ; Source X position.
 1716  00000EAC  323C0054                       move #84,d1                ; Source Y position.
 1717  00000EB0  343C0180                       move #384,d2               ; Full screen width.
 1718  00000EB4  363C0020                       move #32,d3                ; Set height
 1719  00000EB8  383C0000                       move #0,d4                 ; Destination X position
 1720  00000EBC  3A3C0000                       move #0,d5                 ; Destination Y position
 1721  00000EC0  207C00050000                   move.l #screen3,a0         ; Source screen
 1722  00000EC6  227C00050000                   move.l #screen3,a1         ; Destination screen.
 1723  00000ECC  4EB9xxxxxxxx                   jsr ecopy                  ; just blit a clear bit
 1724                                       
 1725                                           ; Display bonus points.
 1726  00000ED2  43F9xxxxxxxx                   lea afont,a1               ; Load the 'Atari' font to a1.
 1727  00000ED8  2079xxxxxxxx                   move.l csmsg,a0            ; Load the bonus points for the selected level as our text.
 1728  00000EDE  42B9xxxxxxxx                   clr.l csmsg                ; Clear csmsg for next time.
 1729  00000EE4  4A79xxxxxxxx                   tst h2h                    ; Are we playing a head-to-head game?
 1730  00000EEA  6600xxxx                       bne rrrts                  ; If so, return now.
 1731  00000EEE  303C0014                       move #20,d0                ; Set Y position of text.
 1732  00000EF2  4EF9xxxxxxxx                   jmp centext                ; Display horizontally centred text.


