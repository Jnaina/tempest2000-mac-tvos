 6606                                   ; drawsphere
 6607                                   ; A member of the draw_vex list.
 6608                                   ; Called during the draw_objects sequence as a member of the draw_vex list.
 6609                                   ; *******************************************************************
 6610                                   drawsphere:
 6611  000053DA  41F900F03F60                   lea in_buf,a0              ; Point our GPU RAM input buffer at a0
 6612  000053E0  202E0004                       move.l 4(a6),d0            ; Get the source X position.
 6613  000053E4  90B9xxxxxxxx                   sub.l vp_x,d0              ; Subtract the player/camera viewpoint X position.
 6614  000053EA  2080                           move.l d0,(a0)             ; Store X position in the GPU RAM input buffer.
 6615  000053EC  202E0008                       move.l 8(a6),d0            ; Get the object's Y position.
 6616  000053F0  90B9xxxxxxxx                   sub.l vp_y,d0              ; Subtract the player/camera viewpoint Y position.
 6617  000053F6  21400004                       move.l d0,4(a0)            ; Store Y position in the GPU RAM input buffer.
 6618  000053FA  202E000C                       move.l 12(a6),d0           ; Get the object's Z position.
 6619  000053FE  90B9xxxxxxxx                   sub.l vp_z,d0              ; Subtract the player/camera viewpoint Z position.
 6620  00005404  21400008                       move.l d0,8(a0)            ; Store Z position in the GPU RAM input buffer.
 6621  00005408  302E002A                       move 42(a6),d0             ; Put the scale factor in d0.
 6622  0000540C  C0BC000000FF                   and.l #$ff,d0              ; Keep it between 0 and 255
 6623                                       
 6624  00005412  2200                           move.l d0,d1               ; Store the scale in d1..
 6625  00005414  2400                           move.l d0,d2               ; .. and d2.
 6626  00005416  E489                           lsr.l #2,d1                ; Divide by 4.
 6627  00005418  4481                           neg.l d1                   ; Make it negative.
 6628  0000541A  D2BC000000FF                   add.l #$ff,d1              ; Add 255.
 6629  00005420  C27C000F                       and #$0f,d1                ; Make it between 0 and 15.
 6630  00005424  826E002E                       or 46(a6),d1               ; Or it, this will now act as our colour.
 6631                                       
 6632  00005428  E580                           asl.l #2,d0                ; was 2
 6633  0000542A  2140000C                       move.l d0,12(a0)           ; rad
 6634  0000542E  217C000000000010               move.l #0,16(a0)           ; phase 1
 6635  00005436  3039xxxxxxxx                   move frames,d0             ; Stash the frame count in d0.
 6636  0000543C  C0BC000000FF                   and.l #$ff,d0              ; Keep it between 0 and 255
 6637  00005442  21400014                       move.l d0,20(a0)           ; phase 2
 6638                                       
 6639  00005446  362E0030                       move 48(a6),d3             ; Get the sphere type index
 6640  0000544A  5343                           subq #1,d3                 ; Subtract 1.
 6641  0000544C  E94B                           lsl #4,d3                  ; Multiply it by 32 so we can use as index into sphertypes.
 6642  0000544E  43F9xxxxxxxx                   lea sphertypes,a1          ; Point a1 at sphertypes.
 6643  00005454  43F13000                       lea 0(a1,d3.w),a1          ; Get the sphere type from sphertypes.
 6644  00005458  21590018                       move.l (a1)+,24(a0)        ; Put rings/sphere in GPU input buffer.
 6645  0000545C  2159001C                       move.l (a1)+,28(a0)        ; Put pixels/ring in GPU input buffer.
 6646  00005460  21590020                       move.l (a1)+,32(a0)        ; Put pixel spacing in GPU input buffer.
 6647  00005464  21590024                       move.l (a1)+,36(a0)        ; Put twist per ring in GPU input buffer.
 6648  00005468  21410028                       move.l d1,40(a0)           ; Putcolour in GPU input buffer.
 6649  0000546C  4482                           neg.l d2
 6650  0000546E  D4BC000000FF                   add.l #$ff,d2              ; calculate i decreasing
 6651  00005474  2142002C                       move.l d2,44(a0)           ; Put scale in GPU input buffer.
 6652  00005478  23FC0000000400F03FFC           move.l #4,gpu_mode         ; Op4 is 'psphere' in ox.gas.
 6653  00005482  41F9xxxxxxxx                   lea bovine,a0              ; Load the GPU module in ox.gas.
 6654  00005488  4EB9xxxxxxxx                   jsr gpurun                 ; do clear screen


                                        src/yak.s            Page 135     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 6655  0000548E  4EF9xxxxxxxx                   jmp gpuwait                ; Wait for the GPU to finish.
