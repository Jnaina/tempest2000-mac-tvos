 6811  0000568C  4EB9xxxxxxxx                   jsr gpurun                 ; do clear screen
 6812  00005692  4EB9xxxxxxxx                   jsr gpuwait                ; Wait for the GPU to finish.
 6813  00005698  4CDF000F                       movem.l (a7)+,d0-d3        ; Restore stashed values from the stack.
