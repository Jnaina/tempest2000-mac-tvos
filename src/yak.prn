 6975                                   ; *******************************************************************
 6976                                   ; draw_mpixex
 6977                                   ; Called during the draw_objects sequence as a member of the draw_vex list.
 6978                                   ; Draws the 'Excellent' message coming towards you and breaking up into
 6979                                   ; pixels.
 6980                                   ; *******************************************************************
 6981                                   draw_mpixex:
 6982  00005894  247C00820000                   move.l #pic,a2             ; We're using the spritemap in beasty3.cry.
 6983  0000589A  23FC0000000400F03FFC   giff:   move.l #4,gpu_mode         ; 'rex' in camel.gas: multiple images stretching towards you in Z
 6984  000058A4  3E3C0000                       move #0,d7
 6985  000058A8  2C2E000C                       move.l 12(a6),d6           ; Store object's Z position in d6.
 6986                                       


                                        src/yak.s            Page 141     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 6987                                           ; This is a loop that keeps decreasing the Z position until
 6988                                           ; it reaches zero or we've drawn it 256 times (whichever comes first).
 6989  000058AC  41F900F03F60           mpixex: lea in_buf,a0              ; Point our GPU RAM input buffer at a0.
 6990  000058B2  20CA                           move.l a2,(a0)+            ; srce screen for effect
 6991  000058B4  20EE0024                       move.l 36(a6),(a0)+        ; srce start pixel address
 6992  000058B8  20EE002E                       move.l 46(a6),(a0)+        ; srce size
 6993  000058BC  202E002A                       move.l 42(a6),d0           ; Store the scale factor in d0.
 6994  000058C0  E480                           asr.l #2,d0                ; Divide by 4.
 6995  000058C2  20C0                           move.l d0,(a0)+            ; Set as x-scale
 6996  000058C4  20C0                           move.l d0,(a0)+            ; Set as y-scale
 6997  000058C6  20FC00000000                   move.l #0,(a0)+            ; no shear
 6998  000058CC  20FC00000000                   move.l #0,(a0)+
 6999  000058D2  20FC00000001                   move.l #1,(a0)+            ; Mode 1 = Centered
 7000  000058D8  202E0004                       move.l 4(a6),d0            ; Get the source X position.
 7001  000058DC  90B9xxxxxxxx                   sub.l vp_x,d0              ; Subtract the player/camera viewpoint X position.
 7002  000058E2  20C0                           move.l d0,(a0)+            ; Add it to our GPU RAM input buffer.
 7003  000058E4  202E0008                       move.l 8(a6),d0            ; Get the object's Y position.
 7004  000058E8  90B9xxxxxxxx                   sub.l vp_y,d0              ; Subtract the player/camera viewpoint Y position.
 7005  000058EE  20C0                           move.l d0,(a0)+            ; Add it to our GPU RAM input buffer.
 7006  000058F0  2006                           move.l d6,d0               ; Get our Z position.
 7007  000058F2  90B9xxxxxxxx                   sub.l vp_z,d0              ; Subtract the player/camera viewpoint Z position.
 7008  000058F8  20C0                           move.l d0,(a0)+            ; Add it our GPU input buffer.
 7009  000058FA  41F9xxxxxxxx                   lea parrot,a0              ; Load the GPU module in camel.gas.
 7010  00005900  4EB9xxxxxxxx                   jsr gpurun                 ; do clear screen
 7011  00005906  4EB9xxxxxxxx                   jsr gpuwait                ; Wait for the GPU to finish.
 7012                                       
 7013  0000590C  9CBC00100000                   sub.l #$100000,d6          ; Decrease the Z position of the object
 7014  00005912  6B00xxxx                       bmi rrts                   ; If it's less than zero, we're done.
 7015  00005916  51CFFF94                       dbra d7,mpixex             ; Otherwise draw again, closer to the viewer (255 iterations max).
 7016  0000591A  4E75                           rts
