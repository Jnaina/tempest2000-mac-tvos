 5039                                   ; *******************************************************************
 5040                                   ; fade ; Do a meltovision transition.
 5041                                   ; This is meltovision.
 5042                                   ; https://www.trademarkia.com/meltovision-74534584
 5043                                   ; go into FADE after merging screen3 to current screen and turning off BEASTIES+64
 5044                                   ; *******************************************************************
 5045  00003D2C  4A79xxxxxxxx           fade:   tst beasties+76            ; Are we ready for meltovision?
 5046  00003D32  6B00xxxx                       bmi ofade                  ; If so, do a meltovision transition.
 5047                                           ; If not do a merge first.
 5048  00003D36  207C00050000                   move.l #screen3,a0
 5049  00003D3C  227900F03FF8                   move.l gpu_screen,a1
 5050  00003D42  7000                           moveq #0,d0                ; X position in source screen
 5051  00003D44  7200                           moveq #0,d1                ; Y position in source screen
 5052  00003D46  343C0180                       move #384,d2               ; Width
 5053  00003D4A  363C00F0                       move #240,d3               ; Height
 5054  00003D4E  D679xxxxxxxx                   add palfix1,d3             ; Adjust for PAL
 5055  00003D54  7800                           moveq #0,d4                ; X position in destination screen.
 5056  00003D56  7A00                           moveq #0,d5                ; Y position in destination screen.
 5057  00003D58  4A79xxxxxxxx                   tst mfudj
 5058  00003D5E  6700xxxx                       beq pmf2
 5059  00003D62  967C0008                       sub #8,d3
 5060                                       
 5061  00003D66  4A79xxxxxxxx           pmfade: tst mfudj
 5062  00003D6C  6700xxxx                       beq pmf2
 5063  00003D70  DA7C0008                       add #8,d5
 5064  00003D74  4279xxxxxxxx                   clr mfudj
 5065  00003D7A  4EB9xxxxxxxx           pmf2:   jsr MergeBlock             ; Merge screen3 and gpu_screen 1
 5066  00003D80  33FCFFFFxxxxxxxx               move #-1,beasties+76       ; Signal we can do a fade now.
 5067                                       
 5068                                           ; Now we can do the fade part of the meltovision.
 5069  00003D88  4279xxxxxxxx           ofade:  clr _pauen                 ; can't pause in fade
 5070  00003D8E  23FCxxxxxxxxxxxxxxxx           move.l #ffade,demo_routine ; Set meltovision as the demo_routine
 5071  00003D98  23FCxxxxxxxxxxxxxxxx           move.l #failcount,routine  ; Set the counter routine.
 5072  00003DA2  33FC0096xxxxxxxx               move #150,pongx
 5073  00003DAA  4EB9xxxxxxxx                   jsr rannum                 ; Put a random number between 0 and d1 in d0.
 5074  00003DB0  C07C0007                       and #$7,d0
 5075  00003DB4  907C0003                       sub #$03,d0
 5076  00003DB8  C07C00FF                       and #$ff,d0                ; Keep it between 0 and 255
 5077  00003DBC  33C0xxxxxxxx                   move d0,pongz
 5078  00003DC2  23FC00F80000xxxxxxxx           move.l #$f80000,delta_i
 5079  00003DCC  3F39xxxxxxxx                   move z,-(a7)               ; Stash some values in the stack so we can restore them later.
 5080  00003DD2  4279xxxxxxxx                   clr z                      ; Clear hard reset signal.
 5081  00003DD8  6100xxxx                       bsr gogame                 ; Run the meltovision transition.
 5082  00003DDC  207C00050000                   move.l #screen3,a0         ; Point a0 at screen3.
 5083  00003DE2  4EB9xxxxxxxx                   jsr clrscreen              ; Clear the screen in a0.
 5084  00003DE8  33DFxxxxxxxx                   move (a7)+,z               ; Restore stashed values from the stack.
 5085  00003DEE  33FC0001xxxxxxxx               move #1,sync
 5086  00003DF6  4E75                           rts
