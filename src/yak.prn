13221                                   srezclaw:
13222                                           ; If we're too close or something use dsclaw2 as the draw routine.
13223  0000A8E6  3D7C00110022                   move #17,34(a6)            ; Set draw routine in draw_vex as 'dsclaw2'.
13224  0000A8EC  066E00400024                   add #$40,36(a6)            ; Something about close rez spacing?
13225  0000A8F2  6600xxxx                       bne go_con                 ; If so, nothing further to do except run the object update routine for the claw.
13226                                       
13227                                           ; Otherwise we're drawing as a solid or vector. First check
13228                                           ; if we should jump.
13229  0000A8F6  2039xxxxxxxx                   move.l _claw,d0            ; Store _claw in d0.
13230  0000A8FC  B096                           cmp.l (a6),d0              ; Check if the current object (a6) is a claw.
13231  0000A8FE  6600xxxx                       bne ncjmp                  ; If not a claw, don't clear cjump.
13232                                           ; Clear the jump indicator for the claw.
13233  0000A902  42B9xxxxxxxx                   clr.l cjump                ; use as jump indicator/velocity
13234                                       
13235                                           ; Are we drawing the claw as a solid or a vector?
13236  0000A908  4A79xxxxxxxx           ncjmp:  tst blanka                 ; Are we drawing solids or vectors?
13237  0000A90E  6700xxxx                       beq vclaw                  ; If vector, skip to vclaw.
13238  0000A912  0C6E0015002E                   cmp #21,46(a6)             ; Is it a droid?
13239  0000A918  6700xxxx                       beq vclaw                  ; If so, draw it as a vector.
13240  0000A91C  3D7C00100022                   move #16,34(a6)            ; We're a solid. Draw routine in draw_vex is 'dsclaw'. This is draw solid claw.
13241  0000A922  6000xxxx                       bra rclaw                  ; Skip to rclaw.
13242  0000A926  3D7C00010022           vclaw:  move #1,34(a6)             ; Draw routine in draw_vex is 'draw'.
13243                                       


                                        src/yak.s            Page 253     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


13244                                           ; Get the 'current' update routine from position 46 and use that as
13245                                           ; the object update routine. Can be one of: dsclaw,
13246  0000A92C  3D6E002E0036           rclaw:  move 46(a6),54(a6)         ; set our obejct update routine
13247  0000A932  3D7CFFFF0034                   move #-1,52(a6)            ; set mode to vulnerable.
13248                                       
13249                                           ; Invoke the object's secondary update routine.
13250                                           ; In single-player games this will be claw_con1.
13251                                           ; In head-to-head, Player 1 is claw_con2, Player 2 is claw_con1.
13252  0000A938  302E002E               go_con: move 46(a6),d0             ; skip on to rez_claw (can move and fire during rezz)
13253  0000A93C  E540                           asl #2,d0                  ; Multiply it by 4.
13254  0000A93E  41F9xxxxxxxx                   lea run_vex,a0             ; Put run_vex in a0.
13255  0000A944  20700000                       move.l 0(a0,d0.w),a0       ; Use our secondary update index to get the routine to use.
13256  0000A948  4ED0                           jmp (a0)                   ; Execute it.
13257                                           ; Returns
