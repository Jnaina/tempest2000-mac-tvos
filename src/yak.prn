17154  0000D97C  2240                           move.l d0,a1               ; Get object header, e.g. _flipper.
17155  0000D97E  41F900F03F64                   lea in_buf+4,a0
17156  0000D984  202E0004                       move.l 4(a6),d0            ; Get the source X position.
17157  0000D988  90B9xxxxxxxx                   sub.l vp_x,d0              ; Subtract the player/camera viewpoint X position.
17158  0000D98E  20C0                           move.l d0,(a0)+            ; Co-ordinates as X, Y, Z 16:16 frax
17159  0000D990  202E0008                       move.l 8(a6),d0            ; Combine with camera viewpoint
17160  0000D994  90B9xxxxxxxx                   sub.l vp_y,d0              ; Subtract the player/camera viewpoint Y position.
17161  0000D99A  20C0                           move.l d0,(a0)+            ; Add it to our GPU RAM input buffer.
