 6842                                   ; *******************************************************************
 6843                                   ; draw_prex
 6844                                   ; Draw a ring explosion.
 6845                                   ; Called during the draw_objects sequence as a member of the draw_vex list.
 6846                                   ; *******************************************************************
 6847                                   draw_prex:
 6848  000056FC  202E0004                       move.l 4(a6),d0            ; Get the object's X position.
 6849  00005700  222E0008                       move.l 8(a6),d1            ; Get the object's Y position.
 6850  00005704  242E000C                       move.l 12(a6),d2           ; Get the object's Z position.
 6851  00005708  90B9xxxxxxxx                   sub.l vp_x,d0              ; Subtract the player/camera viewpoint X position.
 6852  0000570E  92B9xxxxxxxx                   sub.l vp_y,d1              ; Subtract the player/camera viewpoint Y position.
 6853  00005714  94B9xxxxxxxx                   sub.l vp_z,d2              ; Subtract the player/camera viewpoint Z position.
 6854  0000571A  4283                           clr.l d3
 6855  0000571C  4284                           clr.l d4
 6856  0000571E  362E002C                       move 44(a6),d3             ; Get the radius, We use this is as an index for the color.
 6857  00005722  4843                           swap d3                    ; Swap position of the first 2 bytes with last 2 bytes.
 6858  00005724  382E002E                       move 46(a6),d4             ; Get the number of pixels per ring
 6859  00005728  3A3C0002                       move #2,d5                 ; Number of times to iterate in prexloop.
 6860  0000572C  23FC0000000700F03FFC           move.l #7,gpu_mode         ; Select 'pring2' routine xcamel.gas.
 6861                                       
 6862                                   prexloop:
 6863  00005736  48E7FC00                       movem.l d0-d5,-(a7)        ; Stash some values in the stack so we can restore them later.
 6864  0000573A  41F900F03F60                   lea in_buf,a0              ; Point our GPU RAM input buffer at a0.
 6865  00005740  20C4                           move.l d4,(a0)+            ; Add # pixels per ring to GPU input buffer.
 6866  00005742  20C0                           move.l d0,(a0)+            ; Add X to our GPU RAM input buffer.
 6867  00005744  20C1                           move.l d1,(a0)+            ; Add Y to our GPU RAM input buffer.
 6868  00005746  20C2                           move.l d2,(a0)+            ; Add Z t our GPU RAM input buffer.
 6869  00005748  2E03                           move.l d3,d7               ; Store the color index in d7
 6870  0000574A  4847                           swap d7                    ; Swap position of the first 2 bytes with last 2 bytes.
 6871  0000574C  6100C306                       bsr pulser                 ; Get the color using index in d7.
 6872  00005750  CCBC000000FF                   and.l #$ff,d6              ; Keep it between 0 and 255
 6873  00005756  20C6                           move.l d6,(a0)+            ; colour
 6874  00005758  20C3                           move.l d3,(a0)+            ; radius 16:16


                                        src/yak.s            Page 139     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 6875  0000575A  3039xxxxxxxx                   move frames,d0             ; Stash the frame count in d0.
 6876  00005760  C0BC000000FF                   and.l #$ff,d0              ; Keep it between 0 and 255
 6877  00005766  20C0                           move.l d0,(a0)+            ; Use it as the phase when drawing the ring.
 6878  00005768  41F9xxxxxxxx                   lea xparrot,a0             ; Load the GPU module in 'xcamel.gas'.
 6879  0000576E  4EB9xxxxxxxx                   jsr gpurun                 ; Run our selected GPU routine (pring2).
 6880  00005774  4EB9xxxxxxxx                   jsr gpuwait                ; Wait for the GPU to finish.
 6881  0000577A  4CDF003F                       movem.l (a7)+,d0-d5        ; Restore stashed values from the stack.
 6882  0000577E  94BC00040000                   sub.l #$40000,d2           ; Decrease the Z position.
 6883  00005784  E383                           asl.l #1,d3                ; Multiply it by 2.
 6884  00005786  987C0002                       sub #2,d4                  ; Reduce the number of pixels by 2.
 6885  0000578A  51CDFFAA                       dbra d5,prexloop           ; Keep looping until we hit 0.
 6886  0000578E  4E75                           rts
 6887                                       
 6888                                   ; *******************************************************************
 6889                                   ; draw_pprex
 6890                                   ; Draw a p-ring explosion.
 6891                                   ; Called during the draw_objects sequence as a member of the solids list.
 6892                                   ; *******************************************************************
 6893                                   draw_pprex:
 6894  00005790  4280                           clr.l d0
 6895  00005792  4284                           clr.l d4
 6896  00005794  302E002C                       move 44(a6),d0             ; Get the index to use for colour.
 6897  00005798  4840                           swap d0                    ; Swap position of the first 2 bytes with last 2 bytes.
 6898  0000579A  382E002E                       move 46(a6),d4             ; put number of pixels per ring in d4.
 6899                                       
 6900                                           ; We'll loop twice through pprex loop to animate our little power up ring explosion.
 6901  0000579E  3A3C0002                       move #2,d5                 ; Set the number of times to loop in pprexloop as 2.
 6902  000057A2  23FC0000000100F03FFC           move.l #1,gpu_mode         ; Select 'pring2' in horse.gas.
 6903                                   pprexloop:
 6904  000057AC  48E7FC00                       movem.l d0-d5,-(a7)        ; Stash some values in the stack so we can restore them later.
 6905  000057B0  41F900F03F60                   lea in_buf,a0              ; Point our GPU RAM input buffer at a0.
 6906  000057B6  20C4                           move.l d4,(a0)+            ; # pixels per ring
 6907  000057B8  20C2                           move.l d2,(a0)+            ; Add X to our GPU RAM input buffer.
 6908  000057BA  20C3                           move.l d3,(a0)+            ; Add Y to our GPU RAM input buffer.
 6909  000057BC  20C1                           move.l d1,(a0)+            ; Add Z to our GPU RAM input buffer.
 6910  000057BE  2E00                           move.l d0,d7               ; Put colour index in d7.
 6911  000057C0  4847                           swap d7                    ; Swap position of the first 2 bytes with last 2 bytes.
 6912  000057C2  6100C290                       bsr pulser                 ; Get pulser to calculate a colour.
 6913  000057C6  CCBC000000FF                   and.l #$ff,d6              ; Keep it between 0 and 255
 6914  000057CC  20C6                           move.l d6,(a0)+            ; Put the colour in the GPU input buffer.
 6915  000057CE  20C0                           move.l d0,(a0)+            ; radius 16:16
 6916  000057D0  3039xxxxxxxx                   move frames,d0             ; Stash the frame count in d0.
 6917  000057D6  C0BC000000FF                   and.l #$ff,d0              ; Keep it between 0 and 255
 6918  000057DC  20C0                           move.l d0,(a0)+            ; Put it as the phase in GPU input buffer.
 6919  000057DE  41F9xxxxxxxx                   lea equine,a0              ; Load the GPU module in horse.gas.
 6920  000057E4  4EB9xxxxxxxx                   jsr gpurun                 ; Run pring2 in horse.gas.
 6921  000057EA  4EB9xxxxxxxx                   jsr gpuwait                ; Wait for the GPU to finish.
 6922  000057F0  4CDF003F                       movem.l (a7)+,d0-d5        ; Restore stashed values from the stack.
 6923  000057F4  92BC00040000                   sub.l #$40000,d1           ; Decrease our Z position.
 6924  000057FA  E380                           asl.l #1,d0                ; Multiply it by 2.
 6925  000057FC  987C0002                       sub #2,d4                  ; Decrease number of pixels per ring by 2.
 6926  00005800  51CDFFAA                       dbra d5,pprexloop          ; Loop until d5 reaches 0.
 6927  00005804  4E75                           rts
 6928                                       
 6929                                       
 6930                                   ; *******************************************************************


                                        src/yak.s            Page 140     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 6931                                   ; dmpix
 6932                                   ; Draws the source image coming towards you and breaking up into
 6933                                   ; pixels.
 6934                                   ; Called during the draw_objects sequence as a member of the draw_vex list.
 6935                                   ; *******************************************************************
 6936                                   dmpix:
 6937  00005806  246E0010                       move.l 16(a6),a2           ; Put the source screen in a2.
 6938  0000580A  23FC0000000400F03FFC           move.l #4,gpu_mode         ; Select 'rex' in camel.gas: multiple images stretching towards you in Z.
 6939  00005814  3E3C0000                       move #0,d7                 ; Put 0 in d7, so that we loop dmup 256 times in total.
 6940  00005818  2C2E000C                       move.l 12(a6),d6           ; Put the object Z position in d6.
 6941  0000581C  3A3C0096                       move #150,d5
 6942  00005820  9A6E002E                       sub 46(a6),d5              ; range is 0-150
