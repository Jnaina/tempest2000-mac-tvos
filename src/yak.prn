 2481  00001818  6700xxxx                       beq stcnt                  ; If not set, do normal centering.
 2482  0000181C  D86E0024                       add 36(a6),d4              ; If set, reverse the centering.
 2483  00001820  6000xxxx                       bra cntdne                 ; Skip next line.
