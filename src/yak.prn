16940  0000D740  303C0002                       move #2,d0                 ; Z images counter
16941  0000D744  322E0024                       move 36(a6),d1             ; delta z
16942  0000D748  48C1                           ext.l d1                   ; Extend
16943  0000D74A  E181                           asl.l #8,d1                ; Convert to 16:16
16944  0000D74C  342E0026                       move 38(a6),d2             ; Delta for colour
16945  0000D750  262E000C                       move.l 12(a6),d3           ; Z position
16946                                       
16947  0000D754  D56E0028               dr_z:   add d2,40(a6)              ; Add the delta to the colour
16948  0000D758  D681                           add.l d1,d3                ; Add the z delta to the z position.
16949  0000D75A  48E7F000                       movem.l d0-d3,-(a7)        ; Stash the difference between z positions.
16950                                       
16951  0000D75E  2256                           move.l (a6),a1             ; Get object header
16952  0000D760  41F900F03F64                   lea in_buf+4,a0            ; Get GPU buffer
16953  0000D766  202E0004                       move.l 4(a6),d0            ; Get the X pos
16954  0000D76A  90B9xxxxxxxx                   sub.l vp_x,d0              ; Subtract the viewpoint
16955  0000D770  20C0                           move.l d0,(a0)+            ; Add to GPU buffer
16956  0000D772  202E0008                       move.l 8(a6),d0            ; Get the Y pos
16957  0000D776  90B9xxxxxxxx                   sub.l vp_y,d0              ; Subtract the viewpoint
16958  0000D77C  20C0                           move.l d0,(a0)+            ; Add to tGPU buffer
16959  0000D77E  2003                           move.l d3,d0               ; Get the z position
16960  0000D780  6100xxxx                       bsr dra                    ; Run the GPU routine to draw the vectors.
16961  0000D784  4CDF000F                       movem.l (a7)+,d0-d3        ; Retrieve the difference between z positions
16962  0000D788  51C8FFCA                       dbra d0,dr_z               ; Loop until we've done for all diferences.
16963                                       
16964  0000D78C  3D5F0028                       move (a7)+,40(a6)          ; Get old colour back
16965  0000D790  4E75                           rts
16966                                       
16967                                   ; *******************************************************************
16968                                   ; draw
16969                                   ; The 'base' draw routine when processing 'activeobjects'. If a 'vector'
16970                                   ; draw is good enough, we just do that. Otherwise we add the object to the
16971                                   ; 'apriority' list for processing by 'drawpolyos'.
16972                                   ; Called during the draw_objects sequence as a member of the draw_vex list.
16973                                   ; *******************************************************************
16974                                   draw:


                                        src/yak.s            Page 320     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


16975  0000D792  23CExxxxxxxx                   move.l a6,oopss            ; Stash the header.
16976                                           ; If the header contains a negative value it's an index into the
16977                                           ; 'solids' list, otherwise it's the address of the vector data
16978                                           ; object we can draw directly with the gpu.
16979  0000D798  2016                           move.l (a6),d0             ; Is the header value greater than zero?
16980  0000D79A  6A00xxxx                       bpl vector                 ; If yes, then a vector draw will suffice.
16981                                       
16982                                           ; Otherwise we need to do add this object to the 'apriority'
16983                                           ; list so that it can be drawn as a solid polygon.
16984                                       
16985                                           ; The 'apriority' list stores objects in the descending order
16986                                           ; of their Z co-ordinate. This ensures that nearer objects are
16987                                           ; painted in front of objects that are further away or 'behind' them.
16988  0000D79E  2079xxxxxxxx                   move.l fpriority,a0        ; get a free priority object
16989  0000D7A4  208E                           move.l a6,(a0)
16990  0000D7A6  202E000C                       move.l 12(a6),d0           ; get 'z'
16991  0000D7AA  2140000C                       move.l d0,12(a0)           ; put z in prior object
16992  0000D7AE  2279xxxxxxxx                   move.l apriority,a1
16993  0000D7B4  2449                           move.l a1,a2
16994                                   chklp:
16995  0000D7B6  B3FCFFFFFFFF                   cmp.l #-1,a1               ; no objects active?
16996  0000D7BC  6600xxxx                       bne prio1
16997  0000D7C0  6000xxxx                       bra insertprior            ; we are at top of list then, if we are first a1=a2=-1
16998                                       
16999                                   prio1:
17000  0000D7C4  B0A9000C                       cmp.l 12(a1),d0            ; check against stored 'z'
17001  0000D7C8  6C00xxxx                       bge insertprior            ; behind, insert on to list
17002  0000D7CC  2449                           move.l a1,a2
17003  0000D7CE  22690008                       move.l 8(a1),a1            ; get next object
17004  0000D7D2  60E2                           bra chklp                  ; loop until list end or next object in front of us
17005  0000D7D4  4E75                           rts                        ; return with object at right place in the list
17006                                       
17007                                   ; *******************************************************************
17008                                   ; drawpolyos
17009                                   ; Routine for drawing all solid polygons.
17010                                   ; Process each object in the 'apriority' list. We remove each item after
17011                                   ; processing.The draw routine for each item is given by its index into
17012                                   ; the 'solids' array.
17013                                   ; *******************************************************************
17014                                   drawpolyos:
17015  0000D7D6  23FC000000C000F03EFC           move.l #192,xcent          ; Set 192 as X centre.
17016  0000D7E0  7C78                           move.l #120,d6             ; Set 120 as Y centre.
17017  0000D7E2  DC79xxxxxxxx                   add palfix2,d6             ; Adjust for PAL if necessary.
17018  0000D7E8  23C600F03EF8                   move.l d6,ycent            ; Store it as Y centre.
17019  0000D7EE  2079xxxxxxxx                   move.l apriority,a0        ; Get our 'apriority' list.
17020                                   dpoloop:
17021  0000D7F4  B1FCFFFFFFFF                   cmp.l #-1,a0
17022  0000D7FA  6700EDAE                       beq rrts                   ; End of list was reached
17023  0000D7FE  2C50                           move.l (a0),a6             ; Get the index to 'solids'
17024  0000D800  2016                           move.l (a6),d0             ; Store it in d0.
17025  0000D802  2F08                           move.l a0,-(a7)            ; Stash our current position in the list.
17026  0000D804  6100xxxx                       bsr podraw                 ; Go do object type draw
17027  0000D808  4EB9xxxxxxxx                   jsr gpuwait                ; wait for gpu
17028  0000D80E  205F                           move.l (a7)+,a0            ; Get our current position in the list
17029  0000D810  2F280008                       move.l 8(a0),-(a7)         ; Get the next position in the list
17030  0000D814  6100xxxx                       bsr unlinkprior            ; Delete the current object.


                                        src/yak.s            Page 321     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


17031  0000D818  205F                           move.l (a7)+,a0            ; Move to the next position in the list.
17032  0000D81A  60D8                           bra dpoloop                ; Loop until all objects drawn and unlinked
17033                                       
17034                                   podraw:
17035  0000D81C  7809                           move.l #9,d4               ; Set X centre as 9.
17036  0000D81E  7A09                           move.l #9,d5               ; Set Y centre as 9.
17037                                   soldraw:
17038  0000D820  4440                           neg d0
17039  0000D822  49F9xxxxxxxx                   lea solids,a4              ; Get the 'solids' list.
17040  0000D828  E548                           lsl #2,d0                  ; Multiply our index by 4.
17041  0000D82A  20740000                       move.l 0(a4,d0.w),a0       ; Get the draw routine address from 'solids'.
17042  0000D82E  242E0004                       move.l 4(a6),d2            ; Get the X position from our object.
17043  0000D832  94B9xxxxxxxx                   sub.l vp_x,d2              ; Subtract our X viewpoint.
17044  0000D838  262E0008                       move.l 8(a6),d3            ; Get the Y position from our object.
17045  0000D83C  96B9xxxxxxxx                   sub.l vp_y,d3              ; Subtract our Y viewpoint.
17046  0000D842  222E000C                       move.l 12(a6),d1           ; Get the Z position from our object.
17047  0000D846  92B9xxxxxxxx                   sub.l vp_z,d1              ; Subtract our X viewpoint.
17048  0000D84C  6B00ED5C                       bmi rrts                   ; Skip if not visible.
17049  0000D850  302E001C                       move 28(a6),d0             ; Get orientation of object.
17050  0000D854  C0BC000000FF                   and.l #$ff,d0              ; Use only the least significant bytes.
17051  0000D85A  4ED0                           jmp (a0)                   ; Call the objects draw routine.
17052                                                               ; The draw routine returns to 'dpoloop'.
17053                                       
17054                                   ; *******************************************************************
17055                                   ; draw2polyos
17056                                   ; traverse the priority list, draw the objects on p1's web, then traverse it backwards to draw the objects on p2's web
17057                                   ; *******************************************************************
17058                                   draw2polyos:
17059  0000D85C  23FC0000008000F03EFC           move.l #96+32,xcent
17060  0000D866  7C78                           move.l #120,d6
17061  0000D868  DC79xxxxxxxx                   add palfix2,d6             ; Adjust for PAL screens if required.
17062  0000D86E  23C600F03EF8                   move.l d6,ycent
17063  0000D874  4279xxxxxxxx                   clr h2hor
17064  0000D87A  2079xxxxxxxx                   move.l apriority,a0
17065  0000D880  B1FCFFFFFFFF                   cmp.l #-1,a0
17066  0000D886  6700ED22                       beq rrts                   ; End of list was reached
17067                                   d2poloop:
17068  0000D88A  2C50                           move.l (a0),a6             ; Get object handle
17069  0000D88C  2016                           move.l (a6),d0
17070  0000D88E  2F08                           move.l a0,-(a7)            ; Stash some values in the stack so we can restore them later.
17071  0000D890  618A                           bsr podraw                 ; Go do object type draw
17072  0000D892  4EB9xxxxxxxx                   jsr gpuwait                ; Wait for the GPU to finish.
17073  0000D898  205F                           move.l (a7)+,a0            ; Restore stashed values from the stack.
17074  0000D89A  20280008                       move.l 8(a0),d0
17075  0000D89E  6B00xxxx                       bmi travback
17076  0000D8A2  2040                           move.l d0,a0               ; next Object
17077  0000D8A4  60E4                           bra d2poloop
17078                                   travback:
17079  0000D8A6  23FC0000010000F03EFC           move.l #288-32,xcent
17080  0000D8B0  33FC0001xxxxxxxx               move #1,h2hor
17081                                   tback:
17082  0000D8B8  2C50                            move.l (a0),a6            ; Get object handle
17083  0000D8BA  2016                           move.l (a6),d0
17084  0000D8BC  2F08                           move.l a0,-(a7)            ; Stash some values in the stack so we can restore them later.
17085  0000D8BE  6100xxxx                       bsr r_podraw               ; Go do object type draw
17086  0000D8C2  4EB9xxxxxxxx                   jsr gpuwait                ; Wait for the GPU to finish.


                                        src/yak.s            Page 322     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


17087  0000D8C8  205F                           move.l (a7)+,a0            ; Restore stashed values from the stack.
17088  0000D8CA  2F280004                       move.l 4(a0),-(a7)         ; next object or -1
17089  0000D8CE  6100xxxx                       bsr bunlinkprior           ; kill this object
17090  0000D8D2  205F                           move.l (a7)+,a0            ; Restore stashed values from the stack.
17091  0000D8D4  B1FCFFFFFFFF                   cmpa.l #-1,a0
