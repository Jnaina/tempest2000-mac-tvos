 1309  00000800  41F900F03F60                   lea in_buf,a0              ; Point our GPU RAM input buffer at a0.
 1310  00000806  20B9xxxxxxxx                   move.l cscreen,(a0)        ; scar->a1_n: source screen is already-displayed screen
 1311  0000080C  217C000001800004               move.l #384,4(a0)          ; scar->d_width: Put full screen width in GPU input buffer.
 1312  00000814  203C000000F0                   move.l #240,d0             ; Set full screen height.
 1313  0000081A  D079xxxxxxxx                   add palfix1,d0             ; Adjust for PAL
 1314  00000820  21400008                       move.l d0,8(a0)            ; scar->d_height:  Put height in input buffer.
 1315  00000824  217C000001EC000C               move.l #$1ec,12(a0)        ; scar->x_scale:  Put X scale in GPU input buffer.
 1316  0000082C  217C000001EC0010               move.l #$1ec,16(a0)        ; scar->y_scale:  Put Y scale in GPU inputbuffer.
 1317  00000834  217C000000000014               move.l #0,20(a0)           ; scar->angle:  Put initial angle in brads in GPU input buffer.
 1318  0000083C  217C00C000000018               move.l #$c00000,24(a0)     ; scar->x1_n:  Put x centre  postion in GPU input buffer.
 1319  00000844  203C00780000                   move.l #$780000,d0         ; Set Y centre.
 1320  0000084A  D0B9xxxxxxxx                   add.l palfix3,d0           ; Adjust for PAL
 1321  00000850  2140001C                       move.l d0,28(a0)           ; scar->y1_n:  Add y centre  to CPU input buffer.
 1322  00000854  217C000000000020               move.l #$0,32(a0)          ; scar->x2_n,y2_n:  offset of dest rectangle in input buffer
 1323  0000085C  2179xxxxxxxx0024               move.l delta_i,36(a0)      ; scar->delta:  change of i per increment in input buffer
 1324  00000864  23FC0000000200F03FFC           move.l #2,gpu_mode         ; Select 'scar' in antelope.gas. op 2 of this module is Scale and Rotate
 1325  0000086E  207Cxxxxxxxx                   move.l #demons,a0          ; Load the GPU module in antelope.gas.
 1326  00000874  4EB9xxxxxxxx                   jsr gpurun                 ; Run the selected GPU module.
