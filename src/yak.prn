 3585                                   ; *******************************************************************
 3586                                   ; oselector
 3587                                   ; Process selection of options in the option screen.
 3588                                   ; A 'routine' routine.
 3589                                   ; *******************************************************************
 3590                                   oselector:
 3591                                           ; Are we on the 'Select Game to Play' screen?
 3592  0000276A  0CB9xxxxxxxxxxxxxxxx           cmp.l #option1,the_option   ; Are we on 'Select Game to Play?'
 3593  00002774  6600xxxx                       bne selector               ; If not, check if we're on the 'Options' screen itself.
 3594                                       
 3595                                           ; We're on the 'Select Game to Play' screen, so
 3596                                           ; check if the cheat combination of 'a147' has been pressed!
 3597  00002778  2039xxxxxxxx                   move.l pad_now,d0          ; Get pressed buttons.
 3598  0000277E  C0BC200E0000                   and.l #a147,d0             ; Check for cheat combo.
 3599  00002784  B0BC200E0000                   cmp.l #a147,d0             ; Cheat combo selected?
 3600  0000278A  6600xxxx                       bne nchen                  ; No, skip.
 3601  0000278E  4A79xxxxxxxx                   tst chenable               ; Is cheating already enabled?
 3602  00002794  6600xxxx                       bne nchen                  ; No, skip.
 3603  00002798  33FC0001xxxxxxxx               move #1,chenable           ; Enable cheating!
 3604  000027A0  4EB9xxxxxxxx                   jsr sayex                  ; say Excellent for cheat-enable
 3605                                       
 3606                                           ; Still on the 'Game to Play' screen, check if the player has
 3607                                           ; pressed the 'Option' Button.
 3608  000027A6  08390001xxxxxxxx       nchen:  btst.b #1,pad_now+2        ; Was the option button pressed?
 3609  000027AE  6700xxxx                       beq selector               ; If not, check if we're on the 'Options' screen already.
 3610  000027B2  33FC0001xxxxxxxx               move #1,optpress           ; Signal option button was pressed.
 3611  000027BA  23FCxxxxxxxxxxxxxxxx           move.l #rrts,routine       ; And exit now.
 3612  000027C4  4E75                           rts
 3613                                       
 3614                                           ; Are we on the 'Options' screen?
 3615                                   selector:
 3616  000027C6  0CB9xxxxxxxxxxxxxxxx           cmp.l #option2,the_option   ; Are we on the 'Options' screen?
 3617  000027D0  6600xxxx                       bne selector2              ; If not, skip.
 3618  000027D4  08390006xxxxxxxx               btst.b #6,sysflags         ; Are controllers enabled?
 3619  000027DC  6600xxxx                       bne sopt2
 3620  000027E0  08390004xxxxxxxx               btst.b #4,pad_now
 3621  000027E8  6700xxxx                       beq selector2
 3622  000027EC  08390004xxxxxxxx               btst.b #4,pad_now+4
 3623  000027F4  6700xxxx                       beq selector2
 3624  000027F8  08F90006xxxxxxxx               bset.b #6,sysflags         ; Enable controllers.
 3625  00002800  4EB9xxxxxxxx                   jsr sayex                  ; Say 'Excellent!'.
 3626                                       
 3627                                           ;  Controllers are enabled, make them selectable.
 3628  00002806  23FCxxxxxxxxxxxxxxxx   sopt2:  move.l #o2s3,option2+16
 3629  00002810  33FC0002xxxxxxxx               move #2,selectable
