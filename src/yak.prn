15517                                   ;
15518                                   ; *******************************************************************
15519                                   MakeUnScaledObject:
15520  0000C49E  2C08                           move.l a0,d6
15521  0000C4A0  CC7C001F                       and #$1f,d6                ; check for aligned
15522  0000C4A4  6700xxxx                       beq muso
15523  0000C4A8  2C08                           move.l a0,d6
15524  0000C4AA  CCBC00FFFFE0                   and.l #$ffffe0,d6
15525  0000C4B0  2046                           move.l d6,a0
15526  0000C4B2  41E80020                       lea 32(a0),a0              ; make it aligned
15527                                       
15528                                           ; Now the funky bit. Build an unscaled bitmapped object.
15529                                           ; We are now on a quadphrase boundary too.
15530                                       
15531  0000C4B6  2C09                   muso:   move.l a1,d6               ; get copy of data pointer
15532  0000C4B8  CCBCFFFFFFF8                   and.l #$fffffff8,d6        ; lose three LSB's
15533  0000C4BE  E18E                           lsl.l #8,d6                ; move to correct bit position
15534  0000C4C0  20C6                           move.l d6,(a0)+            ; put it in the list
15535  0000C4C2  4DEC0020                       lea 32(a4),a6
15536  0000C4C6  2C0E                           move.l a6,d6               ; get back link-pointer
15537  0000C4C8  EB8E                           lsl.l #5,d6                ; make it aligned OK (bott. 3 bits are 0)
15538  0000C4CA  4846                           swap d6                    ; get top word of the address..
15539  0000C4CC  8D68FFFE                       or d6,-2(a0)               ; and or it into place on the previous word.


                                        src/yak.s            Page 294     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


15540                                       
15541                                           ; That's the first longword done, and the remaining byte of the
15542                                           ; link address is in d6 high already.
15543                                       
15544  0000C4D0  7E00                           move.l #0,d7               ; make d7 empty
15545  0000C4D2  3E04                           move d4,d7                 ; get a copy of the height...
15546  0000C4D4  E49F                           ror.l #2,d7                ; put 2 lowest bits in hi word...
15547  0000C4D6  4846                           swap d6                    ; get back rest of link
15548  0000C4D8  CC7CFF00                       and #$ff00,d6
15549  0000C4DC  8C47                           or d7,d6                   ; OR in top 8-bits of height..
15550  0000C4DE  30C6                           move d6,(a0)+              ; top word now completed..
15551  0000C4E0  4847                           swap d7                    ; get 2 lowest bits of height at top of d7..
15552  0000C4E2  3C01                           move d1,d6                 ; copy of Y pos..
15553  0000C4E4  E74E                           lsl #3,d6                  ; align...
15554  0000C4E6  8C47                           or d7,d6                   ; mask in those 2 bits of height..
15555  0000C4E8  30C6                           move d6,(a0)+              ; ..which completes the first phrase.
15556                                       
15557                                           ; Now on to the next phrase.
15558                                       
15559  0000C4EA  4258                           clr (a0)+                  ; assume Firstpix=0, RELEASE not asserted
15560  0000C4EC  3E02                           move d2,d7                 ; get INDEX
15561  0000C4EE  EF4F                           lsl #7,d7                  ; align it
15562  0000C4F0  7C00                           move.l #0,d6               ; empty d6
15563  0000C4F2  3C03                           move d3,d6                 ; get X size in phrases
15564  0000C4F4  E89E                           ror.l #4,d6                ; shift low 4 bits into hi word
15565  0000C4F6  0886000F                       bclr #15,d6                ; unset transparency
15566  0000C4FA  8C47                           or d7,d6                   ; mask in Index
15567  0000C4FC  30C6                           move d6,(a0)+              ; ignores Reflect, RMW
