12019                                       
12020                                   is_spike:
12021  00009AC6  2444                           move.l d4,a2
12022  00009AC8  B46A0024                       cmp 36(a2),d2              ; compare length of indicated spike with current shortest
12023  00009ACC  6D00xxxx                       blt nxtspik                ; not as short, ignore
12024  00009AD0  264A                           move.l a2,a3               ; save the address of the shorter spike
12025  00009AD2  342A0024                       move 36(a2),d2             ; make it the current shortest
12026                                       
12027                                   nxtspik:
12028  00009AD6  41E80004                       lea 4(a0),a0               ; next spiketable entry
12029  00009ADA  D07C0001                       add #1,d0
