11892                                       
11893  000098E8  0C79FFFExxxxxxxx               cmp #-2,wave_tim           ; are we zooming?
11894  000098F0  6600xxxx                       bne rspik1
11895  000098F4  0CB9xxxxxxxxxxxxxxxx           cmp.l #zoom1,routine
