14269                                   ; ***************************************************************
14270                                   ; The game's main loop
14271                                   ; It handles all the GPU/Blitter drawing. It lets the 'Frame' routine
14272                                   ; look after updates to the objects' state so the only concern here is
14273                                   ; doing all the GPU/drawing operations.
14274                                   ; The loops runs until the player loses a life or completes a game, at
14275                                   ; which point control returns to 'dloop'.
14276                                   ;
14277                                   ; Minter:
14278                                   ; "This loop runs the GPU/Blitter code.  I found that if you
14279                                   ; started up the GPU/Blitter pair from inside the FRAME
14280                                   ; Interrupt, the system would fall over if they got really heavily
14281                                   ; loaded.  MAINLOOP just waits for a sync from the FRAME routine,
14282                                   ; launches the GPU, then loops waiting for another sync."
14283                                   ; ***************************************************************
14284                                   mainloop:
14285  0000B660  33FC0001xxxxxxxx               move #1,sync               ; Reset the sync
14286  0000B668  33FC0001xxxxxxxx               move #1,screen_ready       ; Signal to 'Frame' that we have a screen ready for display
14287  0000B670  33F9xxxxxxxxxxxxxxxx           move pauen,_pauen          ; Reset the pause indicator.
14288                                       
14289  0000B67A  4A79xxxxxxxx           main:   tst sync                   ; loop waiting for another sync
14290  0000B680  66F8                           bne main                   ; from the interrupt in 'Frame'
14291                                       
14292  0000B682  33FC0001xxxxxxxx               move #1,sync               ; reset the sync so that we wait for a new frame next time around.
14293  0000B68A  23F9xxxxxxxx00F03FF8           move.l dscreen,gpu_screen   ; Use dscreen as the screen that GPU will draw everything to.
14294                                       
14295  0000B694  2079xxxxxxxx                   move.l mainloop_routine,a0   ; do the actual mainloop work, mainloop_routine
14296  0000B69A  4E90                           jsr (a0)                   ; is usually a reference to the 'draw_objects' routine.
14297                                       
14298  0000B69C  4A79xxxxxxxx                   tst z                      ; Is 'z' (stop everything) set?
14299  0000B6A2  6600xxxx                       bne rax                    ; If it is, then just loop again.
14300                                       
14301  0000B6A6  2039xxxxxxxx                   move.l s_routine,d0        ; Do we have an s_routine?
14302  0000B6AC  6700xxxx                       beq mloop                  ; If not, check if we're paused.
14303                                       
14304  0000B6B0  4A79xxxxxxxx                   tst auto                   ; Are we in demo mode?
14305  0000B6B6  6700xxxx                       beq nauty                  ; If not, then run the s_routine and continue.
14306                                       
14307  0000B6BA  42B9xxxxxxxx                   clr.l s_routine            ; Clear s_routine.


                                        src/yak.s            Page 272     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


14308  0000B6C0  33FC0001xxxxxxxx               move #1,z                  ; Set the 'stop everything' mode.
14309  0000B6C8  4279xxxxxxxx                   clr _pauen                 ; Disable pause.
14310  0000B6CE  23FCxxxxxxxxxxxxxxxx           move.l #rrts,routine       ; Clear the 'routine' pointer.
14311  0000B6D8  4279xxxxxxxx                   clr term                   ; Clear lost life/game completed signal.
14312  0000B6DE  4E75                           rts                        ; Return.
14313                                       
14314  0000B6E0  2040                   nauty:  move.l d0,a0               ; Move s_routine pointer to a0.
14315  0000B6E2  4E90                           jsr (a0)                   ; Run it.
14316  0000B6E4  42B9xxxxxxxx                   clr.l s_routine            ; Clear it.
14317                                       
14318  0000B6EA  4A79xxxxxxxx           mloop:  tst pawsed                 ; Are we paused?
14319  0000B6F0  6700xxxx                       beq mlooo                  ; If not, check if we just unpaused.
14320  0000B6F4  4EB9xxxxxxxx                   jsr paustuff               ; Do the pause mode stuff.
14321                                       
14322  0000B6FA  4A79xxxxxxxx           mlooo:  tst unpaused               ; Did we just unpause?
14323  0000B700  6700xxxx                       beq nunpa2                 ; If not, prepare to loop back again.
14324                                       
14325  0000B704  4EB9xxxxxxxx                   jsr eepromsave             ; Save the current settings to EEPROM, not sure why.
14326  0000B70A  4279xxxxxxxx                   clr unpaused               ; We're fully unpaused now.
14327                                       
14328                                           ; We've finished preparing dscreen, so we can set screen_ready.
14329  0000B710  33FC0001xxxxxxxx       nunpa2: move #1,screen_ready       ; Set screen_ready so 'Frame' can use it at the next vsync interrupt.
14330  0000B718  4A79xxxxxxxx                   tst term                   ; Have we lost a life or completed the game?
14331  0000B71E  6700FF5A                       beq main                   ; If not, continue looping.
14332                                       
14333                                           ; We've terminated - so bail.
14334  0000B722  4279xxxxxxxx           rax:    clr _pauen                 ; Prevent pausing?
14335  0000B728  23FCxxxxxxxxxxxxxxxx           move.l #rrts,routine       ; Clear the routine pointer.
14336  0000B732  4279xxxxxxxx                   clr term                   ; Clear term
14337  0000B738  4E75                           rts                        ; Return
14338                                       
14339                                       
14340                                   ; *******************************************************************
14341                                   ; Sync with the GPU
14342                                   ; Switch the current drawing screen to the gpu.
14343                                   ; *******************************************************************
14344  0000B73A  33FC0001xxxxxxxx       db:     move #1,sync               ; request sync
14345  0000B742  4A79xxxxxxxx           dboo:   tst sync                   ; Wait for sync to get reset
14346  0000B748  66F8                           bne dboo
14347                                           ; Move our double-buffered screen to the GPU.
14348  0000B74A  23F9xxxxxxxx00F03FF8           move.l dscreen,gpu_screen   ; current DB thang
14349  0000B754  4E75                           rts
14350                                       
