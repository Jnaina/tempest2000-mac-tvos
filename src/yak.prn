16108                                   ; *******************************************************************
16109  0000CA66  41F900F03F60           fw_ex:  lea in_buf,a0              ; Point our GPU RAM input buffer at a0.
16110  0000CA6C  20AE0004                       move.l 4(a6),(a0)          ; Put X position in GPU input buffer.
16111  0000CA70  216E00080004                   move.l 8(a6),4(a0)         ; Put X position in GPU input buffer.
16112  0000CA76  216E000C0008                   move.l 12(a6),8(a0)        ; Put X position in GPU input buffer.
16113  0000CA7C  302E0024                       move 36(a6),d0             ; Get the radius.
16114  0000CA80  C0BC000000FF                   and.l #$ff,d0              ; Keep it between 0 and 255
16115  0000CA86  E580                           asl.l #2,d0                ; Multiply it by 4.
16116  0000CA88  2140000C                       move.l d0,12(a0)           ; rad
16117  0000CA8C  217C000000000010               move.l #0,16(a0)           ; phase 1
16118  0000CA94  217C000000000014               move.l #0,20(a0)           ; phase 2
