 6793  00005640  23FC0000000600F03FFC           move.l #6,gpu_mode         ; Select 'pring' in xcamel.gas.
 6794  0000564A  41F900F03F60                   lea in_buf,a0              ; Point our GPU RAM input buffer at a0.
 6795  00005650  20FC00000014                   move.l #20,(a0)+           ; # pixels per ring
 6796  00005656  20C2                           move.l d2,(a0)+            ; Add it to our GPU RAM input buffer.
 6797  00005658  20C3                           move.l d3,(a0)+            ; Add it to our GPU RAM input buffer.
 6798  0000565A  20C1                           move.l d1,(a0)+            ; XYZ position
 6799  0000565C  3E39xxxxxxxx                   move frames,d7             ; Store frames in d7.
 6800  00005662  6100C3F0                       bsr pulser                 ; Calculate a pulse colour.
 6801  00005666  CCBC000000FF                   and.l #$ff,d6              ; Keep it between 0 and 255
 6802  0000566C  20C6                           move.l d6,(a0)+            ; colour
 6803  0000566E  302E0030                       move 48(a6),d0
 6804  00005672  4840                           swap d0                    ; Swap position of the first 2 bytes with last 2 bytes.
 6805  00005674  4240                           clr d0
 6806  00005676  20C0                           move.l d0,(a0)+            ; radius 16:16
 6807  00005678  3039xxxxxxxx                   move frames,d0             ; Stash the frame count in d0.
 6808  0000567E  C0BC000000FF                   and.l #$ff,d0              ; Keep it between 0 and 255
 6809  00005684  20C0                           move.l d0,(a0)+            ; phase
