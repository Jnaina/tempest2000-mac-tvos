 2559                                   ; *******************************************************************
 2560                                   ; draw_spulstank
 2561                                   ; Draws a pulsar, using one of the pulsar polygons in spulsars. The choice
 2562                                   ; is determined by our incrementing pulse count (pucnt).
 2563                                   ;
 2564                                   ; A member of the solids list.
 2565                                   ; A member of the 'shapes' list
 2566                                   ; Called during the draw_objects sequence as a member of the solids list.
 2567                                   ; *******************************************************************
 2568                                   draw_spulstank:


                                        src/yak.s            Page 62      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 2569  000018B2  3439xxxxxxxx                   move pucnt,d2              ; Put the pulse count in d2.
 2570  000018B8  3C39xxxxxxxx                   move frames,d6             ; Store frames in d6.
 2571  000018BE  D006                           add.b d6,d0                ; Add it to d0, which we will use as the rotation angle in drawsolidxy.
 2572  000018C0  41F9xxxxxxxx                   lea spulsars,a0            ; Point a0 at spulsars.
 2573  000018C6  C47C000F                       and #$0f,d2                ; Keep the pulse count in d2 between 0 and 15.
 2574  000018CA  E54A                           lsl #2,d2                  ; Multiply it by 4.
 2575  000018CC  22702000                       move.l 0(a0,d2.w),a1       ; Use the result to select a polygon from spulsars.
 2576  000018D0  48E7C040                       movem.l d0-d1/a1,-(a7)     ; Stash some values in the stack so we can restore them later.
 2577  000018D4  6100xxxx                       bsr drawsolidxy            ; Draw selected polygon in a1 as a solid polygon.
 2578  000018D8  4EB9xxxxxxxx                   jsr gpuwait                ; Wait for the GPU to finish.
 2579  000018DE  4CDF0203                       movem.l (a7)+,d0-d1/a1     ; Restore stashed values from the stack.
 2580  000018E2  D03C0080                       add.b #$80,d0              ; Add $80 to the rotation angle.
 2581  000018E6  6000xxxx                       bra drawsolidxy            ; Draw it as a solid polygon.
 2582                                           ; Returns
