  822           =008B7400                       pic6         EQU pic5+(640*200)   ; beasty8.cry
  823                                       
  824                                   ; *******************************************************************
  825                                   ; More constants used by the GPU
  826                                   ; *******************************************************************
  827           =00F03F00                       vpang        equ G_RAM+$f00   ; viewpoint angles
  828           =00855E80                       digits       EQU pic2+92800   ; start address of zero digit
  829           =00030000                       p_sines      equ $30000
  830           =00031000                       field1       equ $31000    ; space for the starfield
  831           =00030100                       gpu_sem      EQU $30100
  832           =00F03FFC                       gpu_mode     EQU G_RAM+$ffc
  833           =00F03FF8                       gpu_screen   EQU G_RAM+$ff8
  834           =00F03FD4                       scaler       EQU G_RAM+$fd4   ; Scale of XY 2-D point
  835           =00100000                       screen1      equ page2     ; a 16bit screen 384x200 at start of DRAM bank 1
  836           =00134800                       screen2      equ screen1+screensize   ; same again


                                        src/yak.s            Page 31      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  837           =00050000                       screen3      equ $50000
  838           =00116800                       screen4      equ screen1+$16800   ; a 256-colour screensworth
  839           =00169000                       rmwcursor    equ screen2+screensize   ; to make a RMW object, size is 48x30 16-bit pixels,
  840           =00169B40                       scoreimj     equ rmwcursor+$b40
  841           =0016AD40                       livesimj     equ scoreimj+4608
  842           =0016AE40                       screen5      equ livesimj+$100
  843           =0019F640                       xsample      equ screen5+screensize
  844           =00F03FD8                       z_max        EQU (G_RAM+$fd8)   ; Distance along Z-axis at which depth cue intensity is zero
  845           =00F03FDC                       z_top        EQU (G_RAM+$fdc)   ; Intensity value at z=1
  846           =0000006E                       webz         EQU 110
  847           =00F03F60                       in_buf       equ G_RAM+$f60
  848           =00000213                       INTPOS       equ (260*2)+11
  849           =0000003C                       TOP          equ 60        ; top of screen in halflines  (60=NTSC)
  850           =FFFFFFF8                       SIDE         equ -8
  851           =00F03FF4                       source_flags EQU (G_RAM+$ff4)
  852           =00F03FF0                       dest_flags   EQU (G_RAM+$ff0)   ; Blitter flags 4 source+dest
  853           =00F03FEC                       backg        EQU (G_RAM+$fec)
  854           =00F03FD0                       _sysflags    EQU (G_RAM+$fd0)   ; 'sysflags' copied to this when GPU is run.
  855                                       
  856                                       
  857                                   .text
  858                                   ; *******************************************************************
  859                                   ; Init
  860                                   ; Execution and Initialisation starts here.
  861                                   ; *******************************************************************
  862                                   Init:
  863  00000000  23FC0007000700F0210C           move.l #$70007,G_END       ; NEW mode
  864  0000000A  23FC0007000700F1A10C           move.l #$70007,D_END       ; NEW mode
  865  00000014  33FC010000F14000               move #$100,$f14000         ; audio on
  866  0000001C  33FC000100F000E0               move #1,INT1               ; Set up interrupts.
  867  00000024  21FCxxxxxxxx0100               move.l #dumint,$100        ; Dummy interrupt.
  868                                           ; Notice that we use a7 as our stack.
  869  0000002C  2E7Cxxxxxxxx                   move.l #stack,a7           ; Set up our stack on the a7 register.
  870  00000032  4EB9xxxxxxxx                   jsr VideoIni               ; Video initialisation.
  871                                       
  872  00000038  4EB9xxxxxxxx                   jsr InitLists              ; Initialize blist, dlist and ddlist.
  873  0000003E  2039xxxxxxxx                   move.l ddlist,d0           ; Put ddlist(which points to dlist) on the OLP
  874  00000044  33FC000000F00024               move.w #0,ODP              ; The ODP is not used.
  875  0000004C  4840                           swap d0                    ; Swap position of the first 2 bytes with last 2 bytes.
  876  0000004E  23C000F00020                   move.l d0,OLP              ; Point the Jaguar's object list at our ddlist.
  877                                       
  878  00000054  41F9xxxxxxxx                   lea romstart,a0            ; clear RAM
  879  0000005A  43F9xxxxxxxx                   lea copstart,a1            ; Point a1 at copstart.
  880                                       
  881  00000060  303Cxxxx                       move #(romend-romstart),d0
  882  00000064  E448                           lsr #2,d0                  ; moving longs
  883  00000066  22D8                   crom:   move.l (a0)+,(a1)+         ; copy var defaults to ram
  884  00000068  51C8FFFC                       dbra d0,crom
  885  0000006C  41F9xxxxxxxx                   lea zerstart,a0            ; Point a0 at zerstart.
  886                                       
  887  00000072  203Cxxxxxxxx                   move.l #(zerend-zerstart),d0
  888  00000078  E488                           lsr.l #2,d0                ; Divide by 4.
  889  0000007A  4298                   cram:   clr.l (a0)+
  890  0000007C  90BC00000001                   sub.l #1,d0
  891  00000082  6AF6                           bpl cram                   ; zero out RAM
  892                                       


                                        src/yak.s            Page 32      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  893  00000084  33FC0020xxxxxxxx               move #32,afree             ; There are 32 slots in total in the activeobjects list.
  894  0000008C  11FC000940A0                   move.b #9,intmask
  895  00000092  33FC0000xxxxxxxx               move #0,auto
  896  0000009A  33FC0003xxxxxxxx               move #3,joby
  897  000000A2  33FC000Fxxxxxxxx               move #15,t2k_max           ; Maximum level that can be selected for T2K
  898  000000AA  33FC000Fxxxxxxxx               move #15,trad_max          ; Maximum level that can be selected for Tempest classic.
  899  000000B2  4EB84040                       jsr INIT_SOUND             ; NEW Synth module
  900  000000B6  4280                           clr.l d0
  901  000000B8  323C0001                       move #1,d1
  902  000000BC  4EB8406A                       jsr SET_VOLUME
  903  000000C0  4280                           clr.l d0
  904  000000C2  323C0000                       move #0,d1
  905  000000C6  4EB8406A                       jsr SET_VOLUME
  906  000000CA  4EB9xxxxxxxx                   jsr InitBeasties           ; list of active windows
  907  000000D0  33FCFFFFxxxxxxxx               move #-1,db_on             ; Disable double-buffering.
  908  000000D8  4279xxxxxxxx                   clr modnum                 ; set no tune pending
  909  000000DE  4279xxxxxxxx                   clr lastmod
  910  000000E4  4279xxxxxxxx                   clr screen_ready           ; Signal to 'Frame' that we don't have a screen ready for display yet.
  911  000000EA  23FCFFFFFFFF00030100           move.l #-1,gpu_sem         ; GPU idle semaphore
  912  000000F4  23FC03E70213xxxxxxxx           move.l #$03e70213,pit0
  913  000000FE  23FCxxxxxxxxxxxxxxxx           move.l #rrts,routine
  914  00000108  23FCxxxxxxxxxxxxxxxx           move.l #rrts,fx
  915                                       
  916                                           ; Set up interupts
  917  00000112  4EB9xxxxxxxx                   jsr scint                  ; set intmask according to controller prefs
  918  00000118  21FCxxxxxxxx0100               move.l #Frame,$100         ; Make 'Frame' the interrupt routine.
  919  00000120  3039xxxxxxxx                   move.w n_vde,d0
  920  00000126  807C0001                       or #1,d0
  921  0000012A  33C000F0004E                   move d0,VI
  922  00000130  33F9xxxxxxxx00F00050           move pit0,PIT0
  923  0000013A  4240                           clr d0
  924  0000013C  103840A0                       move.b intmask,d0
  925  00000140  33C000F000E0                   move.w  d0,INT1            ; enable frame int
  926  00000146  40C0                           move.w  sr,d0
  927  00000148  C07CF8FF                       and.w  #$f8ff,d0
  928  0000014C  46C0                           move.w  d0,sr              ; interrupts on
  929                                       
  930  0000014E  4EB9xxxxxxxx                   jsr eepromload             ; get eeprom settings
  931  00000154  4EB9xxxxxxxx                   jsr scint                  ; Set interrupts according to controller prefs.
  932  0000015A  6100xxxx                       bsr setfires               ; set up fire buttons that were saved
