 3688                                   ; ssys


                                        src/yak.s            Page 82      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 3689                                   ; Copy sysflags to _sysflags so that the GPU can use it.
 3690                                   ; Bit 0 - Hardware Interlace On/Off
 3691                                   ; Bit 1 - Fat/Skinny Vectors
 3692                                   ; Bit 2 - Beastly Mode On/Off
 3693                                   ; Bit 3 - Rotary controller On/Off - Player 1
 3694                                   ; Bit 4 - Rotary controller On/Off - Player 2
 3695                                   ; Bit 5 - PAL On/Off
 3696                                   ; Bit 6 - Controllers On/Off
 3697                                   ; *******************************************************************
 3698                                   ssys:
 3699  000028EC  1039xxxxxxxx                   move.b sysflags,d0
 3700  000028F2  C0BC000000FF                   and.l #$ff,d0              ; Keep it between 0 and 255
 3701  000028F8  23C000F03FD0                   move.l d0,_sysflags
 3702  000028FE  4E75                           rts
 3703                                   ; *******************************************************************
 3704                                   ; optiondraw
 3705                                   ; This display the rippling atari logo in the background during option
 3706                                   ; selection.
 3707                                   ; *******************************************************************
 3708                                   optiondraw:
 3709  00002900  23FC0000000100F03FFC           move.l #1,gpu_mode         ; Select ripplewarp routine in antelope.gas
 3710  0000290A  61E0                           bsr ssys                   ; Copy GPU flags.
 3711  0000290C  203C00004220                   move.l #(PITCH1|PIXEL16|WID320),d0
 3712  00002912  23C000F03FF4                   move.l d0,source_flags
 3713  00002918  203C00004420                   move.l #(PITCH1|PIXEL16|WID384),d0
 3714  0000291E  23C000F03FF0                   move.l d0,dest_flags       ; inform GPU of source/dest screentypes
 3715  00002924  41F900F03F60                   lea in_buf,a0              ; Point our GPU RAM input buffer at a0.
 3716  0000292A  2179xxxxxxxx0004               move.l pongx,4(a0)         ; L Phase init 0
 3717  00002932  217C000040000008               move.l #$4000,8(a0)        ; L Amp
 3718  0000293A  2179xxxxxxxx000C               move.l pongy,12(a0)        ; R Phase
 3719  00002942  217C000040000010               move.l #$4000,16(a0)       ; R Amp
 3720  0000294A  217C000100000014               move.l #$10000,20(a0)      ; L step
 3721  00002952  217C000100000018               move.l #$10000,24(a0)      ; R step
 3722  0000295A  20BC00860380                   move.l #pic3+(640*11),(a0)   ; Select the atari logo in pic3 for display.
 3723  00002960  06B900010000xxxxxxxx           add.l #$10000,pongx
 3724  0000296A  06B900012000xxxxxxxx           add.l #$12000,pongy
 3725  00002974  4EB9xxxxxxxx                   jsr WaitBlit               ; Wait for the blitter to finish.
 3726  0000297A  41F9xxxxxxxx                   lea demons,a0              ; Load the GPU module in antelope.gas.
 3727  00002980  4EB9xxxxxxxx                   jsr gpurun                 ; do horizontal ripple warp
 3728  00002986  4EB9xxxxxxxx                   jsr gpuwait                ; Wait for the GPU to finish.
