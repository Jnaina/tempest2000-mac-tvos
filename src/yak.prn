15647  0000C5C4  3E00                           move d0,d7                 ; X and Y destination start
15648  0000C5C6  23C700F0220C                   move.l d7,A1_PIXEL
15649  0000C5CC  23FC0000000000F02218           move.l #0,A1_FPIXEL
15650  0000C5D6  7E01                           move.l #$1,d7
15651  0000C5D8  23C700F0221C                   move.l d7,A1_INC


