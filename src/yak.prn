 9307  0000784A  6600xxxx                       bne _lor1                  ; Wrap mode if web is circular
 9308  0000784E  9240                           sub d0,d1
 9309  00007850  6E00xxxx                       bgt lor0
 9310  00007854  6F00xxxx                       ble lor1
 9311                                   ;  bra zz
