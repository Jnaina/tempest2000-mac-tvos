14352                                   ; Unused routine.
14353                                   ; Looks like it was used to manipulate interrupts.
14354                                   ; *******************************************************************
14355                                   IServ:
14356  0000B756  0839000200F000E1               btst.b #2,INT1+1
14357  0000B75E  6700xxxx                       beq Frame                  ; if not stopobj must be Frame
14358                                           ; stop object code can go here
14359  0000B762  33FC040500F000E0               move #$405,INT1
14360  0000B76A  427900F000E2                   clr INT2
14361  0000B770  4E73                           rte
14362                                       
14363                                   ; *******************************************************************


                                        src/yak.s            Page 273     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


14364                                   ; Frame: MAIN VSYNC INTERRUPT ROUTINE
14365                                   ; This routine is responsible for updating the state of all objects in the
14366                                   ; game. It is called at every vertical sync interrupt (also known as a vertical
14367                                   ; blank).  The counterpart to this routine is 'mainloop'.  While mainloop is
14368                                   ; responsible for processing and drawing the activeobjects to screen, this routine is where the bulk
14369                                   ; of the objects get updated (run_objects) and created/inserted into the
14370                                   ; activeobjects list. The main place this happens is in the moveclaw routine,
14371                                   ; which despite its name is responsible for managing the waves of enemies too.
14372                                   ; The 'sync' and 'screen_ready' variables are used to co-ordinate the
14373                                   ; activities of the 'Frame' and 'mainloop' routines.
14374                                   ; *******************************************************************
14375                                   Frame:
14376  0000B772  48E7FCE0                       movem.l d0-d5/a0-a2,-(a7)   ; Stash values in d0-d5 and a0-a2
14377                                       
14378                                           ; Check if we're in a vertical blank or not.
14379  0000B776  303900F000E0           fr:     move INT1,d0
14380  0000B77C  3F00                           move d0,-(a7)              ; Stash some values in the stack so we can restore them later.
14381  0000B77E  08000000                       btst #0,d0                 ; Are we in a vertical blank?
14382  0000B782  6700xxxx                       beq CheckTimer             ; If not, skip everything and check for input only.
14383                                       
14384                                           ; We're in a vertical blank so can update some state.
14385                                           ; Copy the display list we built in 'blist' to 'dlist'. The
14386                                           ; display list will be used by the Objects Processor to paint
14387                                           ; the next frame. The pixel data for all the objects in the display
14388                                           ; list was generated by the most recent run of 'draw_objects' in
14389                                           ; 'mainloop'.
14390  0000B786  48E7031E                       movem.l d6-d7/a3-a6,-(a7)   ; Stash data and address registers.
14391  0000B78A  2079xxxxxxxx                   move.l blist,a0            ; Stash blist in a0.
14392  0000B790  2279xxxxxxxx                   move.l dlist,a1            ; Stash dlist in a1.
14393                                           ; Copy all bytes in blist to dlist.
14394  0000B796  7030                           move.l #$30,d0             ; 0x30 units of 4 bytes each to be copied.
14395  0000B798  22D8                   xlst:   move.l (a0)+,(a1)+         ; Copy 4 bytes from blist to dlist.
14396  0000B79A  51C8FFFC                       dbra d0,xlst               ; Keep copying until we run out of bytes.
14397                                       
14398                                           ; Build the display list for the next frame.
14399  0000B79E  6100xxxx                       bsr RunBeasties            ; build the next one
14400                                       
14401                                           ; Minter: "this code writes the proper screen address to double buffered objects in the display list."
14402                                           ; In 'main_loop' we prepare dscreen (double-buffered screen) with objects drawn by the GPU/Blitter. Once it's ready
14403                                           ; we set screen_ready. Here we check if screen_ready is set and if so, we swap dscreen into
14404                                           ; 'cscreen' (current screen). We will then update the main screen object in the Display List to
14405                                           ;  reference this new address.
14406                                           ; Check if we can swap in the new screen prepared in 'mainloop'.
14407  0000B7A2  4A79xxxxxxxx           setdb:  tst screen_ready           ; has 'mainloop' finished preparing a new screen?
14408  0000B7A8  6700xxxx                       beq no_new_screen          ; If no, go to no_new_screen.
14409  0000B7AC  4A79xxxxxxxx                   tst sync                   ; Has mainloop signalled it safe to swap screens?
14410  0000B7B2  6700xxxx                       beq no_new_screen          ; If no, go to new_screen.
14411                                       
14412                                           ; Swap dscreen into cscreen so that the new screen can be used in the Object List.
14413  0000B7B6  2239xxxxxxxx                   move.l cscreen,d1          ; Stash cscreen in d1.
14414  0000B7BC  23F9xxxxxxxxxxxxxxxx           move.l dscreen,cscreen     ; Overwrite cscreen with dscreen.
14415  0000B7C6  23C1xxxxxxxx                   move.l d1,dscreen          ; Overwrite dscreen with stashed cscreen.
14416  0000B7CC  4279xxxxxxxx                   clr screen_ready           ; Signal that a new screen is required before we come here again.
14417  0000B7D2  4279xxxxxxxx                   clr sync                   ; Signal to mainloop it can build a new screen.
14418                                       
14419                                           ; Check if we have a new screen to display.


                                        src/yak.s            Page 274     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


14420                                   no_new_screen:
14421  0000B7D8  2079xxxxxxxx                   move.l dlist,a0            ; Point a0 at the display list.
14422  0000B7DE  3E39xxxxxxxx                   move db_on,d7              ; Is double-buffering enabled?
14423  0000B7E4  6B00xxxx                       bmi no_db                  ; If not, skip to warp flash.
14424                                       
14425                                           ; Update the main screen item in the Object List with the address of the new screen contained
14426                                           ; in cscreen. This has the effect of ensuring all the objects we drew with the GPU
14427                                           ; and Blitter in 'mainloop' are actually written to the screen by the Object Processor.
14428  0000B7E8  2C39xxxxxxxx           stdb:   move.l cscreen,d6          ; Get address of current displayed screen
14429  0000B7EE  CCBCFFFFFFF8                   and.l #$fffffff8,d6        ; lose three LSB's
14430  0000B7F4  E18E                           lsl.l #8,d6                ; move to correct bit position
14431  0000B7F6  2210                           move.l (a0),d1             ; get first word of the BMO
14432  0000B7F8  C2BC000007FF                   and.l #$7ff,d1             ; clear data pointer
14433  0000B7FE  8286                           or.l d6,d1                 ; mask in new pointer
14434  0000B800  2081                           move.l d1,(a0)             ; replace in OL
14435  0000B802  41E80020                       lea 32(a0),a0              ; This skips to the next object but is unnecessary since we are
14436                                                               ; only updating one item (the main screen) in the Object List with
14437                                                               ; our new screen pointer.
14438                                       
14439                                           ; Do the warp flash effect.
14440  0000B806  4EB900001212           no_db:  jsr dowf                   ; Call the warp flash effect.
14441                                       
14442                                           ; Now do some magic for NTSC displays. If this is an NTSC display we want to skip playing
14443                                           ; sounds every 5th and 6th interrupt for some reason.
14444  0000B80C  4A79xxxxxxxx                   tst pal                    ; Are we a PAL display?
14445  0000B812  6600xxxx                       bne dtoon                  ; If no, we can skip this part.
14446  0000B816  06790001xxxxxxxx               add #1,tuntime             ; Increment our visit count.
14447  0000B81E  0C790004xxxxxxxx               cmp #4,tuntime             ; Less than 4?
14448  0000B826  6F00xxxx                       ble dtoon                  ; If less than 4, go ahead and play a sound.
14449  0000B82A  0C790006xxxxxxxx               cmp #6,tuntime             ; Is it 6?
14450  0000B832  6600xxxx                       bne ntoon                  ; If not, skip playing a sound this time.
14451  0000B836  4279xxxxxxxx                   clr tuntime                ; If it is 6, reset to zero.
14452                                       
14453                                           ; Something to do with the Imagitec sound chip. Probably whether we should play
14454                                           ; a sound during the interrupt?
14455  0000B83C  4A79xxxxxxxx           dtoon:  tst modstop                ; Is sound turned off?
14456  0000B842  6600xxxx                       bne ntoon                  ; If yes, don't play a sound.
14457  0000B846  4EB84046                       jsr NT_VBL                 ; If no, play the next sound using the Imagitec sound synth.
14458                                       
14459                                           ; Do any in-game effects.
14460  0000B84A  4A79xxxxxxxx           ntoon:  tst pawsed                 ; Are we paused?
14461  0000B850  6600xxxx                       bne zial                   ; If so, skip.
14462  0000B854  06790001xxxxxxxx               add #1,frames              ; Add to the number of frames.
14463  0000B85C  2079xxxxxxxx                   move.l fx,a0               ; Stash the current 'fx' routine in a0.
14464  0000B862  4E90                           jsr (a0)                   ; Run the routine.
14465                                       
14466                                           ; 'mainloop' might be busy processing stuff in the 'activeobjects' list. If it is,
14467                                           ; we will have to skip doing anything in this frame.
14468  0000B864  4A79xxxxxxxx           zial:   tst locked                 ; Are we in the middle of adding stuff to activeobjects?
14469  0000B86A  6700xxxx                       beq doframe                ; If not, do our context-specific per-frame routine.
14470  0000B86E  6000xxxx                       bra loseframe              ; If we're busy, skip this frame.
14471                                       
14472                                           ;
14473                                           ; Perform any context specific updates for this frame.
14474                                           ; 'routine' can be any one of:
14475                                           ;  - rrts, pauson, pausing, budb, pausoff, paws, zoom1, zoomto,


                                        src/yak.s            Page 275     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


14476                                           ;    waitfor, zprev, znext, zshow, oselector, seldb, tunrun, text_o_run,
14477                                           ;    m7run, vicrun, failcount, viccount, txen, tgoto, rotate_web,
14478                                           ;    zoom3, zap_player, take_me_to_your_leader, snatch_it_away,
14479                                           ;    moveclaw, zoom2
14480                                           ;
14481                                           ; rotate_web -> moveclaw -> zoom1 -> zoom2 ->
14482                                           ; zoomto -> waitfor -> zprev -> zshow -> waitfor
14483                                           ;                   -> znext -> zshow
14484                                           ;                   -> rrts
14485                                           ; oselector ->seldb -> oselector
14486                                           ; _tunn -> tunrun ->
14487                                   doframe:
14488  0000B872  2079xxxxxxxx                   move.l routine,a0          ; Stash the current 'routine' in a0.
14489  0000B878  4E90                           jsr (a0)                   ; Run it.
14490  0000B87A  4279xxxxxxxx                   clr drawhalt               ; This is redundant, it is never set anywhere.
14491                                       
14492                                   loseframe:
14493  0000B880  6100xxxx                       bsr checkpause             ; Check if the player has requested to pause the game.
14494  0000B884  6100xxxx                       bsr domod                  ; Play a frame of music in the Imagitec synth.
14495  0000B888  08390000xxxxxxxx               btst.b #0,sysflags         ; Check for hardware interlacing.
14496  0000B890  6600xxxx                       bne chit                   ; If not enabled, skip.
14497                                       
14498                                           ; Some kind of fixing up for hardware interlace mode.
14499  0000B894  3039xxxxxxxx                   move frames,d0             ; Stash frames in d0.
14500  0000B89A  C07C0001                       and #$01,d0                ; Get the lsb.
14501  0000B89E  D07CFFF8                       add #SIDE,d0               ; Add SIDE.
14502  0000B8A2  9079xxxxxxxx                   sub palside,d0             ; Subtract PAL side.
14503  0000B8A8  33C0xxxxxxxx                   move d0,beasties           ; Store in beasties.
14504                                       
14505  0000B8AE  4CDF78C0               chit:   movem.l (a7)+,d6-d7/a3-a6   ; Restore values to data and address registers we stashed at the start.
14506                                       
14507                                           ; Check for player input.
14508                                   CheckTimer:
14509  0000B8B2  301F                           move (a7)+,d0              ; Restore stashed d0.
14510  0000B8B4  3F00                           move d0,-(a7)              ; Stash it again.
14511  0000B8B6  08000003                       btst #3,d0                 ; Do we need to check for joypad in put?
14512  0000B8BA  6700xxxx                       beq exxit                  ; No, we can exit the interrupt.
14513                                       
14514                                           ; Check for joypad input. The logic for rotary controllers was added to support
14515                                           ; the potential release of a rotary controller for the Jaguar, but this never happened.
14516                                           ; So all rotary controller logic in Tempest 2000 is unused.
14517  0000B8BE  4A79xxxxxxxx                   tst roconon                ; Is Rotary Controller enabled?
14518  0000B8C4  6600xxxx                       bne roco                   ; Yes, do the rotary controller.
14519  0000B8C8  4EB9xxxxxxxx                   jsr dopad                  ; No, check for normal joypad in put.
14520  0000B8CE  6000xxxx                       bra exxit                  ; We're done - so exit interrupt.
14521                                       
14522                                           ; Logic for reading input from the never-built and never-released rotary controller.
14523  0000B8D2  3239xxxxxxxx           roco:   move pitcount,d1
14524  0000B8D8  C27C0007                       and #$07,d1
14525  0000B8DC  6600xxxx                       bne rotonly
14526  0000B8E0  4EB9xxxxxxxx                   jsr dopad
14527                                   rotonly:
14528  0000B8E6  06790001xxxxxxxx               add #1,pitcount
14529  0000B8EE  6100xxxx                       bsr readrotary             ; Read input from the rotary controller.
14530                                       
14531                                           ; Minter: "Yeah, interrupts at 8x normal speed, go do special stuff."


                                        src/yak.s            Page 276     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


14532                                   exxit:
14533  0000B8F2  301F                           move (a7)+,d0              ; Restore stashed d0.
14534  0000B8F4  E148                           lsl #8,d0                  ; Shift left 8 bits.
14535  0000B8F6  103840A0                       move.b intmask,d0          ; Add our interrupt mask.
14536  0000B8FA  33C000F000E0                   move d0,INT1               ; Add to INT1.
14537  0000B900  33C000F000E2                   move d0,INT2               ; Add to INT2.
14538  0000B906  4CDF073F                       movem.l (a7)+,d0-d5/a0-a2   ; Restore stashed values.
14539  0000B90A  4E73                           rte                        ; Return from the interrupt.
14540                                       
14541                                   ; *******************************************************************
14542                                   ; The unused rotary controller code.
14543                                   ; *******************************************************************
14544                                   readrotary:
14545                                   ;
14546                                   ; read a Rotary Controller
14547                                       
14548  0000B90C  08390003xxxxxxxx               btst.b #3,sysflags         ; Rotary controller enabled for Player 1?
14549  0000B914  6700xxxx                       beq op2
14550  0000B918  223CF0FFFFFC                   move.l  #$f0fffffc,d1      ; d1 = Joypad data mask   (Player 1)
14551  0000B91E  74FF                           moveq.l  #-1,d2            ; d2 = Cumulative joypad reading
14552  0000B920  33FC81FE00F14000               move.w  #$81fe,JOYOUT
14553  0000B928  203900F14000                   move.l  JOYIN,d0           ; Read joypad, pause button, A button
14554  0000B92E  8081                           or.l    d1,d0              ; Mask off unused bits
14555  0000B930  E898                           ror.l  #4,d0
14556  0000B932  C480                           and.l  d0,d2               ; d2 = xxAPxxxx RLDUxxxx xxxxxxxx xxxxxxxx
14557  0000B934  4842                           swap d2                    ; Swap position of the first 2 bytes with last 2 bytes.
14558  0000B936  3002                           move d2,d0                 ; get joypad in lo byte of d0
14559                                       
14560  0000B938  43F9xxxxxxxx                   lea lstcon,a1              ; Point a1 at lstcon.
14561  0000B93E  45F9xxxxxxxx                   lea roconsens,a2           ; Point a2 at roconsens.
14562  0000B944  6100xxxx                       bsr rroco
14563  0000B948  D1B9xxxxxxxx                   add.l d0,rot_cum
14564                                       
14565  0000B94E  08390004xxxxxxxx       op2:    btst.b #4,sysflags         ; Rotary controller enabled for Player 2?
14566  0000B956  6700xxxx                       beq rrts
14567                                       
14568  0000B95A  223C0FFFFFF3                   move.l  #$0ffffff3,d1      ; d1 = Joypad data mask    (Player 2)
14569  0000B960  74FF                           moveq.l  #-1,d2            ; d2 = Cumulative joypad reading
14570  0000B962  33FC817F00F14000               move.w  #$817f,JOYOUT
14571  0000B96A  203900F14000                   move.l  JOYIN,d0           ; Read joypad, pause button, A button
14572  0000B970  8081                           or.l    d1,d0              ; Mask off unused bits
14573  0000B972  E518                           rol.b  #2,d0               ; note the size of rol
14574  0000B974  E098                           ror.l  #8,d0
14575  0000B976  C480                           and.l  d0,d2               ; d2 = xxAPxxxx RLDUxxxx xxxxxxxx xxxxxxxx
14576  0000B978  4842                           swap d2                    ; Swap position of the first 2 bytes with last 2 bytes.
14577  0000B97A  3002                           move d2,d0
14578                                       
14579  0000B97C  43F9xxxxxxxx                   lea lstcon+2,a1
14580  0000B982  45F9xxxxxxxx                   lea roconsens+4,a2
14581  0000B988  6100xxxx                       bsr rroco
14582  0000B98C  D1B9xxxxxxxx                   add.l d0,rot_cum+4
14583  0000B992  4E75                           rts
