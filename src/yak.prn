19098  0000EEAE  48E7F080                       movem.l d0-d3/a0,-(a7)     ; Stash some values in the stack.
19099  0000EEB2  3039xxxxxxxx                   move sfx,d0


                                        src/yak.s            Page 358     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


19100  0000EEB8  E748                           lsl #3,d0
19101  0000EEBA  3200                           move d0,d1                 ; copy 8x
19102  0000EEBC  E548                           lsl #2,d0                  ; d0 is 32x...
19103  0000EEBE  D041                           add d1,d0                  ; d0 is 40x, much faster than mulu
19104  0000EEC0  41F9009AC800                   lea samtab,a0              ; Point a0 at samtab.
19105  0000EEC6  41F00014                       lea 20(a0,d0.w),a0         ; point to past FX name...
19106  0000EECA  3239xxxxxxxx                   move sfx_pri,d1
19107  0000EED0  3439xxxxxxxx                   move sfx_vol,d2
19108  0000EED6  2639xxxxxxxx                   move.l sfx_pitch,d3
19109  0000EEDC  4EB8405E                       jsr PLAYFX2
19110  0000EEE0  33C0xxxxxxxx                   move d0,handl
19111  0000EEE6  4279xxxxxxxx                   clr sfx_pri                ; Set the sound's priority compared to others.
19112  0000EEEC  4279xxxxxxxx                   clr sfx_vol
19113  0000EEF2  42B9xxxxxxxx                   clr.l sfx_pitch
19114  0000EEF8  4CDF010F                       movem.l (a7)+,d0-d3/a0     ; Restore stashed values from the stack.
19115  0000EEFC  4E75                           rts
