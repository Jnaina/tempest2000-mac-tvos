 1796                                       
 1797  00000F74  08390003xxxxxxxx               btst.b #3,sysflags         ; Rotary controller enabled for Player one?
 1798  00000F7C  6700xxxx                       beq ojoj
 1799  00000F80  1039xxxxxxxx                   move.b pad_now,d0
 1800  00000F86  E718                           rol.b #3,d0                ; get button A as low bit
 1801  00000F88  C07C0001                       and #1,d0
 1802  00000F8C  1239xxxxxxxx                   move.b pad_now+2,d1
 1803  00000F92  E919                           rol.b #4,d1
