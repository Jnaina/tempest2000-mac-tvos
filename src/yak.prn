16240  0000CCD8  4240                           clr d0
16241  0000CCDA  0C6E00BE000C                   cmp #webz+80,12(a6)        ; advance to edge of Web...
16242  0000CCE0  6E00xxxx                       bgt r_o1                   ; no official action, we already did it
16243  0000CCE4  0C6E000B0036                   cmp #11,54(a6)             ; Object update routine in run_vex is 'run_pulsar'.
16244  0000CCEA  6600xxxx                       bne setxx
16245  0000CCEE  3239xxxxxxxx                   move pucnt,d1              ; Put our pulsar counter in d1.
16246  0000CCF4  C27C000F                       and #$0f,d1                ; Keep it between 0 and 15.
