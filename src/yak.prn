17622                                   insertprior:
17623  0000DF5A  26680008                       move.l 8(a0),a3
17624  0000DF5E  23CBxxxxxxxx                   move.l a3,fpriority        ; next free object to top of list
17625  0000DF64  277CFFFFFFFF0004               move.l #-1,4(a3)           ; set object's prev to -1, now our obj is off free list
17626                                       
17627  0000DF6C  B3FCFFFFFFFF                   cmp.l #-1,a1               ; first object on list special case
17628  0000DF72  6600xxxx                       bne insp1
17629  0000DF76  B5C9                           cmp.l a1,a2
17630  0000DF78  6700xxxx                       beq vfo                    ; if list header is -1, go do very-first-object
17631                                       
17632  0000DF7C  25480008               nvfo:   move.l a0,8(a2)            ; us to Next    this is Very Last Object
17633  0000DF80  214A0004                       move.l a2,4(a0)            ; him to Prev
17634  0000DF84  217CFFFFFFFF0008               move.l #-1,8(a0)           ; us to List End
17635  0000DF8C  4E75                           rts
17636                                       
17637  0000DF8E  23C8xxxxxxxx           vfo:    move.l a0,apriority
17638  0000DF94  217CFFFFFFFF0004               move.l #-1,4(a0)
17639  0000DF9C  217CFFFFFFFF0008               move.l #-1,8(a0)           ; set first object
17640  0000DFA4  4E75                           rts
17641                                       
17642  0000DFA6  0CA9FFFFFFFF0004       insp1:  cmp.l #-1,4(a1)            ; is he at the top of the lst?
17643  0000DFAE  6600xxxx                       bne gencase                ; nope
17644  0000DFB2  23C8xxxxxxxx                   move.l a0,apriority        ; set us as the first object
17645  0000DFB8  26690004                       move.l 4(a1),a3
17646  0000DFBC  6000xxxx                       bra insp2                  ; skip setting prev coz it's top of the lst


                                        src/yak.s            Page 332     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


17647                                       
17648  0000DFC0  26690004               gencase:move.l 4(a1),a3            ; get his/our prev
17649  0000DFC4  27480008                       move.l a0,8(a3)            ; put us there
17650  0000DFC8  214B0004               insp2:  move.l a3,4(a0)            ; His prev link is now our prev link
17651  0000DFCC  23480004                       move.l a0,4(a1)            ; We are now his previous
17652  0000DFD0  21490008                       move.l a1,8(a0)            ; He is our next
17653  0000DFD4  4E75                           rts
