 9278  00007808  4246                           clr d6
 9279  0000780A  4847                           swap d7                    ; Swap position of the first 2 bytes with last 2 bytes.
 9280  0000780C  4247                           clr d7                     ; co-ordinates to 16:16 fractions
 9281  0000780E  9886                           sub.l d6,d4


