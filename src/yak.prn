11840                                   ; make_spike
11841                                   ;
11842                                   ; make a spike, in lane d0; uses a0/a1; ASSUMES SPIKE TABLE ADDRESS IN A1!
11843                                   ; *******************************************************************
11844                                   make_spike:
11845  00009834  4A79xxxxxxxx                   tst afree                  ; Are there any free slots for a new activeobject?


                                        src/yak.s            Page 228     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


11846  0000983A  6B00xxxx                       bmi rrts                   ; If not, return without doing anything.
11847  0000983E  04790001xxxxxxxx               sub #1,afree               ; Reserve the 1 slot in activeobjects we're going to us.
11848  00009846  2079xxxxxxxx                   move.l freeobjects,a0      ; Point a0 at the address to use for our new activeobject.
11849  0000984C  20B9xxxxxxxx                   move.l _spike,(a0)         ; Set index into solid polygon draw routine in 'solids': _spike.
11850  00009852  317C00BE000C                   move #webz+80,12(a0)       ; Set z position per web.
11851  00009858  4268000E                       clr 14(a0)                 ; Clear lower byte of z position.
11852  0000985C  31400010                       move d0,16(a0)             ; initial lane/webpos of this tanker
11853  00009860  E540                           asl #2,d0                  ; Multiply it by 4.
11854  00009862  2288                           move.l a0,(a1)             ; address to spike table
11855  00009864  42A8001E                       clr.l 30(a0)               ; clear Y and Z rotate
11856  00009868  317C00040022                   move #4,34(a0)             ; Draw routine in draw_vex is 'draw_spike'.
11857  0000986E  317C001E0024                   move #30,36(a0)            ; length of spike (max 120)
11858  00009874  317C008F0028                   move #143,40(a0)           ; Spikes are GREEN
11859  0000987A  317CFFFF002A                   move #-1,42(a0)            ; Standard rez x2 (so it can be longer than +128!)
11860  00009880  2149002C                       move.l a1,44(a0)           ; position in spike table
11861  00009884  317C00000034                   move #0,52(a0)             ; does not count as an enemy in the wave-end check.
11862  0000988A  317C00060036                   move #6,54(a0)             ; Object update routine in run_vex is 'run_spike'.
11863  00009890  42680014                       clr 20(a0)                 ; Set velocity to zero.
11864  00009894  4A79xxxxxxxx                   tst t2k                    ; Are we playing Tempest 2000?
11865  0000989A  6700xxxx                       beq uspike
11866  0000989E  4EB9xxxxxxxx                   jsr rannum                 ; Put a random number between 0 and d1 in d0.
11867  000098A4  B079xxxxxxxx                   cmp sflip_prob2,d0
11868  000098AA  6A00xxxx                       bpl uspike
11869  000098AE  317C00010014                   move #1,20(a0)             ; set Super Spike
11870                                   uspike:
