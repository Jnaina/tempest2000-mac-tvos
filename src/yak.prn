 3297                                           ; First do the 'Game Type' selection screen.
 3298  000022EE  23FCxxxxxxxxxxxxxxxx           move.l #option1,the_option   ; Enable 'Select Game Type' option screen.
 3299  000022F8  33FC0002xxxxxxxx               move #2,selected           ; Tempest 2000 selected by default.
 3300  00002300  4279xxxxxxxx                   clr t2k
 3301  00002306  4279xxxxxxxx                   clr webbase
 3302  0000230C  33FC000Fxxxxxxxx               move #$0f,weband
 3303  00002314  33FC0003xxxxxxxx               move #3,selectable         ; There are 4 possible options.
 3304                                           ; Player can choose: Traditional, Tempest Plus, Tempest 2000, or Tempest Duel (Head to Head).
 3305  0000231C  6100xxxx                       bsr do_choose              ; Display the selection screen for Game Type.
 3306                                       
 3307                                           ; We've chosen a game, decide what to do next.
 3308  00002320  4A79xxxxxxxx                   tst z                      ; Has the player done a hard reset?
 3309  00002326  6600xxxx                       bne fago                   ; If so, get out of here.
 3310  0000232A  4A79xxxxxxxx                   tst optpress               ; Was the option button pressed?
 3311  00002330  6600xxxx                       bne gameopt                ; If so, display options selection screen until something selected.
 3312  00002334  0C790003xxxxxxxx               cmp #3,selected            ; Was Head-to-Head selected?
 3313  0000233C  6600xxxx                       bne selse                  ; If not, go ahead and set up the game and return.
 3314                                       
 3315                                           ; More options for Head-to-Head mode.
 3316  00002340  4279xxxxxxxx                   clr selected               ; Default is first option.
 3317  00002346  33FC0002xxxxxxxx               move #2,selectable         ; There are three possible options.
 3318  0000234E  23FCxxxxxxxxxxxxxxxx           move.l #option6,the_option   ; Enable the Head-to-Head mode options.
 3319  00002358  6100xxxx                       bsr do_choose              ; Display the selection screen.
 3320                                       
 3321  0000235C  4A79xxxxxxxx                   tst z                      ; Has the player done a hard reset?
 3322  00002362  6600xxxx                       bne fago                   ; If so, get out of here.
 3323  00002366  0C790002xxxxxxxx               cmp #2,selected            ; Was 'Exit' selected?
 3324  0000236E  6700FF74                       beq dcc                    ; If so, loop back so that we can choose again.
 3325                                       
 3326                                           ; Did they select Play or Practice?
 3327  00002372  33F9xxxxxxxxxxxxxxxx           move selected,practise     ; Get what they selected: 0=full 2-player, 1=practise
 3328  0000237C  33FC0001xxxxxxxx               move #1,h2h                ; Enable head-to-head mode
 3329  00002384  4279xxxxxxxx                   clr rounds                 ; Clear the number of rounds in the match.
 3330  0000238A  4A79xxxxxxxx                   tst practise               ; Did they select 'Practise'?
 3331  00002390  6600xxxx                       bne fago                   ; If yes, we can jump to fago and start the game.
 3332  00002394  4279xxxxxxxx                   clr selected
 3333  0000239A  33FC0002xxxxxxxx               move #2,selectable         ; Three options
 3334  000023A2  23FCxxxxxxxxxxxxxxxx           move.l #option10,the_option   ; Enable the 'how many rounds' option screen.
 3335  000023AC  6100xxxx                       bsr do_choose              ; Show the screen and get a selection.
 3336                                       
 3337                                           ; THey've selected how many rounds to play.
 3338  000023B0  3039xxxxxxxx                   move selected,d0           ; Get the selection (0=1 round,1=3 rounds,2=5 rounds).
 3339  000023B6  E348                           lsl #1,d0                  ; Multiply it by 2.
 3340  000023B8  33C0xxxxxxxx                   move d0,rounds             ; Store the selection in rounds
 3341  000023BE  4279xxxxxxxx                   clr p1wins
 3342  000023C4  4279xxxxxxxx                   clr p2wins
 3343                                       
 3344  000023CA  6100xxxx               fago:   bsr fade                   ; Do a meltovision transition.
 3345  000023CE  4279xxxxxxxx                   clr selected               ; Clear selection.
 3346  000023D4  33FC0001xxxxxxxx               move #1,players            ; 1 player
 3347  000023DC  33FC001Cxxxxxxxx               move #$1c,bulland          ; Standard number of bullet slots.
 3348  000023E4  33FC0007xxxxxxxx               move #7,bullmax            ; Max number of bullets.
 3349  000023EC  33FC0001xxxxxxxx               move #1,entities           ; 1 entity: claw.
 3350  000023F4  6000xxxx                       bra xsel1                  ; Configure the game we've selected.
