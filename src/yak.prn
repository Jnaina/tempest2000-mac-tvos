 6657                                   ; *******************************************************************
 6658                                   ; sphertypes
 6659                                   ; Particulars defining each type of sphere.
 6660                                   ; Byte 0 - Rings per sphere
 6661                                   ; Byte 1 - Pixels per ring
 6662                                   ; Byte 2 - Space between pixels
 6663                                   ; Byte 3 - Twist per ring.
 6664                                   ; *******************************************************************
 6665                                   sphertypes:
 6666  00005494  00000040000000100000           dc.l $40,$10,4,8
       0000549E  000400000008           
 6667  000054A4  00000020000000080000           dc.l $20,$08,8,16
       000054AE  000800000010           
 6668  000054B4  00000010000000040000           dc.l $10,$04,16,32
       000054BE  001000000020           
 6669  000054C4  00000008000000020000           dc.l $08,$02,32,61
       000054CE  00200000003D           
 6670                                       
 6671                                       
 6672                                   ; *******************************************************************
 6673                                   ; draw_pixex
 6674                                   ; Draws a pixel based explosion.
 6675                                   ; A member of the draw_vex and solids list.
 6676                                   ; Called during the draw_objects sequence as a member of the draw_vex list.
 6677                                   ; Called during the draw_objects sequence as a member of the solids list.
 6678                                   ; *******************************************************************
 6679                                   draw_pixex:
 6680  000054D4  23FC0000000400F03FFC           move.l #4,gpu_mode         ; Use the 'rex' routine in camel.gas.
 6681  000054DE  41F900F03F60                   lea in_buf,a0              ; Point our GPU RAM input buffer at a0.
 6682  000054E4  20FC00820000                   move.l #pic,(a0)+          ; srce screen for effect
 6683  000054EA  20EE0024                       move.l 36(a6),(a0)+        ; srce start pixel address
 6684  000054EE  20EE002E                       move.l 46(a6),(a0)+        ; srce size
 6685  000054F2  202E002A                       move.l 42(a6),d0           ; Put the scale in d0.
 6686  000054F6  E480                           asr.l #2,d0                ; Divide by 4.
 6687  000054F8  20C0                           move.l d0,(a0)+            ; Add the x-scale to our GPU RAM input buffer.
 6688  000054FA  20C0                           move.l d0,(a0)+            ; Add the y-scale to our GPU RAM input buffer.
 6689  000054FC  20FC00000000                   move.l #0,(a0)+            ; Add no shear to the input buffer.
 6690  00005502  20FC00000000                   move.l #0,(a0)+
 6691  00005508  20FC00000001                   move.l #1,(a0)+            ; Add Mode 1 = Centered to input buffer.
 6692  0000550E  202E0004                       move.l 4(a6),d0            ; Get the source X position.
 6693  00005512  90B9xxxxxxxx                   sub.l vp_x,d0              ; Subtract the player/camera viewpoint X position.
 6694  00005518  20C0                           move.l d0,(a0)+            ; Add it to our GPU RAM input buffer.
 6695  0000551A  202E0008                       move.l 8(a6),d0            ; Get the object's Y position.
 6696  0000551E  90B9xxxxxxxx                   sub.l vp_y,d0              ; Subtract the player/camera viewpoint Y position.
 6697  00005524  20C0                           move.l d0,(a0)+            ; Add it to our GPU RAM input buffer.
 6698  00005526  202E000C                       move.l 12(a6),d0           ; Get the object's Z position.
 6699  0000552A  90B9xxxxxxxx                   sub.l vp_z,d0              ; Subtract the player/camera viewpoint Z position.
 6700  00005530  20C0                           move.l d0,(a0)+            ; Add it to our GPU input buffer.
 6701  00005532  41F9xxxxxxxx                   lea parrot,a0              ; Load the GPU module in camel.gas.
 6702  00005538  4EB9xxxxxxxx                   jsr gpurun                 ; do clear screen
 6703  0000553E  4EF9xxxxxxxx                   jmp gpuwait                ; Wait for the GPU to finish.
