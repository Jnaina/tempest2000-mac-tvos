 2311                                   ; s_multi
 2312                                   ; General purpose routine to draw a solid polygon.
 2313                                   ; d7 is passed by the caller to specify the number of times to draw.
 2314                                   ; d6 is the initial angle - each iteration will rotate the angle.
 2315                                   ; *******************************************************************
 2316                                   s_multi:
 2317  0000169A  48E7C040                       movem.l d0-d1/a1,-(a7)     ; Stash some values in the stack so we can restore them later.
 2318  0000169E  6100xxxx                       bsr drawsolidxy            ; Draw it as a solid polygon.
 2319  000016A2  4EB9xxxxxxxx                   jsr gpuwait                ; Wait for the GPU to finish.
 2320  000016A8  4CDF0203                       movem.l (a7)+,d0-d1/a1     ; Restore stashed values from the stack.
 2321  000016AC  D006                           add.b d6,d0                ; Add the offset in d6 to the angle in d0.
 2322  000016AE  51CFFFEA                       dbra d7,s_multi            ; Loop until d7 is 0.
 2323  000016B2  4E75                           rts
