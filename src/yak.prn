 6527                                   ; *******************************************************************
 6528                                   ; Display the One-Up graphic
 6529                                   ; This runs towards you on the Z axis just like draw_mpixex.
 6530                                   ; A member of the draw_vex list.
 6531                                   ; Called during the draw_objects sequence as a member of the draw_vex list.
 6532                                   ; *******************************************************************
 6533                                   draw_oneup:
 6534  000052CA  23FC0000000400F03FFC           move.l #4,gpu_mode         ; Select 'rex' routine in camel.gas. Multiple images stretching towards you in Z
 6535  000052D4  3E3C0000                       move #0,d7                 ; Start 'doneup' loop iterations at 0 and we will decrement down to 255.
 6536  000052D8  2C2E000C                       move.l 12(a6),d6           ; Put the object's Z in d6.
 6537  000052DC  3A3C0096                       move #150,d5               ; Starting Z point for iteration.
 6538  000052E0  9A6E002E                       sub 46(a6),d5              ; range is 0-150
 6539  000052E4  4845                           swap d5                    ; Swap position of the first 2 bytes with last 2 bytes.
 6540  000052E6  4245                           clr d5
 6541  000052E8  E48D                           lsr.l #2,d5                ; Multiply by 4.
 6542                                       


                                        src/yak.s            Page 133     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 6543                                           ; Object moves forward towards the viewer.
 6544  000052EA  41F900F03F60           doneup: lea in_buf,a0              ; Point our GPU RAM input buffer at a0
 6545  000052F0  20FC0083F400                   move.l #pic2,(a0)+         ; srce screen for effect
 6546  000052F6  20FC00000094                   move.l #$000094,(a0)+      ; srce start pixel address
 6547  000052FC  20FC00150032                   move.l #$150032,(a0)+      ; srce size
 6548  00005302  2005                           move.l d5,d0               ; Get the scale and put in d0.
 6549  00005304  E480                           asr.l #2,d0                ; Divide by 4.
 6550  00005306  20C0                           move.l d0,(a0)+            ; Put as x-scale in input buffer.
 6551  00005308  20C0                           move.l d0,(a0)+            ; Put as y-scale in input buffer.
 6552  0000530A  20FC00000000                   move.l #0,(a0)+            ; no shear
 6553  00005310  20FC00000000                   move.l #0,(a0)+
 6554  00005316  20FC00000001                   move.l #1,(a0)+            ; Mode 1 = Centered
 6555  0000531C  202E0004                       move.l 4(a6),d0            ; Get the source X position.
 6556  00005320  90B9xxxxxxxx                   sub.l vp_x,d0              ; Subtract the player/camera viewpoint X position.
 6557  00005326  20C0                           move.l d0,(a0)+            ; Add it to our GPU RAM input buffer.
 6558  00005328  202E0008                       move.l 8(a6),d0            ; Get the object's Y position.
 6559  0000532C  90B9xxxxxxxx                   sub.l vp_y,d0              ; Subtract the player/camera viewpoint Y position.
 6560  00005332  20C0                           move.l d0,(a0)+            ; Add it to our GPU RAM input buffer.
 6561  00005334  2006                           move.l d6,d0               ; Get the Z position.
 6562  00005336  90B9xxxxxxxx                   sub.l vp_z,d0              ; Subtract the player/camera viewpoint Z position.
 6563  0000533C  20C0                           move.l d0,(a0)+            ; Dest x,y,z
 6564  0000533E  41F9xxxxxxxx                   lea parrot,a0              ; Load the GPU module in camel.gas.
 6565  00005344  4EB9xxxxxxxx                   jsr gpurun                 ; do clear screen
 6566  0000534A  4EB9xxxxxxxx                   jsr gpuwait                ; Wait for the GPU to finish.
 6567  00005350  9C85                           sub.l d5,d6                ; Decrement the object's z position.
 6568  00005352  6B00xxxx                       bmi rrts                   ; Once less than zero we're done.
 6569  00005356  51CFFF92                       dbra d7,doneup             ; Otherwise loop again a max of 256 times.
 6570                                       
 6571  0000535A  DC85                           add.l d5,d6
 6572  0000535C  DC85                           add.l d5,d6
 6573  0000535E  3E3C0005                       move #5,d7                 ; A maximum of 5 iterations.
 6574                                       
 6575                                           ; Object retreats back again away from the viewer.
