 1762  00000F2C  D23C0030               gadig:  add.b #'0',d1
 1763  00000F30  10C1                           move.b d1,(a0)+
 1764  00000F32  1219                           move.b (a1)+,d1
 1765  00000F34  51C8FFF6                       dbra d0,gadig
 1766  00000F38  4E75                           rts
