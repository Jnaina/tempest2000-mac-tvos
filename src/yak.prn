16201  0000CC26  6A00xxxx                       bpl zzonk
16202  0000CC2A  13F9xxxxxxxxxxxxxxxx           move.b pudel+1,pudel
16203  0000CC34  06790001xxxxxxxx               add #1,pucnt               ; Increment our pulsar counter.
16204  0000CC3C  0279000Fxxxxxxxx               and #$0f,pucnt             ; Keep it between 0 and 15.
16205  0000CC44  6700xxxx                       beq clzd
16206  0000CC48  0C790007xxxxxxxx       zzonk:  cmp #7,pucnt
16207  0000CC50  6600xxxx                       bne zonk
16208  0000CC54  4A79xxxxxxxx                   tst zapdone
16209  0000CC5A  6B00xxxx                       bmi zonk
16210  0000CC5E  6700xxxx                       beq zonk
16211  0000CC62  33FCFFFFxxxxxxxx               move #-1,zapdone
16212  0000CC6A  6000xxxx                       bra zonk
16213  0000CC6E  4279xxxxxxxx           clzd:   clr zapdone
16214  0000CC74  33FC0002xxxxxxxx       zonk:   move #2,diag
16215  0000CC7C  3E3C0000                       move #0,d7                 ; use to check for wave_end
16216  0000CC80  2C3C000001F4                   move.l #500,d6             ; use to find the nearest enemy, for the Droid's brain
16217  0000CC86  2C79xxxxxxxx                   move.l activeobjects,a6    ; Point a6 at the activeobjects list.
16218  0000CC8C  4279xxxxxxxx                   clr _sz                    ; Stop superzapper running.
16219  0000CC92  4A79xxxxxxxx                   tst szap_on                ; Is supersapper on?
16220  0000CC98  6700xxxx                       beq r_obj                  ; If not, process our activeobjects.
16221                                       
16222  0000CC9C  3039xxxxxxxx                   move frames,d0             ; Stash the frame count in d0.
16223  0000CCA2  C07C0003                       and #3,d0                  ; Can we enable superzapper?
16224  0000CCA6  6600xxxx                       bne r_obj                  ; If not, skip to rest of objects.
16225  0000CCAA  33FC0001xxxxxxxx               move #1,_sz                ; Kill something please... make superzapper active.
16226                                       
