 9466                                   ; *******************************************************************
 9467                                   ; make_bits
 9468                                   ; Make the vector based objects.
 9469                                   ; If an object uses of one of these it contains the address to it in the
 9470                                   ; the first four bytes of the object's entry in the activeobjects list.
 9471                                   ; They can be drawn directly by the GPU in the 'vector' routine.
 9472                                   ; THe alternative is to use a solid polygon routine in the 'solids' list.
 9473                                   ; *******************************************************************
 9474                                   make_bits:
 9475  00007A64  7000                           move.l #$00,d0             ; parameters for object - XYZ scale...
 9476  00007A66  7201                           move.l #$01,d1
 9477  00007A68  7401                           move.l #$01,d2
 9478  00007A6A  7600                           move.l #0,d3               ; ..local centre x,y,z...
 9479  00007A6C  7800                           move.l #0,d4
 9480  00007A6E  7A00                           move.l #0,d5
 9481  00007A70  4286                           clr.l d6
 9482  00007A72  4247                           clr d7
 9483  00007A74  43F9xxxxxxxx                   lea ev,a1                  ; Point a1 at ev.
 9484  00007A7A  48E7FF00                       movem.l d0-d7,-(a7)        ; Stash some values in the stack so we can restore them later.
 9485  00007A7E  6100xxxx                       bsr make_vo3d
 9486  00007A82  4CDF00FF                       movem.l (a7)+,d0-d7        ; Restore stashed values from the stack.
 9487  00007A86  23C8xxxxxxxx                   move.l a0,_ev
 9488                                       
 9489  00007A8C  43F9xxxxxxxx                   lea la_routine,a1
 9490  00007A92  48E7FF00                       movem.l d0-d7,-(a7)        ; Stash some values in the stack so we can restore them later.
 9491  00007A96  6100xxxx                       bsr make_vo3d
 9492  00007A9A  4CDF00FF                       movem.l (a7)+,d0-d7        ; Restore stashed values from the stack.
 9493  00007A9E  23C8xxxxxxxx                   move.l a0,_la
 9494                                       
 9495  00007AA4  43F9xxxxxxxx                   lea pu,a1                  ; Point a1 at pu.
 9496  00007AAA  48E7FF00                       movem.l d0-d7,-(a7)        ; Stash some values in the stack so we can restore them later.
 9497  00007AAE  6100xxxx                       bsr make_vo3d
 9498  00007AB2  4CDF00FF                       movem.l (a7)+,d0-d7        ; Restore stashed values from the stack.
 9499  00007AB6  23C8xxxxxxxx                   move.l a0,_pu
 9500                                       
 9501  00007ABC  7000                           move.l #$00,d0             ; parameters for object - XYZ scale...
 9502  00007ABE  7201                           move.l #$01,d1
 9503  00007AC0  7401                           move.l #$01,d2
 9504  00007AC2  7609                           move.l #9,d3               ; ..local centre x,y,z...
 9505  00007AC4  7809                           move.l #9,d4


