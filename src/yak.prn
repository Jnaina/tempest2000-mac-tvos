 1735                                   ; *******************************************************************
 1736                                   ; setcsmsg
 1737                                   ; Populate the bonus score, e.g. BONUS 00001000
 1738                                   ; *******************************************************************
 1739                                   setcsmsg:
 1740  00000EF8  41F9xxxxxxxx                   lea csmsg1,a0              ; Point a0 at the "0000000 BONUS" message.
 1741  00000EFE  2279xxxxxxxx                   move.l score,a1            ; Point a1 at the score.
 1742                                       
 1743                                           ; Iterate through the digits of the score message, updating
 1744                                           ; as required.
 1745  00000F04  303C0007                       move #7,d0
 1746  00000F08  1219                   sstb:   move.b (a1)+,d1            ; Put current digit in d1.
 1747  00000F0A  6600xxxx                       bne gotadig                ; Go to gotadig if non-zero,
 1748                                       
 1749  00000F0E  10FC0030                       move.b #'0',(a0)+          ; It's a zero. Put a zero in the score message.
 1750  00000F12  51C8FFF4                       dbra d0,sstb               ; Keep looping for all 7 digits.
 1751                                       
 1752  00000F16  41E8FFFE                       lea -2(a0),a0
 1753  00000F1A  23C8xxxxxxxx                   move.l a0,csmsg
 1754  00000F20  10BC006E                       move.b #'n',(a0)
 1755  00000F24  4E75                           rts
 1756                                       
 1757                                   ; *******************************************************************
 1758                                   ; gotadig
 1759                                   ; *******************************************************************
 1760                                   gotadig:
