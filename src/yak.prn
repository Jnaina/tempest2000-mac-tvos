15830                                   ; *******************************************************************
15831                                   ; make_vo3d
15832                                   ;
15833                                   ; make a 3d vector object at a0, using the short data at (a1)
15834                                   ;
15835                                   ; d0.l=x scale, d1.l=y scale, d2.l=z scale, d3.l=x centre, d4.l=y centre,
15836                                   ; d5.l=z centre, d6=angle (xy)/angle (xz), d7=angle (yz)
15837                                   ;
15838                                   ; Makes a 48-byte header which is copied to GPU local RAM when the object is
15839                                   ; drawn (I guess the techies would call it an instance)
15840                                   ;
15841                                   ; This routines process a vertex list defining objects for drawing.
15842                                   ;
15843                                   ; Each vertex group in the list has the components:
15844                                   ;   - x,y,z
15845                                   ;   - a list of connected vertices terminated with a 0
15846                                   ;     or
15847                                   ;     -1 followed by the value of the color to use when drawing
15848                                   ;
15849                                   ; Each array terminates with a 0.
15850                                   ;
15851                                   ; So for example, 'shot' breaks down as follows:
15852                                   ; 8,7,1   = x,y,z
15853                                   ; 2       = Connected to vertex  with index 2 (i.e. 10,11,1).
15854                                   ; 0       = End of vertex group
15855                                   ;
15856                                   ; 10,11,1 = x,y,z
15857                                   ; 0       = End of vertex group
15858                                   ;
15859                                   ; 10,7,1  = x,y,z
15860                                   ; 4       = Connected to vertex with index 4 (i.e. 8,11,1)
15861                                   ; 0       = End of vertex group
15862                                   ;
15863                                   ; and so on.
15864                                   ;
15865                                   ; An example with a color command is:
15866                                   ;   dc.b 7,8,1,-1,255,9,19,0
15867                                   ; This breaks down as:
15868                                   ; 7,8,1   = x,y,z
15869                                   ; -1      = Need to change color
15870                                   ; 255     = New color value to use when drawing lines
15871                                   ; 9       = Connected to vertex with index 9.
15872                                   ; 19      = Connected to vertex with index 19.
15873                                   ; 0       = End of vertex group
15874                                   ; *******************************************************************
15875                                   make_vo3d:


                                        src/yak.s            Page 300     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


15876  0000C7CC  2079xxxxxxxx                   move.l vadd,a0
15877  0000C7D2  2F08                           move.l a0,-(a7)            ; Stash some values in the stack so we can restore them later.
15878  0000C7D4  6100xxxx                       bsr initvo
15879  0000C7D8  383C0000                       move #$0,d4                ; use this for colour-info
15880                                       
15881                                           ; Get the x,y,z co-ordinates of a single point
15882  0000C7DC  343C0002               buildit:move #2,d2                 ; loop for three items..
15883  0000C7E0  1019                   b3d1:   move.b (a1)+,d0            ; X
15884  0000C7E2  6700xxxx                       beq builtit                ; zero means last vertex
15885  0000C7E6  C0BC000000FF                   and.l #$ff,d0              ; Keep it between 0 and 255
15886  0000C7EC  24C0                           move.l d0,(a2)+            ; put it in the vertex list
15887  0000C7EE  51CAFFF0                       dbra d2,b3d1               ; get x,y and z
15888                                       
15889  0000C7F2  1011                           move.b (a1),d0             ; test for zero connections from this point
15890  0000C7F4  6600xxxx                       bne dcnc
15891  0000C7F8  43E90001                       lea 1(a1),a1
15892  0000C7FC  6000xxxx                       bra nxtvrt
15893                                       
15894  0000C800  36C3                   dcnc:   move d3,(a3)+              ; vertex # to connect list
15895  0000C802  1019                   cnect:  move.b (a1)+,d0            ; get connected vertex #
15896  0000C804  6A00xxxx                       bpl stdvrt                 ; Are we setting a new color? (-1 indicates we are)
15897  0000C808  1819                           move.b (a1)+,d4            ; Yes,
15898  0000C80A  E14C                           lsl #8,d4                  ; set nu colour
15899  0000C80C  1019                           move.b (a1)+,d0
15900                                       
15901  0000C80E  C07C00FF               stdvrt: and #$ff,d0                ; Keep it between 0 and 255
15902  0000C812  6700xxxx                       beq zv
15903  0000C816  8044                           or d4,d0
15904  0000C818  36C0                   zv:     move d0,(a3)+
15905  0000C81A  66E6                           bne cnect                  ; loop until a zero
15906                                       
15907  0000C81C  5243                   nxtvrt: addq #1,d3                 ; next vertex number
15908  0000C81E  60BC                           bra buildit                ; go do next vertex
15909                                       
15910  0000C820  26FC00000000           builtit:move.l #0,(a3)+
15911  0000C826  C6BC0000FFFF                   and.l #$ffff,d3
15912  0000C82C  20C3                           move.l d3,(a0)+            ; pass # of vertices in header
15913  0000C82E  23CBxxxxxxxx                   move.l a3,connect_ptr
15914  0000C834  23CAxxxxxxxx                   move.l a2,vertex_ptr
15915  0000C83A  23C8xxxxxxxx                   move.l a0,vadd
15916  0000C840  205F                           move.l (a7)+,a0            ; Restore stashed values from the stack.
15917  0000C842  4E75                           rts
15918                                       
15919                                   ; *******************************************************************
15920                                   ; initvo
15921                                   ; Initialize a standard vector object
15922                                   ; Makes a3 point to connect_ptr
15923                                   ; *******************************************************************
15924  0000C844  2448                   initvo: move.l a0,a2
15925  0000C846  20C0                           move.l d0,(a0)+            ; x
15926  0000C848  20C1                           move.l d1,(a0)+            ; y
15927  0000C84A  20C2                           move.l d2,(a0)+            ; z scales
15928  0000C84C  20C3                           move.l d3,(a0)+            ; x
15929  0000C84E  20C4                           move.l d4,(a0)+            ; y
15930  0000C850  20C5                           move.l d5,(a0)+            ; z centres
15931                                       


                                        src/yak.s            Page 301     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


15932  0000C852  2006                           move.l d6,d0
15933  0000C854  C0BCFFFF0000                   and.l #$ffff0000,d0
15934  0000C85A  4840                           swap d0                    ; Swap position of the first 2 bytes with last 2 bytes.
15935  0000C85C  20C0                           move.l d0,(a0)+            ; angle XZ
15936  0000C85E  CCBC0000FFFF                   and.l #$ffff,d6
15937  0000C864  20C6                           move.l d6,(a0)+            ; angle XZ
15938  0000C866  CEBC0000FFFF                   and.l #$ffff,d7
15939  0000C86C  20C7                           move.l d7,(a0)+            ; angle YZ
15940                                       
15941  0000C86E  2039xxxxxxxx                   move.l vertex_ptr,d0
15942  0000C874  2679xxxxxxxx                   move.l connect_ptr,a3      ; point to vertex and connection list space
15943  0000C87A  5880                           addq.l #4,d0
15944  0000C87C  C0BCFFFFFFFC                   and.l #$fffffffc,d0        ; longalign vertex base
15945  0000C882  2440                           move.l d0,a2
15946  0000C884  20C0                           move.l d0,(a0)+            ; vertex pointer to header
15947  0000C886  200B                           move.l a3,d0
15948  0000C888  20C0                           move.l d0,(a0)+            ; connect pointer to header
15949  0000C88A  363C0001                       move #1,d3                 ; vertex number
15950  0000C88E  4E75                           rts
