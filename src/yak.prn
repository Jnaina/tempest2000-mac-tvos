 9041                                   ; *******************************************************************
 9042                                   ; circa
 9043                                   ; During level selection, set the level bonus and mutate the starfield
 9044                                   ; using the current level value.
 9045                                   ; *******************************************************************
 9046                                   circa:
 9047  000075A8  6100xxxx                       bsr slebon                 ; set level bonus
 9048                                           ; Use the current level value to alter the display of the
 9049                                           ; star field. First we use the level to adjust the sine step
 9050                                           ; in d5.
 9051  000075AC  4284                           clr.l d4
 9052  000075AE  3839xxxxxxxx                   move cwave,d4              ; Get current level
 9053  000075B4  E184                           asl.l #8,d4
 9054  000075B6  ED84                           asl.l #6,d4
 9055  000075B8  D8BC00060000                   add.l #$60000,d4
 9056  000075BE  2A04                           move.l d4,d5
 9057                                           ; Then we use it to set the sine pointer in d7.


                                        src/yak.s            Page 178     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 9058  000075C0  3039xxxxxxxx                   move cwave,d0              ; Get current level
 9059  000075C6  C07C007F                       and #$7f,d0
 9060  000075CA  D07C0040                       add #$40,d0
 9061  000075CE  3E00                           move d0,d7
 9062  000075D0  4847                           swap d7                    ; Swap position of the first 2 bytes with last 2 bytes.
 9063                                           ; Finally we render the starfield.
 9064  000075D2  6000xxxx                       bra ips                    ; Set up the starfield.
 9065                                           ; Returns
 9066                                       
 9067                                   ; *******************************************************************
 9068                                   ; slebon
 9069                                   ; Set level bonus for the current selected level.
 9070                                   ; set level bonus at 5800+(level*100)
 9071                                   ; *******************************************************************
 9072                                   slebon:
 9073  000075D6  42B9xxxxxxxx                   clr.l lbonus
 9074  000075DC  42B9xxxxxxxx                   clr.l lbonus+4
 9075  000075E2  3039xxxxxxxx                   move cwave,d0              ; Get current level
 9076  000075E8  3200                           move d0,d1
 9077  000075EA  C2FC00C8                       mulu #200,d1
 9078  000075EE  D2BC00000A28                   add.l #2600,d1
 9079  000075F4  C2C0                           mulu d0,d1
 9080  000075F6  41F9xxxxxxxx                   lea lbonus+8,a0
 9081  000075FC  2401                           move.l d1,d2
 9082  000075FE  84FC2710                       divu #10000,d2             ; d2 is highest 4 digits
 9083  00007602  C4BC0000FFFF                   and.l #$ffff,d2
 9084  00007608  3602                           move d2,d3
 9085  0000760A  C6FC2710                       mulu #10000,d3
 9086  0000760E  9283                           sub.l d3,d1
 9087  00007610  363C0003                       move #3,d3
 9088                                   xlebon:
 9089  00007614  82FC000A                       divu #10,d1
 9090  00007618  4841                           swap d1                    ; Swap position of the first 2 bytes with last 2 bytes.
 9091  0000761A  1101                           move.b d1,-(a0)
 9092  0000761C  4241                           clr d1
 9093  0000761E  4841                           swap d1                    ; Swap position of the first 2 bytes with last 2 bytes.
 9094  00007620  51CBFFF2                       dbra d3,xlebon
 9095                                   xleb2:
 9096  00007624  84FC000A                       divu #10,d2
 9097  00007628  4842                           swap d2                    ; Swap position of the first 2 bytes with last 2 bytes.
 9098  0000762A  1102                           move.b d2,-(a0)
 9099  0000762C  4242                           clr d2
 9100  0000762E  4842                           swap d2                    ; Swap position of the first 2 bytes with last 2 bytes.
 9101  00007630  4A42                           tst d2
 9102  00007632  66F0                           bne xleb2
