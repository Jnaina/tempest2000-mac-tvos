 1646  00000D90  23FC00000004xxxxxxxx           move.l #4,warp_count       ; A good stiff starf with big streaks
 1647  00000D9A  23FC00060000xxxxxxxx           move.l #$60000,vp_sfs      ; fast starfield
 1648                                       
 1649  00000DA4  4A79xxxxxxxx                   tst cwave                  ; Is the current selected wave 0?
 1650  00000DAA  6700xxxx                       beq alrzero                ; If yes, skip to alrzero.
 1651  00000DAE  04790001xxxxxxxx               sub #1,cwave               ; If not, subtract 1 from it.
 1652  00000DB6  08B90000xxxxxxxx               bclr.b #0,cwave+1          ; Clear it
 1653  00000DBE  33F9xxxxxxxxxxxxxxxx           move cwave,cweb            ; Store it as the web level too.
 1654                                       
 1655                                           ; Set ourselves up for the level selection loop.
 1656                                   alrzero:
 1657  00000DC8  4EB9xxxxxxxx                   jsr initobjects            ; Initialize the activeobjects list.
 1658  00000DCE  6100xxxx                       bsr setweb                 ; Set up the web
 1659  00000DD2  6100xxxx                       bsr circa                  ; Update the level bonus and starfield.
 1660  00000DD6  41F9xxxxxxxx                   lea _web,a0
 1661  00000DDC  203C0000019A                   move.l #300+webz,d0        ; Take the normal top of web + 300, to use as our Z position.
 1662  00000DE2  4840                           swap d0                    ; Swap position of the first 2 bytes with last 2 bytes.
 1663  00000DE4  2140000C                       move.l d0,12(a0)           ; initial Z of the web is further away than the usual
 1664  00000DE8  23FCxxxxxxxxxxxxxxxx           move.l #draw_oo,mainloop_routine
 1665  00000DF2  23FCxxxxxxxxxxxxxxxx           move.l #zoomto,routine
 1666  00000DFC  23FCxxxxxxxxxxxxxxxx           move.l #gamefx,fx
 1667  00000E06  4279xxxxxxxx                   clr db_on                  ; Enable double-buffering.
 1668  00000E0C  4279xxxxxxxx                   clr sync                   ; Signal to mainloop it can draw a new screen.
 1669  00000E12  33FC0001xxxxxxxx               move #1,screen_ready       ; Signal to 'Frame' that we have a screen ready for display.
 1670  00000E1A  4EB9xxxxxxxx                   jsr mainloop               ; Run the mainloop while the user selects the level.
 1671                                           ; Once they've finished we can do a fade transition and start the game.
