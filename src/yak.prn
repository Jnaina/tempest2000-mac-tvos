 9772                                   ; Called during the run_objects sequence as a member of the run_vex list.
 9773                                   ; *******************************************************************
 9774                                   run_h2hshot:
 9775  00007E6A  066E0003001C                   add #3,28(a6)              ; make it flicker
 9776                                   moomoomoo:
 9777  00007E70  202E0024                       move.l 36(a6),d0
 9778  00007E74  6B00xxxx                       bmi upweb
 9779  00007E78  D1AE000C                       add.l d0,12(a6)            ; Set Z position in activobject entry.
 9780  00007E7C  302E000C                       move 12(a6),d0             ; this bull's Z
 9781  00007E80  322E0010                       move 16(a6),d1
 9782  00007E84  2879xxxxxxxx                   move.l _claw,a4
 9783  00007E8A  286C0038                       move.l 56(a4),a4           ; p2's Claw
 9784  00007E8E  286C0038                       move.l 56(a4),a4           ; p1's Shield
 9785  00007E92  286C0038                       move.l 56(a4),a4           ; p2's Shield


                                        src/yak.s            Page 191     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 9786  00007E96  B06C000C                       cmp 12(a4),d0              ; check against the Shield
 9787  00007E9A  6B00xxxx                       bmi np2sh
 9788  00007E9E  4A79xxxxxxxx                   tst practise
 9789  00007EA4  6600xxxx                       bne reflshot
 9790  00007EA8  B26C0010                       cmp 16(a4),d1
 9791  00007EAC  6600xxxx                       bne np2sh                  ; check for same lane
 9792  00007EB0  4A6C0022                       tst 34(a4)                 ; is it On?
 9793  00007EB4  6700xxxx                       beq biu2
 9794                                   reflshot:
