 1806  00000F9A  08000000                       btst #0,d0
 1807  00000F9E  6600xxxx                       bne zforward
 1808  00000FA2  08000001                       btst #1,d0
 1809  00000FA6  6600xxxx                       bne zbackward
 1810  00000FAA  6000xxxx                       bra not2p
