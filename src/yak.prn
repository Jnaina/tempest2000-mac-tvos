17703                                   ; MovePrior
17704                                   ; Linked-list transfer entry from list a4 to list a3
17705                                   ; prev ptr in a1, next in a2
17706                                   ; *******************************************************************
17707                                   MovePrior:
17708  0000E068  B3FCFFFFFFFF           mprio:  cmpa.l #-1,a1              ; Prev is -1?
17709  0000E06E  6600xxxx                       bne MP1
17710  0000E072  288A                           move.l a2,(a4)             ; Make Next entry current top of list
17711  0000E074  B5C9                           cmpa.l a1,a2               ; Check if Next is -1
17712  0000E076  6700xxxx                       beq NewPLink               ; Yup, we were the only entry
17713  0000E07A  B5FCFFFFFFFF           MP1:    cmpa.l #-1,a2              ; Next link is -1?
17714  0000E080  6600xxxx                       bne MP2                    ; Nope
17715  0000E084  234A0008                       move.l a2,8(a1)            ; Make prev link-to-next -1
17716  0000E088  6000xxxx                       bra NewPLink
17717  0000E08C  B3FCFFFFFFFF           MP2:    cmpa.l #-1,a1
17718  0000E092  6700xxxx                       beq mp3
17719  0000E096  234A0008                       move.l a2,8(a1)
17720  0000E09A  25490004               mp3:    move.l a1,4(a2)            ; Link 'em up
17721                                       
17722                                   NewPLink:
17723  0000E09E  2853                           move.l (a3),a4             ; Get address of first entry of dest list
17724  0000E0A0  B9FCFFFFFFFF                   cmpa.l #-1,a4              ; Check if link is real
17725  0000E0A6  6600xxxx                       bne NP1                    ; Yup
17726  0000E0AA  2688                           move.l a0,(a3)             ; Make ourselves the first entry
17727  0000E0AC  217CFFFFFFFF0004               move.l #-1,4(a0)
17728  0000E0B4  217CFFFFFFFF0008               move.l #-1,8(a0)
17729  0000E0BC  4E75                           rts
17730  0000E0BE  217CFFFFFFFF0004       NP1:    move.l #-1,4(a0)           ; Gonna insert ourselves at the top
17731  0000E0C6  29480004                       move.l a0,4(a4)            ; We are his previous
17732  0000E0CA  214C0008                       move.l a4,8(a0)            ; And he is our next
17733  0000E0CE  2688                           move.l a0,(a3)             ; Put us in
17734  0000E0D0  4E75                           rts
