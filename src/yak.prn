 3353                                   ; *******************************************************************
 3354                                   ; gameopt
 3355                                   ; Display the Game Options, Select Dude Menu.
 3356                                   ; This is the general options screen you get when you press the
 3357                                   ; 'Option' button.
 3358                                   ; *******************************************************************
 3359                                   gameopt:
 3360                                           ; Display the 'Game Options' screen, e.g. 'Display Setup',
 3361                                           ; and 'Control Setup'.
 3362  000023F8  4279xxxxxxxx                   clr selected               ; Set 'Display Setup' as the initial selection.
 3363  000023FE  33FC0001xxxxxxxx               move #1,selectable         ; Two Options are available, we don't enable the 'Controller Type'.
 3364  00002406  23FCxxxxxxxxxxxxxxxx           move.l #option2,the_option   ; Enable the General Options Screen
 3365  00002410  6100xxxx                       bsr do_choose              ; Display the General Options screen.
 3366                                       
 3367  00002414  4A79xxxxxxxx                   tst z                      ; Has the player done a hard reset?
 3368  0000241A  66AE                           bne fago                   ; If so, start a game.
 3369  0000241C  4EB9xxxxxxxx                   jsr eepromsave             ; Otherwise, save the selections from General Options.
 3370  00002422  3039xxxxxxxx                   move selected,d0           ; See which general option they selected.
 3371  00002428  6700xxxx                       beq dispop                 ; If option 0, show the hardware interlace/vector selection screen.
 3372  0000242C  B07C0001                       cmp #1,d0                  ; Did they select 'Controller Setup?
 3373  00002430  6600xxxx                       bne nxtsl                  ; If no, skip to nxtssl.
 3374                                       
 3375                                           ; They selected Controller Setup.
 3376  00002434  6100FCF8                       bsr firesel                ; Enter 'Controller Setup' option screen.
 3377                                           ; User has finished controller setup.
 3378  00002438  4A79xxxxxxxx                   tst z                      ; Has the player done a hard reset?
 3379  0000243E  668A                           bne fago                   ; If yes, go ahead and start game?
 3380  00002440  6000FEA2                       bra dcc                    ; Go back to the main options screen.
 3381                                       
 3382  00002444  B07C0002               nxtsl:  cmp #2,d0                  ; Did they select 'Controller TYpe'?
 3383  00002448  6600FE9A                       bne dcc                    ; If not, go back to the main options screen.
 3384                                       
 3385                                           ; Otherwise they've selected rotary controoler options.
 3386  0000244C  6100FD7C                       bsr rotset                 ; Display the rotary controller options screen.
 3387                                           ; They've finished setting up rotary.
 3388  00002450  6000FE60                       bra optionscreen           ; Go back to the main options screen.
 3389                                           ; Returns
 3390                                       
 3391                                   ; *******************************************************************
 3392                                   ; dispop
 3393                                   ; Hardware Interlace/Fat Vectors Option Display
 3394                                   ; *******************************************************************
 3395  00002454  6100xxxx               dispop: bsr fade                   ; going to do option on top of a displayed Web
 3396  00002458  6100xxxx                       bsr sopt3                  ; Set up the option messages in option3.
 3397  0000245C  23FCxxxxxxxxxxxxxxxx           move.l #option3,the_option   ; Store it in the_option.
 3398  00002466  33FC0002xxxxxxxx               move #2,selectable
 3399  0000246E  4279xxxxxxxx                   clr selected               ; selector is set up...
 3400  00002474  33FC0001xxxxxxxx               move #1,tblock
 3401                                       
 3402  0000247C  33FC001Axxxxxxxx               move #26,warp_add          ; Set up starfield stuff
 3403  00002484  23FC00000004xxxxxxxx           move.l #4,warp_count
 3404  0000248E  23FC00060000xxxxxxxx           move.l #$60000,vp_sfs
 3405  00002498  4EB9xxxxxxxx                   jsr clvp                   ; Clear the viewpoint co-ordinates.
 3406  0000249E  3F39xxxxxxxx                   move cweb,-(a7)            ; Stash some values in the stack so we can restore them later.
 3407  000024A4  33FC000Exxxxxxxx               move #14,cweb              ; set Yaks head web
 3408  000024AC  4EB9xxxxxxxx                   jsr initobjects            ; Initialize the activeobjects list.


                                        src/yak.s            Page 77      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 3409  000024B2  6100xxxx                       bsr setweb
 3410  000024B6  6100xxxx                       bsr circa                  ; init circular *field
 3411  000024BA  23FCxxxxxxxxxxxxxxxx           move.l #gamefx,fx          ; (so *f moves)
 3412  000024C4  41F9xxxxxxxx                   lea _web,a0
 3413  000024CA  706E                           move.l #webz,d0            ; Put the Z value for the top position of the web in d0.
 3414  000024CC  4840                           swap d0                    ; Swap position of the first 2 bytes with last 2 bytes.
 3415  000024CE  2140000C                       move.l d0,12(a0)           ; Store it in the _web object: initial Z is further away than the usual
 3416  000024D2  317C00010022                   move #1,34(a0)             ; Draw routine in draw_vex is 'draw'.
 3417  000024D8  23FCxxxxxxxxxxxxxxxx           move.l #vecoptdraw,demo_routine
 3418                                       
 3419                                           ; Option choose loop for hardware interlace/fat vectors.
 3420  000024E2  6100xxxx               dcc2:   bsr do_choose              ; Feedback to player.
 3421  000024E6  4279xxxxxxxx                   clr tblock
 3422  000024EC  4A79xxxxxxxx                   tst z                      ; Has the player done a hard reset?
 3423  000024F2  6600xxxx                       bne dcc3
 3424  000024F6  3039xxxxxxxx                   move selected,d0
 3425  000024FC  6600xxxx                       bne vop11
 3426  00002500  08790000xxxxxxxx               bchg.b #0,sysflags         ; Toggle Interlace Mode
 3427  00002508  6100xxxx               voe:    bsr sopt3                  ; Update the displayed text.
 3428  0000250C  60D4                           bra dcc2
 3429  0000250E  B07C0001               vop11:  cmp #1,d0
 3430  00002512  6600xxxx                       bne dcc3
 3431  00002516  08790001xxxxxxxx               bchg.b #1,sysflags         ; Toggle skinny/fat vectors.
 3432  0000251E  60E8                           bra voe
 3433  00002520  4EB9xxxxxxxx           dcc3:   jsr eepromsave             ; Save the choice in settings.
 3434  00002526  6100xxxx                       bsr fade                   ; Do a meltovision transition.
