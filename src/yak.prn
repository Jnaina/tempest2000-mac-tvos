11951                                   ; *******************************************************************
11952                                   ; make_spiker
11953                                   ;
11954                                   ; make a spiker, in a random Lane
11955                                   ; *******************************************************************
11956                                   make_spiker:
11957  000099F2  4A79xxxxxxxx                   tst afree                  ; Are there any free slots for a new activeobject?


                                        src/yak.s            Page 230     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


11958  000099F8  6B00xxxx                       bmi rrts                   ; If not, return now.
11959  000099FC  4A79xxxxxxxx                   tst max_spikers            ; Do we already have enough spikers?
11960  00009A02  6B00FE2A                       bmi zrts                   ; If yes, zero return wont hang the wave sequencer
11961  00009A06  04790001xxxxxxxx               sub #1,afree               ; Mark one less free slot for activeobjects.
11962  00009A0E  04790001xxxxxxxx               sub #1,max_spikers         ; And one less available spikers.
11963                                           ; Make an activeobject entry for the spiker.
11964  00009A16  2079xxxxxxxx                   move.l freeobjects,a0      ; Get a free slot for our activeobject entry.
11965  00009A1C  20B9xxxxxxxx                   move.l _spiker,(a0)        ; Set address of the vector object to draw: _spiker.
11966  00009A22  317C00BE000C                   move #webz+80,12(a0)       ; Set the end of the web as Z position in the activeobject entry.
11967  00009A28  4268000E                       clr 14(a0)
11968  00009A2C  3239xxxxxxxx                   move web_max,d1            ; Get the number of lanes in the web.
11969  00009A32  6100xxxx                       bsr rand                   ; Put a random number between 0 and d1 in d0.
