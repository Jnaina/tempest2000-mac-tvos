 8150                                   ; *******************************************************************
 8151                                   ; attract
 8152                                   ; Called periodically during attract mode to detect button presses
 8153                                   ; and run whatever background attract mode is active, e.g. the yak head,
 8154                                   ; specified by demo_routine.
 8155                                   ; *******************************************************************
 8156                                   attract:
 8157  00006978  33FC01F4xxxxxxxx               move #500,attime           ; Set the duration of this screen in attract mode.
 8158                                   attr:
 8159  00006980  4279xxxxxxxx                   clr ud_score
 8160                                           ; as above, attract mode version
 8161  00006986  33FC0001xxxxxxxx               move #1,screen_ready       ; Signal to 'Frame' that we have a screen ready for display.
 8162  0000698E  4279xxxxxxxx                   clr db_on                  ; Enable double-buffering.


                                        src/yak.s            Page 162     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 8163  00006994  4279xxxxxxxx                   clr e_attract              ; Not used!
 8164  0000699A  4279xxxxxxxx                   clr optpress
 8165                                       
 8166                                           ; Loop until we're sure no button has been pressed. THis is a
 8167                                           ; 'debounce' that ensures we're not picking up on any previous
 8168                                           ; button press inadvertently.
 8169  000069A0  6100xxxx               timr:   bsr thang                  ; Run the background routine, one of yakhead, glopyr.
 8170  000069A4  4A79xxxxxxxx                   tst e_attract              ; Not used!
 8171  000069AA  6600xxxx                       bne arts                   ; Not used!
 8172  000069AE  2039xxxxxxxx                   move.l pad_now,d0          ; Get pressed buttons.
 8173  000069B4  C0BC22002000                   and.l #allbutts,d0         ; Filter to the ones we're interested in.
 8174  000069BA  66E4                           bne timr                   ; Keep looping until no buttons pressed.
 8175                                       
 8176                                           ; Loop 500 times waiting for the player to press a button.
 8177  000069BC  6100xxxx               dbnce:  bsr thang                  ; Run the background routine, one of yakhead, glopyr.
 8178  000069C0  4A79xxxxxxxx                   tst pawsed                 ; Has the player paused?
 8179  000069C6  66F4                           bne dbnce                  ; If so, keep looping until unpaused.
 8180  000069C8  04790001xxxxxxxx               sub #1,attime              ; Decrement the display duration counter.
 8181  000069D0  6A00xxxx                       bpl intime                 ; If timer not yet expired, skip next line.
 8182  000069D4  33FCFFFFxxxxxxxx               move #-1,z                 ; Timer expired: signal that attract mode has timed out.
 8183                                   intime:
 8184  000069DC  4A79xxxxxxxx                   tst optpress               ; Has the player pressed the 'Option' button?
 8185  000069E2  6600xxxx                       bne gogx                   ; If so, get out of here.
 8186  000069E6  4A79xxxxxxxx                   tst z                      ; Have we timed out?
 8187  000069EC  6600xxxx                       bne gogx                   ; If so, get out of here.
 8188  000069F0  4A79xxxxxxxx                   tst e_attract              ; Not used!
 8189  000069F6  6600xxxx                       bne arts                   ; Not used.
 8190  000069FA  2039xxxxxxxx                   move.l pad_now,d0          ; Get any buttons pressed.
 8191  00006A00  80B9xxxxxxxx                   or.l pad_now+4,d0
 8192  00006A06  C0BC22002000                   and.l #allbutts,d0         ; Filter to the ones we're interested in.
 8193  00006A0C  67AE                           beq dbnce                  ; If nothing pressed, keep looping.
 8194                                   arts:
 8195  00006A0E  4279xxxxxxxx                   clr _pauen                 ; Disable pausing.
 8196  00006A14  23FCxxxxxxxxxxxxxxxx           move.l #rrts,routine
 8197  00006A1E  23C0xxxxxxxx                   move.l d0,selbutt          ; Store the button press.
 8198  00006A24  4E75                           rts
