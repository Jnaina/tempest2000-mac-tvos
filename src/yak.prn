 2663  000019D6  43F9xxxxxxxx                   lea fbpiece2,a1            ; Point at 2nd leg of fuseball.
 2664  000019DC  14367000                       move.b 0(a6,d7.w),d2       ; Get the element of fbcols indexed by d7.
 2665  000019E0  13420009                       move.b d2,9(a1)            ; Store the colour in the fbpiece2 data structure.
 2666  000019E4  13420019                       move.b d2,25(a1)           ; Store the colour in the fbpiece2 data structure.
 2667  000019E8  48E7C000                       movem.l d0-d1,-(A7)        ; Stash some values in the stack so we can restore them later.
 2668  000019EC  6100xxxx                       bsr drawsolid              ; Draw a solid polygon with default centering.
 2669  000019F0  4EB9xxxxxxxx                   jsr gpuwait                ; Wait for the GPU to finish.
 2670  000019F6  4CDF0003                       movem.l (a7)+,d0-d1        ; Restore stashed values from the stack.
 2671  000019FA  48E7C000                       movem.l d0-d1,-(a7)        ; Stash some values in the stack so we can restore them later.
 2672  000019FE  43F9xxxxxxxx                   lea fbpiece1,a1            ; Point at 1st leg of fuseball.
 2673  00001A04  14367000                       move.b 0(a6,d7.w),d2       ; Get the element of fbcols indexed by d7.
 2674  00001A08  13420009                       move.b d2,9(a1)            ; Store the color in the fbpiece1 data structure.
 2675  00001A0C  13420019                       move.b d2,25(a1)           ; Store the color in the fbpiece1 data structure.
 2676  00001A10  6100xxxx                       bsr drawsolid              ; Draw a solid polygon with default centering.
 2677  00001A14  4EB9xxxxxxxx                   jsr gpuwait                ; Wait for the GPU to finish.
 2678  00001A1A  4CDF0003                       movem.l (a7)+,d0-d1        ; Restore stashed values from the stack.
 2679  00001A1E  D006                           add.b d6,d0                ; Add the frames to d0 (not used elsewhere here).
