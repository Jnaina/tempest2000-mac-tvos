12416                                   ; *******************************************************************
12417                                   ; make_pulsar
12418                                   ;
12419                                   ; make a Pulsar, in a random Lane
12420                                   ; *******************************************************************
12421                                   make_pulsar:
12422                                       
12423  00009F8E  4A79xxxxxxxx                   tst afree                  ; Are there any free slots for a new activeobject?
12424  00009F94  6B00xxxx                       bmi rrts                   ; If not, return now.
12425                                   m_puls:
12426  00009F98  04790001xxxxxxxx               sub #1,afree               ; Mark one less available slot for activobjects.
12427  00009FA0  2079xxxxxxxx                   move.l freeobjects,a0      ; Point a0 at the address to use for our new activeobject.
12428  00009FA6  2039xxxxxxxx                   move.l _pus,d0             ; Set address of the vector object to draw: _pus.
12429  00009FAC  4A79xxxxxxxx                   tst blanka                 ; Are we drawing solids or vectors?
12430  00009FB2  6700xxxx                       beq vop2                   ; If vectors, skip to vop2.
12431  00009FB6  70FB                           move.l #-5,d0              ; If solids, use draw_spulsar as our draw routine.
12432  00009FB8  2080                   vop2:   move.l d0,(a0)             ; Store selected draw routine in the activeobject entry.
12433  00009FBA  317C00BE000C                   move #webz+80,12(a0)       ; Store the top of the web as the object's Z position.
12434  00009FC0  4268000E                       clr 14(a0)
12435  00009FC4  3239xxxxxxxx                   move web_max,d1            ; Get number of lanes in web and put it in d1.
12436  00009FCA  6100xxxx                       bsr rand                   ; Put a random number between 0 and d1 in d0.
12437  00009FCE  31400010                       move d0,16(a0)             ; initial webpos of this Fuseball
12438  00009FD2  42A8001E                       clr.l 30(a0)               ; clear Y and Z rotate
12439  00009FD6  317C00010022                   move #1,34(a0)             ; Draw routine in draw_vex is 'draw'.
12440  00009FDC  317C00FF0028                   move #$ff,40(a0)           ; Pulsars are YELLOW
12441  00009FE2  317C0001002A                   move #1,42(a0)             ; Fine rez
12442  00009FE8  317C00010034                   move #1,52(a0)             ; does count as an enemy in the wave-end check.
12443  00009FEE  317C000B0036                   move #11,54(a0)            ; Object update routine in run_vex is 'run_pulsar'.
12444  00009FF4  2C48                           move.l a0,a6               ; Move our newly created object into the activeobjects list.
12445  00009FF6  6100xxxx                       bsr toweb                  ; Set X and Y of object to attach it to the web on selected lane.
12446  00009FFA  6000EE3C                       bra ipix                   ; Add it to the activeobjects list and make it very far away (pixel size).
12447                                       
