 2747  00001A90  41F900F03F60                   lea in_buf,a0              ; Point our GPU RAM input buffer at a0.
 2748  00001A96  20C9                           move.l a1,(a0)+            ; pointer to our polygon data structure
 2749  00001A98  20C2                           move.l d2,(a0)+            ; x position to draw polygon
 2750  00001A9A  20C3                           move.l d3,(a0)+            ; y position to draw polygon
 2751  00001A9C  20C1                           move.l d1,(a0)+            ; z position to draw polygon
 2752  00001A9E  20C4                           move.l d4,(a0)+            ; x position of polygon's centre
 2753  00001AA0  20C5                           move.l d5,(a0)+            ; y position of polygon's centre
 2754  00001AA2  2080                           move.l d0,(a0)             ; rotation angle
