 6345                                   notatari:
 6346  00005062  23FC0000000400F03FFC           move.l #4,gpu_mode         ; Select 'rex' in camel.gas. Op4 is multiple images stretching towards you in Z
 6347  0000506C  3E39xxxxxxxx                   move pongy,d7
 6348  00005072  2C39xxxxxxxx                   move.l pongz,d6
 6349  00005078  3A39xxxxxxxx                   move pongx,d5
 6350  0000507E  CA7C00FF                       and #$ff,d5                ; Keep d5 between 0 and 255.
 6351  00005082  4845                           swap d5                    ; Swap position of the first 2 bytes with last 2 bytes.
 6352  00005084  4245                           clr d5
 6353  00005086  3839xxxxxxxx                   move frames,d4             ; Stash the frame count in d4.
 6354  0000508C  ED44                           asl #6,d4
 6355  0000508E  C87C00FF                       and #$ff,d4                ; Keep d4 between 0 and 255.
 6356                                       
 6357                                           ; Loop to stretch and rotate the selected graphic in the background.
 6358                                   dyakhead:
 6359  00005092  41F900F03F60                   lea in_buf,a0              ; Point our GPU RAM input buffer at a0
 6360  00005098  20CA                           move.l a2,(a0)+            ; rex->_bass: srce screen for effect
 6361  0000509A  20C0                           move.l d0,(a0)+            ; rex->spixel: srce start pixel address
 6362  0000509C  20C1                           move.l d1,(a0)+            ; rex->ssize: srce size
 6363  0000509E  48E7C000                       movem.l d0-d1,-(a7)        ; Stash some values in the stack so we can restore them later.
 6364  000050A2  2005                           move.l d5,d0
 6365  000050A4  E480                           asr.l #2,d0                ; Divide by 4.
 6366  000050A6  20C0                           move.l d0,(a0)+            ; rex->scalex: x-scale
 6367  000050A8  20C0                           move.l d0,(a0)+            ; rex->scaley: y-scale
 6368                                       
 6369                                           ; Calculate a 'shear' value for the X co-ordinate.
 6370  000050AA  49F9xxxxxxxx                   lea sines,a4               ; Load the sine table to a4.
 6371  000050B0  1239xxxxxxxx                   move.b pongxv,d1           ; Put our 'roll' offset in d1.
 6372  000050B6  C27C00FF                       and #$ff,d1                ; Keep d1 between 0 and 255.
 6373  000050BA  10341000                       move.b 0(a4,d1.w),d0       ; Use it as an index into the sine table.
 6374  000050BE  4880                           ext d0                     ; Make the result a long.


                                        src/yak.s            Page 130     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 6375  000050C0  4840                           swap d0                    ; Swap position of the first 2 bytes with last 2 bytes.
 6376  000050C2  4240                           clr d0                     ; Clear the lowest byte.
 6377  000050C4  EC80                           asr.l #6,d0                ; Shift right.
 6378  000050C6  20C0                           move.l d0,(a0)+            ; rex->shearx: Store the result as shearx for 'rex'.
 6379                                       
 6380                                           ; Calculate a 'shear' value for the Y co-ordinate.
 6381  000050C8  1239xxxxxxxx                   move.b pongxv+1,d1
 6382  000050CE  10341000                       move.b 0(a4,d1.w),d0
 6383  000050D2  4880                           ext d0
 6384  000050D4  4840                           swap d0                    ; Swap position of the first 2 bytes with last 2 bytes.
 6385  000050D6  4240                           clr d0
 6386  000050D8  EC80                           asr.l #6,d0
 6387  000050DA  20C0                           move.l d0,(a0)+            ; rex->sheary: Store the result as sheary for 'rex'.
 6388                                       
 6389  000050DC  20FC00000001                   move.l #1,(a0)+            ; rex->mode: Mode 1 = Centered
 6390  000050E2  20FC00000000                   move.l #0,(a0)+            ; rex->dstx:
 6391  000050E8  20FC00000000                   move.l #0,(a0)+            ; rex->dsty:
 6392                                       
 6393                                           ; Calculate the Z position.
 6394  000050EE  2006                           move.l d6,d0
 6395  000050F0  DCBC00200000                   add.l #$200000,d6
 6396  000050F6  4A80                           tst.l d0
 6397  000050F8  6B00xxxx                       bmi xane                   ; no point in drawing -ves
 6398  000050FC  20C0                           move.l d0,(a0)+            ; rex->dstz
 6399                                       
 6400                                           ; GPU buffer is ready now - so run 'rex'.
 6401  000050FE  41F9xxxxxxxx                   lea parrot,a0              ; Load the GPU module in camel.gas.
 6402  00005104  4EB9xxxxxxxx                   jsr gpurun                 ; Run the GPU module.
 6403  0000510A  4EB9xxxxxxxx                   jsr gpuwait                ; Wait for the GPU to finish.
 6404  00005110  4CDF0003               xane:   movem.l (a7)+,d0-d1        ; Restore stashed values from the stack.
 6405  00005114  51CFFF7C                       dbra d7,dyakhead           ; Keep looping until d7 is zero.
 6406  00005118  4E75                           rts
