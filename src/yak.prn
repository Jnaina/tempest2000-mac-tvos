14727  0000BB6A  23C8xxxxxxxx                   move.l a0,msg              ; Set the message object.
14728  0000BB70  4E75                           rts
14729                                       
14730                                   ; *******************************************************************
14731                                   ; runmsg
14732                                   ; Decide whether we should stop showing an active message.
14733                                   ; *******************************************************************
14734                                   runmsg:
14735  0000BB72  4AB9xxxxxxxx                   tst.l msg                  ; Do we have an active message?
14736  0000BB78  6700xxxx                       beq rrts                   ; If not, return early.
14737  0000BB7C  4A79xxxxxxxx                   tst msgtim1                ; How's the message timer doing?
14738  0000BB82  6B00xxxx                       bmi runmsg2                ; If it has run out, go to the second timer.
14739  0000BB86  04790001xxxxxxxx               sub #1,msgtim1             ; Otherwise subtract 1.
14740  0000BB8E  4E75                           rts
14741                                   runmsg2:
14742  0000BB90  2039xxxxxxxx                   move.l msgxv,d0            ; Get X position for second phase of message.
14743  0000BB96  D1B9xxxxxxxx                   add.l d0,msgxs             ; Set it.
14744  0000BB9C  2039xxxxxxxx                   move.l msgyv,d0            ; Get Y position for second phase of message.
14745  0000BBA2  D1B9xxxxxxxx                   add.l d0,msgys             ; Set it.
14746  0000BBA8  04790001xxxxxxxx               sub #1,msgtim2             ; Decrement the second message timer.
14747  0000BBB0  6A00xxxx                       bpl rrts                   ; If still time left, return.
14748  0000BBB4  42B9xxxxxxxx                   clr.l msg                  ; Otherwise it has expired, so clear it to stop displaying.
14749  0000BBBA  4E75                           rts
