19080  0000EE7A  4EB84058                       jsr STOP_MOD
19081  0000EE7E  E548                           lsl #2,d0                  ; Multiply it by 4
19082  0000EE80  41F9008D6800                   lea modbase,a0             ; Point a0 at modbase.
19083  0000EE86  20700000                       move.l 0(a0,d0.w),a0       ; get tune base
19084  0000EE8A  4EB8404C                       jsr PT_MOD_INIT
19085  0000EE8E  1039xxxxxxxx                   move.b vols,d0
19086  0000EE94  C0BC000000FF                   and.l #$ff,d0              ; Keep it between 0 and 255
19087  0000EE9A  4241                           clr d1
19088  0000EE9C  4EB8406A                       jsr SET_VOLUME
19089  0000EEA0  23C0xxxxxxxx                   move.l d0,vset
19090  0000EEA6  4EB84070                       jsr NOFADE
19091  0000EEAA  4EF84052                       jmp START_MOD
