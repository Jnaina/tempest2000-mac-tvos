12460                                   ; run_pulsar
12461                                   ; Called during the run_objects sequence as a member of the run_vex list.
12462                                   ; *******************************************************************
12463                                   run_pulsar:
12464  0000A012  41F9xxxxxxxx                   lea _pus,a0                ; Set address of the vector object to draw: _pus.
12465  0000A018  4A79xxxxxxxx                   tst blanka                 ; Are we drawing solids or vectors?
12466  0000A01E  6600xxxx                       bne vop3                   ; If vectors, skip to vop3.
12467                                           ; If solids, the pucycl array contains the index of the routine in 'solids'
12468                                           ; that we're going to use. The one we select will depend on pucnt (pulse count).
12469  0000A022  3039xxxxxxxx                   move pucnt,d0              ; Put pucnt in d0.
12470  0000A028  C07C000F                       and #$0f,d0                ; Clamp it to a value between 0 and 15.
12471  0000A02C  43F9xxxxxxxx                   lea pucycl,a1              ; Point a1 at pucycl arrray.
12472  0000A032  10310000                       move.b 0(a1,d0.w),d0       ; Use the counter as an index to select an entry in pucycl.
12473  0000A036  E540                           asl #2,d0                  ; Multiply it by 4.
12474  0000A038  2CB00000                       move.l 0(a0,d0.w),(a6)     ; Set the selected index as our draw routine in 'solids'.
12475  0000A03C  2039xxxxxxxx           vop3:   move.l pulsar_zspeed,d0
12476  0000A042  91AE000C                       sub.l d0,12(a6)            ; Set Z position in activobject entry.
12477  0000A046  302E0010                       move 16(a6),d0
12478  0000A04A  3239xxxxxxxx                   move webcol,d1
12479  0000A050  E540                           asl #2,d0                  ; Multiply it by 4.
12480  0000A052  3E39xxxxxxxx                   move frames,d7             ; Store frames in d7.
12481  0000A058  CE7C000F                       and #$0f,d7                ; Keep it between 0 and 15.
12482  0000A05C  E94F                           lsl #4,d7                  ; Multiply it by 32.
12483  0000A05E  2279xxxxxxxx                   move.l lanes,a1
12484  0000A064  24710000                       move.l 0(a1,d0.w),a2       ; address of lane's vertex list cluster
12485  0000A068  15410002                       move.b d1,2(a2)            ; Set this line to blue
12486  0000A06C  15410004                       move.b d1,4(a2)            ; make end bar flash
12487  0000A070  26710004                       move.l 4(a1,d0.w),a3
12488  0000A074  17410002                       move.b d1,2(a3)            ; Set this line to blue
12489  0000A078  0C79FFFExxxxxxxx               cmp #-2,wave_tim
12490  0000A080  6700xxxx                       beq rrts
12491  0000A084  6100xxxx                       bsr collie
12492  0000A088  6600xxxx                       bne pkm
12493  0000A08C  0C6E001E000C                   cmp #webz-80,12(a6)        ; Set Z position in activobject entry.
12494  0000A092  6D00xxxx                       blt lanetop                ; transform into a Flipper or a pair of Psparks
12495  0000A096  3E39xxxxxxxx                   move frames,d7             ; Store frames in d7.
12496  0000A09C  CE7C000F                       and #$0f,d7                ; Keep it between 0 and 15.
12497  0000A0A0  E94F                           lsl #4,d7                  ; Multiply it by 32.
12498  0000A0A2  15470004                       move.b d7,4(a2)            ; make end bar flash
12499  0000A0A6  3039xxxxxxxx                   move pucnt,d0              ; Store the pulse count in d0.
12500  0000A0AC  C07C000F                       and #$0f,d0                ; Keep it between 0 and 15.
12501  0000A0B0  B07C0007                       cmp #7,d0                  ; check for Deadly
12502  0000A0B4  6600xxxx                       bne rrts
12503  0000A0B8  4A79xxxxxxxx                   tst zapdone                ; do we need to start a zap sound?
12504  0000A0BE  6600xxxx                       bne zd0                    ; no, someone already did
12505  0000A0C2  33FC0001xxxxxxxx               move #1,zapdone
12506  0000A0CA  33FC0007xxxxxxxx               move #$07,sfx              ; Select 'Crackle' sound effect.
12507  0000A0D2  33FC0033xxxxxxxx               move #51,sfx_pri           ; Set the sound's priority compared to others.
12508  0000A0DA  23FC000001F4xxxxxxxx           move.l #500,sfx_pitch
12509  0000A0E4  4EB9xxxxxxxx                   jsr fox                    ; Play selected sound effect.
12510                                       
12511                                   zd0:
