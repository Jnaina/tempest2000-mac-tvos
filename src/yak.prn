15412                                   ; *******************************************************************
15413                                   ; MakeScaledObject
15414                                   ; This routine goes unused. We only ever use MakeUnScaledObject.
15415                                   ;
15416                                   ; Make an OL entry for an object. a0 --> current pos in OL being built
15417                                   ; (assumes a0 is already phrase aligned)
15418                                   ;  d0-d1 = x,y
15419                                   ;  d2 = index into CLUT
15420                                   ;  d3 = X size, in phrases
15421                                   ;  d4 = Y size, in scan lines
15422                                   ;  d5 = Object depth
15423                                   ;  a1.l = address of data
15424                                   ;
15425                                   ; uses all d-regs, a0 must have OL position, a6 used internally
15426                                   ;
15427                                   ; Adding new stuff: d3 high word now=Yscale:Xscale


                                        src/yak.s            Page 292     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


15428                                   ; *******************************************************************
15429                                   MakeScaledObject:
15430                                           ; Now the funky bit. Build a scaled bitmapped object.
15431                                           ; We are now on a quadphrase boundary too.
15432                                       
15433  0000C424  2C09                           move.l a1,d6               ; get copy of data pointer
15434  0000C426  CCBCFFFFFFF8                   and.l #$fffffff8,d6        ; lose three LSB's
15435  0000C42C  E18E                           lsl.l #8,d6                ; move to correct bit position
15436  0000C42E  20C6                           move.l d6,(a0)+            ; put it in the list
15437                                       
15438                                           ; The link address is the same as for the preceding conditional
15439                                           ; object, and remember i saved it in a1, so...
15440                                       
15441  0000C430  4DE80020                       lea 32(a0),a6
15442  0000C434  2C0E                           move.l a6,d6               ; get back link-pointer
15443  0000C436  EB8E                           lsl.l #5,d6                ; make it aligned OK (bott. 3 bits are 0)
15444  0000C438  4846                           swap d6                    ; get top word of the address..
15445  0000C43A  8D68FFFE                       or d6,-2(a0)               ; and or it into place on the previous word.
15446                                       
15447                                           ; That's the first longword done, and the remaining byte of the
15448                                           ; link address is in d6 high already.
15449                                       
15450  0000C43E  7E00                           move.l #0,d7               ; make d7 empty
15451  0000C440  3E04                           move d4,d7                 ; get a copy of the height...
15452  0000C442  E49F                           ror.l #2,d7                ; put 2 lowest bits in hi word...
15453  0000C444  4846                           swap d6                    ; get back rest of link
15454  0000C446  8C47                           or d7,d6                   ; OR in top 8-bits of height..
15455  0000C448  30C6                           move d6,(a0)+              ; top word now completed..
15456  0000C44A  4847                           swap d7                    ; get 2 lowest bits of height at top of d7..
15457  0000C44C  3C01                           move d1,d6                 ; copy of Y pos..
15458  0000C44E  E74E                           lsl #3,d6                  ; align...
15459  0000C450  8C47                           or d7,d6                   ; mask in those 2 bits of height..
15460  0000C452  08C60000                       bset #0,d6                 ; set the type=1
15461  0000C456  30C6                           move d6,(a0)+              ; ..which completes the first phrase.
15462                                       
15463                                           ; Now on to the next phrase.
15464                                       
15465  0000C458  4258                           clr (a0)+                  ; assume Firstpix=0, RELEASE not asserted
15466  0000C45A  3E02                           move d2,d7                 ; get INDEX
15467  0000C45C  EF4F                           lsl #7,d7                  ; align it
15468  0000C45E  7C00                           move.l #0,d6               ; empty d6
15469  0000C460  3C03                           move d3,d6                 ; get X size in phrases
15470  0000C462  E89E                           ror.l #4,d6                ; shift low 4 bits into hi word
15471  0000C464  08C6000F                       bset #15,d6                ; set transparency
15472  0000C468  8C47                           or d7,d6                   ; mask in Index
15473  0000C46A  30C6                           move d6,(a0)+              ; ignores Reflect, RMW
15474                                       
15475                                           ; First long of phrase 2 is done...
15476                                       
15477  0000C46C  3E03                           move d3,d7                 ; Assume dwidth=iwidth for simplicity
15478  0000C46E  E54F                           lsl #2,d7                  ; align
15479  0000C470  4846                           swap d6                    ; get top of d6, which has rest of iwidth
15480  0000C472  8C47                           or d7,d6                   ; mask in dwidth
15481  0000C474  30C6                           move d6,(a0)+              ; put it in, assume pitch is 1
15482  0000C476  3C05                           move d5,d6                 ; get copy of depth
15483  0000C478  E85E                           ror #4,d6                  ; put it in top byte


                                        src/yak.s            Page 293     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


15484  0000C47A  8C40                           or d0,d6                   ; Hallelujah! X doesn't need shifting!
15485  0000C47C  08C6000F                       bset #15,d6                ; (PITCH=1)
15486  0000C480  30C6                           move d6,(a0)+              ; Here endeth the Second Phrase.
15487                                       
15488                                           ; Now the third and final phrase.
15489                                       
15490  0000C482  20FC00000000                   move.l #0,(a0)+            ; Not used.....
15491  0000C488  2C03                           move.l d3,d6
15492  0000C48A  4287                           clr.l d7
15493  0000C48C  4846                           swap d6                    ; get x- and y-scale
15494  0000C48E  3E06                           move d6,d7                 ; copy scales
15495  0000C490  E04F                           lsr #8,d7
15496  0000C492  4847                           swap d7                    ; Swap position of the first 2 bytes with last 2 bytes.
15497  0000C494  3E06                           move d6,d7                 ; recombine remainder with d7
15498  0000C496  20C7                           move.l d7,(a0)+            ; Add it to our GPU RAM input buffer.
15499  0000C498  41E80008                       lea 8(a0),a0
15500  0000C49C  4E75                           rts                        ; Outta here.
15501                                       
15502                                   ; *******************************************************************
15503                                   ; MakeUnScaledObject
15504                                   ; Make an Object List item in 'blist', pointed at by a0.
15505                                   ; dlist is a4
15506                                   ;
15507                                   ; Make an OL entry for an object. a0 --> current pos in OL being built
15508                                   ; (assumes a0 is already phrase aligned)
15509                                   ;  d0-d1 = x,y
15510                                   ;  d2 = index into CLUT
15511                                   ;  d3 = X size, in phrases
15512                                   ;  d4 = Y size, in scan lines
15513                                   ;  d5 = Object depth
15514                                   ;  a1.l = address of data
15515                                   ;
