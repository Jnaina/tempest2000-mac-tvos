19117                                   .include "eeprim.s"                ; EEPROM code
    1                                   ;************************************************
    2                                   ;                                               *
    3                                   ;       EEPROM Write & Read Primitives          *
    4                                   ;                                               *
    5                                   ;************************************************
    6                                   ;
    7                                   ;       Hi-Score on-board-cartridge EEPROM primitives 
    8                                   ;       for use by Jaguar game cartridge developers.
    9                                   ;
   10                                   ;       128 bytes (accessable as 64 words) of non-volatile
   11                                   ;       memory are available on Jaguar game cartridges to
   12                                   ;       preserve Hi-scores or other game status.
   13                                   ;       Data is retained for up to 10 years, and a minimum
   14                                   ;       of 10,000 read/write cycles is assured, according to
   15                                   ;       product literature. 
   16                                   ;
   17                                   ;
   18                                   ;
   19                                   ;
   20                                   ;
   21                                   ;        Programmer: Dave Staugas
   22                                   ;                    Atari, Sunnyvale
   23                                   ;                    [408] 745-8802
   24                                   ;
   25                                   ;       Last Update: 24-Sept-93
   26                                   ;
   27                                   ;
   28                                   ;   Equates needed that may already be defined in the JAGUAR.INC file..
   29                                   ;
   30           =00F14000               JOY1            equ     $f14000         ;this we'll use as our I/O base address
   31           =00F14800               GPIO_0          equ     $f14800         ;General purpose I/O #0
   32           =00F15000               GPIO_1          equ     $f15000         ;General purpose I/O #1
   33                                   ;
   34                                   ;   Equates derived from the above
   35                                   ;    to allow indirect with 16-bit displacement addressing
   36                                   ;
   37           =00000800               GPIO_0of        equ     GPIO_0-JOY1     ;offset to GPIO_0 (when addr reg Ax -> JOY1) 
   38           =00001000               GPIO_1of        equ     GPIO_1-JOY1     ;offset to GPIO_1 (when addr reg Ax -> JOY1) 


                                        eeprim.s             Page 359     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


   39                                   ;
   40                                   ;   Commands specific to the National Semiconductor NM93C14
   41                                   ;
   42                                   ;  9-bit commands..
   43                                   ;                876543210
   44           =00000180               eREAD   equ     %110000000              ;read from EEPROM
   45           =00000130               eEWEN   equ     %100110000              ;Erase/write Enable
   46           =00000140               eWRITE  equ     %101000000              ;Write selected register
   47           =00000100               eEWDS   equ     %100000000              ;Erase/Write disable (default)
   48                                   ;
   49                                   ;
   50                                   ;  DO (data out)        - is read on bit0 of JOY1
   51                                   ;  DI (data in)         - is written on bit0 of GPIO_0
   52                                   ;  CS (chip select)     - is pulsed low by any access to GPIO_1
   53                                   ;
   54                                   ;
   55                                   ;*****************************************************************
   56                                   ;
   57                                   ;  Write a word to EEPROM
   58                                   ;
   59                                   ;  entry: d0.w = data to be written
   60                                   ;         d1.w = least signifigant 6 bits specify write address (0-63)  
   61                                   ;
   62                                   ;   exit: all preserved
   63                                   ;
   64                                   ;
   65                                   eewrite::
   66  0000EEFE  48E7F880                       movem.l a0/d0-d4,-(sp)
   67  0000EF02  41F900F14000                   lea     JOY1,a0         ;set ptr to EEPROM i/o addresses
   68                                   ;
   69  0000EF08  4A681000                       tst.w   GPIO_1of(a0)    ;strobe ChipSelect
   70                                   ;
   71  0000EF0C  343C0130                       move.w  #eEWEN,d2       ;erase/write enable command
   72  0000EF10  6100xxxx                       bsr     out9bits        ;send it to EEPROM
   73                                   ;       
   74  0000EF14  4A681000                       tst.w   GPIO_1of(a0)    ;strobe ChipSelect
   75                                   ;
   76  0000EF18  0241003F                       andi.w  #$3f,d1         ;force write addr to be legit (0-63)
   77  0000EF1C  00410140                       ori.w   #eWRITE,d1      ;form WRITE command
   78  0000EF20  3401                           move.w  d1,d2
   79  0000EF22  6100xxxx                       bsr     out9bits        ;send it to EEPROM
   80                                   ;
   81  0000EF26  3400                           move.w  d0,d2           ;get 16-bit data word to send
   82  0000EF28  6100xxxx                       bsr     out16bit        ;  & send it
   83                                   ;
   84  0000EF2C  4A681000                       tst.w   GPIO_1of(a0)    ;strobe ChipSelect
   85                                   ;
   86  0000EF30  4E71                           nop                     ;1 us required after CS for status valid
   87  0000EF32  4E71                           nop
   88  0000EF34  343C0001                       move.w  #1,d2
   89                                   wrwait:
   90  0000EF38  3610                           move.w  (a0),d3         ;wait until write is complete
   91  0000EF3A  C642                           and.w   d2,d3
   92  0000EF3C  67FA                           beq     wrwait  
   93                                   ;       
   94  0000EF3E  343C0100                       move.w  #eEWDS,d2       ;get erase/write disable command


                                        eeprim.s             Page 360     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


   95  0000EF42  6100xxxx                       bsr     out9bits        ;send it
   96                                   ;
   97  0000EF46  4A681000                       tst.w   GPIO_1of(a0)    ;strobe ChipSelect
   98                                   ;
   99  0000EF4A  4CDF011F                       movem.l (sp)+,a0/d0-d4
  100  0000EF4E  4E75                           rts                     ;we're done
  101                                   ;
  102                                   ;
  103                                   ;
  104                                   ;******************************************************
  105                                   ;
  106                                   ;
  107                                   ;  Read a word from EEPROM
  108                                   ;
  109                                   ;  entry:  d1.w = least signifigant 6 bits specify read address (0-63)  
  110                                   ;
  111                                   ;   exit:  d0.w = data as read from EEPROM
  112                                   ;                 all other registers preserved
  113                                   ;
  114                                   eeread::
  115  0000EF50  48E77880                       movem.l a0/d1-d4,-(sp)
  116  0000EF54  41F900F14000                   lea     JOY1,a0         ;set ptr to EEPROM i/o address
  117                                   ;
  118  0000EF5A  4A681000                       tst.w   GPIO_1of(a0)    ;strobe ChipSelect
  119                                   ;
  120  0000EF5E  0241003F                       andi.w  #$3f,d1         ;force legit read addr
  121  0000EF62  00410180                       ori.w   #eREAD,d1
  122  0000EF66  3401                           move.w  d1,d2
  123  0000EF68  6100xxxx                       bsr     out9bits
  124                                   ;
  125  0000EF6C  7000                           moveq   #0,d0
  126  0000EF6E  760F                           moveq   #15,d3          ;pick up 17 bits (1st is dummy)
  127                                   inlp:   
  128  0000EF70  4A680800                       tst.w   GPIO_0of(a0)
  129  0000EF74  4E71                           nop
  130  0000EF76  3210                           move.w  (a0),d1
  131  0000EF78  E249                           lsr.w   #1,d1
  132  0000EF7A  D140                           addx.w  d0,d0
  133  0000EF7C  4E71                           nop
  134  0000EF7E  4E71                           nop
  135  0000EF80  4E71                           nop
  136  0000EF82  4E71                           nop
  137  0000EF84  4E71                           nop
  138  0000EF86  4E71                           nop
  139  0000EF88  51CBFFE6                       dbra    d3,inlp
  140                                   ;
  141  0000EF8C  4CDF011E                       movem.l (sp)+,a0/d1-d4
  142  0000EF90  4E75                           rts
  143                                   ;
  144                                   ;
  145                                   ;
  146                                   ;**************************************************************
  147                                   ;
  148                                   ;  Subordinate Routines needed by "eewrite"
  149                                   ;
  150                                   ;  Serial data sent to device is written to DI, bit0 of GPIO_0


                                        eeprim.s             Page 361     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  151                                   ;
  152                                   ; entry:
  153                                   ;  a0 -> JOY1
  154                                   ;  d2.w = 16-bit data word to write
  155                                   ;
  156                                   ; exit:
  157                                   ;  d2.w, d3.l destroyed
  158                                   ;
  159                                   out16bit:
  160  0000EF92  E35A                           rol.w   #1,d2           ;align 1st serial data bit (bit15) to bit0
  161  0000EF94  760F                           moveq   #15,d3          ;send 16 bits
  162  0000EF96  60xx                           bra.s   out9lp
  163                                   ;
  164                                   ; entry:
  165                                   ;  a0 -> JOY1
  166                                   ;  d2.w = 9-bit command to write
  167                                   ;
  168                                   out9bits:
  169  0000EF98  E15A                           rol.w   #8,d2           ;align 1st serial data bit (bit8) to bit0
  170  0000EF9A  7608                           moveq   #8,d3           ;send 9
  171                                   out9lp:
  172  0000EF9C  31420800                       move.w  d2,GPIO_0of(a0)         ;write next bit
  173  0000EFA0  4E71                           nop
  174  0000EFA2  4E71                           nop
  175  0000EFA4  4E71                           nop                     ;delay next write
  176  0000EFA6  4E71                           nop
  177  0000EFA8  4E71                           nop
  178  0000EFAA  4E71                           nop
  179  0000EFAC  E35A                           rol.w   #1,d2           ;adjust bit0 for next datum
  180  0000EFAE  51CBFFEC                       dbra    d3,out9lp       ;go for all 9 or all 16
  181  0000EFB2  4E75                           rts
  182                                   ;
