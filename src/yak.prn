 9682                                   ; *******************************************************************
 9683                                   ; fire
 9684                                   ; check for firebutton 2 and do superzapper.
 9685                                   ; *******************************************************************
 9686                                   fire:
 9687  00007D24  2039xxxxxxxx                   move.l fire_3,d0
 9688  00007D2A  2239xxxxxxxx                   move.l pad_now,d1
 9689  00007D30  0C790002xxxxxxxx               cmp #2,players             ; combine players firebuttons in 2pl mode
 9690  00007D38  6600xxxx                       bne snglsmart
 9691  00007D3C  2439xxxxxxxx                   move.l pad_now+4,d2
 9692  00007D42  3601                           move d1,d3
 9693  00007D44  8642                           or d2,d3                   ; combined...
 9694  00007D46  C680                           and.l d0,d3
 9695  00007D48  6700xxxx                       beq rrts                   ; no-one smarted
 9696  00007D4C  4A79xxxxxxxx                   tst szap_avail
 9697  00007D52  6B00xxxx                       bmi rrts                   ; someone smarted, but it wasn't available
 9698  00007D56  4A79xxxxxxxx                   tst szap_on                ; Is superzapper on?
 9699  00007D5C  6600xxxx                       bne rrts                   ; someone smarted, but it's already happening
 9700  00007D60  4279xxxxxxxx                   clr p2smarted
 9701  00007D66  C480                           and.l d0,d2                ; did player 2 smart?
 9702  00007D68  6700xxxx                       beq snglsmart
 9703  00007D6C  33FC0001xxxxxxxx               move #1,p2smarted          ; Player 2 smarted!
 9704  00007D74  6000xxxx                       bra gsmart
 9705                                   snglsmart:
 9706  00007D78  C280                           and.l d0,d1
 9707  00007D7A  6700xxxx                       beq rrts
 9708  00007D7E  4A79xxxxxxxx                   tst szap_avail
 9709  00007D84  6B00xxxx                       bmi rrts                   ; You already had it!
 9710  00007D88  4A79xxxxxxxx                   tst szap_on                ; Is superzapper on?
 9711  00007D8E  6600xxxx                       bne rrts                   ; You are already Superzapping!
 9712                                   gsmart:
 9713  00007D92  04790001xxxxxxxx               sub #1,szap_avail
 9714  00007D9A  6B00xxxx                       bmi nmsg
 9715  00007D9E  41F9xxxxxxxx                   lea zmes1,a0               ; Set message to "Eat Electric"
 9716  00007DA4  4280                           clr.l d0                   ; Set X pos to 0
 9717  00007DA6  223C00008000                   move.l #$8000,d1           ; Set Y pos
 9718  00007DAC  6100xxxx                       bsr setmsg                 ; Display the message.
 9719                                   nmsg:
 9720  00007DB0  33FC0001xxxxxxxx               move #1,szap_on            ; Start the sizzle... start the Superzapper.
 9721  00007DB8  33FC0007xxxxxxxx               move #7,sfx                ; Select the 'Crackle' sound effect.
 9722  00007DC0  33FC000Axxxxxxxx               move #10,sfx_pri           ; Set the sound's priority compared to others.
 9723  00007DC8  4EB9xxxxxxxx                   jsr fox                    ; Play selected sound effect.
 9724  00007DCE  4E75                           rts
 9725                                       
 9726                                       
 9727                                   ; *******************************************************************
 9728                                   ; h2hfrab
 9729                                   ; Fire a bullet in head to head mode.


                                        src/yak.s            Page 190     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 9730                                   ; If there's room for another bullet, we'll create it and add it to the
 9731                                   ; activeobjects list.
 9732                                   ; *******************************************************************
 9733                                   h2hfrab:
 9734  00007DD0  2F00                           move.l d0,-(a7)            ; Stash some values in the stack so we can restore them later.
 9735  00007DD2  33FC0001xxxxxxxx               move #1,sfx                ; Select the 'Player SHot Normal 2' sound effect.
 9736  00007DDA  33FC0001xxxxxxxx               move #1,sfx_pri            ; Set the sound's priority compared to others.
 9737  00007DE2  4EB9xxxxxxxx                   jsr fox                    ; Play selected sound effect.
 9738                                       
 9739                                           ; Look for a free slot for a new bullet.
 9740  00007DE8  2079xxxxxxxx                   move.l freeobjects,a0      ; address of new shot
 9741  00007DEE  47F9xxxxxxxx                   lea bulls,a3               ; Point a3 at bullets list.
 9742  00007DF4  3039xxxxxxxx           hgoaty: move bully,d0              ; Get current index into bullets list.
 9743  00007DFA  3239xxxxxxxx                   move bulland,d1            ; Put bulland in d1.
 9744  00007E00  C041                           and d1,d0                  ; Use it to limit the slot we can select in the bullets list.
 9745  00007E02  45F30000                       lea 0(a3,d0.w),a2          ; point a2 to this bullets slot
 9746  00007E06  2012                           move.l (a2),d0             ; Move it to d0 to see if it's free.
 9747  00007E08  6700xxxx                       beq hfreeslot              ; If it's a free slot, add a bullet.
 9748  00007E0C  06790004xxxxxxxx               add #4,bully               ; Otherwise move to next slot.
 9749  00007E14  60DE                           bra hgoaty                 ; Loop to test whether new slot is free.
 9750                                       
 9751                                   hfreeslot:
 9752  00007E16  06790004xxxxxxxx               add #4,bully               ; Point to the next slot in 'bulls' for later.
 9753  00007E1E  2488                           move.l a0,(a2)             ; store address of this bull
 9754  00007E20  214A0018                       move.l a2,24(a0)           ; store slot addr. in bull
 9755  00007E24  20BCFFFFFFF2                   move.l #-14,(a0)           ; Set index into solid polygon draw routine in 'solids': draw_h2hshot.
 9756  00007E2A  216900040004                   move.l 4(a1),4(a0)         ; Set X position to player's position.
 9757  00007E30  216900080008                   move.l 8(A1),8(a0)         ; Set Y position to player's position.
 9758  00007E36  2169000C000C                   move.l 12(a1),12(a0)       ; Set Z position to player's position.
 9759  00007E3C  216900100010                   move.l 16(a1),16(a0)       ; Web position from claw
 9760  00007E42  42A8001C                       clr.l 28(a0)
 9761  00007E46  42680020                       clr 32(a0)                 ; Zero roll, pitch and yaw
 9762  00007E4A  317C00010022                   move #1,34(a0)             ; Draw routine in draw_vex is 'draw'.
 9763  00007E50  215F0024                       move.l (a7)+,36(a0)        ; get saved velocity
 9764  00007E54  317C00000020                   move #0,32(a0)             ; bullet ID (player ownership) changed from 44() to 32()
 9765  00007E5A  317C00010034                   move #1,52(a0)             ; not alien and Type
 9766  00007E60  317C00200036                   move #32,54(a0)            ; Object update routine in run_vex is 'run_h2hshot'.
 9767  00007E66  6000xxxx                       bra insertobject           ; Add it to the activeobjects list.
 9768                                       
 9769                                       
