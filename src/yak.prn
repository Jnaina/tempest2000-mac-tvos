 9169  000076C8  31400010                       move d0,16(a0)             ; Set it as the droid's initial position on the web.


                                        src/yak.s            Page 180     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 9170  000076CC  42680012                       clr 18(a0)                 ; Set
 9171  000076D0  42A80014                       clr.l 20(a0)               ; Set velocity to 0.
 9172  000076D4  42A80018                       clr.l 24(a0)               ; Set acceleration to 0.
 9173  000076D8  42A8001C                       clr.l 28(a0)               ; Set pitcha nd roll to 0.
 9174  000076DC  42680020                       clr 32(a0)                 ; Set pitch to 0.
 9175  000076E0  317C00000022                   move #0,34(a0)             ; Draw routine in draw_vex is 'rrts', i.e. draw nothing.
 9176  000076E6  317C00880028                   move #136,40(a0)           ; Set the colour.
 9177  000076EC  317CFFFF002A                   move #-1,42(a0)            ; Set the scale factor.
 9178  000076F2  4268002C                       clr 44(a0)                 ; Set the mode to 'get target'
 9179  000076F6  42680034                       clr 52(a0)                 ; Set so not an enemy.
