17737                                   ; return a ran# 0-255
17738                                   ; *******************************************************************
17739                                   rannum:
17740  0000E0D2  47F9xxxxxxxx                   lea rantab,a3              ; Point a3 at rantab.
17741  0000E0D8  06790001xxxxxxxx               add #1,ranptr
17742  0000E0E0  3039xxxxxxxx                   move ranptr,d0
17743  0000E0E6  C07C00FF                       and #$ff,d0                ; Keep it between 0 and 255
17744  0000E0EA  10330000                       move.b 0(a3,d0.w),d0
17745  0000E0EE  4E75                           rts
17746                                       
17747                                   ; *******************************************************************
17748                                   ; Return a number in d0  between zero and d1, uses same stuff as rannum (plus d1 obviously)
17749                                   ; *******************************************************************
17750                                   rand:
17751  0000E0F0  61E0                           bsr rannum                 ; Put a random number between 0 and d1 in d0.
17752  0000E0F2  C0C1                           mulu d1,d0
17753  0000E0F4  E088                           lsr.l #8,d0
17754  0000E0F6  4E75                           rts
17755                                       
17756                                   ; *******************************************************************
17757                                   ; setnewgen
17758                                   ; Initialize the wave data in 'wstuff' using the selected wave data structure.


                                        src/yak.s            Page 334     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


17759                                   ; a0 is the wave data structure selected from the 'waves' array.
17760                                   ; The processed data gets written to wstuff.
17761                                   ; e.g.
17762                                   ; _nw1:   dc.w 24       ; Duration
17763                                   ;         dc.w 120,0    ; Flippers - Max Time,  Index into 'inits' for generation routine.
17764                                   ;         dc.w -1       ; End of data sentinel
17765                                   ;
17766                                   ; _nw3:   dc.w 16       ; Duration
17767                                   ;         dc.w 120,0    ; Flippers - Max Time, Type
17768                                   ;         dc.w 0,444,1  ; Flipper Tankers - Sentinel, Max Time, Index into 'inits' for generation routine.
17769                                   ;         dc.w -1       ; End of data sentinel
17770                                   ; *******************************************************************
17771                                   setnewgen:
17772  0000E0F8  43F9xxxxxxxx                   lea wstuff,a1              ; Point to the wstuff table to a1
17773  0000E0FE  32FCFFFF                       move #-1,(a1)+             ; Terminate the previous entry.
17774                                           ; Read the header byte.
17775  0000E102  33D8xxxxxxxx                   move (a0)+,wave_dur        ; Store the duration in wave_dur.
17776                                           ; There's always at least one entry - for flippers, so we
17777                                           ; do that first entry here. It always has just two elements,
17778                                           ; while the others have three.
17779  0000E108  3018                           move (a0)+,d0              ; Stash the max time in d0.
17780  0000E10A  32C0                           move d0,(a1)+              ; Then store it in the wstuff table.
17781  0000E10C  32D8                           move (a0)+,(a1)+           ; Store the type in the wstuff table.
17782  0000E10E  E248                           lsr #1,d0                  ; Divide by 2.
17783  0000E110  32C0                           move d0,(a1)+              ; Store it as a timer.
17784                                       
17785                                           ; Process the remaining items in the wave data.
17786  0000E112  3018                   sngenl: move (a0)+,d0              ; Stash the sentinel in d0.
17787  0000E114  6B00xxxx                       bmi thaggit                ; If it's -1, then we've reached the end of the wave data.
17788  0000E118  32C0                           move d0,(a1)+              ; Otherwise store it in the wstuff table.
17789  0000E11A  3018                           move (a0)+,d0              ; Stash the max time in d0.
17790  0000E11C  32C0                           move d0,(a1)+              ; Store it in the wstuff table.
17791  0000E11E  32D8                           move (a0)+,(a1)+           ; Store the type in the wstuff table.
17792  0000E120  E248                           lsr #1,d0                  ; Divide by 2.
17793  0000E122  32C0                           move d0,(a1)+              ; Store it as a timer.
17794  0000E124  60EC                           bra sngenl                 ; Loop until all done
17795                                       
17796                                   thaggit:
17797  0000E126  33400004                       move d0,4(a1)              ; Store the end sentinel
17798  0000E12A  4279xxxxxxxx                   clr wave_tim               ; Clear the wave timer.
17799  0000E130  4E75                           rts
17800                                       
17801                                   ; *******************************************************************
17802                                   ; newgen
17803                                   ; Use the wstuff table to determine the generation of new enemies.
17804                                   ; Processes each entry in wstuff and sees if its time to generate a new
17805                                   ; enemy for each enemy type in the wave.
17806                                   ; *******************************************************************
17807  0000E132  4A79xxxxxxxx           newgen: tst wave_tim
17808  0000E138  6B00E470                       bmi rrts                   ; If not, return now.
17809  0000E13C  4A79xxxxxxxx                   tst startbonus
17810  0000E142  6A00xxxx                       bpl nostab
17811  0000E146  6100C24A                       bsr do_oneup
17812  0000E14A  4279xxxxxxxx                   clr startbonus
17813                                       
17814  0000E150  41F9xxxxxxxx           nostab: lea wstuff,a0              ; Get the wave table.


                                        src/yak.s            Page 335     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


17815                                           ; Process the first entry in the wstuff table (always the flipper entry).
17816  0000E156  046800010006                   sub #1,6(a0)               ; Decrement the wave timer.
17817  0000E15C  6A00xxxx                       bpl nugen1
17818  0000E160  30280004                       move 4(a0),d0              ; Store the type/index of the first entry (always a flipper) in d0.
17819  0000E164  6100xxxx                       bsr launch1                ; Try to launch a new flipper.
17820                                       
17821                                           ; Process the rest of the wstuff table.
17822  0000E168  41E80008               nugen1: lea 8(a0),a0               ; Move to the next entry in the list.
17823  0000E16C  30280004               nugen2: move 4(a0),d0              ; Store the type/index of the next entry in d0.
17824  0000E170  6B00E438                       bmi rrts                   ; If it's -1 we've reached the end of the wstuff table.
17825  0000E174  046800010006                   sub #1,6(a0)               ; Subtract 1 from the wave's timer.
17826  0000E17A  6A00xxxx                       bpl nugen3                 ; Is it zero yet? If not - go the next item in wsstuff.
17827  0000E17E  6100xxxx                       bsr launch1                ; If it is, then it's time to create a new enemy for this part of the wave.
17828  0000E182  41E80008               nugen3: lea 8(a0),a0               ; Move to the next entry in the list.
17829  0000E186  60E4                           bra nugen2                 ; Process it.
17830                                       
17831                                           ; Generate a new enemy.
17832  0000E188  4A79xxxxxxxx           launch1:tst t2k                    ; Are we in t2k mode?
17833  0000E18E  6600xxxx                       bne doany                  ; If not, go ahead and try to create an enemy.
17834  0000E192  B07C0006                       cmp #6,d0                  ; Is the type greater than 6?
17835  0000E196  6E00xxxx                       bgt shutoff                ; 
17836                                       
17837  0000E19A  3239xxxxxxxx           doany:  move noclog,d1             ; Get the available bandwidth for new enemies.
17838  0000E1A0  B279xxxxxxxx                   cmp afree,d1               ; Do we have room for a new enemy?
17839  0000E1A6  6A00E402                       bpl rrts                   ; if no, return now.
17840                                           ; Add an enemy.
17841  0000E1AA  316800020006                   move 2(a0),6(a0)
17842  0000E1B0  E548                           lsl #2,d0                  ; Multiply the type/index by 4
17843  0000E1B2  2F08                           move.l a0,-(a7)            ; Stash a0
17844  0000E1B4  41F9xxxxxxxx                   lea inits,a0               ; Load the inits list to a0.
17845  0000E1BA  20700000                       move.l 0(a0,d0.w),a0       ; Index into 'inits' to get the routine for this type/index.
17846  0000E1BE  4E90                           jsr (a0)                   ; Run the creation routine for this enemy type.
17847  0000E1C0  205F                           move.l (a7)+,a0            ; Retrieve the stashed a0.
17848  0000E1C2  04790001xxxxxxxx               sub #1,wave_dur            ; We've created an enemy, so knock one off the duration.
17849  0000E1CA  6A00E3DE                       bpl rrts                   ; If we still have more to generate, return now.
17850  0000E1CE  33FCFFFFxxxxxxxx               move #-1,wave_tim          ; Otherwise signal that there are no more to do.
17851  0000E1D6  4E75                           rts
17852                                       
17853                                   shutoff:
17854  0000E1D8  317C7FFF0002                   move #$7fff,2(a0)
17855  0000E1DE  317C7FFF0006                   move #$7fff,6(a0)
17856  0000E1E4  4E75                           rts
17857                                       
17858                                       
17859                                   ; *******************************************************************
17860                                   ; init_wave
17861                                   ; Set up the wave run routine.
17862                                   ; a0 is the wave data structure selected from the 'waves' array.
17863                                   ; e.g.
17864                                   ; _nw1:   dc.w 24
17865                                   ;         dc.w 120,0    ;Flippers
17866                                   ;         dc.w -1
17867                                   ; *******************************************************************
17868                                   init_wave:
17869  0000E1E6  6000FF10                       bra setnewgen              ; Initialize the wave data
17870                                       


                                        src/yak.s            Page 336     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


17871  0000E1EA  23C8xxxxxxxx                   move.l a0,wave_ptr
17872  0000E1F0  23FCxxxxxxxxxxxxxxxx           move.l #wave_stack,wave_sp   ; init pointer and stack
17873  0000E1FA  4279xxxxxxxx                   clr wave_tim               ; OK to run
17874  0000E200  4E75                           rts
17875                                       
17876                                   ; *******************************************************************
17877                                   ; Routines for generating all types of new enemies.
17878                                   ;
17879                                   ; *******************************************************************
17880                                   inits:
17881  0000E202  00008D9E000094D40000           dc.l make_flipper,make_tanker,make_spiker,make_fuseball,make_pulsar,make_futanker,make_putanker   ; 6
       0000E20C  99F200009CDC00009F8E   
       0000E216  000094B600009498       
17882  0000E21E  00008D7E00009BC80000           dc.l make_sflip2,make_mirr,make_adroid,make_beast,make_sflip3
       0000E228  8BEA00008D3200008D58   
17883                                       
17884                                   ; *******************************************************************
17885                                   ; Generate a new enemy if required.
17886                                   ; *******************************************************************
17887                                   run_wave:
17888  0000E232  6000FEFE                       bra newgen                 ; Add new enemies from 'wstuff' if available.
17889                                       
17890  0000E236  4A79xxxxxxxx                   tst wave_tim               ; Is it time to generate a new wave?
17891  0000E23C  6700xxxx                       beq rwave0                 ; If yes, go to rwave0.
17892  0000E240  6B00E368                       bmi rrts                   ; If value is negative, we're not generating enemies.
17893  0000E244  3039xxxxxxxx                   move wave_speed,d0         ; Get the wave speed.
17894  0000E24A  9179xxxxxxxx                   sub d0,wave_tim            ; Subtract it from the wave timer.
17895  0000E250  6A00E358                       bpl rrts                   ; If still positive, return as not time to generate a new enemy.
17896  0000E254  4279xxxxxxxx                   clr wave_tim               ; Clear the timer, we'll generate a new enemy the next time we come round.
17897  0000E25A  4E75                           rts                        ; Return.
17898                                       
17899  0000E25C  B07C0001               rwave:  cmp #1,d0                  ; Is wave speed '1'?
17900  0000E260  6600xxxx                       bne strin                  ; If so, avoid granting bonuses.
17901                                       
17902                                           ; Generate a new wave.
17903  0000E264  4A79xxxxxxxx           rwave0: tst startbonus             ; Has the player received a start bonus?
17904  0000E26A  6A00xxxx                       bpl nosb                   ; No, skip.
17905  0000E26E  6100C122                       bsr do_oneup               ; Yes, give them an extra life.
17906  0000E272  4279xxxxxxxx                   clr startbonus             ; Clear the start bonus.
17907                                       
17908  0000E278  3039xxxxxxxx           nosb:   move noclog,d0             ; Number of new waves we could tolerate.
17909  0000E27E  B079xxxxxxxx                   cmp afree,d0               ; Number of slots available.
17910  0000E284  6C00E324                       bge rrts                   ; If not enough slots, don't add any new waves.
17911                                       
17912                                           ; Update the wave as appropriate to its current state.
17913  0000E288  2C79xxxxxxxx           strin:  move.l wave_ptr,a6         ; Get the current wave ptr.
17914  0000E28E  101E                   rave:   move.b (a6)+,d0            ; Get the current status of the wave.
17915                                       
17916                                           ; Check if it's 'waiting'.
17917  0000E290  B03C0077                       cmp.b #'w',d0              ; Is it in wait status?
17918  0000E294  6600xxxx                       bne rwav1                  ; No, check if it's awaiting intialisation.
17919                                           ; It's waiting, so set the timer based on its value.
17920  0000E298  101E                           move.b (a6)+,d0            ; Put the timer value in d0
17921  0000E29A  C07C00FF                       and #$ff,d0                ; Just the LSB.
17922  0000E29E  3200                           move d0,d1                 ; Stash it in d1.
17923  0000E2A0  E248                           lsr #1,d0                  ; Divide by 2.


                                        src/yak.s            Page 337     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


17924  0000E2A2  D041                           add d1,d0                  ; Add to initial timer value.
17925  0000E2A4  33C0xxxxxxxx                   move d0,wave_tim           ; Set result as wave_tim
17926  0000E2AA  23CExxxxxxxx           wok:    move.l a6,wave_ptr         ; Store updated a6 in wave_ptr
17927  0000E2B0  4E75                           rts
17928                                       
17929                                           ; Is it awaiting initialisation?
17930  0000E2B2  B03C0069               rwav1:  cmp.b #'i',d0              ; Awaiting initialisation?
17931  0000E2B6  6600xxxx                       bne rwav2                  ; No, check if it's open.
17932                                           ; Initialize it.
17933  0000E2BA  101E                           move.b (a6)+,d0            ; Get the index to the init routine.
17934  0000E2BC  C07C00FF                       and #$ff,d0                ; LSB byte only.
17935  0000E2C0  41F90000E202                   lea inits,a0               ; Stash the inits array in a0.
17936  0000E2C6  E540                           asl #2,d0                  ; Multiply index by 4.
17937  0000E2C8  20700000                       move.l 0(a0,d0.w),a0       ; Get the init routine from inits.
17938  0000E2CC  2F0E                           move.l a6,-(a7)            ; Stash a6.
17939  0000E2CE  4E90                           jsr (a0)                   ; Run the init routine.
17940  0000E2D0  2C5F                           move.l (a7)+,a6            ; Retrieve a6.
17941  0000E2D2  6ABA                           bpl rave                   ; If it worked, try running it.
17942  0000E2D4  4DEEFFFE                       lea -2(a6),a6              ; Try the previous one.
17943  0000E2D8  33FC000Axxxxxxxx               move #10,wave_tim          ; Try again after 10 ticks
17944  0000E2E0  60C8                           bra wok                    ; Exit run_wave for now.
17945                                       
17946                                           ; Is it for an open loop?
17947  0000E2E2  B03C0028               rwav2:  cmp.b #'(',d0              ; Is the wave for an open loop?
17948  0000E2E6  6600xxxx                       bne rwav3                  ; If no, check for closed loop.
17949                                           ; Set it up.
17950  0000E2EA  101E                           move.b (a6)+,d0            ; Put the loop counter in d0.
17951  0000E2EC  C07C00FF                       and #$ff,d0                ; Just the LSB byte.
17952  0000E2F0  2079xxxxxxxx                   move.l wave_sp,a0          ; Stash the wave_sp in a0.
17953  0000E2F6  20CE                           move.l a6,(a0)+            ; Add the wave_ptr to the stack.
17954  0000E2F8  30C0                           move d0,(a0)+              ; Add the loop counter to the stack.
17955  0000E2FA  23C8xxxxxxxx                   move.l a0,wave_sp          ; Restore the wave_sp from a0.
17956  0000E300  608C                           bra rave                   ; Try again.
17957                                       
17958                                           ; Is it for a closed loop?
17959  0000E302  B03C0029               rwav3:  cmp.b #')',d0              ; Is the wave for a closed loop?
17960  0000E306  6600xxxx                       bne rwav4                  ; If no, check if it's finished.
17961  0000E30A  2079xxxxxxxx                   move.l wave_sp,a0          ; Stash wave_sp in a0.
17962  0000E310  04680001FFFE                   sub #1,-2(a0)              ; Decrement the counter.
17963  0000E316  6B00xxxx                       bmi unstak                 ; If less than zero, free it up.
17964  0000E31A  2C68FFFA                       move.l -6(a0),a6           ; Set pointer from stack
17965  0000E31E  6000FF6E                       bra rave                   ; Try again.
17966                                       
17967  0000E322  04B900000006xxxxxxxx   unstak: sub.l #6,wave_sp           ; free stack space
17968  0000E32C  6000FF7C                       bra wok                    ; Exit run_wave for now.
17969                                       
17970                                           ; Is it finished?
17971  0000E330  B03C0065               rwav4:  cmp.b #'e',d0              ; End
17972  0000E334  6600FF74                       bne wok                    ; effectively discard spuirious shit
17973  0000E338  33FCFFFFxxxxxxxx               move #-1,wave_tim          ; turn it off
17974  0000E340  4E75                           rts
