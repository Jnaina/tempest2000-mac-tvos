11872  000098B6  2C48                           move.l a0,a6               ; Move our newly created object into the activeobjects list.
11873  000098B8  6100xxxx                       bsr toweb                  ; Attach the Tanker to the web
11874  000098BC  2C5F                           move.l (a7)+,a6            ; Restore stashed values from the stack.
11875  000098BE  04790001xxxxxxxx               sub #1,noclog
11876  000098C6  6000xxxx                       bra insertobject           ; Add it to the activeobjects list.
