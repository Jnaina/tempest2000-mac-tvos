17583  0000DEFE  2248                           move.l a0,a1
17584  0000DF00  41E80010                       lea 16(a0),a0
17585  0000DF04  23480008                       move.l a0,8(a1)
17586  0000DF08  51C8FFF0                       dbra d0,inipri
