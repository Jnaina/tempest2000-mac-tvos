11933  0000999A  33FC000Dxxxxxxxx               move #$0d,sfx              ; Select 'tink for spike' sound effect.
11934  000099A2  33FC0002xxxxxxxx               move #2,sfx_pri            ; Set the sound's priority compared to others.
11935  000099AA  302E0024                       move 36(a6),d0
11936  000099AE  C0BC000001FF                   and.l #$1ff,d0
11937  000099B4  D0BC0000020C                   add.l #524,d0
11938  000099BA  23C0xxxxxxxx                   move.l d0,sfx_pitch
11939  000099C0  4EB9xxxxxxxx                   jsr fox                    ; Play selected sound effect.
11940  000099C6  303C0002                       move #2,d0
11941  000099CA  6100xxxx                       bsr doscore
11942  000099CE  6100xxxx                       bsr webinfo
11943  000099D2  046E00030024                   sub #3,36(a6)              ; dec spike length
11944  000099D8  6A00xxxx                       bpl rrts
11945  000099DC  206E002C                       move.l 44(a6),a0
11946  000099E0  4290                           clr.l (a0)                 ; clear entry in spike table.
11947  000099E2  06790001xxxxxxxx               add #1,noclog
11948  000099EA  303C0002                       move #2,d0
11949  000099EE  6000F6E2                       bra fkm
