 9148                                   ; makedroid
 9149                                   ; Maybe make an AI droid object.
 9150                                   ; *******************************************************************
 9151                                   makedroid:
 9152  0000768C  0C790002xxxxxxxx               cmp #2,players             ; Are we in 2 player mode?
 9153  00007694  6700xxxx                       beq rrts                   ; no Droid in 2p mode
 9154  00007698  0C790002xxxxxxxx               cmp #2,entities            ; Are there 2 entities?
 9155  000076A0  6600xxxx                       bne rrts                   ; If not, return.
 9156                                           ; Otherwise 1 of the entities must be a droid, 2 entities and not 2p, it's droidytime.
 9157                                       
 9158                                   ; *******************************************************************
 9159                                   ; mkdroid
 9160                                   ; Make an AI Droid object.
 9161                                   ; *******************************************************************
 9162                                   mkdroid:
 9163  000076A4  2079xxxxxxxx                   move.l freeobjects,a0      ; Point a0 at the address to use for our new activeobject.
 9164  000076AA  04790001xxxxxxxx               sub #1,ofree               ; Make one less slot available on the freeobjects list.
 9165  000076B2  20B9xxxxxxxx                   move.l _cube,(a0)          ; Set address of the vector object to draw: _cube.
 9166  000076B8  317C0014000C                   move #webz-90,12(a0)       ; Set our Z position as near the top of the web.
 9167  000076BE  3039xxxxxxxx                   move web_firstseg,d0       ; Get the first lane on the web.
