17515                                   ; *******************************************************************
17516                                   ; MoveLink
17517                                   ; Linked-list transfer entry from list a4 to list a3
17518                                   ; prev ptr in a1, next in a2
17519                                   ; Part of the GPU object management system.
17520                                   ; *******************************************************************
17521                                   MoveLink:
17522  0000DE1C  B3FCFFFFFFFF           mlink:  cmpa.l #-1,a1              ; Prev is -1?
17523  0000DE22  6600xxxx                       bne ML1
17524  0000DE26  288A                           move.l a2,(a4)             ; Make Next entry current top of list
17525  0000DE28  B5C9                           cmpa.l a1,a2               ; Check if Next is -1
17526  0000DE2A  6700xxxx                       beq NewLink                ; Yup, we were the only entry
17527  0000DE2E  B5FCFFFFFFFF           ML1:    cmpa.l #-1,a2              ; Next link is -1?
17528  0000DE34  6600xxxx                       bne ML2                    ; Nope
17529  0000DE38  234A003C                       move.l a2,60(a1)           ; Make prev link-to-next -1
17530  0000DE3C  6000xxxx                       bra NewLink
17531  0000DE40  B3FCFFFFFFFF           ML2:    cmpa.l #-1,a1
17532  0000DE46  6700xxxx                       beq ml3
17533  0000DE4A  234A003C                       move.l a2,60(a1)
17534  0000DE4E  25490038               ml3:    move.l a1,56(a2)           ; Link 'em up


                                        src/yak.s            Page 330     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


17535  0000DE52  2853                   NewLink:move.l (a3),a4             ; Get address of first entry of dest list
17536  0000DE54  B9FCFFFFFFFF                   cmpa.l #-1,a4              ; Check if link is real
17537  0000DE5A  6600xxxx                       bne NL1                    ; Yup
17538  0000DE5E  2688                           move.l a0,(a3)             ; Make ourselves the first entry
17539  0000DE60  217CFFFFFFFF0038               move.l #-1,56(a0)
17540  0000DE68  217CFFFFFFFF003C               move.l #-1,60(a0)
17541  0000DE70  4240                           clr d0
17542  0000DE72  4E75                           rts
17543  0000DE74  217CFFFFFFFF0038       NL1:    move.l #-1,56(a0)          ; Gonna insert ourselves at the top
17544  0000DE7C  29480038                       move.l a0,56(a4)           ; We are his previous
17545  0000DE80  214C003C                       move.l a4,60(a0)           ; And he is our next
17546  0000DE84  2688                           move.l a0,(a3)             ; Put us in
17547  0000DE86  4240                           clr d0
17548  0000DE88  4E75                           rts
