15339  0000C37A  47E8FFE0                       lea -32(a0),a3
15340  0000C37E  08EB0007000A                   bset.b #7,10(a3)
15341  0000C384  4E75                           rts
15342                                       
15343  0000C386  xxxxxxxx               ModeVex: dc.l rrts
15344                                       
15345                                   ; *******************************************************************
15346                                   ; InitLists
15347                                   ; Set up our dlist and blist object list pointers.
15348                                   ; Our end result is that we point ddlist at dlist. ddlist will be stored
15349                                   ; in the OLP (Object List Pointer), which is what the Graphics Processor
15350                                   ; will use as the address of the object list to use for all objects to be
15351                                   ; painted to the screen.
15352                                   ;
15353                                   ; We also set up blist, which is where all our objects will actually get
15354                                   ; stored. When ready to be drawn we will copy blist into dlist so that it
15355                                   ; can be processed by the Object Processor. It's InitBeasties and RunBeasties
15356                                   ; that create all the items in blist.
15357                                   ;
15358                                   ; Align object list buffers and initialise them with some
15359                                   ; data, set one of them to be displayed
15360                                   ; *******************************************************************
15361                                   InitLists:
15362  0000C38A  203Cxxxxxxxx                   move.l #list1,d0
15363  0000C390  C0BCFFFFFFE0                   and.l #$ffffffe0,d0        ; make sure it's quadphrase aligned
15364                                       
15365  0000C396  2040                           move.l d0,a0
15366  0000C398  20FC00000000                   move.l #0,(a0)+            ; The STOP Object for v pos out of range.
15367  0000C39E  20FC00000004                   move.l #4,(a0)+
15368  0000C3A4  41E80018                       lea 24(a0),a0              ; Move to next object
15369  0000C3A8  23C8xxxxxxxx                   move.l a0,ddlist           ; Initial start point of list
15370                                       
15371  0000C3AE  EB88                           lsl.l #5,d0


                                        src/yak.s            Page 291     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


15372  0000C3B0  3239xxxxxxxx                   move n_vdb,d1
15373  0000C3B6  3439xxxxxxxx                   move n_vde,d2              ; display start + end...
15374  0000C3BC  E749                           lsl #3,d1
15375  0000C3BE  E74A                           lsl #3,d2                  ; shift'em up
15376  0000C3C0  827C0003                       or #3,d1
15377  0000C3C4  847C0003                       or #3,d2                   ; set branch-object bitz
15378  0000C3C8  08C1000E                       bset #14,d1                ; branch if beam < n_vdb
15379  0000C3CC  08C2000F                       bset #15,d2                ; branch if beam > n_vde
15380                                       
15381                                       
15382  0000C3D0  4840                           swap d0                    ; this is the address of the stopobject
15383  0000C3D2  30FC0000                       move #0,(a0)+
15384  0000C3D6  30C0                           move d0,(a0)+
15385  0000C3D8  4840                           swap d0                    ; Swap position of the first 2 bytes with last 2 bytes.
15386  0000C3DA  30C0                           move d0,(a0)+
15387  0000C3DC  30C1                           move d1,(a0)+
15388                                       
15389  0000C3DE  4840                           swap d0                    ; this is the address of the stopobject
15390  0000C3E0  30FC0000                       move #0,(a0)+
15391  0000C3E4  30C0                           move d0,(a0)+
15392  0000C3E6  4840                           swap d0                    ; Swap position of the first 2 bytes with last 2 bytes.
15393  0000C3E8  30C0                           move d0,(a0)+
15394  0000C3EA  30C2                           move d2,(a0)+
15395                                       
15396  0000C3EC  23C8xxxxxxxx                   move.l a0,dlist
15397  0000C3F2  6100xxxx                       bsr StopList
15398                                       
15399  0000C3F6  203Cxxxxxxxx                   move.l #list2,d0           ; same for the other list
15400  0000C3FC  C0BCFFFFFFE0                   and.l #$ffffffe0,d0        ; make sure it's quadphrase aligned
15401  0000C402  23C0xxxxxxxx                   move.l d0,blist
15402  0000C408  2040                           move.l d0,a0
15403  0000C40A  6000xxxx                       bra StopList
15404                                       
15405                                   StopList:
15406  0000C40E  303C000F                       move #15,d0
15407  0000C412  20FC00000000           sl:     move.l #0,(a0)+
15408  0000C418  20FC00000004                   move.l #4,(a0)+            ; make a stopobject
15409  0000C41E  51C8FFF2                       dbra d0,sl
15410  0000C422  4E75                           rts
