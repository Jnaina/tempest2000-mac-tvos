 6730  00005572  7604                           move.l #4,d3               ; Set the number of pixels per ring.
 6731  00005574  23FC0000000600F03FFC           move.l #6,gpu_mode         ; Select 'pring' routine in xcamel.gas.
 6732  0000557E  41F900F03F60                   lea in_buf,a0              ; Point our GPU RAM input buffer at a0.
 6733  00005584  20C3                           move.l d3,(a0)+            ; # pixels per ring
 6734  00005586  202E0004                       move.l 4(a6),d0            ; Get the source X position.
 6735  0000558A  90B9xxxxxxxx                   sub.l vp_x,d0              ; Subtract the player/camera viewpoint X position.
 6736  00005590  20C0                           move.l d0,(a0)+            ; Add it to our GPU RAM input buffer.
 6737  00005592  202E0008                       move.l 8(a6),d0            ; Get the object's Y position.
 6738  00005596  90B9xxxxxxxx                   sub.l vp_y,d0              ; Subtract the player/camera viewpoint Y position.
 6739  0000559C  20C0                           move.l d0,(a0)+            ; Add it to our GPU RAM input buffer.
 6740  0000559E  202E000C                       move.l 12(a6),d0           ; Get the object's Z position.
 6741  000055A2  90B9xxxxxxxx                   sub.l vp_z,d0              ; Subtract the player/camera viewpoint Z position.
 6742  000055A8  20C0                           move.l d0,(a0)+            ; XYZ position
 6743  000055AA  4840                           swap d0                    ; Swap position of the first 2 bytes with last 2 bytes.
 6744  000055AC  3E00                           move d0,d7
 6745                                       
 6746  000055AE  6100C4A4               dprdpr: bsr pulser                 ; Calculate pulse colour and store in d6.
 6747  000055B2  CCBC000000FF                   and.l #$ff,d6              ; Keep it between 0 and 255
 6748  000055B8  20C6                           move.l d6,(a0)+            ; colour
 6749  000055BA  20C4                           move.l d4,(a0)+            ; radius 16:16
 6750  000055BC  C0BC000000FF                   and.l #$ff,d0              ; Keep it between 0 and 255
 6751  000055C2  20C0                           move.l d0,(a0)+            ; phase
 6752  000055C4  41F9xxxxxxxx                   lea xparrot,a0             ; Load the GPU module in 'xcamel.gas'.
 6753  000055CA  4EB9xxxxxxxx                   jsr gpurun                 ; do clear screen
 6754  000055D0  4EF9xxxxxxxx                   jmp gpuwait                ; Wait for the GPU to finish.
