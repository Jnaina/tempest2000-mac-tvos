  617                                   
  618                                   ; Bits when LONGword is formatted as below (from JOYTEST\JT_LOOP.S).
  619                                   ;
  620                                   ; Format: xxApxxBx RLDU147* xxCxxxox 2580369#
  621                                   
  622           =00000014               JOY_UP          EQU     20              ;joypad
  623           =00000015               JOY_DOWN        EQU     21
  624           =00000016               JOY_LEFT        EQU     22
  625           =00000017               JOY_RIGHT       EQU     23
  626                                   
  627           =0000001D               FIRE_A          EQU     29              ;fire buttons
  628           =00000019               FIRE_B          EQU     25
  629           =0000000D               FIRE_C          EQU     13
  630           =00000009               OPTION          EQU     9
  631           =0000001C               PAUSE           EQU     28
  632                                   
  633           =00000010               KEY_STAR        EQU     16              ;keypad
  634           =00000011               KEY_7           EQU     17
  635           =00000012               KEY_4           EQU     18
  636           =00000013               KEY_1           EQU     19
  637                                   
  638           =00000004               KEY_0           EQU     4
  639           =00000005               KEY_8           EQU     5
  640           =00000006               KEY_5           EQU     6
  641           =00000007               KEY_2           EQU     7
  642                                   
  643           =00000000               KEY_HASH        EQU     0
  644           =00000001               KEY_9           EQU     1
  645           =00000002               KEY_6           EQU     2
  646           =00000003               KEY_3           EQU     3
  647                                   
  648           =00000012               SHIFT_L         EQU     18              ; ProController Mappings
  649           =00000002               SHIFT_R         EQU     2
  650           =00000011               FIRE_Z          EQU     17
  651           =00000005               FIRE_Y          EQU     5
  652           =00000001               FIRE_X          EQU     1
  653                                   
  654           =00F00000               ANY_JOY         EQU     $00F00000       ; AND joyedge with this...
  655                                                                           ; joypad was pressed if result is not 0


                                        jaguar.inc           Page 21      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  656           =32002200               ANY_FIRE        EQU     $32002200       ; AND joyedge with this...
  657                                                                           ; A,B C, Option or Pause was pressed
  658                                                                           ; if result is not 0
  659           =000F00FF               ANY_KEY         EQU     $000F00FF       ; AND joyedge with this... 123456789*0#
  660                                                                           ; was pressed if result is not 0
  661                                   
  662                                   ;;;
  663                                   ;;;     ROM Tables built into Jerry - 128 samples each
  664                                   ;;;     16 bit samples sign extended to 32
  665                                   ;;;
  666                                   
  667           =00F1D000               ROM_TABLE       EQU     BASE + $1D000   ; Base of tables
  668                                   
  669           =00F1D000               ROM_TRI         EQU     BASE + $1D000   ; A triangle wave
  670           =00F1D200               ROM_SINE        EQU     BASE + $1D200   ; Full amplitude SINE
  671           =00F1D400               ROM_AMSINE      EQU     BASE + $1D400   ; Linear (?) ramp SINE
  672           =00F1D600               ROM_12W         EQU     BASE + $1D600   ; SINE(X)+SINE(2*X) : (was ROM_SINE12W)
  673           =00F1D800               ROM_CHIRP16     EQU     BASE + $1D800   ; SHORT SWEEP
  674           =00F1DA00               ROM_NTRI        EQU     BASE + $1DA00   ; Triangle w/NOISE
  675           =00F1DC00               ROM_DELTA       EQU     BASE + $1DC00   ; Positive spike
  676           =00F1DE00               ROM_NOISE       EQU     BASE + $1DE00   ; Guess
  677                                   
  678                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  679                                   ;       JERRY Registers (DSP)
  680                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  681                                   
  682           =00F1A100               D_FLAGS         EQU     BASE + $1A100   ; DSP Flags
  683           =00F1A104               D_MTXC          EQU     BASE + $1A104   ; DSP Matrix Control
  684           =00F1A108               D_MTXA          EQU     BASE + $1A108   ; DSP Matrix Address
  685           =00F1A10C               D_END           EQU     BASE + $1A10C   ; DSP Data Organization
  686           =00F1A110               D_PC            EQU     BASE + $1A110   ; DSP Program Counter
  687           =00F1A114               D_CTRL          EQU     BASE + $1A114   ; DSP Operation Control/Status
  688           =00F1A118               D_MOD          EQU     BASE + $1A118   ; DSP Modulo Instruction Mask
  689           =00F1A11C               D_REMAIN        EQU     BASE + $1A11C   ; DSP Division Remainder
  690           =00F1A11C               D_DIVCTRL       EQU     BASE + $1A11C   ; DSP Divider control
  691           =00F1A120               D_MACHI        EQU     BASE + $1A120   ; DSP Hi byte of MAC operations
  692           =00F1B000               D_RAM           EQU     BASE + $1B000   ; DSP Internal RAM
  693           =00F1D000               D_ENDRAM        EQU     D_RAM +(8*1024) ; 8K bytes
  694                                   
  695                                   ;;;
  696                                   ;;; JERRY Flag Register Equates
  697                                   ;;;
  698                                   
  699           =00000010               D_CPUENA        EQU     $00000010       ; CPU Interrupt Enable Bit
  700           =00000020               D_I2SENA        EQU     $00000020       ; I2S Interrupt Enable Bit
  701           =00000040               D_TIM1ENA       EQU     $00000040       ; Timer 1 Interrupt Enable Bit
  702           =00000080               D_TIM2ENA       EQU     $00000080       ; Timer 2 Interrupt Enable Bit
  703           =00000100               D_EXT0ENA       EQU     $00000100       ; External Interrupt 0 Enable Bit
  704           =00010000               D_EXT1ENA       EQU     $00010000       ; External Interrupt 1 Enable Bit
  705                                   
  706           =00000200               D_CPUCLR        EQU     $00000200       ; CPU Interrupt Clear Bit
  707           =00000400               D_I2SCLR        EQU     $00000400       ; I2S Interrupt Clear Bit
  708           =00000800               D_TIM1CLR       EQU     $00000800       ; Timer 1 Interrupt Clear Bit
  709           =00001000               D_TIM2CLR       EQU     $00001000       ; Timer 2 Interrupt Clear Bit
  710           =00002000               D_EXT0CLR       EQU     $00002000       ; External Interrupt 0 Clear Bit
  711           =00020000               D_EXT1CLR       EQU     $00020000       ; External Interrupt 1 Clear Bit


                                        jaguar.inc           Page 22      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  712                                   
  713                                   ;;;
  714                                   ;;; JERRY Control/Status Register
  715                                   ;;;
  716                                   
  717           =00000001               DSPGO           EQU     $00000001       ; Start DSP
  718           =00000004               DSPINT0         EQU     $00000004       ; Generate a DSP Interrupt 0
  719                                   
  720           =00000040               D_CPULAT        EQU     $00000040       ; Interrupt Latches
  721           =00000080               D_I2SLAT        EQU     $00000080
  722           =00000100               D_TIM1LAT       EQU     $00000100
  723           =00000200               D_TIM2LAT       EQU     $00000200
  724           =00000400               D_EXT1LAT       EQU     $00000400
  725           =00010000               D_EXT2LAT       EQU     $00010000
  726                                   
  727                                   ;;;
  728                                   ;;; JERRY Modulo Instruction Masks
  729                                   ;;;
  730                                   
  731           =FFFFFFFE               MODMASK2        EQU     $FFFFFFFE       ; 2 byte circular buffer
  732           =FFFFFFFC               MODMASK4        EQU     $FFFFFFFC       ; 4 byte circular buffer
  733           =FFFFFFF8               MODMASK8        EQU     $FFFFFFF8       ; 8 byte circular buffer
  734           =FFFFFFF0               MODMASK16       EQU     $FFFFFFF0       ; 16 byte circular buffer
  735           =FFFFFFE0               MODMASK32       EQU     $FFFFFFE0       ; 32 byte circular buffer
  736           =FFFFFFC0               MODMASK64       EQU     $FFFFFFC0       ; 64 byte circular buffer
  737           =FFFFFF80               MODMASK128      EQU     $FFFFFF80       ; 128 byte circular buffer
  738           =FFFFFF00               MODMASK256      EQU     $FFFFFF00       ; 256 byte circular buffer
  739           =FFFFFE00               MODMASK512      EQU     $FFFFFE00       ; 512 byte circular buffer
  740           =FFFFFC00               MODMASK1K       EQU     $FFFFFC00       ; 1k circular buffer
  741           =FFFFF800               MODMASK2K       EQU     $FFFFF800       ; 2k circular buffer
  742           =FFFFF000               MODMASK4K       EQU     $FFFFF000       ; 4k circular buffer
  743           =FFFFE000               MODMASK8K       EQU     $FFFFE000       ; 8k circular buffer
  744           =FFFFC000               MODMASK16K      EQU     $FFFFC000       ; 16k circular buffer
  745           =FFFF8000               MODMASK32K      EQU     $FFFF8000       ; 32k circular buffer
  746           =FFFF0000               MODMASK64K      EQU     $FFFF0000       ; 64k circular buffer
  747           =FFFE0000               MODMASK128K     EQU     $FFFE0000       ; 128k circular buffer
  748           =FFFC0000               MODMASK256K     EQU     $FFFC0000       ; 256k circular buffer
  749           =FFF80000               MODMASK512K     EQU     $FFF80000       ; 512k circular buffer
  750           =FFF00000               MODMASK1M       EQU     $FFF00000       ; 1M circular buffer
  751                                   
  752                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  753                                   ;;; SHARED Equates for TOM (GPU) and JERRY (DSP)
  754                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  755                                   
  756                                   ;;;
  757                                   ;;; Control/Status Registers
  758                                   ;;;
  759                                   
  760           =00000001               RISCGO          EQU     $00000001       ; Start GPU or DSP
  761           =00000002               CPUINT          EQU     $00000002       ; Allow the GPU/DSP to interrupt CPU
  762           =00000004               FORCEINT0       EQU     $00000004       ; Cause an INT 0 on GPU or DSP
  763           =00000008               SINGLE_STEP     EQU     $00000008       ; Enter SINGLE_STEP mode
  764           =00000010               SINGLE_GO       EQU     $00000010       ; Execute one instruction
  765                                   
  766           =00004000               REGPAGE         EQU     $00004000       ; Register Bank Select
  767           =00008000               DMAEN           EQU     $00008000       ; Enable DMA LOAD and STORE


                                        jaguar.inc           Page 23      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  768                                   
  769                                   ;;;
  770                                   ;;; Flags Register
  771                                   ;;;
  772                                   
  773           =00000001               ZERO_FLAG       EQU     $00000001       ; ALU Zero Flag
  774           =00000002               CARRY_FLAG      EQU     $00000002       ; ALU Carry Flag
  775           =00000004               NEGA_FLAG       EQU     $00000004       ; ALU Negative Flag
  776                                   
  777           =00000008               IMASK           EQU     $00000008       ; Interrupt Service Mask
  778                                   
  779                                   ;;;
  780                                   ;;; Matrix Control Register
  781                                   ;;;
  782                                   
  783           =00000003               MATRIX3         EQU     $00000003       ; use for 3x1 Matrix
  784           =00000004               MATRIX4         EQU     $00000004       ; etc...
  785           =00000005               MATRIX5         EQU     $00000005
  786           =00000006               MATRIX6         EQU     $00000006
  787           =00000007               MATRIX7         EQU     $00000007
  788           =00000008               MATRIX8         EQU     $00000008
  789           =00000009               MATRIX9         EQU     $00000009
  790           =0000000A               MATRIX10        EQU     $0000000A
  791           =0000000B               MATRIX11        EQU     $0000000B
  792           =0000000C               MATRIX12        EQU     $0000000C
  793           =0000000D               MATRIX13        EQU     $0000000D
  794           =0000000E               MATRIX14        EQU     $0000000E
  795           =0000000F               MATRIX15        EQU     $0000000F
  796                                   
  797           =00000000               MATROW          EQU     $00000000       ; Access Matrix by Row
  798           =00000010               MATCOL          EQU     $00000010       ; Access Matrix by Column
  799                                   
  800                                   ;;;
  801                                   ;;; Data Organisation Register
  802                                   ;;;
  803                                   
  804           =00010001               BIG_IO          EQU     $00010001       ; Use 32-bit registers as big-endian
  805           =00020002               BIG_PIX         EQU     $00020002       ; Pixel organisation is big-endian
  806           =00040004               BIG_INST        EQU     $00040004       ; Word program fetches are big-endian
  807                                   
  808                                   ;;;
  809                                   ;;; Divide Unit Control
  810                                   ;;;
  811                                   
  812           =00000001               DIV_OFFSET      EQU     $00000001       ; Divide 16.16 values if set
  813                                   
  814                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  815                                   ;;; Atari claimed the below registers should never be messed with and
  816                                   ;;; eventually removed them from later copies of jaguar.inc. However, there
  817                                   ;;; are corner cases in which messing with them is necessary (E.g., fixing up
  818                                   ;;; MEMCON1 to access the Jaguar CD's memory-mapped registers while booting
  819                                   ;;; from a Skunkboard, programming custom high-resolution video modes, etc.),
  820                                   ;;; so I've restored them. In general though, the point stands: Don't use
  821                                   ;;; these if you don't know what you're doing.
  822                                   ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  823                                   


                                        jaguar.inc           Page 24      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


  824           =00F00000               MEMCON1         EQU     BASE + 0        ; Memory Configuration Register One
  825           =00F00002               MEMCON2         EQU     BASE + 2        ; Memory Configuration Register Two
  826           =00F00020               OLPLO           EQU     BASE + $20
  827           =00F00022               OLPHI           EQU     BASE + $22
  828           =00F00024               ODP             EQU     BASE + $24      ; Object Data Pointer
  829           =00F0002E               HP              EQU     BASE + $2e      ; Horizontal Period
  830           =00F00030               HBB             EQU     BASE + $30      ; Horizontal Blanking Begin
  831           =00F00032               HBE             EQU     BASE + $32      ; Horizontal Blanking End
  832           =00F00034               HS              EQU     BASE + $34      ; Horizontal Sync
  833           =00F00036               HVS             EQU     BASE + $36      ; Horizontal Vertical Sync
  834           =00F0003E               VP              EQU     BASE + $3e      ; Vertical Period
  835           =00F00040               VBB             EQU     BASE + $40      ; Vertical Blanking Begin
  836           =00F00042               VBE             EQU     BASE + $42      ; Vertical Blanking End
  837           =00F0004A               VEB             EQU     BASE + $4a      ; Vertical EQUalization Begin
  838           =00F0004C               VEE             EQU     BASE + $4c      ; Vertical EQUalization End
  839           =00F00054               HEQ             EQU     BASE + $54      ; Horizontal EQUalization End
  840           =00F00056               TEST1           EQU     BASE + $56      ; Undocumented Register - DO NOT USE
