13666                                   ; *******************************************************************
13667                                   ; nutargg
13668                                   ; Animate the movement of the claw by changing the member of 'claws',
13669                                   ; which is a list of activeobject-type objects, for all 8 claw polygons.
13670                                   ; *******************************************************************
13671                                   nutargg:
13672                                           ; Get our position in the web and convert it to a value we can use
13673                                           ; for getting the right polygon for that position in 'claws'.
13674                                           ; First, we convert the position to an index we can use.
13675  0000AEB6  202E0010                       move.l 16(a6),d0           ; Put the position on the web in d0.
13676  0000AEBA  ED88                           lsl.l #6,d0                ; Multiply it by 64.
13677  0000AEBC  4840                           swap d0                    ; Swap position of the first 2 bytes with last 2 bytes.
13678  0000AEBE  3200                           move d0,d1
13679  0000AEC0  C07C001C                       and #$1c,d0
13680  0000AEC4  7401                           move.l #1,d2               ; h.scale valu
13681  0000AEC6  C27C0020                       and #$20,d1
13682  0000AECA  6600xxxx                       bne noflipme
13683                                       
13684                                           ; Flip the index so that we get a claw for the top of the web.
13685  0000AECE  4482                           neg.l d2
13686  0000AED0  323C001C                       move #$1c,d1
13687  0000AED4  9240                           sub d0,d1
13688  0000AED6  3001                           move d1,d0                 ; opposite frame
13689                                       
13690                                           ; Now we have claw's position as index we can use, so get the appropriate
13691                                           ; claw object from 'claws'.


                                        src/yak.s            Page 261     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


13692                                   noflipme:
13693  0000AED8  41F9xxxxxxxx                   lea claws,a0               ; Point a0 at claws.
13694  0000AEDE  2CB00000                       move.l 0(a0,d0.w),(a6)     ; Use our position in the web to point a6 at the right claw polygon.
13695  0000AEE2  302E0010                       move 16(a6),d0             ; Put the current position on web in d0.
13696  0000AEE6  E348                           lsl #1,d0                  ; Multiply it by 2.
13697  0000AEE8  2079xxxxxxxx                   move.l web_otab,a0         ; Point a0 at the orientation table.
13698  0000AEEE  3D700000001C                   move 0(a0,d0.w),28(a6)     ; Get the orientation value from the table and store it as 'roll' in our new activeobject.
13699  0000AEF4  2056                           move.l (a6),a0             ; Store the new claw to use in Byte 0 of the claw's activobject.
13700  0000AEF6  21420004                       move.l d2,4(a0)            ; scale (-ve to flip frame)
13701  0000AEFA  4E75                           rts
