 9271  000077FA  6100xxxx                       bsr l_webinfo              ; get info on the channel to the left
 9272                                   droim:
 9273  000077FE  4844                           swap d4                    ; Swap position of the first 2 bytes with last 2 bytes.
 9274  00007800  4244                           clr d4
 9275  00007802  4845                           swap d5                    ; Swap position of the first 2 bytes with last 2 bytes.
