15952                                   ; *******************************************************************
15953                                   ; extrude
15954                                   ; This routine reads in the web data structure for a given web.
15955                                   ;
15956                                   ; extrude a web from a list of 16 pairs of XY coordinates addressed by (a1)
15957                                   ;
15958                                   ; a0 = vector ram space; a2.l = z depth to extrude to;
15959                                   ; d0.l=x scale, d1.l=y scale, d2.l=z scale, d3.l=x centre, d4.l=y centre,
15960                                   ; d5.l=z centre, d6=angle (xy)/angle (xz), d7=angle (yz)
15961                                   ; a5 = webs,
15962                                   ;
15963                                   ; *******************************************************************
15964                                   extrude:
15965  0000C890  2079xxxxxxxx                   move.l vadd,a0
15966  0000C896  48E7FFA0                       movem.l d0-d7/a0/a2,-(a7)   ; save so routine can return address
15967  0000C89A  4279xxxxxxxx                   clr connect
15968  0000C8A0  2F0A                           move.l a2,-(a7)            ; save z depth
15969  0000C8A2  61A0                           bsr initvo                 ; make header, do standard vector object init
15970                                           ; a3 now points to connect_ptr
15971  0000C8A4  284B                           move.l a3,a4               ; save first vertex
15972  0000C8A6  2E1F                           move.l (a7)+,d7            ; retrieve z-depth
15973  0000C8A8  3007                           move d7,d0
15974  0000C8AA  E240                           asr #1,d0                  ; Divide by 2.
15975  0000C8AC  33C0xxxxxxxx                   move d0,web_z              ; Current Web z centering
15976  0000C8B2  4280                           clr.l d0
15977  0000C8B4  4281                           clr.l d1
15978  0000C8B6  4245                           clr d5                     ; to catch highest X point
15979  0000C8B8  3C19                           move (a1)+,d6              ; First byte from raw_web: # channels to a web
15980  0000C8BA  33C6xxxxxxxx                   move d6,web_max            ; Set as the number of lanes in the web.
15981  0000C8C0  33D9xxxxxxxx                   move (a1)+,web_firstseg    ; Second byte: player's starting position on web.
15982  0000C8C6  23C9xxxxxxxx                   move.l a1,web_ptab         ; Third byte: start of x/y pairs, the position table
15983  0000C8CC  2ACB                           move.l a3,(a5)+            ; first vertex to lanes list
15984                                       
15985                                           ; Read in the x/y pairs. xweb will loop for all lanes in the web.
