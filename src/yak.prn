 9240  000077C2  202E0018                       move.l 24(a6),d0           ; Move droid along its vector.
 9241  000077C6  D1AE0008                       add.l d0,8(a6)             ; Set Y position in activobject entry
 9242  000077CA  046E0001002C                   sub #1,44(a6)              ; dec timer, will fall thru to zero and seek a new targ.
 9243  000077D0  0C6E0008002C                   cmp #8,44(a6)              ; half way along the logical lane no. needs to change over
 9244  000077D6  6600xxxx                       bne rrts
 9245  000077DA  3D6E00300010                   move 48(a6),16(a6)         ; do that very Thang
 9246  000077E0  4E75                           rts
