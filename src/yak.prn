  449                                   ; ---------------------------------------
  450                                   ; TODO
  451                                   ;
  452                                   ; Interesting Search Keywords for the Impatient
  453                                   ; -------------------------------------------
  454                                   ; 'Init'   - Execution starts here.
  455                                   ; 'Frame:' - Responsible for updating the internal state of all the objects
  456                                   ;           in the game, such as enemies and the player's claw and bullets.
  457                                   ;           It is called every time the screen has finished painting, i.e.
  458                                   ;           at a 'vertical sync' interrupt.
  459                                   ; 'dloop' - The game's topmost control loop.
  460                                   ; 'mainloop' - The game's main loop. It's primary task is performing all the
  461                                   ;             GPU operations that prepare all the game's elements for drawing
  462                                   ;             to the screen.
  463                                   ;
  464                                   ; *******************************************************************
  465                                           .include  'jaguar.inc'
