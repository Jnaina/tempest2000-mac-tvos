17099  0000D8E4  49F9xxxxxxxx                   lea solids,a4              ; Point a4 at solids.
17100  0000D8EA  E548                           lsl #2,d0                  ; Multiply it by 4
17101  0000D8EC  20740000                       move.l 0(a4,d0.w),a0       ; polyobject draw routine address
