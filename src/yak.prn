 2685                                   ; *******************************************************************
 2686                                   ; draw_sfliptank
 2687                                   ; Draw a flipper tanker with customized colours in the flipper badge.
 2688                                   ; A member of the solids list.
 2689                                   ; A member of the 'shapes' list
 2690                                   ; Called during the draw_objects sequence as a member of the draw_vex list.
 2691                                   ; *******************************************************************
 2692                                   draw_sfliptank:
 2693  00001A28  43F9xxxxxxxx                   lea s_fliptank2,a1         ; Point a1 at the s_fliptank2 data structure.
 2694  00001A2E  3E39xxxxxxxx                   move frames,d7             ; Get the frame counter to use in pulser.
 2695  00001A34  E547                           asl #2,d7                  ; Multiply it by 4.
 2696  00001A36  D007                           add.b d7,d0                ; Add it to d0.
 2697  00001A38  2F05                           move.l d5,-(a7)            ; Stash some values in the stack so we can restore them later.
 2698  00001A3A  6100xxxx                       bsr pulser                 ; Use d7 to come up with a colour (returned in d6).
 2699  00001A3E  2A1F                           move.l (a7)+,d5            ; Restore stashed values from the stack.
 2700  00001A40  33460004                       move d6,4(a1)              ; Populate the color in the fliptank data structure.
 2701  00001A44  33460014                       move d6,20(a1)             ; Populate the color in the fliptank data structure.
 2702  00001A48  33460024                       move d6,36(a1)             ; Populate the color in the fliptank data structure.
 2703  00001A4C  33460034                       move d6,52(a1)             ; Populate the color in the fliptank data structure.
 2704  00001A50  6000xxxx                       bra drawsolidxy            ; Draw it as a solid polygon.
 2705                                       
 2706                                   ; *******************************************************************
 2707                                   ; pulser ; Calculate a pulse colour.
 2708                                   ;
 2709                                   ; enter with d7=counter, return pulse colour in d6, uses d5-7 and a2
 2710                                   ; *******************************************************************
 2711                                   pulser:
 2712  00001A54  CE7C00FF                       and #$ff,d7                ; Keep d7 between 0 and 255.
 2713  00001A58  45F9xxxxxxxx                   lea sines,a2               ; Load the sine table to a2.
 2714  00001A5E  1A327000                       move.b 0(a2,d7.w),d5       ; Use d7 as an index into the sine table.
 2715  00001A62  4885                           ext d5                     ; Make the result a long.
 2716  00001A64  DE3C0040                       add.b #$40,d7              ; Add $40 to d7.
 2717  00001A68  1C327000                       move.b 0(a2,d7.w),d6       ; Use that as an index into the sine table.
 2718  00001A6C  9E3C0040                       sub.b #$40,d7              ; Subtract $40 back out again from d7.
 2719  00001A70  4886                           ext d6                     ; Make the value from the sine table a long.
 2720  00001A72  DA7C0080                       add #$80,d5
 2721  00001A76  DC7C0080                       add #$80,d6
 2722  00001A7A  CA7C00F0                       and #$f0,d5
 2723  00001A7E  E84E                           lsr #4,d6                  ; Divide by 32.
 2724  00001A80  CC7C000F                       and #$0f,d6                ; Keep it between 0 and 15.
 2725  00001A84  8C45                           or d5,d6
 2726  00001A86  4E75                           rts
 2727                                       
 2728                                   ; *******************************************************************
 2729                                   ; drawsolid ; Draw a solid polygon with default centering.
 2730                                   ;
 2731                                   ; draw a solid Tempest enemy, enter with a1=poly shape address, d0=angle, d1=Z-position
 2732                                   ; d2-d3=XY, d4-d5=Centre position
 2733                                   ; *******************************************************************
 2734                                   drawsolid:
 2735  00001A88  4282                           clr.l d2
 2736  00001A8A  4283                           clr.l d3


                                        src/yak.s            Page 65      5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 2737  00001A8C  7809                           move.l #9,d4
 2738  00001A8E  7A09                           move.l #9,d5
 2739                                       
 2740                                   ; *******************************************************************
 2741                                   ; drawsolidxy ; Draw it as a solid polygon.
 2742                                   ; General purpose draw a solid polygon.
 2743                                   ; We use this to draw most of the objects in obj2d.s.
 2744                                   ; A pointer to the polygon's data structure (e.g. s_flipper) is passed in a1.
 2745                                   ; *******************************************************************
