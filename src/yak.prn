 9621                                   ; *******************************************************************
 9622                                   ; make_claws
 9623                                   ; *******************************************************************
 9624                                   make_claws:
 9625  00007C72  4DF9xxxxxxxx                   lea uclaws,a6              ; Point a6 at uclaws, our claw data structures.
 9626  00007C78  4BF9xxxxxxxx                   lea claws,a5               ; Point a5 at claws, where we will store the finished claw objects.
 9627  00007C7E  7000                           move.l #$00,d0             ; Set initial X pos
 9628  00007C80  7201                           move.l #$01,d1             ; Set initial Y pos.
 9629  00007C82  7401                           move.l #$01,d2             ; Set initial Z pos.
 9630  00007C84  7609                           move.l #9,d3               ; Set X centre.
 9631  00007C86  7809                           move.l #9,d4               ; Set Y centre.
 9632  00007C88  7A00                           move.l #0,d5               ; Set z centre.
 9633  00007C8A  4286                           clr.l d6                   ; Set initial orientation
 9634                                       
 9635  00007C8C  3E3C0007                       move #7,d7                 ; We have 8 claws to build.
 9636  00007C90  3F07                   mclaws: move d7,-(a7)              ; Stash some values in the stack so we can restore them later.
 9637  00007C92  4247                           clr d7
 9638  00007C94  225E                           move.l (a6)+,a1            ; Get the next claw data structure from uclaws.
 9639  00007C96  48E7FE00                       movem.l d0-d6,-(a7)        ; Stash some values in the stack so we can restore them later.
 9640  00007C9A  6100xxxx                       bsr make_vo3d              ; Make the vector object.
 9641  00007C9E  4CDF007F                       movem.l (a7)+,d0-d6        ; Restore stashed values from the stack.
 9642  00007CA2  2AC8                           move.l a0,(a5)+            ; Store the pointer to the claw object in the next position in 'claws'.
 9643  00007CA4  3E1F                           move (a7)+,d7              ; Restore stashed values from the stack.
 9644  00007CA6  51CFFFE8                       dbra d7,mclaws             ; Keep looping until zero.
 9645  00007CAA  4E75                           rts
