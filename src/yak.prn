12015  00009AB8  6600xxxx                       bne is_spike               ; Non zero if it is a spike
12016  00009ABC  D27C0001                       add #1,d1                  ; inc free spikes ctr
12017  00009AC0  32C0                           move d0,(a1)+              ; spike number to scratch ram
