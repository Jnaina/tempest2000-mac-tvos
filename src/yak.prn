 8893                                   ; *******************************************************************
 8894                                   ; sweb0
 8895                                   ; Start a new level, including playing a bonus game first if necessary.
 8896                                   ; *******************************************************************
 8897                                   sweb0:
 8898  000073D0  23FCxxxxxxxxxxxxxxxx           move.l #rrts,routine
 8899  000073DA  4A79xxxxxxxx                   tst t2k                    ; Are we playing Tempest 2000?
 8900  000073E0  6700xxxx                       beq swip1                  ; If not, skip to swip1.
 8901                                       
 8902                                           ; We're playing Tempest 2000, have we reached level 99?
 8903  000073E4  0C790063xxxxxxxx               cmp #99,cwave              ; Have we reached level 99?
 8904  000073EC  6D00xxxx                       blt wwoo                   ; If not yet, skip to wwoo.
 8905                                       
 8906                                           ; The player has beaten Tempest 2000!
 8907  000073F0  4279xxxxxxxx                   clr _pauen                 ; Disable pause
 8908  000073F6  4279xxxxxxxx                   clr pauen                  ; Disable pause
 8909  000073FC  33FC0001xxxxxxxx               move #1,term               ; Signal to exit mainloop.
 8910  00007404  33FC0001xxxxxxxx               move #1,gb                 ; Signal to allow beastly mode.
 8911  0000740C  4E75                           rts                        ; Bail out!
 8912                                       
 8913                                           ; Start the set up for a new level.
 8914  0000740E  4A79xxxxxxxx           wwoo:   tst warpy                  ; Do we still need more power-ups before we can warp?
 8915  00007414  6A00xxxx                       bpl swip1                  ; If so, carry them over to this level.
 8916  00007418  33FC0002xxxxxxxx               move #2,warpy              ; Otherwise we warped already, so reset power-ups required before next warp.
 8917  00007420  207C00050000                   move.l #screen3,a0
 8918  00007426  303C00C0                       move #192,d0               ; Clear screen a0
 8919  0000742A  4241                           clr d1
 8920  0000742C  343C00C0                       move #192,d2
 8921  00007430  363C0020                       move #32,d3
 8922  00007434  383C0000                       move #$000,d4
 8923  00007438  6100xxxx                       bsr BlitBlock              ; clear off pyramids
 8924  0000743C  2F39xxxxxxxx                   move.l vp_z,-(a7)          ; Stash some values in the stack so we can restore them later.
 8925                                       
 8926                                           ; Play a bonus game. There are three types, the one we play is based
 8927                                           ; on the level we've reached.
 8928  00007442  3039xxxxxxxx                   move cweb,d0               ; Get our current level.
 8929  00007448  E440                           asr #2,d0                  ; Divide it by 4.
 8930  0000744A  C07C000C                       and #$0c,d0                ; Clamp to 12 and store in d0.
 8931  0000744E  41F9000073C0                   lea bonies,a0              ; Point a0 to our array of 4 levels.
 8932  00007454  20700000                       move.l 0(a0,d0.w),a0       ; Use d0 as index to choose our level.
 8933  00007458  33FC0001xxxxxxxx               move #1,warped             ; Signal bonus level is active.
 8934  00007460  4E90                           jsr (a0)                   ; <<<< do a bonus-game
 8935  00007462  4279xxxxxxxx                   clr warped                 ; Signal bonus level inactive.
 8936                                       
 8937  00007468  33FC0001xxxxxxxx               move #1,wason
 8938  00007470  23FC000001F4xxxxxxxx           move.l #500,wapitch
 8939  0000747A  23DFxxxxxxxx                   move.l (a7)+,vp_z          ; Restore stashed values from the stack.
 8940  00007480  6100FAD6               swip1:  bsr sweb
 8941  00007484  4A79xxxxxxxx                   tst startbonus             ; check to add starting web's bonus
 8942  0000748A  6700xxxx                       beq sweb00
 8943  0000748E  33FCFFFFxxxxxxxx               move #-1,startbonus
 8944  00007496  2079xxxxxxxx                   move.l score,a0
 8945  0000749C  43F9xxxxxxxx                   lea lbonus+8,a1


