 6767  000055F2  20C3                           move.l d3,(a0)+            ; Add it to our GPU RAM input buffer.
 6768  000055F4  20C1                           move.l d1,(a0)+            ; XYZ position
 6769  000055F6  2E01                           move.l d1,d7
 6770  000055F8  4847                           swap d7                    ; Swap position of the first 2 bytes with last 2 bytes.
 6771  000055FA  6100C458                       bsr pulser                 ; Calculate a pulse colour.
 6772  000055FE  CCBC000000FF                   and.l #$ff,d6              ; Keep it between 0 and 255
 6773  00005604  20C6                           move.l d6,(a0)+            ; colour
 6774  00005606  302E002C                       move 44(a6),d0
 6775  0000560A  4840                           swap d0                    ; Swap position of the first 2 bytes with last 2 bytes.
 6776  0000560C  4240                           clr d0
 6777  0000560E  20C0                           move.l d0,(a0)+            ; radius 16:16
 6778  00005610  3039xxxxxxxx                   move frames,d0             ; Stash the frame count in d0.
 6779  00005616  C0BC000000FF                   and.l #$ff,d0              ; Keep it between 0 and 255
 6780  0000561C  20C0                           move.l d0,(a0)+            ; phase
 6781  0000561E  41F9xxxxxxxx                   lea xparrot,a0             ; Load the GPU module in 'xcamel.gas'.
