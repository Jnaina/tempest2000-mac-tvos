15598  0000C532  3E01                           move d1,d7
15599  0000C534  4847                           swap d7                    ; Swap position of the first 2 bytes with last 2 bytes.
15600  0000C536  3E00                           move d0,d7                 ; X and Y destination start
15601  0000C538  23C700F0220C                   move.l d7,A1_PIXEL
15602  0000C53E  23FC0000000000F02218           move.l #0,A1_FPIXEL
15603  0000C548  7E01                           move.l #$1,d7
