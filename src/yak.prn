 6577  00005368  20FC0083F400                   move.l #pic2,(a0)+         ; srce screen for effect
 6578  0000536E  20FC000000C6                   move.l #$0000c6,(a0)+      ; srce start pixel address
 6579  00005374  20FC0015000F                   move.l #$15000f,(a0)+      ; srce size
 6580  0000537A  2005                           move.l d5,d0               ; Get the scale.
 6581  0000537C  E680                           asr.l #3,d0                ; Divide by 8.
 6582  0000537E  20C0                           move.l d0,(a0)+            ; Put as x-scale in input buffer.
 6583  00005380  20C0                           move.l d0,(a0)+            ; Put as y-scale in input buffer.
 6584  00005382  20FC00000000                   move.l #0,(a0)+            ; no shear
 6585  00005388  20FC00000000                   move.l #0,(a0)+
 6586  0000538E  20FC00000001                   move.l #1,(a0)+            ; Mode 1 = Centered
 6587  00005394  202E0004                       move.l 4(a6),d0            ; Get the source X position.
 6588  00005398  90B9xxxxxxxx                   sub.l vp_x,d0              ; Subtract the player/camera viewpoint X position.
 6589  0000539E  20C0                           move.l d0,(a0)+            ; Add it to our GPU RAM input buffer.
 6590  000053A0  202E0008                       move.l 8(a6),d0            ; Get the object's Y position.
 6591  000053A4  90B9xxxxxxxx                   sub.l vp_y,d0              ; Subtract the player/camera viewpoint Y position.
 6592  000053AA  90BC00080000                   sub.l #$80000,d0           ; Subtract by even more.
 6593  000053B0  20C0                           move.l d0,(a0)+            ; Add it to our GPU RAM input buffer.
