 2763                                   ; gameover
 2764                                   ; Game Over sequence.
 2765                                   ;
 2766                                   ; Game Over accounting.
 2767                                   ; The game over graphical effect.
 2768                                   ;
 2769                                   ; *******************************************************************
 2770                                   gameover:
 2771  00001AC2  23FCxxxxxxxxxxxxxxxx           move.l #rrts,routine
 2772  00001ACC  4279xxxxxxxx                   clr _pauen                 ; Disable pausing.
 2773  00001AD2  4279xxxxxxxx                   clr pauen                  ; Disable pausing.
 2774  00001AD8  33FC0001xxxxxxxx               move #1,modnum             ; Request theme tune.
 2775  00001AE0  4A79xxxxxxxx                   tst h2h                    ; Are we playing a head-to-head game?
 2776  00001AE6  6600xxxx                       bne ddthis
 2777  00001AEA  4A79xxxxxxxx                   tst auto                   ; Are we in demo mode?
 2778  00001AF0  6600xxxx                       bne ddthis
 2779  00001AF4  3039xxxxxxxx                   move cwave,d0              ; Store the achieved level in d0
 2780  00001AFA  B07C0062                       cmp #98,d0                 ; Did we exceed the maximum?
 2781  00001AFE  6F00xxxx                       ble imaxx                  ; If not, go to imaxx.
 2782  00001B02  303C0062                       move #98,d0                ; 98 is the max possibl saved lvl
 2783  00001B06  41F9xxxxxxxx           imaxx:  lea t2k_max,a0             ; Put the maximum selectable level in a0
 2784  00001B0C  4A79xxxxxxxx                   tst t2k                    ; Are we playing Tempest 200?
 2785  00001B12  6600xxxx                       bne yty                    ; If yes go to yty.
 2786  00001B16  41F9xxxxxxxx                   lea trad_max,a0            ; If no, use the maximum selectable level for classic mode.
 2787  00001B1C  3210                   yty:    move (a0),d1               ; Store it in d1.
 2788  00001B1E  B041                           cmp d1,d0                  ; Compare with the level we achieved.
 2789  00001B20  6F00xxxx                       ble ddthat                 ; Do not update if this was llarger
 2790  00001B24  3080                           move d0,(a0)               ; save the highest wave we ever reached
 2791  00001B26  31400002               ddthat: move d0,2(a0)              ; save where we got to this game
 2792  00001B2A  23FCxxxxxxxxxxxxxxxx   ddthis: move.l #gofeed,demo_routine


