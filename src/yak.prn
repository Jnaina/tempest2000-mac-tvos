 9408                                   ; *******************************************************************
 9409                                   ; setclaw
 9410                                   ; Create the player's claw object, the caller adds it to the activeobjects
 9411                                   ; list.
 9412                                   ; Current player number is in d7. Player 1 = 1, Player 2 = 2.
 9413                                   ; *******************************************************************
 9414                                   setclaw:
 9415  000079AE  204E                           move.l a6,a0
 9416  000079B0  2CB9xxxxxxxx                   move.l claws,(a6)          ; Set 'claws' as the array of solids to use for drawing.
 9417  000079B6  42AE0004                       clr.l 4(a6)                ; Set X to 0.
 9418  000079BA  42AE0008                       clr.l 8(a6)                ; Set Y to 0.
 9419  000079BE  701E                           move.l #webz-80,d0         ; Store just above the top of the web's Z position in d0.
 9420  000079C0  4840                           swap d0                    ; initial Z position
 9421  000079C2  2D40000C                       move.l d0,12(a6)           ; Set it as our Z position in activobject entry.
 9422  000079C6  2D79xxxxxxxx0010               move.l web_firstseg,16(a6)   ; web position
 9423  000079CE  42AE0014                       clr.l 20(a6)               ; clear CLAWV
 9424  000079D2  2D7C000004000018               move.l #$400,24(a6)        ; clear CLAWA
 9425  000079DA  42AE001C                       clr.l 28(a6)               ; Set roll to zero..
 9426  000079DE  426E0020                       clr 32(a6)                 ; initial X,Y,Z rotation is zero
 9427  000079E2  3D7C00000022                   move #0,34(a6)             ; no draw at first, it will be Z-TRAIL...
 9428  000079E8  3D7C00FF0028                   move #255,40(a6)           ; yellow, the proper colour for a Tempest claw
 9429  000079EE  3D7C0001002A                   move #1,42(a6)             ; scaler value
 9430  000079F4  3D7C03030030                   move #$0303,48(a6)         ; fire timer  (0303 std)
 9431  000079FA  4A79xxxxxxxx                   tst beastly                ; Are we in beastly mode?
 9432  00007A00  6700xxxx                       beq knobby                 ; If not, skip.
 9433  00007A04  3D7C06060030                   move #$0606,48(a6)         ; If  in beastly mode, make firing less frequent.
 9434                                       
 9435  00007A0A  0C790002xxxxxxxx       knobby: cmp #2,players             ; Are we in 2 player mode?
 9436  00007A12  6700xxxx                       beq setdouble              ; If yes, figure out which player we're setting up.
 9437                                       
 9438                                           ; We're in single player mode, so set up the object update routine and return.
 9439  00007A16  3D7C0010002E                   move #16,46(a6)            ; Set secondary update routine to 'claw_con1'.
 9440  00007A1C  6000xxxx                       bra set_rezclaw            ; Set up the rest of the object and return.
 9441                                           ; Returns
 9442                                       
 9443                                           ; We're in 2 player mode, figure out which player we're creating.
 9444                                   setdouble:
 9445  00007A20  3007                           move d7,d0                 ; Put the player number in d7.
 9446  00007A22  D07C000E                       add #14,d0                 ; Add 14 to it.
 9447  00007A26  3140002E                       move d0,46(a0)             ; Set object update routine for Player1 as claw_con2, for Player 2 as claw_con1.
 9448  00007A2A  BE7C0001                       cmp #1,d7                  ; Is this for Player 1?
 9449  00007A2E  6600xxxx                       bne set_rezclaw            ; If not, skip next bit.


                                        src/yak.s            Page 185     5:01:00 pm 29-Sep-2026        RMAC 2.1.01 (Linux/OSX)


 9450  00007A32  317C005F0028                   move #95,40(a0)            ; Set colour of Player 1 claw.
 9451  00007A38  066800020010                   add #2,16(a0)              ; Second claw rezzes nearby
