 6715  0000554E  7A09                           move.l #9,d5
 6716  00005550  302E002E                       move 46(a6),d0             ; Put number of pixels to draw in d0.
 6717  00005554  C0BC000000FF                   and.l #$ff,d0              ; Keep it between 0 and 255
 6718  0000555A  3E3C0002                       move #2,d7                 ; Store Number of times to draw in d7, i.e. animation length.
 6719  0000555E  3C3C0055                       move #$55,d6               ; Set the offset to add to the angle when animating.
 6720  00005562  43F9xxxxxxxx                   lea xbit,a1                ; Point a1 to the xbit data structure.
 6721  00005568  6000C130                       bra s_multi                ; Draw it.
