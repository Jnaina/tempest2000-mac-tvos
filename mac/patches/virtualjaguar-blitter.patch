+/* Constant fill of one line (Tempest 2000 clears the screen this way: ~60% of all blitted pixels).
+ * Applies only when the blit is a pure PATDSEL fill -- no source or destination read, no Z, no comparators,
+ * no clipping, no Gouraud -- onto a 16bpp, pitch-0, one-pixel-per-step destination that lies wholly in main
+ * RAM, with nothing observing the writes (blit memo, shadow framebuffers).  Then the per-pixel loop would store
+ * the same PATTERNDATA halfword n_pixels times to consecutive addresses and advance A1/A2 linearly, so do
+ * exactly that in one go.  Returns 0 (having changed nothing) whenever any condition does not hold. */
+static BLITTER_ALWAYS_INLINE int blitter_fill_line(uint32_t a1_flags)
+{
+   uint32_t n = n_pixels, x0, addr, i, k;
+   uint16_t pat[4];
+   if (((a1_flags >> 3) & 0x07) != 4 || a1_pitch != 0
+         || a1_xadd != (1 << 16) || a1_yadd != 0)
+      return 0;
+   if (blitMemoMode || shadowFBActive || shadowHiresActive)
+      return 0;
+   if (a2_mask_x != -1 || a2_mask_y != -1)
+      return 0;
+   x0 = (uint32_t)a1_x >> 16;
+   if (x0 + n > 0x10000)
+      return 0;
+   addr = a1_addr + ((((uint32_t)a1_y >> 16) * (uint32_t)a1_width + x0) << 1);
+   if (addr >= 0x200000 || addr + 2 * n > 0x200000)
+      return 0;
+   /* The pixel the loop would write at column X is READ_RDATA(PATTERNDATA, a1, ...): one constant halfword,
+    * or in phrase mode the 64-bit pattern indexed by X & 3.  Evaluate it with the loop's own macro. */
+   for (k = 0; k < 4; k++)
+   {
+      int32_t pk_x = (int32_t)(k << 16);
+      pat[k] = (uint16_t)READ_RDATA_16(PATTERNDATA, pk, a1_phrase_mode);
+   }
+   if (!a1_phrase_mode)
+      pat[1] = pat[2] = pat[3] = pat[0];
+   if (pat[0] == pat[1] && pat[1] == pat[2] && pat[2] == pat[3] && (pat[0] >> 8) == (pat[0] & 0xFF))
