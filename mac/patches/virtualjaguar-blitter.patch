+      {
+         uint16_t d = pat[(x0 + i) & 3];
+         jaguarMainRAM[addr + 2 * i]     = (uint8_t)(d >> 8);
+         jaguarMainRAM[addr + 2 * i + 1] = (uint8_t)(d & 0xFF);
+      }
